# Ghostty color theme, rendered from the active palette by lib/theme.sh.
# The layout is the upstream catppuccin/ghostty theme with every value a
# palette token, so it follows theme.conf. Selected by `theme = dotfiles.conf`
# in ../config.
palette = 0=@@SURFACE1@@
palette = 1=@@RED@@
palette = 2=@@GREEN@@
palette = 3=@@YELLOW@@
palette = 4=@@BLUE@@
palette = 5=@@PINK@@
palette = 6=@@TEAL@@
palette = 7=@@SUBTEXT0@@
palette = 8=@@SURFACE2@@
palette = 9=@@RED@@
palette = 10=@@GREEN@@
palette = 11=@@YELLOW@@
palette = 12=@@BLUE@@
palette = 13=@@PINK@@
palette = 14=@@TEAL@@
palette = 15=@@SUBTEXT1@@
background = @@BASE_RAW@@
foreground = @@TEXT_RAW@@
cursor-color = @@ROSEWATER_RAW@@
cursor-text = @@CRUST_RAW@@
# Upstream hardcodes 353749 here, a blend that sits between surface0 and
# surface1; surface0 is the nearest palette color.
selection-background = @@SURFACE0_RAW@@
selection-foreground = @@TEXT_RAW@@
