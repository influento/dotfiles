# Ghostty terminal configuration
# Managed by dotfiles repo.
# Docs: https://ghostty.org/docs/config

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = calt
font-feature = liga

# Theme
theme = dotfiles.conf
bold-is-bright = true

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = none

# Cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# Scrollback
scrollback-limit = 50000
copy-on-select = clipboard
confirm-close-surface = false
# No OSC 52 writes: tmux (with tmux-yank) and Claude Code copy with wl-copy and
# also send OSC 52. When wl-copy lands first, sway rejects Ghostty's write as
# superseded, yet GTK keeps treating itself as the owner and ignores every later
# copy, so ctrl+v pastes stale text until restart. OSC 52 copies from inside
# tmux (nvim over ssh) still arrive: tmux's pane-set-clipboard hook passes them
# to wl-copy (common/tmux/tmux.conf.tpl). Outside tmux they are dropped.
# GTK bug, open as of GTK 4.24.1 (Nov 2026):
# https://gitlab.gnome.org/GNOME/gtk/-/work_items/8527 (MR !10441 fixes only
# compositors that send cancelled; wlroots does not). Once a GTK release fixes
# it, drop this line and check that ctrl+v still pastes the newest copy.
clipboard-write = deny

# Shell integration (prompt jumping, command output selection)
shell-integration = detect

# Auto-start tmux. tmux-attach runs tmux-revive, which restores the saved
# sessions on a new server before it attaches (workstation/scripts/tmux-attach).
command = tmux-attach

# Keybinds
# Copy is handled by copy-on-select; ctrl+c stays plain SIGINT
keybind = ctrl+v=paste_from_clipboard
