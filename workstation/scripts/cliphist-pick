#!/usr/bin/env bash
# cliphist-pick — Clipboard history picker (gtk-widgets launcher --dmenu), on
# $mod+v. sway also starts the history: wl-paste --watch cliphist-store.
# launcher-clipboard adds thumbnails and previews to cliphist's list; Right in
# the picker opens the preview pane. A row's cross (or Ctrl+d) deletes that
# entry: launcher hands its line to cliphist delete and stays open.
set -euo pipefail

# The pick's "<id>" is all launcher-clipboard --restore needs: cut drops the
# label and the options after it, NUL bytes included, before bash sees them.
# --restore puts images and file links back as file + path (+ image bytes),
# so Telegram pastes the picture and a terminal the path; text goes through
# wl-copy as before.
# Esc makes launcher exit 1 with no output; stop there, or launcher-clipboard
# --restore would run with an empty id (cliphist decodes nothing, and wl-copy
# of empty input replaces the clipboard with empty data). The Clear button
# exits 10: empty the history and the current clipboard
status=0
id=$(launcher-clipboard |
  launcher --dmenu --prompt Clipboard --after-tab --action Clear \
    --delete 'cliphist delete' |
  cut -f1) || status=$?
case "$status" in
  0) launcher-clipboard --restore "$id" ;;
  10)
    wl-copy --clear
    cliphist wipe
    ;;
esac
