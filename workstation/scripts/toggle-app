#!/usr/bin/env bash
set -euo pipefail

# toggle-app — Start an app, or kill it if it is already running. Bound to
# waybar clicks: nm-connection-editor on the network module, pavucontrol on
# the audio one. flock keeps a double click from launching two copies; the
# 0.5s hold after the app exits is the debounce.
#
# Usage: toggle-app <command> [args...]

if [[ $# -eq 0 ]]; then
  echo "usage: toggle-app <command> [args...]" >&2
  exit 1
fi

# pgrep/pkill -x match the kernel's comm name: the executable's basename cut
# to 15 bytes (nm-connection-editor runs as nm-connection-e).
name="$(basename "$1")"
name="${name:0:15}"
LOCKFILE="/tmp/.toggle-app-${name}-${UID}.lock"

exec 9>"$LOCKFILE"
if ! flock -n 9; then
  if pgrep -x "$name" >/dev/null 2>&1; then
    pkill -x "$name"
  fi
  exit 0
fi

if pgrep -x "$name" >/dev/null 2>&1; then
  pkill -x "$name"
  flock -u 9
else
  flock -u 9
  "$@"
  exec 9>"$LOCKFILE"
  flock -n 9 && sleep 0.5
fi
