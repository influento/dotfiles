#!/usr/bin/env bash
set -euo pipefail

# tmux-attach — the terminal's entry point: restore the saved tmux state, then
# attach. Ghostty runs this instead of `tmux new-session -A -s main`.
#
# It exists because tmux-continuum's own auto-restore is unusable here, in two
# separate ways, so `@continuum-restore` is off in common/tmux/tmux.conf.tpl:
#
#   * It decides whether to restore at all from `ps -u | grep "^tmux"`, a count
#     of every concurrent tmux process. A second terminal opening in the same
#     moment pushes the count over its threshold and the restore is skipped
#     silently — the "sometimes it restores, sometimes it doesn't" symptom.
#   * When it does fire it restores in the background, while the shell is
#     already live. Panes created in those seconds race tmux-resurrect's
#     pane_exists check, so it splits a pane that is already there; the pane
#     count then no longer matches the saved layout, select-layout refuses it
#     (the error is swallowed), and the window is left as horizontal strips
#     with 1-row-tall panes. It ratchets: the broken layout is what gets saved.
#
# Restoring here is unconditional and finishes before the shell exists, so
# nothing can race it.

readonly restore_script="$HOME/.local/share/tmux/plugins/tmux-resurrect/scripts/restore.sh"
readonly lock_file="${XDG_RUNTIME_DIR:-/tmp}/tmux-attach.lock"
readonly restored_flag='@dotfiles-restored'
# Not `main`: saved state may hold a `main` of its own, and a name no saved
# state can hold is one this script can drop without touching real work.
readonly bootstrap_session='tmux-attach-bootstrap'

server_running() {
  tmux list-sessions >/dev/null 2>&1
}

# The session a terminal lands on: the most recently used one holding real
# work, or nothing. Skipped are the bootstrap session and tmux-overlay's
# hidden `ov-*` sessions.
# session_last_attached is empty for a session never attached — every session
# right after a restore — so the format substitutes 0 rather than leave a
# field that would shift the ones after it.
attach_target() {
  local last activity name
  local best_last=-1 best_activity=-1 best=''
  while IFS=' ' read -r last activity name; do
    case "$name" in
      "$bootstrap_session" | ov-*) continue ;;
    esac
    if [ "$last" -gt "$best_last" ] ||
      { [ "$last" -eq "$best_last" ] && [ "$activity" -gt "$best_activity" ]; }; then
      best_last="$last"
      best_activity="$activity"
      best="$name"
    fi
  done < <(tmux list-sessions -F \
    '#{?session_last_attached,#{session_last_attached},0} #{?session_activity,#{session_activity},0} #{session_name}' \
    2>/dev/null 9>&-)
  printf '%s' "$best"
}

# Set on the server, so it survives for the server's lifetime and no second
# terminal restores on top of a session that is already back.
already_restored() {
  [ "$(tmux show-options -gv "$restored_flag" 2>/dev/null || true)" = "1" ]
}

# A server holding nothing but the bootstrap session this script creates, or a
# one-window `main`, is one a restore may fill. Anything else is live work, and
# restoring onto it is never right whatever the flag says: tmux-resurrect names
# windows by index, so on a layout that has since closed windows and renumbered
# it stamps saved names on the wrong windows, with automatic-rename off, and
# they keep them for good.
server_is_bare() {
  local name windows
  while IFS=$'\t' read -r name windows; do
    case "$name" in
      "$bootstrap_session") ;;
      main) [ "$windows" -le 1 ] || return 1 ;;
      *) return 1 ;;
    esac
  done < <(tmux list-sessions -F $'#{session_name}\t#{session_windows}' 2>/dev/null 9>&-)
  return 0
}

# Every tmux command here closes fd 9. This is load-bearing: the tmux server
# inherits the fds of whichever client forks it and then outlives this script,
# so a server holding fd 9 holds the lock forever and every later terminal
# blocks on flock with no way out.
restore_once() {
  server_running || tmux new-session -d -s "$bootstrap_session" 9>&-
  if already_restored; then
    return 0
  fi
  if ! server_is_bare; then
    tmux set-option -g "$restored_flag" 1 9>&-
    return 0
  fi
  # run-shell, not a direct call: restore.sh derives the server socket from
  # $TMUX (`echo $TMUX | cut -d, -f1`), so run outside a tmux context it builds
  # `tmux -S "" new-session` and creates no session at all — it would restore
  # windows into sessions that happen to exist and drop every other one.
  if [ -x "$restore_script" ]; then
    tmux run-shell "$restore_script" 9>&-
  fi
  # Panes that ran Claude Code come back as shells; claude-tmux resumes the
  # conversations it recorded and re-flags what they were waiting on.
  if command -v claude-tmux >/dev/null 2>&1; then
    claude-tmux restore 9>&- || true
  fi
  tmux set-option -g "$restored_flag" 1 9>&-
}

# The bootstrap session only existed to give the restore a tmux context. With
# work restored it goes, so the terminal lands on that work; with nothing
# restored it becomes `main` — unless a `main` already exists, and a failed
# rename would abort this script before any terminal attaches.
settle_bootstrap() {
  tmux has-session -t "=$bootstrap_session" 2>/dev/null 9>&- || return 0
  if [ -n "$(attach_target)" ] || tmux has-session -t '=main' 2>/dev/null 9>&-; then
    tmux kill-session -t "=$bootstrap_session" 9>&- || true
  else
    tmux rename-session -t "=$bootstrap_session" main 9>&- || true
  fi
}

# Two terminals opening at once must not both restore.
exec 9>"$lock_file"
flock 9
restore_once
settle_bootstrap
exec 9>&-

# `main` is only a fallback, for a server with no work in it.
target=$(attach_target)
if [ -n "$target" ] && tmux has-session -t "=$target" 2>/dev/null; then
  exec tmux attach-session -t "=$target"
fi
exec tmux new-session -A -s main
