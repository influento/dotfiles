#!/usr/bin/env bash
set -euo pipefail

# tmux-attach: what ghostty runs for every terminal. tmux-revive
# (influento/tmux-plugins) restores the saved sessions on a new server, then
# attaches. Without the binary a plain tmux session opens, so a failed
# download never costs the terminal.
command -v tmux-revive >/dev/null && exec tmux-revive attach
exec tmux new-session -A -s main
