#!/usr/bin/env bash
set -euo pipefail

# startup-reminders — Show pending reminders as desktop notifications on sway start.
# Reads reminders/*.txt from the dotfiles repo and sends each pending line via
# notify-send. Which lines are pending is decided by lib/reminders.sh, shared
# with install.sh.

# Resolve repo root through this script's own symlink
# (~/.local/bin/startup-reminders → <dotfiles>/workstation/scripts/startup-reminders)
DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../lib/reminders.sh
source "${DOTFILES_DIR}/lib/reminders.sh"

sleep 10

while IFS= read -r msg; do
  notify-send -u critical "Reminder" "$msg"
done < <(pending_reminders "$HOME/.local/state/dotfiles/completed" \
  "${DOTFILES_DIR}/reminders/common.txt" "${DOTFILES_DIR}/reminders/workstation.txt")
