#!/usr/bin/env bash
set -euo pipefail

# Toggle sleep inhibition for the current login session: while on, the
# machine never sleeps or hibernates on its own.
#
# Two logind inhibitors, both needed:
#   sleep              refuses every sleep operation, so swayidle's
#                      suspend-then-hibernate after 60 min idle (see
#                      workstation/swayidle/config) does nothing
#   handle-lid-switch  stops logind acting on lid close at all. The sleep
#                      lock alone does not cover the lid: logind ignores it
#                      for the lid switch (LidSwitchIgnoreInhibited=yes)
#
# Lock/display-off timeouts are untouched: the screen still locks at 15 min
# and displays still power off at 30 min. UPower's critical-battery action
# still fires, so a laptop left running with the lid closed shuts down
# cleanly instead of dying.
#
# State lives in a transient systemd --user unit, so it survives closing the
# terminal but is gone after a reboot.

UNIT="nosleep"
REASON="nosleep: sleep inhibited by user"

usage() {
  cat <<'EOF'
Usage: nosleep <on|off|status|toggle>

  on      Block idle sleep and lid-close sleep (screen lock and
          display-off still apply)
  off     Allow sleep again
  status  Report whether sleep is currently inhibited
  toggle  Flip between on and off
EOF
}

is_active() {
  systemctl --user is-active --quiet "$UNIT"
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$1" "$2" || true
}

# Nudge the waybar indicator so it reflects the change immediately instead of
# waiting for its poll interval. Signal number matches "signal": 8 on
# custom/nosleep in waybar/config.tpl.
refresh_waybar() {
  pkill -RTMIN+8 waybar 2>/dev/null || true
}

nosleep_on() {
  if is_active; then
    echo "nosleep: already on"
    return 0
  fi
  systemd-run --user --quiet --unit="$UNIT" \
    --description="Inhibit sleep (idle and lid close)" \
    systemd-inhibit --what=sleep:handle-lid-switch --why="$REASON" \
    sleep infinity
  echo "nosleep: on — sleep blocked (idle and lid close)"
  notify "No Sleep" "Sleep blocked, lid close included. Screen still locks and displays still power off."
  refresh_waybar
}

nosleep_off() {
  if ! is_active; then
    echo "nosleep: already off"
    return 0
  fi
  systemctl --user stop "$UNIT"
  echo "nosleep: off — sleep allowed"
  notify "No Sleep" "Sleep re-enabled, lid close included."
  refresh_waybar
}

nosleep_status() {
  if is_active; then
    echo "nosleep: on — sleep blocked (idle and lid close)"
  else
    echo "nosleep: off — sleep allowed"
  fi
}

main() {
  case "${1:-status}" in
    on) nosleep_on ;;
    off) nosleep_off ;;
    status) nosleep_status ;;
    toggle)
      if is_active; then nosleep_off; else nosleep_on; fi
      ;;
    -h | --help | help) usage ;;
    *)
      echo "nosleep: unknown command '${1}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
