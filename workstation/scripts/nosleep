#!/usr/bin/env bash
set -euo pipefail

# Keep the machine running for the current login session, in two levels:
#
#   nosleep  the machine never sleeps or hibernates on its own. The screen
#            still locks at 15 min and displays still power off at 30 min.
#            For a long task you walk away from
#   awake    nosleep, plus no idle lock and no idle display-off. For a call
#            or reading: you are there but give no input
#
# Each level is a transient systemd --user unit, so it survives closing the
# terminal but is gone after a reboot. The units are independent: awake holds
# its own inhibitors, so `nosleep on` (headless calls it) never stops an
# awake. Both stay on until `off` (or `hibernate`) stops them.
#
# Two logind inhibitors, held by both units:
#   sleep              refuses every sleep operation, so swayidle's
#                      suspend-then-hibernate after 60 min idle (see
#                      workstation/swayidle/config) does nothing
#   handle-lid-switch  stops logind acting on lid close at all. The sleep
#                      lock alone does not cover the lid: logind ignores it
#                      for the lid switch (LidSwitchIgnoreInhibited=yes)
#
# awake's lock and display-off are skipped by swayidle itself: its timeouts
# check for the awake unit. Lid close locks at either level (`lock --lid`,
# bound in sway), unless another output is in use: docked, or headless mode.
# UPower's critical-battery action still fires, so a laptop left running with
# the lid closed shuts down cleanly instead of dying.

UNIT="nosleep"
AWAKE_UNIT="nosleep-awake"
REASON="nosleep: sleep inhibited by user"

usage() {
  cat <<'EOF'
Usage: nosleep <on|awake|off|status|toggle|cycle|hibernate>

  on         Block idle sleep and lid-close sleep (screen lock and
             display-off still apply)
  awake      As on, and the screen neither locks nor turns off when idle
  off        Allow sleep, idle lock and display-off again
  status     Report the current level: off, nosleep or awake
  toggle     Off if any level is on, otherwise on
  cycle      Step off -> nosleep -> awake -> off (the waybar click)
  hibernate  Turn everything off and hibernate now, even with the lid closed.
             Use this to hibernate when a long task finishes; the machine
             comes back with nosleep off
EOF
}

is_active() {
  systemctl --user is-active --quiet "$1"
}

level() {
  if is_active "$AWAKE_UNIT"; then
    echo awake
  elif is_active "$UNIT"; then
    echo nosleep
  else
    echo off
  fi
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$1" "$2" || true
}

# Nudge the waybar indicator so it reflects the change immediately instead of
# waiting for its poll interval. Signal number matches "signal": 8 on
# custom/nosleep in waybar/config.tpl.
refresh_waybar() {
  pkill -RTMIN+8 waybar 2>/dev/null || true
}

nosleep_on() {
  if is_active "$UNIT"; then
    echo "nosleep: already on"
    return 0
  fi
  systemd-run --user --quiet --collect --unit="$UNIT" \
    --description="Inhibit sleep (idle and lid close)" \
    systemd-inhibit --what=sleep:handle-lid-switch --why="$REASON" \
    sleep infinity
  echo "nosleep: on — sleep blocked (idle and lid close)"
  notify "No Sleep" "Sleep blocked, lid close included. Screen still locks and displays still power off."
  refresh_waybar
}

nosleep_awake() {
  if is_active "$AWAKE_UNIT"; then
    echo "nosleep: already awake"
    return 0
  fi
  systemd-run --user --quiet --collect --unit="$AWAKE_UNIT" \
    --description="Inhibit sleep, idle lock and display-off" \
    systemd-inhibit --what=sleep:handle-lid-switch --why="$REASON (awake)" \
    sleep infinity
  echo "nosleep: awake — no sleep, no idle lock, no display-off"
  notify "Awake" "No sleep, no idle lock, no display-off until turned off. Closing the lid still locks."
  refresh_waybar
}

nosleep_off() {
  if [[ "$(level)" == off ]]; then
    echo "nosleep: already off"
    return 0
  fi
  local unit
  for unit in "$AWAKE_UNIT" "$UNIT"; do
    if is_active "$unit"; then
      systemctl --user stop "$unit"
    fi
  done
  echo "nosleep: off — sleep, idle lock and display-off allowed"
  notify "No Sleep" "Off. Sleep, idle lock and display-off apply again."
  refresh_waybar
}

nosleep_status() {
  case "$(level)" in
    awake) echo "nosleep: awake — no sleep, no idle lock, no display-off" ;;
    nosleep) echo "nosleep: on — sleep blocked (idle and lid close)" ;;
    off) echo "nosleep: off — sleep allowed" ;;
  esac
}

# `nosleep off; systemctl hibernate` fails with the lid closed: logind acts on
# the lid the moment the lock is released, and the suspend freezes the caller
# before it reaches hibernate. It then hibernates only when the lid is opened.
# Holding handle-lid-switch across the switch keeps logind off the lid. The
# trailing sleep is frozen with everything else during hibernation, so the
# lock is released a few seconds after resume, not before the image is taken.
nosleep_hibernate() {
  # shellcheck disable=SC2016 # $1 expands in the inner bash, not here
  if ! systemd-inhibit --what=handle-lid-switch --why="nosleep: hibernating" \
    bash -c '"$1" off && systemctl hibernate && sleep 10' _ "$0"; then
    echo "nosleep: hibernate failed — nosleep is off, so normal sleep rules apply" >&2
    return 1
  fi
}

main() {
  case "${1:-status}" in
    on) nosleep_on ;;
    awake) nosleep_awake ;;
    off) nosleep_off ;;
    status) nosleep_status ;;
    level) level ;;
    toggle)
      if [[ "$(level)" == off ]]; then nosleep_on; else nosleep_off; fi
      ;;
    cycle)
      case "$(level)" in
        off) nosleep_on ;;
        nosleep) nosleep_awake ;;
        awake) nosleep_off ;;
      esac
      ;;
    hibernate) nosleep_hibernate ;;
    -h | --help | help) usage ;;
    *)
      echo "nosleep: unknown command '${1}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
