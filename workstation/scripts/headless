#!/usr/bin/env bash
set -euo pipefail

# headless — switch this machine between normal desktop and headless remote mode.
#
# Backup mode for power outages. The physical monitor is by far the largest
# consumer in the setup, so headless mode disables every physical output and
# serves the live Sway session over VNC to a virtual output instead, sized for
# whatever screen you connect from.
#
#   on      Create a headless output, start wayvnc on loopback, inhibit
#           suspend, then disable the physical outputs. Sway migrates the
#           workspaces to the headless output automatically.
#   off     Reverse all of that, restoring the workspace-to-output layout
#           recorded on the way in.
#   status  Report the current mode.
#   toggle  Flip between on and off.
#
# Capturing a virtual output rather than the physical one is deliberate: a
# disabled or powered-off output stops being composited, so wlr-screencopy has
# no frames to hand wayvnc and the stream would freeze. The headless output is
# always composited, which makes remote access independent of the monitor.
#
# wayvnc binds to loopback only. Reach it by tunnelling over the SSH daemon
# that already runs on this machine, never by exposing the port:
#
#   headless connect <host>        full desktop, from the remote machine
#   headless app <host> <cmd>...   single app over waypipe, no session needed
#
# State lives in a transient systemd --user unit plus $XDG_RUNTIME_DIR, so it
# is gone after a reboot: a rebooted machine always comes back a normal desktop.

UNIT="wayvnc"
# Sway increments the suffix on every create_output for the lifetime of the
# compositor, so the second toggle yields HEADLESS-2 and so on. Never assume
# HEADLESS-1 — always resolve the current name.
HEADLESS_PREFIX="HEADLESS-"
VNC_ADDR="127.0.0.1"
VNC_PORT="5900"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="${RUNTIME_DIR}/headless.workspaces"
FOCUS_FILE="${RUNTIME_DIR}/headless.focus"
# Marks that headless mode is the one holding the suspend inhibitor, so a
# nosleep the user enabled by hand is not released when headless mode ends.
NOSLEEP_OWNED_FILE="${RUNTIME_DIR}/headless.nosleep-owned"

# Geometry of the virtual output: it should match the screen being connected
# from, not the panel attached here (a 3840x1600 ultrawide, which suits no
# laptop). Scale matters as much as mode on a HiDPI client — mode sets the
# framebuffer wayvnc streams, scale sets the logical layout inside it. Getting
# scale wrong gives either half-size UI or a blurry upscaled image.
#
# Precedence: environment > config file > built-in default. Per-machine values
# belong in the config file, which is outside the repo so nothing
# machine-specific is tracked:
#
#   ~/.config/headless.conf
#     HEADLESS_MODE=1920x1080
#     HEADLESS_SCALE=1
#
# `headless connect` overrides both by detecting the local screen, so these
# defaults only apply when starting headless mode directly on this machine.
_env_mode="${HEADLESS_MODE:-}"
_env_scale="${HEADLESS_SCALE:-}"

CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/headless.conf"
if [[ -r "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

HEADLESS_MODE="${_env_mode:-${HEADLESS_MODE:-2880x1800}}"
HEADLESS_SCALE="${_env_scale:-${HEADLESS_SCALE:-2}}"

usage() {
  cat <<'EOF'
Usage: headless <command>

  on                    Disable physical outputs, serve the session over VNC
  off                   Restore the physical outputs and stop serving
  status                Report whether headless mode is active
  toggle                Flip between on and off

  connect <host>        Tunnel over SSH and open the remote desktop (VNC)
  app <host> <cmd>...   Run one remote app locally over waypipe

  dpms <on|off>         Power the physical outputs only, never the virtual
                        one (used by swayidle)

Environment / ~/.config/headless.conf:
  HEADLESS_MODE         Virtual output mode  (default: 2880x1800)
  HEADLESS_SCALE        Virtual output scale (default: 2)
  HEADLESS_VIEWER       VNC client to use, in preference order
                        (default: wlvncc remote-viewer vncviewer)
  HEADLESS_VIEWER_ARGS  Extra arguments passed to the viewer, e.g. to run
                        windowed instead of fullscreen

With remote-viewer, ctrl+alt releases the keyboard grab — without it $mod+1
switches the remote workspace rather than the local one.

`connect` detects the local screen and overrides both, so these normally
only matter when running `headless on` directly on this machine.
EOF
}

die() {
  echo "headless: $1" >&2
  exit 1
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$1" "$2" || true
}

# Sway's IPC socket is not in the environment over SSH, so find it explicitly.
# This is what lets the mode be switched from the remote machine as well.
ensure_swaysock() {
  if [[ -n "${SWAYSOCK:-}" && -S "${SWAYSOCK}" ]]; then
    return 0
  fi
  local sock
  sock="$(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'sway-ipc.*.sock' 2>/dev/null | head -n1)"
  [[ -n "${sock}" ]] || die "no sway IPC socket found — is sway running?"
  export SWAYSOCK="${sock}"
}

output_names() {
  swaymsg -t get_outputs -r | python3 -c '
import json, sys
for output in json.load(sys.stdin):
    print(output["name"])
'
}

# Every output that is not the virtual one, whether currently enabled or not:
# a disabled output still appears in get_outputs, which is how "off" finds it.
physical_outputs() {
  output_names | grep -v "^${HEADLESS_PREFIX}" || true
}

headless_outputs() {
  output_names | grep "^${HEADLESS_PREFIX}" || true
}

# Only ever one is created, so the first match is the one being served.
current_headless_output() {
  headless_outputs | head -n1
}

have_headless_output() {
  [[ -n "$(current_headless_output)" ]]
}

is_active() {
  systemctl --user is-active --quiet "${UNIT}"
}

save_layout() {
  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
seen = set()
for workspace in json.load(sys.stdin):
    pair = (workspace["name"], workspace["output"])
    if pair in seen:
        continue
    seen.add(pair)
    print(workspace["name"], workspace["output"])
' >"${STATE_FILE}"

  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace.get("focused"):
        print(workspace["name"])
        break
' >"${FOCUS_FILE}"
}

# Sway moves whichever workspace is focused, so this walks the recorded pairs
# and restores focus afterwards rather than leaving the user somewhere random.
restore_layout() {
  [[ -f "${STATE_FILE}" ]] || return 0
  local workspace output
  while read -r workspace output; do
    [[ -n "${workspace}" && -n "${output}" ]] || continue
    swaymsg -q "workspace \"${workspace}\"" || true
    swaymsg -q "move workspace to output \"${output}\"" || true
  done <"${STATE_FILE}"

  if [[ -s "${FOCUS_FILE}" ]]; then
    swaymsg -q "workspace \"$(cat "${FOCUS_FILE}")\"" || true
  fi
  rm -f "${STATE_FILE}" "${FOCUS_FILE}"
}

headless_on() {
  ensure_swaysock
  command -v wayvnc >/dev/null 2>&1 || die "wayvnc is not installed"

  if is_active; then
    echo "headless: already on"
    return 0
  fi

  local physical=()
  mapfile -t physical < <(physical_outputs)
  [[ ${#physical[@]} -gt 0 ]] || die "no physical output found — nothing to disable"

  save_layout

  if ! have_headless_output; then
    swaymsg -q create_output
  fi
  local virtual
  virtual="$(current_headless_output)"
  [[ -n "${virtual}" ]] || die "could not create a headless output"

  # Scale is always set explicitly: scale.conf applies `output * scale 1.3` for
  # the ultrawide, and inheriting that would misrender the remote view.
  swaymsg -q "output ${virtual} mode --custom ${HEADLESS_MODE} scale ${HEADLESS_SCALE}"

  # --render-cursor composites the pointer into the framebuffer at the output's
  # own scale. Without it wayvnc sends the cursor separately and the client
  # draws it locally at logical size, so a scale-2 output produces a pointer
  # twice the size it should be.
  # --disable-resizing refuses SetDesktopSize outright rather than failing the
  # request, since a Sway output cannot be resized on a client's say-so.
  systemd-run --user --quiet --unit="${UNIT}" \
    --description="wayvnc serving ${virtual} (headless mode)" \
    wayvnc --output="${virtual}" --render-cursor --disable-resizing \
    "${VNC_ADDR}" "${VNC_PORT}"

  # swayidle still suspends at 60 min, which would drop every remote session.
  # Only claim the inhibitor if it is not already held, so that turning
  # headless mode off later does not undo a nosleep the user set by hand.
  if systemctl --user is-active --quiet nosleep; then
    rm -f "${NOSLEEP_OWNED_FILE}"
  else
    nosleep on >/dev/null
    : >"${NOSLEEP_OWNED_FILE}"
  fi

  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" disable" || true
  done

  echo "headless: on — ${virtual} at ${HEADLESS_MODE} scale ${HEADLESS_SCALE}, wayvnc on ${VNC_ADDR}:${VNC_PORT}"
  echo "headless: physical outputs disabled: ${physical[*]}"
  notify "Headless Mode" "Monitor disabled. Session served on ${VNC_ADDR}:${VNC_PORT} (SSH tunnel only)."
}

headless_off() {
  ensure_swaysock

  if ! is_active && ! have_headless_output; then
    echo "headless: already off"
    return 0
  fi

  local physical=()
  mapfile -t physical < <(physical_outputs)

  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" enable" || true
  done

  restore_layout

  if is_active; then
    systemctl --user stop "${UNIT}"
  fi
  # Release the inhibitor only if headless mode was the one that took it.
  if [[ -e "${NOSLEEP_OWNED_FILE}" ]]; then
    nosleep off >/dev/null || true
    rm -f "${NOSLEEP_OWNED_FILE}"
  fi

  # Unplug every one, so an earlier interrupted run cannot strand any.
  local virtual
  while read -r virtual; do
    [[ -n "${virtual}" ]] || continue
    swaymsg -q "output ${virtual} unplug" || true
  done < <(headless_outputs)

  echo "headless: off — physical outputs restored: ${physical[*]}"
  notify "Headless Mode" "Monitor restored. Remote session stopped."
}

headless_status() {
  if is_active; then
    ensure_swaysock
    echo "headless: on — wayvnc serving $(current_headless_output) on ${VNC_ADDR}:${VNC_PORT}"
  else
    echo "headless: off — normal desktop"
  fi
}

# swayidle's idle timeout must never power off the virtual output: wlroots
# stops compositing a powered-off output, which freezes the VNC stream with no
# way to wake it remotely. A bare `output * power off` would do exactly that,
# so idle handling goes through here to skip HEADLESS-*.
headless_dpms() {
  ensure_swaysock
  local action="${1:-}"
  case "${action}" in
    on | off) ;;
    *) die "dpms needs 'on' or 'off'" ;;
  esac

  local output
  while read -r output; do
    [[ -n "${output}" ]] || continue
    swaymsg -q "output \"${output}\" power ${action}" || true
  done < <(physical_outputs)
}

# Mode and scale of this machine's active output, so the remote virtual output
# can be sized to the screen actually being looked at. Both ends run the same
# Sway setup, which is what makes this possible. Prints "<WxH> <scale>", or
# nothing when not running under Sway — callers fall back to the defaults.
local_geometry() {
  swaymsg -t get_outputs -r 2>/dev/null | python3 -c '
import json, sys
try:
    outputs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for output in outputs:
    if not output.get("active"):
        continue
    mode = output.get("current_mode") or {}
    width, height = mode.get("width"), mode.get("height")
    if not width or not height:
        continue
    scale = float(output.get("scale") or 1)
    scale = int(scale) if scale.is_integer() else round(scale, 2)
    print(f"{width}x{height} {scale}")
    break
' 2>/dev/null || true
}

# Bring the far side up sized to this screen, unless it is already serving.
ensure_remote_headless() {
  local host="$1"
  if ssh "${host}" 'headless status' 2>/dev/null | grep -q 'on —'; then
    echo "headless: ${host} already serving"
    return 0
  fi

  local geometry mode scale
  geometry="$(local_geometry)"
  if [[ -n "${geometry}" ]]; then
    mode="${geometry%% *}"
    scale="${geometry##* }"
    echo "headless: starting ${host} at ${mode} scale ${scale} (detected locally)"
    # SC2029: expanding locally is the point — these are this screen's values,
    # sent to the far side.
    # shellcheck disable=SC2029
    ssh "${host}" "HEADLESS_MODE=${mode} HEADLESS_SCALE=${scale} headless on" \
      || die "could not start headless mode on ${host}"
  else
    echo "headless: local screen not detected, using remote defaults"
    ssh "${host}" 'headless on' || die "could not start headless mode on ${host}"
  fi
}

# Run from the remote machine. The tunnel uses a control socket so the viewer
# exiting always tears it down, rather than leaking a background ssh.
# Pick a viewer, preferring Wayland-native ones. tigervnc's vncviewer is X11
# only, so under Sway it runs through XWayland: on a scaled output the
# compositor renders it at 1x and upscales, throwing away half the detail of a
# HiDPI stream. wlvncc is purpose-built for wayvnc; remote-viewer (virt-viewer)
# is GTK and Wayland-native. Override with HEADLESS_VIEWER=<name>.
pick_viewer() {
  local candidate
  for candidate in ${HEADLESS_VIEWER:-wlvncc remote-viewer vncviewer}; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      echo "${candidate}"
      return 0
    fi
  done
  return 1
}

run_viewer() {
  local viewer="$1"
  case "${viewer}" in
    wlvncc)
      wlvncc "${VNC_ADDR}" "${VNC_PORT}"
      ;;
    remote-viewer)
      # Fullscreen with auto-resize off is what makes the sizing pay off: the
      # virtual output already matches this screen, so a windowed presentation
      # would resample the framebuffer and throw the sharpness away again.
      # auto-resize is off because wayvnc cannot resize a Sway output anyway.
      #
      # Hotkeys listed here stay active even while the guest display holds
      # focus — which matters, because gtk-vnc uses the Wayland
      # keyboard-shortcuts-inhibit protocol that Sway honours, so $mod+1 goes
      # to the remote and the local compositor never sees it. Fullscreen plus
      # an inhibited keyboard means shift+f11 is the only way out; without it
      # the session is a trap. release-cursor is kept as a second escape,
      # though it does nothing while the pointer is absolute (as it is here).
      # shellcheck disable=SC2086
      remote-viewer -f --auto-resize=never \
        --hotkeys=toggle-fullscreen=shift+f11,release-cursor=shift+f12 \
        ${HEADLESS_VIEWER_ARGS:-} "vnc://${VNC_ADDR}:${VNC_PORT}"
      ;;
    vncviewer)
      # RemoteResize defaults to on and makes the viewer ask wayvnc to resize
      # the Sway output, which it cannot do — the request fails with
      # "SetDesktopSize failed". Harmless, but there is no reason to send it.
      vncviewer -RemoteResize=0 "${VNC_ADDR}:${VNC_PORT}"
      ;;
    *)
      "${viewer}" "${VNC_ADDR}:${VNC_PORT}"
      ;;
  esac
}

headless_connect() {
  local host="${1:-}"
  [[ -n "${host}" ]] || die "connect needs a host (e.g. headless connect desktop)"

  local viewer
  viewer="$(pick_viewer)" \
    || die "no VNC viewer found — install wlvncc (AUR) or virt-viewer, or tigervnc"
  if [[ "${viewer}" == "vncviewer" ]]; then
    echo "headless: using vncviewer (X11/XWayland) — expect a soft image on a" \
         "HiDPI screen; install wlvncc or virt-viewer for a sharp one" >&2
  fi

  ensure_remote_headless "${host}"

  local control="${RUNTIME_DIR}/headless-tunnel-${host}.sock"
  ssh -f -N -M -S "${control}" -L "${VNC_PORT}:${VNC_ADDR}:${VNC_PORT}" "${host}" \
    || die "could not open SSH tunnel to ${host}"
  # shellcheck disable=SC2064
  trap "ssh -q -S '${control}' -O exit '${host}' >/dev/null 2>&1 || true" EXIT

  echo "headless: connecting with ${viewer}"
  if [[ "${viewer}" == "remote-viewer" ]]; then
    echo "headless: shift+f11 leaves fullscreen — the remote grabs the keyboard," \
         "so local shortcuts do not work until you do"
  fi
  run_viewer "${viewer}"
}

# waypipe needs no headless output, no VNC and no running compositor on the
# far side — only sshd. This is the path that still works after a reboot.
headless_app() {
  local host="${1:-}"
  shift || true
  [[ -n "${host}" && $# -gt 0 ]] || die "app needs a host and a command (e.g. headless app desktop nvim)"
  command -v waypipe >/dev/null 2>&1 || die "waypipe is not installed"

  waypipe ssh "${host}" "$@"
}

main() {
  case "${1:-status}" in
    on) headless_on ;;
    off) headless_off ;;
    status) headless_status ;;
    toggle)
      if is_active; then headless_off; else headless_on; fi
      ;;
    connect)
      shift
      headless_connect "$@"
      ;;
    app)
      shift
      headless_app "$@"
      ;;
    dpms)
      shift
      headless_dpms "$@"
      ;;
    -h | --help | help) usage ;;
    *)
      echo "headless: unknown command '${1}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
