#!/usr/bin/env bash
set -euo pipefail

# headless — switch this machine between normal desktop and headless remote mode.
#
#   headless on|off|status|toggle
#   headless connect <host>        full desktop, from the remote machine,
#                                  with the clipboard crossing both ways
#   headless bind [host]           bind or unbind a host workspace (own viewer)
#   headless app <host> <cmd>...   single app over waypipe, no session needed
#   headless dpms on|off           power the physical outputs only (swayidle)
#
# Backup mode for power outages: the physical outputs go off and the live Sway
# session is served over VNC from a virtual output. wayvnc binds to loopback
# only; reach it over SSH, never by exposing the port. Design constraints and
# requirements: see workstation/scripts/CLAUDE.md.

UNIT="wayvnc"
# Sway increments the suffix on every create_output for the lifetime of the
# compositor, so the second toggle yields HEADLESS-2 and so on. Never assume
# HEADLESS-1 — always resolve the current name.
#
# Other tools create HEADLESS-* outputs too (to keep the windows on them rendering
# off screen). This script serves, moves workspaces to and
# unplugs only the output it created itself, recorded in OUTPUT_FILE.
HEADLESS_PREFIX="HEADLESS-"
VNC_ADDR="127.0.0.1"
VNC_PORT="5900"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="${RUNTIME_DIR}/headless.workspaces"
FOCUS_FILE="${RUNTIME_DIR}/headless.focus"
OUTPUT_FILE="${RUNTIME_DIR}/headless.output"
# Marks that headless mode is the one holding the suspend inhibitor, so a
# nosleep the user enabled by hand is not released when headless mode ends.
NOSLEEP_OWNED_FILE="${RUNTIME_DIR}/headless.nosleep-owned"

# Geometry of the virtual output: it should match the screen being connected
# from, not the panel attached here (a 3840x1600 ultrawide, which suits no
# laptop). Scale matters as much as mode on a HiDPI client — mode sets the
# framebuffer wayvnc streams, scale sets the logical layout inside it. Getting
# scale wrong gives either half-size UI or a blurry upscaled image.
#
# Precedence: environment > config file > built-in default. Per-machine values
# belong in the config file, which is outside the repo so nothing
# machine-specific is tracked:
#
#   ~/.config/headless.conf
#     HEADLESS_MODE=1920x1080
#     HEADLESS_SCALE=1
#
# `headless connect` overrides both by detecting the local screen, so these
# defaults only apply when starting headless mode directly on this machine.
_env_mode="${HEADLESS_MODE:-}"
_env_scale="${HEADLESS_SCALE:-}"
_env_fps="${HEADLESS_FPS:-}"

CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/headless.conf"
if [[ -r "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

HEADLESS_MODE="${_env_mode:-${HEADLESS_MODE:-2880x1800}}"
HEADLESS_SCALE="${_env_scale:-${HEADLESS_SCALE:-2}}"
HEADLESS_FPS="${_env_fps:-${HEADLESS_FPS:-60}}"

usage() {
  cat <<'EOF'
Usage: headless <command>

  on                    Disable physical outputs, serve the session over VNC
  off                   Restore the physical outputs and stop serving
  status                Report whether headless mode is active
  toggle                Flip between on and off

  connect <host>        Tunnel over SSH and open the remote desktop (VNC);
                        the clipboard crosses both ways while it runs
  bind [host]           Pick a host workspace that has an output of its own
                        (another tool's HEADLESS-* output) and give it its
                        own viewer, full screen on the same workspace number
                        here, connected only while that workspace is visible.
                        Picking a bound one unbinds it; the menu opens again
                        until Esc. Its first row brings the desktop viewer to
                        the front. Without a host, the one connected; with
                        none connected, a menu of hosts (the last connected,
                        then the Host entries of ~/.ssh/config, each only if
                        it answers with headless and wayvnc) starts
                        \`connect\` in the background
  app <host> <cmd>...   Run one remote app locally over waypipe

  dpms <on|off>         Power the physical outputs only, never the virtual
                        one (used by swayidle). off first runs each
                        executable in ~/.local/share/sway/dpms-off.d/

Environment / ~/.config/headless.conf:
  HEADLESS_MODE         Virtual output mode  (default: 2880x1800)
  HEADLESS_SCALE        Virtual output scale (default: 2)
  HEADLESS_FPS          Stream frame rate cap (default: 60)
  HEADLESS_VIEWER       VNC client to use, in preference order
                        (default: wlvncc remote-viewer vncviewer)
  HEADLESS_VIEWER_ARGS  Extra arguments passed to the viewer, e.g. to run
                        windowed instead of fullscreen

With remote-viewer, ctrl+alt releases the keyboard grab — without it $mod+1
switches the remote workspace rather than the local one.

`connect` detects the local screen and overrides both, so these normally
only matter when running `headless on` directly on this machine.
EOF
}

die() {
  echo "headless: $1" >&2
  exit 1
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$1" "$2" || true
}

# Sway's IPC socket is not in the environment over SSH, so find it explicitly.
# This is what lets the mode be switched from the remote machine as well.
ensure_swaysock() {
  if [[ -n "${SWAYSOCK:-}" && -S "${SWAYSOCK}" ]]; then
    return 0
  fi
  local sock
  sock="$(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'sway-ipc.*.sock' 2>/dev/null | head -n1)"
  [[ -n "${sock}" ]] || die "no sway IPC socket found — is sway running?"
  export SWAYSOCK="${sock}"
}

output_names() {
  swaymsg -t get_outputs -r | python3 -c '
import json, sys
for output in json.load(sys.stdin):
    print(output["name"])
'
}

# Every output that is not the virtual one, whether currently enabled or not:
# a disabled output still appears in get_outputs, which is how "off" finds it.
physical_outputs() {
  output_names | grep -v "^${HEADLESS_PREFIX}" || true
}

headless_outputs() {
  output_names | grep "^${HEADLESS_PREFIX}" || true
}

# Physical outputs that are enabled: what workspaces can go back to.
active_physical_outputs() {
  swaymsg -t get_outputs -r | python3 -c '
import json, sys
for output in json.load(sys.stdin):
    if output["active"] and not output["name"].startswith(sys.argv[1]):
        print(output["name"])
' "${HEADLESS_PREFIX}"
}

# The physical outputs the workspaces were saved from at `on`.
saved_outputs() {
  [[ -f "${STATE_FILE}" ]] || return 0
  awk -v prefix="${HEADLESS_PREFIX}" 'NF >= 2 && index($2, prefix) != 1 { print $2 }' "${STATE_FILE}"
}

# Swaylock is running: the screen is locked, or is about to be.
is_locked() {
  pgrep -xu "$(id -u)" swaylock >/dev/null
}

# The output this script created, if it still exists.
current_headless_output() {
  [[ -s "${OUTPUT_FILE}" ]] || return 0
  local name
  name="$(cat "${OUTPUT_FILE}")"
  if headless_outputs | grep -qxF "${name}"; then
    echo "${name}"
  fi
}

have_headless_output() {
  [[ -n "$(current_headless_output)" ]]
}

workspaces_on() {
  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace["output"] == sys.argv[1]:
        print(workspace["name"])
' "$1"
}

# Sway moves whichever workspace is focused, so focus each one first.
move_workspace() {
  swaymsg -q "workspace \"$1\"" || true
  swaymsg -q "move workspace to output \"$2\"" || true
}

is_active() {
  systemctl --user is-active --quiet "${UNIT}"
}

save_layout() {
  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
seen = set()
for workspace in json.load(sys.stdin):
    pair = (workspace["name"], workspace["output"])
    if pair in seen:
        continue
    seen.add(pair)
    print(workspace["name"], workspace["output"])
' >"${STATE_FILE}"

  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace.get("focused"):
        print(workspace["name"])
        break
' >"${FOCUS_FILE}"
}

restore_focus() {
  if [[ -s "${FOCUS_FILE}" ]]; then
    swaymsg -q "workspace \"$(cat "${FOCUS_FILE}")\"" || true
  fi
}

# Moves the workspaces of the physical outputs onto the virtual one before the
# physical ones are disabled. Left to itself, Sway may pick another tool's
# HEADLESS-* output instead.
take_workspaces() {
  local virtual="$1"
  shift
  local workspace output
  while read -r workspace output; do
    [[ -n "${workspace}" && -n "${output}" ]] || continue
    printf '%s\n' "$@" | grep -qxF "${output}" || continue
    move_workspace "${workspace}" "${virtual}"
  done <"${STATE_FILE}"
  restore_focus
}

# Moves every workspace on the virtual output back: to the physical output it
# came from, or to the first one for a workspace created while headless. Ones
# that never left another tool's output are not touched.
return_workspaces() {
  local virtual="$1"
  shift
  local workspace saved target
  while read -r workspace; do
    [[ -n "${workspace}" ]] || continue
    saved=""
    if [[ -f "${STATE_FILE}" ]]; then
      saved="$(awk -v ws="${workspace}" '$1 == ws { print $2; exit }' "${STATE_FILE}")"
    fi
    target="$1"
    if [[ -n "${saved}" ]] && printf '%s\n' "$@" | grep -qxF "${saved}"; then
      target="${saved}"
    fi
    move_workspace "${workspace}" "${target}"
  done < <(workspaces_on "${virtual}")
  restore_focus
  rm -f "${STATE_FILE}" "${FOCUS_FILE}"
}

headless_on() {
  ensure_swaysock
  command -v wayvnc >/dev/null 2>&1 || die "wayvnc is not installed"

  if is_active; then
    echo "headless: already on"
    return 0
  fi

  local physical=()
  mapfile -t physical < <(physical_outputs)
  [[ ${#physical[@]} -gt 0 ]] || die "no physical output found — nothing to disable"

  save_layout

  # Always a fresh output, named by what create_output added: an existing
  # HEADLESS-* may belong to another tool.
  local virtual
  virtual="$(current_headless_output)"
  if [[ -z "${virtual}" ]]; then
    local before
    before="$(headless_outputs)"
    swaymsg -q create_output
    virtual="$(headless_outputs | grep -vxF -f <(printf '%s\n' "${before}") | head -n1 || true)"
    [[ -n "${virtual}" ]] || die "could not create a headless output"
    printf '%s\n' "${virtual}" >"${OUTPUT_FILE}"
  fi

  # Scale is always set explicitly: the settings popup's scale.conf applies
  # `output * scale 1.3` for the ultrawide, and inheriting that would misrender
  # the remote view.
  swaymsg -q "output ${virtual} mode --custom ${HEADLESS_MODE} scale ${HEADLESS_SCALE}"

  # --render-cursor composites the pointer into the framebuffer at the output's
  # own scale. Without it wayvnc sends the cursor separately and the client
  # draws it locally at logical size, so a scale-2 output produces a pointer
  # twice the size it should be.
  # --disable-resizing refuses SetDesktopSize outright rather than failing the
  # request, since a Sway output cannot be resized on a client's say-so.
  # --gpu enables H.264 through VA-API for clients that ask for it (wlvncc
  # does by default). Under full-screen motion it measured ~7% of a core
  # against ~47% for Tight, which is what makes 60 fps affordable. Clients
  # without H.264 (remote-viewer) still get Tight.
  systemd-run --user --quiet --collect --unit="${UNIT}" \
    --description="wayvnc serving ${virtual} (headless mode)" \
    wayvnc --output="${virtual}" --render-cursor --disable-resizing \
    --gpu --max-fps="${HEADLESS_FPS}" "${VNC_ADDR}" "${VNC_PORT}"

  # The screen goes off only once wayvnc serves: it can exit right after the
  # start (the port is taken, e.g. by this machine's own tunnel to another
  # host), and a dark screen with nothing serving it has no way back.
  local _ serving=""
  for _ in $(seq 50); do
    if [[ "$(served_output "${RUNTIME_DIR}/wayvncctl")" == "${virtual}" ]]; then
      serving=1
      break
    fi
    systemctl --user is-active --quiet "${UNIT}" || break
    sleep 0.1
  done
  if [[ -z "${serving}" ]]; then
    systemctl --user stop "${UNIT}" 2>/dev/null || true
    systemctl --user reset-failed "${UNIT}" 2>/dev/null || true
    swaymsg -q "output ${virtual} unplug" || true
    rm -f "${OUTPUT_FILE}" "${STATE_FILE}" "${FOCUS_FILE}"
    notify "Headless Mode" "wayvnc did not start (port ${VNC_PORT} taken?): the screen stays on"
    die "wayvnc did not start on ${virtual}; the screen stays on (journalctl --user -u ${UNIT})"
  fi

  # swayidle still suspends at 60 min, which would drop every remote session.
  # Only claim the inhibitor if it is not already held, so that turning
  # headless mode off later does not undo a nosleep the user set by hand.
  if systemctl --user is-active --quiet nosleep; then
    rm -f "${NOSLEEP_OWNED_FILE}"
  else
    nosleep on >/dev/null
    : >"${NOSLEEP_OWNED_FILE}"
  fi

  take_workspaces "${virtual}" "${physical[@]}"

  # disable, not power off: it puts the monitor in standby.
  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" disable" || true
  done

  echo "headless: on — ${virtual} at ${HEADLESS_MODE} scale ${HEADLESS_SCALE}, wayvnc on ${VNC_ADDR}:${VNC_PORT}"
  echo "headless: physical outputs disabled: ${physical[*]}"
  notify "Headless Mode" "Monitor disabled. Session served on ${VNC_ADDR}:${VNC_PORT} (SSH tunnel only)."
}

headless_off() {
  ensure_swaysock

  if ! is_active && ! have_headless_output; then
    echo "headless: already off"
    return 0
  fi

  # The outputs sway lists, and the ones the workspaces were saved from: a
  # monitor can drop out of sway's list (it re-syncs on a VT switch, and
  # wlroots does not rescan while its VT is inactive). Sway keeps the config
  # of an absent output and applies it when the output comes back.
  # power on: swayidle's `dpms off` may have left a listed one powered off,
  # which would come back enabled but dark.
  local physical=()
  mapfile -t physical < <({ physical_outputs; saved_outputs; } | awk 'NF && !seen[$0]++')

  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" enable power on" || true
  done

  local active=() _
  for _ in $(seq 20); do
    mapfile -t active < <(active_physical_outputs)
    [[ ${#active[@]} -eq 0 ]] || break
    sleep 0.1
  done

  # With nothing to return the workspaces to, unplugging the virtual output
  # would leave sway to move them onto another tool's HEADLESS-* output, and
  # the session would be on no screen and no VNC stream. Stay on, and put
  # back the disable so an absent monitor does not light up later on its own.
  if [[ ${#active[@]} -eq 0 ]]; then
    for output in "${physical[@]}"; do
      swaymsg -q "output \"${output}\" disable" || true
    done
    notify "Headless Mode" "No monitor found: headless mode stays on. Switch to tty1 and try again."
    die "no physical output is active (tried ${physical[*]:-none}); headless mode stays on. Sway finds a monitor again only while its VT is the active one: switch to tty1 (Ctrl+Alt+F1), then run headless off or press \$mod+Shift+o"
  fi

  local virtual
  virtual="$(current_headless_output)"
  if [[ -n "${virtual}" ]]; then
    return_workspaces "${virtual}" "${active[@]}"
  fi

  if is_active; then
    systemctl --user stop "${UNIT}"
  fi
  headless_unserve all
  # Release the inhibitor only if headless mode was the one that took it.
  if [[ -e "${NOSLEEP_OWNED_FILE}" ]]; then
    nosleep off >/dev/null || true
    rm -f "${NOSLEEP_OWNED_FILE}"
  fi

  if [[ -n "${virtual}" ]]; then
    swaymsg -q "output ${virtual} unplug" || true
  fi
  rm -f "${OUTPUT_FILE}"

  echo "headless: off — physical outputs restored: ${active[*]}"
  notify "Headless Mode" "Monitor restored. Remote session stopped."
}

# The first line is what `connect` reads from the host ("on —"). Then the
# bound workspaces this machine serves, and those of the host it is
# connected to.
headless_status() {
  local ws output port host
  if is_active; then
    ensure_swaysock
    echo "headless: on — wayvnc serving $(current_headless_output) on ${VNC_ADDR}:${VNC_PORT}"
    while IFS=$'\t' read -r ws output port; do
      [[ -n "${ws}" ]] || continue
      echo "headless: bound workspace ${ws} — wayvnc serving ${output:-?} on ${VNC_ADDR}:${port}"
    done < <(headless_served)
  else
    echo "headless: off — normal desktop"
  fi

  host="$(connected_host || true)"
  [[ -n "${host}" ]] || return 0
  echo "headless: connected to ${host}"
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    if viewer_running "${ws}"; then
      echo "headless: workspace ${ws} bound, cursor $(bound_cursor "${host}" "${ws}") — viewer open"
    else
      echo "headless: workspace ${ws} bound, cursor $(bound_cursor "${host}" "${ws}") — viewer opens when workspace ${ws} is shown"
    fi
  done < <(bound_workspaces "${host}")
}

# swayidle's idle timeout must never power off the virtual output: wlroots
# stops compositing a powered-off output, which freezes the VNC stream with no
# way to wake it remotely. A bare `output * power off` would do exactly that,
# so idle handling goes through here to skip HEADLESS-*.
headless_dpms() {
  ensure_swaysock
  local action="${1:-}"
  case "${action}" in
    on | off) ;;
    *) die "dpms needs 'on' or 'off'" ;;
  esac

  # off skips disabled outputs (headless mode's monitor): the power state is
  # kept in their config, and they would come back dark at `headless off`.
  local outputs=() output
  if [[ "${action}" == off ]]; then
    mapfile -t outputs < <(active_physical_outputs)
    [[ ${#outputs[@]} -eq 0 ]] || run_dpms_off_hooks
  else
    mapfile -t outputs < <(physical_outputs)
  fi
  for output in "${outputs[@]}"; do
    [[ -n "${output}" ]] || continue
    swaymsg -q "output \"${output}\" power ${action}" || true
  done
}

# The machine-only slot before `dpms off`: each executable in DPMS_OFF_DIR,
# owned by another tool (one per tool, like ~/.local/share/sway/env.d/), runs
# in name order before the outputs power off, e.g. to move windows that must
# keep rendering off the monitor. Only when an output is about to go off.
# A hook gets SWAYSOCK and WAYLAND_DISPLAY and at most DPMS_OFF_TIMEOUT
# seconds (HEADLESS_DPMS_OFF_TIMEOUT, default 15). Its failure is logged
# (journal tag headless) and never stops the power-off. Nothing runs on
# `dpms on`.
DPMS_OFF_DIR="${HOME}/.local/share/sway/dpms-off.d"
DPMS_OFF_TIMEOUT="${HEADLESS_DPMS_OFF_TIMEOUT:-15}"

log_warn() {
  echo "headless: $1" >&2
  logger -t headless -p user.warning -- "$1" 2>/dev/null || true
}

run_dpms_off_hooks() {
  [[ -d "${DPMS_OFF_DIR}" ]] || return 0
  # Over SSH there is no WAYLAND_DISPLAY: take sway's from a child of sway
  # (sway sets it after it starts, so its own /proc environ lacks it).
  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    local sway_pid child line
    sway_pid="$(basename "${SWAYSOCK}" .sock)"
    sway_pid="${sway_pid##*.}"
    for child in $(pgrep -P "${sway_pid}" 2>/dev/null || true); do
      line="$(tr '\0' '\n' <"/proc/${child}/environ" 2>/dev/null | grep -m1 '^WAYLAND_DISPLAY=' || true)"
      if [[ -n "${line}" ]]; then
        export WAYLAND_DISPLAY="${line#WAYLAND_DISPLAY=}"
        break
      fi
    done
  fi

  local hook name status
  for hook in "${DPMS_OFF_DIR}"/*; do
    [[ -e "${hook}" ]] || continue
    name="$(basename "${hook}")"
    if [[ ! -f "${hook}" || ! -x "${hook}" ]]; then
      log_warn "dpms-off hook ${name} skipped: not an executable file"
      continue
    fi
    status=0
    timeout -k 2 "${DPMS_OFF_TIMEOUT}" "${hook}" </dev/null || status=$?
    case "${status}" in
      0) ;;
      124 | 137) log_warn "dpms-off hook ${name} timed out after ${DPMS_OFF_TIMEOUT}s" ;;
      *) log_warn "dpms-off hook ${name} failed (exit ${status})" ;;
    esac
  done
}

# Mode and scale of this machine's active output, so the remote virtual output
# can be sized to the screen actually being looked at. Both ends run the same
# Sway setup, which is what makes this possible. Prints "<WxH> <scale>", or
# nothing when not running under Sway — callers fall back to the defaults.
local_geometry() {
  swaymsg -t get_outputs -r 2>/dev/null | python3 -c '
import json, sys
try:
    outputs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for output in outputs:
    if not output.get("active"):
        continue
    mode = output.get("current_mode") or {}
    width, height = mode.get("width"), mode.get("height")
    if not width or not height:
        continue
    scale = float(output.get("scale") or 1)
    scale = int(scale) if scale.is_integer() else round(scale, 2)
    print(f"{width}x{height} {scale}")
    break
' 2>/dev/null || true
}

# Bring the far side up sized to this screen, unless it is already serving.
ensure_remote_headless() {
  local host="$1"
  if ssh "${host}" 'headless status' 2>/dev/null | grep -q 'on —'; then
    echo "headless: ${host} already serving"
    return 0
  fi

  local geometry mode scale
  geometry="$(local_geometry)"
  if [[ -n "${geometry}" ]]; then
    mode="${geometry%% *}"
    scale="${geometry##* }"
    echo "headless: starting ${host} at ${mode} scale ${scale} (detected locally)"
    # SC2029: expanding locally is the point — these are this screen's values,
    # sent to the far side.
    # shellcheck disable=SC2029
    ssh "${host}" "HEADLESS_MODE=${mode} HEADLESS_SCALE=${scale} headless on" \
      || die "could not start headless mode on ${host}"
  else
    echo "headless: local screen not detected, using remote defaults"
    ssh "${host}" 'headless on' || die "could not start headless mode on ${host}"
  fi
}

# Run from the remote machine. The tunnel uses a control socket so the viewer
# exiting always tears it down, rather than leaking a background ssh.
# Pick a viewer, preferring Wayland-native ones. tigervnc's vncviewer is X11
# only, so under Sway it runs through XWayland: on a scaled output the
# compositor renders it at 1x and upscales, throwing away half the detail of a
# HiDPI stream. wlvncc is purpose-built for wayvnc; remote-viewer (virt-viewer)
# is GTK and Wayland-native. Override with HEADLESS_VIEWER=<name>.
pick_viewer() {
  local candidate
  for candidate in ${HEADLESS_VIEWER:-wlvncc remote-viewer vncviewer}; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      echo "${candidate}"
      return 0
    fi
  done
  return 1
}

run_viewer() {
  local viewer="$1"
  case "${viewer}" in
    wlvncc)
      # -i asks for the keyboard-shortcuts-inhibit protocol while focused, so
      # $mod+N reaches the remote session; wlvncc leaves it off by default.
      # The --inhibited bindings in sway/config ($mod+Ctrl+N) stay local.
      wlvncc -i "${VNC_ADDR}" "${VNC_PORT}"
      ;;
    remote-viewer)
      # Fullscreen with auto-resize off is what makes the sizing pay off: the
      # virtual output already matches this screen, so a windowed presentation
      # would resample the framebuffer and throw the sharpness away again.
      # auto-resize is off because wayvnc cannot resize a Sway output anyway.
      #
      # Hotkeys listed here stay active even while the guest display holds
      # focus — which matters, because gtk-vnc uses the Wayland
      # keyboard-shortcuts-inhibit protocol that Sway honours, so $mod+1 goes
      # to the remote and the local compositor never sees it. Fullscreen plus
      # an inhibited keyboard means shift+f11 is the only way out; without it
      # the session is a trap. release-cursor is kept as a second escape,
      # though it does nothing while the pointer is absolute (as it is here).
      # shellcheck disable=SC2086
      remote-viewer -f --auto-resize=never \
        --hotkeys=toggle-fullscreen=shift+f11,release-cursor=shift+f12 \
        ${HEADLESS_VIEWER_ARGS:-} "vnc://${VNC_ADDR}:${VNC_PORT}"
      ;;
    vncviewer)
      # RemoteResize defaults to on and makes the viewer ask wayvnc to resize
      # the Sway output, which it cannot do — the request fails with
      # "SetDesktopSize failed". Harmless, but there is no reason to send it.
      vncviewer -RemoteResize=0 "${VNC_ADDR}:${VNC_PORT}"
      ;;
    *)
      "${viewer}" "${VNC_ADDR}:${VNC_PORT}"
      ;;
  esac
}

headless_connect() {
  local host="${1:-}"
  [[ -n "${host}" ]] || die "connect needs a host (e.g. headless connect desktop)"

  local viewer
  viewer="$(pick_viewer)" \
    || die "no VNC viewer found — install wlvncc (AUR) or virt-viewer, or tigervnc"
  if [[ "${viewer}" == "vncviewer" ]]; then
    echo "headless: using vncviewer (X11/XWayland) — expect a soft image on a" \
         "HiDPI screen; install wlvncc or virt-viewer for a sharp one" >&2
  fi

  # One connect per host: a second one would share the tunnel, and its exit
  # would close the first one's tunnel along with its own.
  local control
  control="$(tunnel_socket "${host}")"
  if ssh -q -S "${control}" -O check "${host}" 2>/dev/null; then
    echo "headless: already connected to ${host}"
    swaymsg -q '[app_id="^wlvncc$"] focus' 2>/dev/null || true
    return 0
  fi
  # A socket left by a connect that was killed: ssh would not become the
  # master beside it.
  rm -f "${control}"

  ensure_remote_headless "${host}"

  # ExitOnForwardFailure: with the port taken, fail here instead of running
  # on without the forward the viewer needs.
  ssh -f -N -M -S "${control}" -o ExitOnForwardFailure=yes \
    -L "${VNC_PORT}:${VNC_ADDR}:${VNC_PORT}" "${host}" \
    || die "could not open SSH tunnel to ${host}"
  mkdir -p "${BOUND_DIR}"
  echo "${host}" >"${LAST_HOST_FILE}"
  local restore watcher clip
  # setsid: the bridge leads a process group, so the trap ends all of it
  # (its ssh streams, its wl-paste watcher) with one kill.
  setsid "${BASH_SOURCE[0]}" clip-bridge "${host}" </dev/null >/dev/null \
    2>"${RUNTIME_DIR}/headless-clip-${host}.log" &
  clip=$!
  restore_bound "${host}" &
  restore=$!
  # The watcher starts once the restore is done: a viewer needs its forward.
  {
    while kill -0 "${restore}" 2>/dev/null; do sleep 0.1; done
    watch_bound_viewers "${host}"
  } &
  watcher=$!
  # Closing the desktop viewer closes the bound ones too and stops their
  # wayvnc; which ones are bound stays recorded for the next connect. The
  # watcher goes first, with its swaymsg, so it opens nothing during the
  # cleanup. The restore is waited for: a wayvnc it starts after the cleanup
  # would be left running.
  # shellcheck disable=SC2064
  trap "pkill -P ${watcher} 2>/dev/null; kill ${watcher} 2>/dev/null
    kill -- -${clip} 2>/dev/null
    wait ${restore} 2>/dev/null || true
    pkill -f -- '^wlvncc -a headless-ws' || true
    on_host '${host}' unserve all >/dev/null 2>&1 || true
    ssh -q -S '${control}' -O exit '${host}' >/dev/null 2>&1 || true" EXIT

  echo "headless: connecting with ${viewer}"
  if [[ "${viewer}" == "remote-viewer" ]]; then
    echo "headless: shift+f11 leaves fullscreen — the remote grabs the keyboard," \
         "so local shortcuts do not work until you do"
  fi
  run_viewer "${viewer}"
}

# --- Bound workspaces ---
# A host workspace that has an output of its own (another tool's HEADLESS-*,
# made to keep its windows rendering) can be bound: it gets its own wayvnc and
# its own viewer here, full screen on the same workspace number. The desktop
# viewer keeps showing the desktop. `headless bind` picks them; the choice is
# kept per host in BOUND_DIR, and `connect` opens them again.

# Run on the host: one line per workspace that can be bound, as
# "<ws>\t<output>\t<label>". A workspace on this script's own output shares
# it with the desktop, so it cannot have a view of its own. The label is the
# first window's sway mark, after its last colon ("<tool>:<name>"), else its
# title: the owning tool can name its windows.
headless_bindable() {
  ensure_swaysock
  swaymsg -t get_tree -r | python3 -c '
import json, sys
tree, own, prefix = json.load(sys.stdin), sys.argv[1], sys.argv[2]
visible = {o["name"]: o.get("current_workspace")
           for o in json.loads(sys.argv[3]) if o.get("active")}

def label(node):
    if node.get("pid"):
        marks = node.get("marks") or []
        if marks:
            return marks[0].rsplit(":", 1)[-1]
        if node.get("name"):
            return node["name"]
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = label(child)
        if found:
            return found
    return ""

for out in tree["nodes"]:
    name = out["name"]
    if not name.startswith(prefix) or name == own:
        continue
    for ws in out.get("nodes", []):
        if ws["name"] != visible.get(name) or not ws["name"].isdigit():
            continue
        text = label(ws)
        if len(text) > 40:
            text = text[:39] + "…"
        print(ws["name"] + "\t" + name + "\t" + text)
' "$(current_headless_output)" "${HEADLESS_PREFIX}" "$(swaymsg -t get_outputs -r)"
}

# The port is VNC_PORT + N, so a workspace number has to stay small.
valid_ws() {
  [[ "${1:-}" =~ ^[1-9][0-9]?$ ]] || die "not a workspace number from 1 to 99: ${1:-}"
}

# The output a wayvnc instance serves, from its control socket.
served_output() {
  wayvncctl -S "$1" output-list 2>/dev/null | sed -n 's/^\* \([^:]*\):.*/\1/p'
}

# Run on the host: serve workspace $1's output on its own port, and print the
# port. The output is left as it is (no mode, scale or unplug): it belongs to
# another tool. An instance still on an output the workspace has left (the
# tool recreated it) is replaced.
headless_serve() {
  local ws="${1:-}" cursor="${2:-both}"
  valid_ws "${ws}"
  valid_cursor "${cursor}"
  ensure_swaysock
  is_active || die "headless mode is off"
  local output
  output="$(headless_bindable | awk -F'\t' -v ws="${ws}" '$1 == ws { print $2; exit }')"
  [[ -n "${output}" ]] || die "workspace ${ws} has no output of its own"

  local unit="${UNIT}-ws${ws}"
  local socket="${RUNTIME_DIR}/wayvncctl-ws${ws}"
  local port=$((VNC_PORT + ws))
  # local: the pointer is sent apart and the viewer shows it as its own;
  # both and remote: it is drawn into the stream, as on the desktop's output.
  local render=(--render-cursor) drawn="drawn in"
  if [[ "${cursor}" == "local" ]]; then
    render=()
    drawn="sent apart"
  fi
  local input=() inputs="input on"
  if view_only "${ws}"; then
    input=(--disable-input)
    inputs="view only"
  fi
  local description="wayvnc serving ${output} (headless, bound workspace ${ws}, cursor ${drawn}, ${inputs})"
  # Kept only while it still serves the workspace's output with the same
  # cursor and input: the owner recreates outputs, and their names change.
  if systemctl --user is-active --quiet "${unit}"; then
    if [[ "$(served_output "${socket}")" == "${output}" \
      && "$(systemctl --user show -p Description --value "${unit}")" == "${description}" ]]; then
      echo "${port}"
      return 0
    fi
    systemctl --user stop "${unit}"
  fi
  systemctl --user reset-failed "${unit}" 2>/dev/null || true

  # The same flags as the desktop's instance: see headless_on.
  systemd-run --user --quiet --collect --unit="${unit}" \
    --description="${description}" \
    wayvnc --output="${output}" --socket="${socket}" "${render[@]}" "${input[@]}" \
    --disable-resizing --gpu --max-fps="${HEADLESS_FPS}" "${VNC_ADDR}" "${port}"

  local _
  for _ in $(seq 50); do
    [[ "$(served_output "${socket}")" == "${output}" ]] && { echo "${port}"; return 0; }
    sleep 0.1
  done
  die "wayvnc did not start on ${output}"
}

valid_cursor() {
  case "${1:-}" in
    both | local | remote) ;;
    *) die "a cursor mode is both, local or remote, not: ${1:-}" ;;
  esac
}

# Run on the host when the viewing machine shows a view: "desktop" focuses
# this script's own output; a workspace number is served first (again, if
# its output changed) and then focused, so keys typed before the pointer
# moves reach it, not the window focused last. A view-only one is not
# focused: its stream takes no keys, and focusing a window there can
# disturb the tool driving it.
headless_show() {
  local target="${1:-}" output
  ensure_swaysock
  if [[ "${target}" == "desktop" ]]; then
    output="$(current_headless_output)"
  else
    headless_serve "${target}" "${2:-both}" >/dev/null
    view_only "${target}" && return 0
    output="$(headless_bindable | awk -F'\t' -v ws="${target}" '$1 == ws { print $2; exit }')"
  fi
  [[ -z "${output}" ]] || swaymsg -q "focus output ${output}"
}

# Run on the host: one line per bound workspace being served, as
# "<ws>\t<output>\t<port>".
headless_served() {
  local unit ws
  while read -r unit; do
    [[ -n "${unit}" ]] || continue
    ws="${unit#"${UNIT}"-ws}"
    ws="${ws%.service}"
    printf '%s\t%s\t%s\n' "${ws}" "$(served_output "${RUNTIME_DIR}/wayvncctl-ws${ws}")" "$((VNC_PORT + ws))"
  done < <(systemctl --user list-units --plain --no-legend --state=active "${UNIT}-ws*.service" | awk '{print $1}')
}

# Run on the host: stop serving workspace $1, or every bound one with "all".
# wayvnc leaves its control socket behind when stopped, so it goes too.
headless_unserve() {
  local ws="${1:-}"
  if [[ "${ws}" == "all" ]]; then
    systemctl --user stop "${UNIT}-ws*.service" 2>/dev/null || true
    rm -f "${RUNTIME_DIR}"/wayvncctl-ws*
    return 0
  fi
  valid_ws "${ws}"
  systemctl --user stop "${UNIT}-ws${ws}.service" 2>/dev/null || true
  rm -f "${RUNTIME_DIR}/wayvncctl-ws${ws}"
}

# Run on the host by the tool that writes the view-only markers, when they
# change: every bound workspace being served is served again, so its input
# follows its marker. Its viewer loses the stream and opens again
# (watch_bound_viewers).
headless_restream() {
  local unit ws cursor
  ensure_swaysock
  is_active || return 0
  while read -r unit; do
    [[ -n "${unit}" ]] || continue
    ws="${unit#"${UNIT}"-ws}"
    ws="${ws%.service}"
    cursor=both
    [[ "$(systemctl --user show -p Description --value "${unit}")" == *"cursor sent apart"* ]] \
      && cursor=local
    # A subshell: serve dies on a workspace that lost its output.
    (headless_serve "${ws}" "${cursor}" >/dev/null) || true
  done < <(systemctl --user list-units --plain --no-legend --state=active "${UNIT}-ws*.service" | awk '{print $1}')
}

# Runs this copy of the script on the host, so the host-side commands never
# depend on the version the host has installed.
on_host() {
  local host="$1"
  shift
  # SC2029: the arguments are meant to expand here; they are checked words.
  # shellcheck disable=SC2029
  # Through the tunnel's master when it is up (~20 ms instead of a new
  # login); ssh connects on its own when the socket is not there.
  ssh -S "$(tunnel_socket "${host}")" "${host}" "bash -s -- $*" <"${BASH_SOURCE[0]}"
}

tunnel_socket() {
  echo "${RUNTIME_DIR}/headless-tunnel-$1.sock"
}

# The host whose tunnel is open, if exactly one is.
connected_host() {
  local control host found=()
  for control in "${RUNTIME_DIR}"/headless-tunnel-*.sock; do
    [[ -S "${control}" ]] || continue
    host="${control##*/headless-tunnel-}"
    host="${host%.sock}"
    if ssh -q -S "${control}" -O check "${host}" 2>/dev/null; then
      found+=("${host}")
    fi
  done
  [[ ${#found[@]} -eq 1 ]] && echo "${found[0]}"
}

BOUND_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/headless"

# Written by another tool while it drives workspace <n>: the stream of a
# bound workspace with a marker takes no input (view-only).
VIEW_ONLY_DIR="${RUNTIME_DIR}/view-only"

view_only() {
  [[ -e "${VIEW_ONLY_DIR}/$1" ]]
}

# The host connected last: the first row of bind's connect menu.
LAST_HOST_FILE="${BOUND_DIR}/last-host"

bound_file() {
  echo "${BOUND_DIR}/bound-$1"
}

# One line per bound workspace: "<ws> <cursor mode>". The mode is how a
# view shows the pointer: both (this machine's and the host's, drawn into the
# stream), local (only this one, in the host's cursor shape, no lag) or
# remote (only the host's, as late as the stream).
is_bound() {
  awk -v ws="$2" '$1 == ws { found = 1 } END { exit !found }' "$(bound_file "$1")" 2>/dev/null
}

bound_cursor() {
  local mode
  mode="$(awk -v ws="$2" '$1 == ws { print $2; exit }' "$(bound_file "$1")" 2>/dev/null)"
  echo "${mode:-both}"
}

# Prints the bound workspaces of host $1, one per line.
bound_workspaces() {
  awk '{ print $1 }' "$(bound_file "$1")" 2>/dev/null || true
}

# set_bound <host> <ws> on [cursor] | off
set_bound() {
  local file
  file="$(bound_file "$1")"
  mkdir -p "${BOUND_DIR}"
  {
    awk -v ws="$2" '$1 != ws' "${file}" 2>/dev/null || true
    if [[ "$3" == "on" ]]; then
      echo "$2 ${4:-both}"
    fi
  } | sort -n >"${file}.tmp"
  mv "${file}.tmp" "${file}"
}

next_cursor() {
  case "$1" in
    both) echo local ;;
    local) echo remote ;;
    *) echo both ;;
  esac
}

viewer_running() {
  pgrep -f -- "^wlvncc -a headless-ws$1 " >/dev/null
}

# Waits for the viewer to exit, so its window is gone before a new one with
# the same app_id is looked for.
stop_bound_viewer() {
  pkill -f -- "^wlvncc -a headless-ws$1 " || return 0
  local _
  for _ in $(seq 50); do
    viewer_running "$1" || return 0
    sleep 0.1
  done
}

# Opens the viewer of bound workspace $1, full screen on the same workspace
# number here.
show_bound_viewer() {
  local ws="$1"
  # No -i: $mod+N stays on this machine, so the workspace keys always switch
  # away from a bound view.
  local hide=()
  [[ "${2:-both}" == "remote" ]] && hide=(-n)
  # The sync lock's fd is closed for the viewer: it would inherit it and hold
  # the lock as long as it runs, and every later sync would wait for it.
  if [[ -n "${SYNC_LOCK_FD:-}" ]]; then
    setsid -f wlvncc -a "headless-ws${ws}" "${hide[@]}" "${VNC_ADDR}" "$((VNC_PORT + ws))" \
      >/dev/null 2>&1 {SYNC_LOCK_FD}>&-
  else
    setsid -f wlvncc -a "headless-ws${ws}" "${hide[@]}" "${VNC_ADDR}" "$((VNC_PORT + ws))" \
      >/dev/null 2>&1
  fi

  local _ criteria="[app_id=\"^headless-ws${ws}\$\"]"
  for _ in $(seq 100); do
    if swaymsg -t get_tree | grep -qF "\"app_id\": \"headless-ws${ws}\""; then
      swaymsg -q "${criteria} move container to workspace number ${ws}, fullscreen enable"
      return 0
    fi
    sleep 0.1
  done
  echo "headless: the viewer of workspace ${ws} did not open" >&2
  return 1
}

# Connect on view: a bound workspace's viewer runs only while that workspace
# is visible here. A hidden viewer still receives and decodes the whole
# stream (measured: ~55 Mbit/s and ~8% of a core for each busy 60 fps stream), while an
# idle wayvnc with no client costs nothing. Showing one again takes the
# viewer's connect time (~0.2-0.35 s).
# The menu and the watcher both sync: one at a time, or both see no viewer
# and each opens one.
sync_bound_viewers() {
  local rc=0
  exec {SYNC_LOCK_FD}>"${RUNTIME_DIR}/headless-sync-$1.lock"
  flock "${SYNC_LOCK_FD}"
  sync_bound_viewers_locked "$1" || rc=$?
  exec {SYNC_LOCK_FD}>&-
  SYNC_LOCK_FD=""
  return "${rc}"
}

sync_bound_viewers_locked() {
  local host="$1" state focused="" desktop="" visible="" target="" ws cursor
  [[ -s "$(bound_file "${host}")" ]] || return 0
  # "focused <ws>", "visible <ws>" lines, and "desktop <ws>" for where the
  # desktop viewer is.
  state="$(swaymsg -t get_tree -r | python3 -c '
import json, sys

def walk(node, ws):
    if node.get("type") == "workspace":
        ws = node["name"]
    if node.get("app_id") == "wlvncc":
        print("desktop", ws)
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        walk(child, ws)

walk(json.load(sys.stdin), None)
')"$'\n'"$(swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace.get("visible"):
        print("visible", workspace["name"])
    if workspace.get("focused"):
        print("focused", workspace["name"])
')"
  focused="$(awk '$1 == "focused" { print $2 }' <<<"${state}")"
  desktop="$(awk '$1 == "desktop" { print $2; exit }' <<<"${state}")"
  visible="$(awk '$1 == "visible" { print $2 }' <<<"${state}")"
  # While the session is locked, sway lists no workspaces: that is no reason
  # to close a view, and the lock ends without an event to open it again.
  [[ -n "${visible}" ]] || return 0

  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    if grep -qxF "${ws}" <<<"${visible}"; then
      if ! viewer_running "${ws}"; then
        # Serves it again first if its output changed, and focuses it there.
        cursor="$(bound_cursor "${host}" "${ws}")"
        on_host "${host}" show "${ws}" "${cursor}" >/dev/null 2>&1 || true
        [[ "${ws}" == "${focused}" ]] && SHOWN_FOCUS="${ws}"
        show_bound_viewer "${ws}" "${cursor}" || true
      fi
    elif viewer_running "${ws}"; then
      stop_bound_viewer "${ws}"
    fi
  done < <(bound_workspaces "${host}")

  # Keys go to whatever the host has focused: follow the view in front here.
  if is_bound "${host}" "${focused}"; then
    target="${focused}"
  elif [[ -n "${desktop}" && "${focused}" == "${desktop}" ]]; then
    target="desktop"
  fi
  if [[ -n "${target}" && "${target}" != "${SHOWN_FOCUS:-}" ]]; then
    on_host "${host}" show "${target}" "$(bound_cursor "${host}" "${target}")" >/dev/null 2>&1 || true
    SHOWN_FOCUS="${target}"
  fi
}

# Run by `connect` in the background: syncs on every workspace change here,
# and when a window closes (a bound viewer that lost its stream opens again).
watch_bound_viewers() {
  local host="$1" event
  SHOWN_FOCUS=""
  sync_bound_viewers "${host}"
  while read -r event; do
    [[ "${event}" == *'"container":'* && "${event}" != *'"change": "close"'* ]] && continue
    sync_bound_viewers "${host}"
  done < <(swaymsg -t subscribe -m '["workspace", "window"]')
}

# Binds workspace $2 of $1: wayvnc there and a forward through the open
# tunnel. The viewer follows from sync_bound_viewers.
serve_bound() {
  local host="$1" ws="$2" control port
  control="$(tunnel_socket "${host}")"
  port="$(on_host "${host}" serve "${ws}" "$(bound_cursor "${host}" "${ws}")")" || return 1
  ssh -q -S "${control}" -O cancel -L "${port}:${VNC_ADDR}:${port}" "${host}" 2>/dev/null || true
  ssh -q -S "${control}" -O forward -L "${port}:${VNC_ADDR}:${port}" "${host}" \
    || { echo "headless: could not forward port ${port}" >&2; return 1; }
}

close_bound() {
  local host="$1" ws="$2" port=$((VNC_PORT + $2))
  stop_bound_viewer "${ws}"
  ssh -q -S "$(tunnel_socket "${host}")" -O cancel -L "${port}:${VNC_ADDR}:${port}" "${host}" 2>/dev/null || true
  on_host "${host}" unserve "${ws}" || true
}

# Called by `connect`: serves every bound workspace the host still has.
restore_bound() {
  local host="$1" bindable ws
  [[ -s "$(bound_file "${host}")" ]] || return 0
  bindable="$(on_host "${host}" bindable)" || return 0
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    if awk -F'\t' -v ws="${ws}" '$1 == ws { found = 1 } END { exit !found }' <<<"${bindable}"; then
      serve_bound "${host}" "${ws}" || true
    else
      echo "headless: workspace ${ws} is bound but has no output of its own on ${host}; skipped"
    fi
  done < <(bound_workspaces "${host}")
}

# Run from the remote machine, usually by a key binding with no terminal, so
# failures also go out as notifications. Lists the whole session first, then
# the host's bindable workspaces. Picking a workspace binds or unbinds it and
# opens the menu again with the new marks, until Esc; picking the session
# closes the menu and brings its viewer to the front.
headless_bind() {
  local host="${1:-}"
  host="${host:-$(connected_host || true)}"
  command -v launcher >/dev/null 2>&1 || die "launcher (gtk-widgets) is not installed"
  if [[ -z "${host}" ]] || ! ssh -q -S "$(tunnel_socket "${host}")" -O check "${host}" 2>/dev/null; then
    connect_from_menu "${host}"
    return 0
  fi
  command -v wlvncc >/dev/null 2>&1 || die "bound workspaces need wlvncc"

  # Listed once: binding changes the marks, not which workspaces there are.
  local bindable
  if ! bindable="$(on_host "${host}" bindable)"; then
    notify "Headless" "Could not list the workspaces of ${host}"
    die "could not list the workspaces of ${host}"
  fi

  local choice key="" ws mode
  while choice="$(bind_rows "${host}" "${bindable}" "${key}" \
    | launcher --dmenu --prompt "bind · ${host}" --after-tab)"; do
    key="${choice%%$'\t'*}"
    if [[ "${key}" == "desktop" ]]; then
      swaymsg -q '[app_id="^wlvncc$"] focus' || true
      return 0
    fi
    # A cursor row ("c<ws>") switches that view to the next mode. A view on
    # screen opens again with it; wayvnc follows when the view is shown.
    if [[ "${key}" == c* ]]; then
      ws="${key#c}"
      valid_ws "${ws}"
      is_bound "${host}" "${ws}" || continue
      mode="$(next_cursor "$(bound_cursor "${host}" "${ws}")")"
      set_bound "${host}" "${ws}" on "${mode}"
      if viewer_running "${ws}"; then
        stop_bound_viewer "${ws}"
        sync_bound_viewers "${host}"
      fi
      continue
    fi
    ws="${key}"
    valid_ws "${ws}"
    if is_bound "${host}" "${ws}"; then
      close_bound "${host}" "${ws}"
      set_bound "${host}" "${ws}" off
    elif serve_bound "${host}" "${ws}"; then
      set_bound "${host}" "${ws}" on
      sync_bound_viewers "${host}"
    else
      notify "Headless" "Could not bind workspace ${ws} of ${host}"
    fi
  done
}

# The hosts bind's connect menu offers: the last one connected, every host
# with a bound file, then the Host entries of ~/.ssh/config. This machine
# itself is left out.
known_hosts() {
  local f self
  self="$(</proc/sys/kernel/hostname)"
  {
    cat "${LAST_HOST_FILE}" 2>/dev/null || true
    for f in "${BOUND_DIR}"/bound-*; do
      [[ -e "${f}" ]] && echo "${f##*/bound-}"
    done
    ssh_config_hosts
  } | awk -v self="${self}" 'NF && $0 != self && !seen[$0]++'
}

# The known hosts connect can use now: they answer over ssh within 3 s
# without a password prompt, and have headless and wayvnc. All are asked at
# once, so the menu waits for the slowest one at most; an offline host drops
# out.
headless_hosts() {
  local hosts host i=0 dir
  hosts="$(known_hosts)"
  [[ -n "${hosts}" ]] || return 0
  dir="$(mktemp -d)"
  while read -r host; do
    {
      timeout 3 ssh -n -o BatchMode=yes -o ConnectTimeout=2 "${host}" \
        'command -v headless && command -v wayvnc' >/dev/null 2>&1 \
        && touch "${dir}/${i}"
    } &
    i=$((i + 1))
  done <<<"${hosts}"
  wait
  i=0
  while read -r host; do
    [[ -e "${dir}/${i}" ]] && echo "${host}"
    i=$((i + 1))
  done <<<"${hosts}"
  rm -rf "${dir}"
}

# The names of ~/.ssh/config's Host entries and of the files it includes,
# without patterns (*, ?, !).
ssh_config_hosts() {
  local cfg="${HOME}/.ssh/config" files=() inc f
  [[ -r "${cfg}" ]] || return 0
  files=("${cfg}")
  while read -r inc; do
    inc="${inc/#\~/${HOME}}"
    [[ "${inc}" == /* ]] || inc="${HOME}/.ssh/${inc}"
    while read -r f; do
      [[ -n "${f}" ]] && files+=("${f}")
    done < <(compgen -G "${inc}" || true)
  done < <(awk 'tolower($1) == "include" { for (i = 2; i <= NF; i++) print $i }' "${cfg}")
  awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' \
    "${files[@]}" 2>/dev/null || true
}

# bind with no viewer open: pick a host (or take $1), start `connect` to it
# in the background, and return once its tunnel is up. The desktop viewer
# opens here; bind again for the bind menu.
connect_from_menu() {
  local host="$1" hosts choice
  if [[ -z "${host}" ]]; then
    hosts="$(headless_hosts)"
    if [[ -z "${hosts}" ]]; then
      notify "Headless" "No host answers with headless and wayvnc"
      die "no host answers with headless and wayvnc (hosts: last connected, ~/.ssh/config)"
    fi
    choice="$(while read -r host; do printf '%s\t   connect · %s\n' "${host}" "${host}"; done <<<"${hosts}" \
      | launcher --dmenu --prompt "headless · not connected" --after-tab)" || return 0
    host="${choice%%$'\t'*}"
  fi

  local log="${RUNTIME_DIR}/headless-connect-${host}.log" pid
  setsid -f "${BASH_SOURCE[0]}" connect "${host}" >"${log}" 2>&1 </dev/null
  # Up to 20 s: connect may first turn headless on at the host.
  # Gone after its first second: it failed.
  local i
  for i in $(seq 200); do
    ssh -q -S "$(tunnel_socket "${host}")" -O check "${host}" 2>/dev/null && return 0
    if ((i > 10)); then
      pid="$(pgrep -f -- "^bash ${BASH_SOURCE[0]} connect ${host}\$" | head -1 || true)"
      [[ -n "${pid}" ]] || break
    fi
    sleep 0.1
  done
  notify "Headless" "Could not connect to ${host}: $(tail -1 "${log}")"
  die "could not connect to ${host} (${log})"
}

# The rows of the bind menu, as "<key>\t<text>": the session, the bindable
# workspaces with ● on the bound ones, and bound ones without an output of
# their own now, so they can be unbound. The row of key $3 (the one just
# toggled) comes first: the launcher selects the first row, and has no way
# to select another.
bind_rows() {
  local rows
  rows="$(menu_rows "$1" "$2")"
  awk -F'\t' -v first="${3:-}" '$1 == first' <<<"${rows}"
  awk -F'\t' -v first="${3:-}" '$1 != first' <<<"${rows}"
}

menu_rows() {
  local host="$1" bindable="$2" ws output label mark
  printf 'desktop\t   desktop · the whole session\n'
  while IFS=$'\t' read -r ws output label; do
    [[ -n "${ws}" ]] || continue
    mark="   "
    is_bound "${host}" "${ws}" && mark="● "
    printf '%s\t%sws %s%s   (%s)\n' "${ws}" "${mark}" "${ws}" "${label:+ · ${label}}" "${output}"
    if is_bound "${host}" "${ws}"; then
      printf 'c%s\t       ws %s cursor: %s\n' "${ws}" "${ws}" "$(bound_cursor "${host}" "${ws}")"
    fi
  done <<<"${bindable}"
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    awk -F'\t' -v ws="${ws}" '$1 == ws { found = 1 } END { exit !found }' <<<"${bindable}" && continue
    printf '%s\t● ws %s · no output of its own now\n' "${ws}" "${ws}"
  done < <(bound_workspaces "${host}")
}

# --- Clipboard ---
# wlvncc has no clipboard, so connect bridges it over the tunnel instead, for
# every viewer alike: a copy on either side lands in the other's clipboard.
# Two streams through the tunnel's master, each a run of frames, a header
# line "<mime type> <length>" and then that many raw bytes:
#   host -> here   on_host clip-out | clip_recv
#   here -> host   clip_watch | ssh host clip-in
# Each side keeps the hash of the last copy it received (<state>.in) and does
# not send a copy back with that hash, or the two would bounce one copy
# forever. Only copies made after connect cross: wl-paste --watch reports the
# current clipboard when it starts, and that first report is dropped
# (<state>.skip), or connecting would swap the two clipboards.

# The type a copy crosses in, from its offered types ($1): text where the app
# offers text, else an image. An offer from launcher-clipboard (cliphist-store
# re-offering a copied image, a $mod+v pick) carries its marker; its text is
# a path to a file on this machine only, so its image goes instead.
clip_type() {
  local types="$1" image text
  image="$(grep -m1 '^image/' <<<"${types}")" || image=""
  text="$(grep -m1 -x 'text/plain;charset=utf-8' <<<"${types}" \
    || grep -m1 '^text/plain' <<<"${types}")" || text=""
  if [[ -n "${image}" ]] && grep -qxF application/x-launcher-clipboard <<<"${types}"; then
    echo "${image}"
  elif [[ -n "${text}" ]]; then
    echo "${text}"
  elif [[ -n "${image}" ]]; then
    echo "${image}"
  else
    return 1
  fi
}

# Run by wl-paste --watch for each copy: writes the copy's frame to stdout.
# It runs in a bash -c of its own (clip_watch), so it takes everything as
# arguments and calls nothing outside this function and clip_type.
clip_emit() {
  local state="$1" types type data hash
  # wl-paste hands over the copy in the type it picks; read it so the app
  # is not left writing to a closed pipe, and fetch the type wanted below.
  cat >/dev/null
  if [[ -e "${state}.skip" ]]; then
    rm -f "${state}.skip"
    return 0
  fi
  # nil, clear, or sensitive (a password manager's copy): nothing crosses.
  [[ "${CLIPBOARD_STATE:-data}" == data ]] || return 0
  types="$(wl-paste --list-types 2>/dev/null)" || return 0
  type="$(clip_type "${types}")" || return 0
  data="$(mktemp)"
  wl-paste --no-newline --type "${type}" >"${data}" 2>/dev/null || { rm -f "${data}"; return 0; }
  hash="$(sha256sum <"${data}")"
  if [[ "${hash%% *}" != "$(cat "${state}.in" 2>/dev/null)" ]]; then
    # Frames from two copies in quick succession must not interleave. A
    # write that fails means the far side is gone: the watcher goes too.
    # shellcheck disable=SC2016  # expanded by the inner sh
    if ! flock "${state}.lock" sh -c 'printf "%s %s\n" "$1" "$(stat -c %s "$2")"; cat "$2"' \
      _ "${type}" "${data}"; then
      kill "${PPID}" 2>/dev/null || true
    fi
  fi
  rm -f "${data}"
}

# Watch this side's clipboard and write a frame per copy to stdout.
clip_watch() {
  local state="$1"
  : >"${state}.skip"
  exec wl-paste --watch bash -c "$(declare -f clip_type clip_emit); clip_emit \"\$1\"" \
    headless-clip "${state}"
}

# Read frames from stdin until it closes and put each into the clipboard.
# bash's read takes the header a byte at a time and head -c takes no more
# than the length, so neither eats into the next frame.
clip_recv() {
  local state="$1" type len hash
  while read -r type len; do
    [[ "${len}" =~ ^[0-9]+$ ]] || die "clipboard: bad frame header '${type} ${len}'"
    head -c "${len}" >"${state}.data"
    hash="$(sha256sum <"${state}.data")"
    echo "${hash%% *}" >"${state}.in"
    # wl-copy stays behind to serve the copy: it gets no stdout or stderr
    # that would hold the stream open.
    wl-copy --type "${type}" <"${state}.data" >/dev/null 2>&1
  done
  rm -f "${state}.data"
}

# Over SSH the session's Wayland socket is not in the environment; the user
# manager has it, the same one wayvnc's unit gets.
ensure_wayland_display() {
  [[ -n "${WAYLAND_DISPLAY:-}" ]] && return 0
  local display
  display="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p')"
  [[ -n "${display}" ]] || die "no WAYLAND_DISPLAY in the user manager — is sway running?"
  export WAYLAND_DISPLAY="${display}"
}

# Run on the host: its copies, as frames on stdout. A watcher left by an
# earlier connect goes first; it would only notice the closed stream at the
# next copy. One viewing machine per host, as for the tunnel.
headless_clip_out() {
  ensure_wayland_display
  local state="${RUNTIME_DIR}/headless-clip" pid
  pid="$(cat "${state}.pid" 2>/dev/null || true)"
  if [[ -n "${pid}" && "$(ps -o comm= -p "${pid}" 2>/dev/null)" == wl-paste ]]; then
    kill "${pid}" 2>/dev/null || true
  fi
  echo "$$" >"${state}.pid"
  clip_watch "${state}"
}

# Run on the host: frames from stdin into its clipboard.
headless_clip_in() {
  ensure_wayland_display
  clip_recv "${RUNTIME_DIR}/headless-clip"
}

# Run here by connect, in a process group of its own that connect kills.
# clip-in reads its frames from the same stdin as the script: bash -s runs
# main as soon as it has read the last line, and leaves the rest unread.
headless_clip_bridge() {
  local host="$1"
  local state="${RUNTIME_DIR}/headless-clip-${host}"
  on_host "${host}" clip-out | clip_recv "${state}" &
  { cat "${BASH_SOURCE[0]}"; clip_watch "${state}"; } \
    | ssh -S "$(tunnel_socket "${host}")" "${host}" 'bash -s -- clip-in' &
  wait
}

# waypipe needs no headless output, no VNC and no running compositor on the
# far side — only sshd. This is the path that still works after a reboot.
headless_app() {
  local host="${1:-}"
  shift || true
  [[ -n "${host}" && $# -gt 0 ]] || die "app needs a host and a command (e.g. headless app desktop nvim)"
  command -v waypipe >/dev/null 2>&1 || die "waypipe is not installed"

  waypipe ssh "${host}" "$@"
}

main() {
  case "${1:-status}" in
    on) headless_on ;;
    off) headless_off ;;
    status) headless_status ;;
    toggle)
      # Also off when only part of it is up: the virtual output without wayvnc.
      # The binding works on the lock screen, so the monitor can be brought
      # back at the desk. Turning headless mode on from there is refused.
      if is_active || have_headless_output; then
        headless_off
      elif is_locked; then
        notify "Headless Mode" "The screen is locked: unlock it to turn headless mode on."
        die "the screen is locked: unlock it to turn headless mode on"
      else
        headless_on
      fi
      ;;
    connect)
      shift
      headless_connect "$@"
      ;;
    bind)
      shift
      headless_bind "$@"
      ;;
    # Run on the host by the commands above, through on_host.
    bindable) headless_bindable ;;
    serve)
      shift
      headless_serve "$@"
      ;;
    unserve)
      shift
      headless_unserve "$@"
      ;;
    show)
      shift
      headless_show "$@"
      ;;
    served) headless_served ;;
    restream) headless_restream ;;
    clip-out) headless_clip_out ;;
    clip-in) headless_clip_in ;;
    clip-bridge)
      shift
      headless_clip_bridge "$@"
      ;;
    app)
      shift
      headless_app "$@"
      ;;
    dpms)
      shift
      headless_dpms "$@"
      ;;
    -h | --help | help) usage ;;
    *)
      echo "headless: unknown command '${1}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
