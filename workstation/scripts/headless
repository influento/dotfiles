#!/usr/bin/env bash
set -euo pipefail

# headless — switch this machine between normal desktop and headless remote mode.
#
#   headless on|off|status|toggle
#   headless connect <host>        full desktop, from the remote machine
#   headless bind [host]           bind or unbind a host workspace (own viewer)
#   headless app <host> <cmd>...   single app over waypipe, no session needed
#   headless dpms on|off           power the physical outputs only (swayidle)
#
# Backup mode for power outages: the physical outputs go off and the live Sway
# session is served over VNC from a virtual output. wayvnc binds to loopback
# only; reach it over SSH, never by exposing the port. Design constraints and
# requirements: see workstation/scripts/CLAUDE.md.

UNIT="wayvnc"
# Sway increments the suffix on every create_output for the lifetime of the
# compositor, so the second toggle yields HEADLESS-2 and so on. Never assume
# HEADLESS-1 — always resolve the current name.
#
# Other tools create HEADLESS-* outputs too (to keep the windows on them rendering
# off screen). This script serves, moves workspaces to and
# unplugs only the output it created itself, recorded in OUTPUT_FILE.
HEADLESS_PREFIX="HEADLESS-"
VNC_ADDR="127.0.0.1"
VNC_PORT="5900"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="${RUNTIME_DIR}/headless.workspaces"
FOCUS_FILE="${RUNTIME_DIR}/headless.focus"
OUTPUT_FILE="${RUNTIME_DIR}/headless.output"
# Marks that headless mode is the one holding the suspend inhibitor, so a
# nosleep the user enabled by hand is not released when headless mode ends.
NOSLEEP_OWNED_FILE="${RUNTIME_DIR}/headless.nosleep-owned"

# Geometry of the virtual output: it should match the screen being connected
# from, not the panel attached here (a 3840x1600 ultrawide, which suits no
# laptop). Scale matters as much as mode on a HiDPI client — mode sets the
# framebuffer wayvnc streams, scale sets the logical layout inside it. Getting
# scale wrong gives either half-size UI or a blurry upscaled image.
#
# Precedence: environment > config file > built-in default. Per-machine values
# belong in the config file, which is outside the repo so nothing
# machine-specific is tracked:
#
#   ~/.config/headless.conf
#     HEADLESS_MODE=1920x1080
#     HEADLESS_SCALE=1
#
# `headless connect` overrides both by detecting the local screen, so these
# defaults only apply when starting headless mode directly on this machine.
_env_mode="${HEADLESS_MODE:-}"
_env_scale="${HEADLESS_SCALE:-}"
_env_fps="${HEADLESS_FPS:-}"

CONFIG_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/headless.conf"
if [[ -r "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

HEADLESS_MODE="${_env_mode:-${HEADLESS_MODE:-2880x1800}}"
HEADLESS_SCALE="${_env_scale:-${HEADLESS_SCALE:-2}}"
HEADLESS_FPS="${_env_fps:-${HEADLESS_FPS:-60}}"

usage() {
  cat <<'EOF'
Usage: headless <command>

  on                    Disable physical outputs, serve the session over VNC
  off                   Restore the physical outputs and stop serving
  status                Report whether headless mode is active
  toggle                Flip between on and off

  connect <host>        Tunnel over SSH and open the remote desktop (VNC)
  bind [host]           Pick a host workspace that has an output of its own
                        (another tool's HEADLESS-* output) and give it its
                        own viewer, full screen on the same workspace number
                        here, connected only while that workspace is visible.
                        Picking a bound one unbinds it; the menu opens again
                        until Esc. Its first row brings the desktop viewer to
                        the front. Needs an open viewer; without a host, the
                        one connected
  app <host> <cmd>...   Run one remote app locally over waypipe

  dpms <on|off>         Power the physical outputs only, never the virtual
                        one (used by swayidle)

Environment / ~/.config/headless.conf:
  HEADLESS_MODE         Virtual output mode  (default: 2880x1800)
  HEADLESS_SCALE        Virtual output scale (default: 2)
  HEADLESS_FPS          Stream frame rate cap (default: 60)
  HEADLESS_VIEWER       VNC client to use, in preference order
                        (default: wlvncc remote-viewer vncviewer)
  HEADLESS_VIEWER_ARGS  Extra arguments passed to the viewer, e.g. to run
                        windowed instead of fullscreen

With remote-viewer, ctrl+alt releases the keyboard grab — without it $mod+1
switches the remote workspace rather than the local one.

`connect` detects the local screen and overrides both, so these normally
only matter when running `headless on` directly on this machine.
EOF
}

die() {
  echo "headless: $1" >&2
  exit 1
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$1" "$2" || true
}

# Sway's IPC socket is not in the environment over SSH, so find it explicitly.
# This is what lets the mode be switched from the remote machine as well.
ensure_swaysock() {
  if [[ -n "${SWAYSOCK:-}" && -S "${SWAYSOCK}" ]]; then
    return 0
  fi
  local sock
  sock="$(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'sway-ipc.*.sock' 2>/dev/null | head -n1)"
  [[ -n "${sock}" ]] || die "no sway IPC socket found — is sway running?"
  export SWAYSOCK="${sock}"
}

output_names() {
  swaymsg -t get_outputs -r | python3 -c '
import json, sys
for output in json.load(sys.stdin):
    print(output["name"])
'
}

# Every output that is not the virtual one, whether currently enabled or not:
# a disabled output still appears in get_outputs, which is how "off" finds it.
physical_outputs() {
  output_names | grep -v "^${HEADLESS_PREFIX}" || true
}

headless_outputs() {
  output_names | grep "^${HEADLESS_PREFIX}" || true
}

# The output this script created, if it still exists.
current_headless_output() {
  [[ -s "${OUTPUT_FILE}" ]] || return 0
  local name
  name="$(cat "${OUTPUT_FILE}")"
  if headless_outputs | grep -qxF "${name}"; then
    echo "${name}"
  fi
}

have_headless_output() {
  [[ -n "$(current_headless_output)" ]]
}

workspaces_on() {
  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace["output"] == sys.argv[1]:
        print(workspace["name"])
' "$1"
}

# Sway moves whichever workspace is focused, so focus each one first.
move_workspace() {
  swaymsg -q "workspace \"$1\"" || true
  swaymsg -q "move workspace to output \"$2\"" || true
}

is_active() {
  systemctl --user is-active --quiet "${UNIT}"
}

save_layout() {
  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
seen = set()
for workspace in json.load(sys.stdin):
    pair = (workspace["name"], workspace["output"])
    if pair in seen:
        continue
    seen.add(pair)
    print(workspace["name"], workspace["output"])
' >"${STATE_FILE}"

  swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace.get("focused"):
        print(workspace["name"])
        break
' >"${FOCUS_FILE}"
}

restore_focus() {
  if [[ -s "${FOCUS_FILE}" ]]; then
    swaymsg -q "workspace \"$(cat "${FOCUS_FILE}")\"" || true
  fi
}

# Moves the workspaces of the physical outputs onto the virtual one before the
# physical ones are disabled. Left to itself, Sway may pick another tool's
# HEADLESS-* output instead.
take_workspaces() {
  local virtual="$1"
  shift
  local workspace output
  while read -r workspace output; do
    [[ -n "${workspace}" && -n "${output}" ]] || continue
    printf '%s\n' "$@" | grep -qxF "${output}" || continue
    move_workspace "${workspace}" "${virtual}"
  done <"${STATE_FILE}"
  restore_focus
}

# Moves every workspace on the virtual output back: to the physical output it
# came from, or to the first one for a workspace created while headless. Ones
# that never left another tool's output are not touched.
return_workspaces() {
  local virtual="$1"
  shift
  local workspace saved target
  while read -r workspace; do
    [[ -n "${workspace}" ]] || continue
    saved=""
    if [[ -f "${STATE_FILE}" ]]; then
      saved="$(awk -v ws="${workspace}" '$1 == ws { print $2; exit }' "${STATE_FILE}")"
    fi
    target="$1"
    if [[ -n "${saved}" ]] && printf '%s\n' "$@" | grep -qxF "${saved}"; then
      target="${saved}"
    fi
    move_workspace "${workspace}" "${target}"
  done < <(workspaces_on "${virtual}")
  restore_focus
  rm -f "${STATE_FILE}" "${FOCUS_FILE}"
}

headless_on() {
  ensure_swaysock
  command -v wayvnc >/dev/null 2>&1 || die "wayvnc is not installed"

  if is_active; then
    echo "headless: already on"
    return 0
  fi

  local physical=()
  mapfile -t physical < <(physical_outputs)
  [[ ${#physical[@]} -gt 0 ]] || die "no physical output found — nothing to disable"

  save_layout

  # Always a fresh output, named by what create_output added: an existing
  # HEADLESS-* may belong to another tool.
  local virtual
  virtual="$(current_headless_output)"
  if [[ -z "${virtual}" ]]; then
    local before
    before="$(headless_outputs)"
    swaymsg -q create_output
    virtual="$(headless_outputs | grep -vxF -f <(printf '%s\n' "${before}") | head -n1 || true)"
    [[ -n "${virtual}" ]] || die "could not create a headless output"
    printf '%s\n' "${virtual}" >"${OUTPUT_FILE}"
  fi

  # Scale is always set explicitly: the settings popup's scale.conf applies
  # `output * scale 1.3` for the ultrawide, and inheriting that would misrender
  # the remote view.
  swaymsg -q "output ${virtual} mode --custom ${HEADLESS_MODE} scale ${HEADLESS_SCALE}"

  # --render-cursor composites the pointer into the framebuffer at the output's
  # own scale. Without it wayvnc sends the cursor separately and the client
  # draws it locally at logical size, so a scale-2 output produces a pointer
  # twice the size it should be.
  # --disable-resizing refuses SetDesktopSize outright rather than failing the
  # request, since a Sway output cannot be resized on a client's say-so.
  # --gpu enables H.264 through VA-API for clients that ask for it (wlvncc
  # does by default). Under full-screen motion it measured ~7% of a core
  # against ~47% for Tight, which is what makes 60 fps affordable. Clients
  # without H.264 (remote-viewer) still get Tight.
  systemd-run --user --quiet --collect --unit="${UNIT}" \
    --description="wayvnc serving ${virtual} (headless mode)" \
    wayvnc --output="${virtual}" --render-cursor --disable-resizing \
    --gpu --max-fps="${HEADLESS_FPS}" "${VNC_ADDR}" "${VNC_PORT}"

  # swayidle still suspends at 60 min, which would drop every remote session.
  # Only claim the inhibitor if it is not already held, so that turning
  # headless mode off later does not undo a nosleep the user set by hand.
  if systemctl --user is-active --quiet nosleep; then
    rm -f "${NOSLEEP_OWNED_FILE}"
  else
    nosleep on >/dev/null
    : >"${NOSLEEP_OWNED_FILE}"
  fi

  take_workspaces "${virtual}" "${physical[@]}"

  # disable, not power off: it puts the monitor in standby.
  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" disable" || true
  done

  echo "headless: on — ${virtual} at ${HEADLESS_MODE} scale ${HEADLESS_SCALE}, wayvnc on ${VNC_ADDR}:${VNC_PORT}"
  echo "headless: physical outputs disabled: ${physical[*]}"
  notify "Headless Mode" "Monitor disabled. Session served on ${VNC_ADDR}:${VNC_PORT} (SSH tunnel only)."
}

headless_off() {
  ensure_swaysock

  if ! is_active && ! have_headless_output; then
    echo "headless: already off"
    return 0
  fi

  local physical=()
  mapfile -t physical < <(physical_outputs)

  local output
  for output in "${physical[@]}"; do
    swaymsg -q "output \"${output}\" enable" || true
  done

  local virtual
  virtual="$(current_headless_output)"
  if [[ -n "${virtual}" ]]; then
    return_workspaces "${virtual}" "${physical[@]}"
  fi

  if is_active; then
    systemctl --user stop "${UNIT}"
  fi
  headless_unserve all
  # Release the inhibitor only if headless mode was the one that took it.
  if [[ -e "${NOSLEEP_OWNED_FILE}" ]]; then
    nosleep off >/dev/null || true
    rm -f "${NOSLEEP_OWNED_FILE}"
  fi

  if [[ -n "${virtual}" ]]; then
    swaymsg -q "output ${virtual} unplug" || true
  fi
  rm -f "${OUTPUT_FILE}"

  echo "headless: off — physical outputs restored: ${physical[*]}"
  notify "Headless Mode" "Monitor restored. Remote session stopped."
}

headless_status() {
  if is_active; then
    ensure_swaysock
    echo "headless: on — wayvnc serving $(current_headless_output) on ${VNC_ADDR}:${VNC_PORT}"
  else
    echo "headless: off — normal desktop"
  fi
}

# swayidle's idle timeout must never power off the virtual output: wlroots
# stops compositing a powered-off output, which freezes the VNC stream with no
# way to wake it remotely. A bare `output * power off` would do exactly that,
# so idle handling goes through here to skip HEADLESS-*.
headless_dpms() {
  ensure_swaysock
  local action="${1:-}"
  case "${action}" in
    on | off) ;;
    *) die "dpms needs 'on' or 'off'" ;;
  esac

  local output
  while read -r output; do
    [[ -n "${output}" ]] || continue
    swaymsg -q "output \"${output}\" power ${action}" || true
  done < <(physical_outputs)
}

# Mode and scale of this machine's active output, so the remote virtual output
# can be sized to the screen actually being looked at. Both ends run the same
# Sway setup, which is what makes this possible. Prints "<WxH> <scale>", or
# nothing when not running under Sway — callers fall back to the defaults.
local_geometry() {
  swaymsg -t get_outputs -r 2>/dev/null | python3 -c '
import json, sys
try:
    outputs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for output in outputs:
    if not output.get("active"):
        continue
    mode = output.get("current_mode") or {}
    width, height = mode.get("width"), mode.get("height")
    if not width or not height:
        continue
    scale = float(output.get("scale") or 1)
    scale = int(scale) if scale.is_integer() else round(scale, 2)
    print(f"{width}x{height} {scale}")
    break
' 2>/dev/null || true
}

# Bring the far side up sized to this screen, unless it is already serving.
ensure_remote_headless() {
  local host="$1"
  if ssh "${host}" 'headless status' 2>/dev/null | grep -q 'on —'; then
    echo "headless: ${host} already serving"
    return 0
  fi

  local geometry mode scale
  geometry="$(local_geometry)"
  if [[ -n "${geometry}" ]]; then
    mode="${geometry%% *}"
    scale="${geometry##* }"
    echo "headless: starting ${host} at ${mode} scale ${scale} (detected locally)"
    # SC2029: expanding locally is the point — these are this screen's values,
    # sent to the far side.
    # shellcheck disable=SC2029
    ssh "${host}" "HEADLESS_MODE=${mode} HEADLESS_SCALE=${scale} headless on" \
      || die "could not start headless mode on ${host}"
  else
    echo "headless: local screen not detected, using remote defaults"
    ssh "${host}" 'headless on' || die "could not start headless mode on ${host}"
  fi
}

# Run from the remote machine. The tunnel uses a control socket so the viewer
# exiting always tears it down, rather than leaking a background ssh.
# Pick a viewer, preferring Wayland-native ones. tigervnc's vncviewer is X11
# only, so under Sway it runs through XWayland: on a scaled output the
# compositor renders it at 1x and upscales, throwing away half the detail of a
# HiDPI stream. wlvncc is purpose-built for wayvnc; remote-viewer (virt-viewer)
# is GTK and Wayland-native. Override with HEADLESS_VIEWER=<name>.
pick_viewer() {
  local candidate
  for candidate in ${HEADLESS_VIEWER:-wlvncc remote-viewer vncviewer}; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      echo "${candidate}"
      return 0
    fi
  done
  return 1
}

run_viewer() {
  local viewer="$1"
  case "${viewer}" in
    wlvncc)
      # -i asks for the keyboard-shortcuts-inhibit protocol while focused, so
      # $mod+N reaches the remote session; wlvncc leaves it off by default.
      # The --inhibited bindings in sway/config ($mod+Ctrl+N) stay local.
      wlvncc -i "${VNC_ADDR}" "${VNC_PORT}"
      ;;
    remote-viewer)
      # Fullscreen with auto-resize off is what makes the sizing pay off: the
      # virtual output already matches this screen, so a windowed presentation
      # would resample the framebuffer and throw the sharpness away again.
      # auto-resize is off because wayvnc cannot resize a Sway output anyway.
      #
      # Hotkeys listed here stay active even while the guest display holds
      # focus — which matters, because gtk-vnc uses the Wayland
      # keyboard-shortcuts-inhibit protocol that Sway honours, so $mod+1 goes
      # to the remote and the local compositor never sees it. Fullscreen plus
      # an inhibited keyboard means shift+f11 is the only way out; without it
      # the session is a trap. release-cursor is kept as a second escape,
      # though it does nothing while the pointer is absolute (as it is here).
      # shellcheck disable=SC2086
      remote-viewer -f --auto-resize=never \
        --hotkeys=toggle-fullscreen=shift+f11,release-cursor=shift+f12 \
        ${HEADLESS_VIEWER_ARGS:-} "vnc://${VNC_ADDR}:${VNC_PORT}"
      ;;
    vncviewer)
      # RemoteResize defaults to on and makes the viewer ask wayvnc to resize
      # the Sway output, which it cannot do — the request fails with
      # "SetDesktopSize failed". Harmless, but there is no reason to send it.
      vncviewer -RemoteResize=0 "${VNC_ADDR}:${VNC_PORT}"
      ;;
    *)
      "${viewer}" "${VNC_ADDR}:${VNC_PORT}"
      ;;
  esac
}

headless_connect() {
  local host="${1:-}"
  [[ -n "${host}" ]] || die "connect needs a host (e.g. headless connect desktop)"

  local viewer
  viewer="$(pick_viewer)" \
    || die "no VNC viewer found — install wlvncc (AUR) or virt-viewer, or tigervnc"
  if [[ "${viewer}" == "vncviewer" ]]; then
    echo "headless: using vncviewer (X11/XWayland) — expect a soft image on a" \
         "HiDPI screen; install wlvncc or virt-viewer for a sharp one" >&2
  fi

  # One connect per host: a second one would share the tunnel, and its exit
  # would close the first one's tunnel along with its own.
  local control
  control="$(tunnel_socket "${host}")"
  if ssh -q -S "${control}" -O check "${host}" 2>/dev/null; then
    echo "headless: already connected to ${host}"
    swaymsg -q '[app_id="^wlvncc$"] focus' 2>/dev/null || true
    return 0
  fi
  # A socket left by a connect that was killed: ssh would not become the
  # master beside it.
  rm -f "${control}"

  ensure_remote_headless "${host}"

  # ExitOnForwardFailure: with the port taken, fail here instead of running
  # on without the forward the viewer needs.
  ssh -f -N -M -S "${control}" -o ExitOnForwardFailure=yes \
    -L "${VNC_PORT}:${VNC_ADDR}:${VNC_PORT}" "${host}" \
    || die "could not open SSH tunnel to ${host}"
  local restore watcher
  restore_bound "${host}" &
  restore=$!
  # The watcher starts once the restore is done: a viewer needs its forward.
  {
    while kill -0 "${restore}" 2>/dev/null; do sleep 0.1; done
    watch_bound_viewers "${host}"
  } &
  watcher=$!
  # Closing the desktop viewer closes the bound ones too and stops their
  # wayvnc; which ones are bound stays recorded for the next connect. The
  # watcher goes first, with its swaymsg, so it opens nothing during the
  # cleanup. The restore is waited for: a wayvnc it starts after the cleanup
  # would be left running.
  # shellcheck disable=SC2064
  trap "pkill -P ${watcher} 2>/dev/null; kill ${watcher} 2>/dev/null
    wait ${restore} 2>/dev/null || true
    pkill -f -- '^wlvncc -a headless-ws' || true
    on_host '${host}' unserve all >/dev/null 2>&1 || true
    ssh -q -S '${control}' -O exit '${host}' >/dev/null 2>&1 || true" EXIT

  echo "headless: connecting with ${viewer}"
  if [[ "${viewer}" == "remote-viewer" ]]; then
    echo "headless: shift+f11 leaves fullscreen — the remote grabs the keyboard," \
         "so local shortcuts do not work until you do"
  fi
  run_viewer "${viewer}"
}

# --- Bound workspaces ---
# A host workspace that has an output of its own (another tool's HEADLESS-*,
# made to keep its windows rendering) can be bound: it gets its own wayvnc and
# its own viewer here, full screen on the same workspace number. The desktop
# viewer keeps showing the desktop. `headless bind` picks them; the choice is
# kept per host in BOUND_DIR, and `connect` opens them again.

# Run on the host: one line per workspace that can be bound, as
# "<ws>\t<output>\t<label>". A workspace on this script's own output shares
# it with the desktop, so it cannot have a view of its own. The label is the
# first window's sway mark, after its last colon ("<tool>:<name>"), else its
# title: the owning tool can name its windows.
headless_bindable() {
  ensure_swaysock
  swaymsg -t get_tree -r | python3 -c '
import json, sys
tree, own, prefix = json.load(sys.stdin), sys.argv[1], sys.argv[2]
visible = {o["name"]: o.get("current_workspace")
           for o in json.loads(sys.argv[3]) if o.get("active")}

def label(node):
    if node.get("pid"):
        marks = node.get("marks") or []
        if marks:
            return marks[0].rsplit(":", 1)[-1]
        if node.get("name"):
            return node["name"]
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = label(child)
        if found:
            return found
    return ""

for out in tree["nodes"]:
    name = out["name"]
    if not name.startswith(prefix) or name == own:
        continue
    for ws in out.get("nodes", []):
        if ws["name"] != visible.get(name) or not ws["name"].isdigit():
            continue
        text = label(ws)
        if len(text) > 40:
            text = text[:39] + "…"
        print(ws["name"] + "\t" + name + "\t" + text)
' "$(current_headless_output)" "${HEADLESS_PREFIX}" "$(swaymsg -t get_outputs -r)"
}

# The port is VNC_PORT + N, so a workspace number has to stay small.
valid_ws() {
  [[ "${1:-}" =~ ^[1-9][0-9]?$ ]] || die "not a workspace number from 1 to 99: ${1:-}"
}

# The output a wayvnc instance serves, from its control socket.
served_output() {
  wayvncctl -S "$1" output-list 2>/dev/null | sed -n 's/^\* \([^:]*\):.*/\1/p'
}

# Run on the host: serve workspace $1's output on its own port, and print the
# port. The output is left as it is (no mode, scale or unplug): it belongs to
# another tool. An instance still on an output the workspace has left (the
# tool recreated it) is replaced.
headless_serve() {
  local ws="${1:-}"
  valid_ws "${ws}"
  ensure_swaysock
  is_active || die "headless mode is off"
  local output
  output="$(headless_bindable | awk -F'\t' -v ws="${ws}" '$1 == ws { print $2; exit }')"
  [[ -n "${output}" ]] || die "workspace ${ws} has no output of its own"

  local unit="${UNIT}-ws${ws}"
  local socket="${RUNTIME_DIR}/wayvncctl-ws${ws}"
  local port=$((VNC_PORT + ws))
  if systemctl --user is-active --quiet "${unit}"; then
    if [[ "$(served_output "${socket}")" == "${output}" ]]; then
      echo "${port}"
      return 0
    fi
    systemctl --user stop "${unit}"
  fi
  systemctl --user reset-failed "${unit}" 2>/dev/null || true

  # The same flags as the desktop's instance: see headless_on.
  systemd-run --user --quiet --collect --unit="${unit}" \
    --description="wayvnc serving ${output} (headless, bound workspace ${ws})" \
    wayvnc --output="${output}" --socket="${socket}" --render-cursor \
    --disable-resizing --gpu --max-fps="${HEADLESS_FPS}" "${VNC_ADDR}" "${port}"

  local _
  for _ in $(seq 50); do
    [[ "$(served_output "${socket}")" == "${output}" ]] && { echo "${port}"; return 0; }
    sleep 0.1
  done
  die "wayvnc did not start on ${output}"
}

# Run on the host: stop serving workspace $1, or every bound one with "all".
# wayvnc leaves its control socket behind when stopped, so it goes too.
headless_unserve() {
  local ws="${1:-}"
  if [[ "${ws}" == "all" ]]; then
    systemctl --user stop "${UNIT}-ws*.service" 2>/dev/null || true
    rm -f "${RUNTIME_DIR}"/wayvncctl-ws*
    return 0
  fi
  valid_ws "${ws}"
  systemctl --user stop "${UNIT}-ws${ws}.service" 2>/dev/null || true
  rm -f "${RUNTIME_DIR}/wayvncctl-ws${ws}"
}

# Runs this copy of the script on the host, so the host-side commands never
# depend on the version the host has installed.
on_host() {
  local host="$1"
  shift
  # SC2029: the arguments are meant to expand here; they are checked words.
  # shellcheck disable=SC2029
  ssh "${host}" "bash -s -- $*" <"${BASH_SOURCE[0]}"
}

tunnel_socket() {
  echo "${RUNTIME_DIR}/headless-tunnel-$1.sock"
}

# The host whose tunnel is open, if exactly one is.
connected_host() {
  local control host found=()
  for control in "${RUNTIME_DIR}"/headless-tunnel-*.sock; do
    [[ -S "${control}" ]] || continue
    host="${control##*/headless-tunnel-}"
    host="${host%.sock}"
    if ssh -q -S "${control}" -O check "${host}" 2>/dev/null; then
      found+=("${host}")
    fi
  done
  [[ ${#found[@]} -eq 1 ]] && echo "${found[0]}"
}

BOUND_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/headless"

bound_file() {
  echo "${BOUND_DIR}/bound-$1"
}

is_bound() {
  grep -qxF "$2" "$(bound_file "$1")" 2>/dev/null
}

set_bound() {
  local file
  file="$(bound_file "$1")"
  mkdir -p "${BOUND_DIR}"
  {
    grep -vxF "$2" "${file}" 2>/dev/null || true
    if [[ "$3" == "on" ]]; then
      echo "$2"
    fi
  } | sort -n >"${file}.tmp"
  mv "${file}.tmp" "${file}"
}

viewer_running() {
  pgrep -f -- "^wlvncc -a headless-ws$1 " >/dev/null
}

# Waits for the viewer to exit, so its window is gone before a new one with
# the same app_id is looked for.
stop_bound_viewer() {
  pkill -f -- "^wlvncc -a headless-ws$1 " || return 0
  local _
  for _ in $(seq 50); do
    viewer_running "$1" || return 0
    sleep 0.1
  done
}

# Opens the viewer of bound workspace $1, full screen on the same workspace
# number here.
show_bound_viewer() {
  local ws="$1"
  # No -i: $mod+N stays on this machine, so the workspace keys always switch
  # away from a bound view.
  setsid -f wlvncc -a "headless-ws${ws}" "${VNC_ADDR}" "$((VNC_PORT + ws))" >/dev/null 2>&1

  local _ criteria="[app_id=\"^headless-ws${ws}\$\"]"
  for _ in $(seq 100); do
    if swaymsg -t get_tree | grep -qF "\"app_id\": \"headless-ws${ws}\""; then
      swaymsg -q "${criteria} move container to workspace number ${ws}, fullscreen enable"
      return 0
    fi
    sleep 0.1
  done
  echo "headless: the viewer of workspace ${ws} did not open" >&2
  return 1
}

# Connect on view: a bound workspace's viewer runs only while that workspace
# is visible here. A hidden viewer still receives and decodes the whole
# stream (measured: ~55 Mbit/s and ~8% of a core for each busy 60 fps stream), while an
# idle wayvnc with no client costs nothing. Showing one again takes the
# viewer's connect time (~0.2-0.35 s).
sync_bound_viewers() {
  local host="$1" visible ws
  visible="$(swaymsg -t get_workspaces -r | python3 -c '
import json, sys
for workspace in json.load(sys.stdin):
    if workspace.get("visible"):
        print(workspace["name"])
')"
  [[ -s "$(bound_file "${host}")" ]] || return 0
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    if grep -qxF "${ws}" <<<"${visible}"; then
      viewer_running "${ws}" || show_bound_viewer "${ws}" || true
    elif viewer_running "${ws}"; then
      stop_bound_viewer "${ws}"
    fi
  done <"$(bound_file "${host}")"
}

# Run by `connect` in the background: syncs on every workspace change here.
watch_bound_viewers() {
  local host="$1" _
  sync_bound_viewers "${host}"
  while read -r _; do
    sync_bound_viewers "${host}"
  done < <(swaymsg -t subscribe -m '["workspace"]')
}

# Binds workspace $2 of $1: wayvnc there and a forward through the open
# tunnel. The viewer follows from sync_bound_viewers.
serve_bound() {
  local host="$1" ws="$2" control port
  control="$(tunnel_socket "${host}")"
  port="$(on_host "${host}" serve "${ws}")" || return 1
  ssh -q -S "${control}" -O cancel -L "${port}:${VNC_ADDR}:${port}" "${host}" 2>/dev/null || true
  ssh -q -S "${control}" -O forward -L "${port}:${VNC_ADDR}:${port}" "${host}" \
    || { echo "headless: could not forward port ${port}" >&2; return 1; }
}

close_bound() {
  local host="$1" ws="$2" port=$((VNC_PORT + $2))
  stop_bound_viewer "${ws}"
  ssh -q -S "$(tunnel_socket "${host}")" -O cancel -L "${port}:${VNC_ADDR}:${port}" "${host}" 2>/dev/null || true
  on_host "${host}" unserve "${ws}" || true
}

# Called by `connect`: serves every bound workspace the host still has.
restore_bound() {
  local host="$1" bindable ws
  [[ -s "$(bound_file "${host}")" ]] || return 0
  bindable="$(on_host "${host}" bindable)" || return 0
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    if awk -F'\t' -v ws="${ws}" '$1 == ws { found = 1 } END { exit !found }' <<<"${bindable}"; then
      serve_bound "${host}" "${ws}" || true
    else
      echo "headless: workspace ${ws} is bound but has no output of its own on ${host}; skipped"
    fi
  done <"$(bound_file "${host}")"
}

# Run from the remote machine, usually by a key binding with no terminal, so
# failures also go out as notifications. Lists the whole session first, then
# the host's bindable workspaces. Picking a workspace binds or unbinds it and
# opens the menu again with the new marks, until Esc; picking the session
# closes the menu and brings its viewer to the front.
headless_bind() {
  local host="${1:-}"
  host="${host:-$(connected_host || true)}"
  if [[ -z "${host}" ]] || ! ssh -q -S "$(tunnel_socket "${host}")" -O check "${host}" 2>/dev/null; then
    notify "Headless" "No viewer open: run headless connect <host> first"
    die "bind needs an open viewer: run headless connect <host> first"
  fi
  command -v launcher >/dev/null 2>&1 || die "launcher (gtk-widgets) is not installed"
  command -v wlvncc >/dev/null 2>&1 || die "bound workspaces need wlvncc"

  # Listed once: binding changes the marks, not which workspaces there are.
  local bindable
  if ! bindable="$(on_host "${host}" bindable)"; then
    notify "Headless" "Could not list the workspaces of ${host}"
    die "could not list the workspaces of ${host}"
  fi

  local choice ws
  while choice="$(bind_rows "${host}" "${bindable}" \
    | launcher --dmenu --prompt "bind · ${host}" --after-tab)"; do
    ws="${choice%%$'\t'*}"
    if [[ "${ws}" == "desktop" ]]; then
      swaymsg -q '[app_id="^wlvncc$"] focus' || true
      return 0
    fi
    valid_ws "${ws}"
    if is_bound "${host}" "${ws}"; then
      close_bound "${host}" "${ws}"
      set_bound "${host}" "${ws}" off
    elif serve_bound "${host}" "${ws}"; then
      set_bound "${host}" "${ws}" on
      sync_bound_viewers "${host}"
    else
      notify "Headless" "Could not bind workspace ${ws} of ${host}"
    fi
  done
}

# The rows of the bind menu, as "<key>\t<text>": the session, the bindable
# workspaces with ● on the bound ones, and bound ones without an output of
# their own now, so they can be unbound.
bind_rows() {
  local host="$1" bindable="$2" ws output label mark
  printf 'desktop\t   desktop · the whole session\n'
  while IFS=$'\t' read -r ws output label; do
    [[ -n "${ws}" ]] || continue
    mark="   "
    is_bound "${host}" "${ws}" && mark="● "
    printf '%s\t%sws %s%s   (%s)\n' "${ws}" "${mark}" "${ws}" "${label:+ · ${label}}" "${output}"
  done <<<"${bindable}"
  while read -r ws; do
    [[ -n "${ws}" ]] || continue
    awk -F'\t' -v ws="${ws}" '$1 == ws { found = 1 } END { exit !found }' <<<"${bindable}" && continue
    printf '%s\t● ws %s · no output of its own now\n' "${ws}" "${ws}"
  done < <(cat "$(bound_file "${host}")" 2>/dev/null)
}

# waypipe needs no headless output, no VNC and no running compositor on the
# far side — only sshd. This is the path that still works after a reboot.
headless_app() {
  local host="${1:-}"
  shift || true
  [[ -n "${host}" && $# -gt 0 ]] || die "app needs a host and a command (e.g. headless app desktop nvim)"
  command -v waypipe >/dev/null 2>&1 || die "waypipe is not installed"

  waypipe ssh "${host}" "$@"
}

main() {
  case "${1:-status}" in
    on) headless_on ;;
    off) headless_off ;;
    status) headless_status ;;
    toggle)
      if is_active; then headless_off; else headless_on; fi
      ;;
    connect)
      shift
      headless_connect "$@"
      ;;
    bind)
      shift
      headless_bind "$@"
      ;;
    # Run on the host by the commands above, through on_host.
    bindable) headless_bindable ;;
    serve)
      shift
      headless_serve "$@"
      ;;
    unserve)
      shift
      headless_unserve "$@"
      ;;
    app)
      shift
      headless_app "$@"
      ;;
    dpms)
      shift
      headless_dpms "$@"
      ;;
    -h | --help | help) usage ;;
    *)
      echo "headless: unknown command '${1}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
