# ~/.zshrc-workstation — Workstation-only zsh configuration
# Sourced from .zshrc on workstation profile only. Do not edit directly.

# --- Workstation aliases ---
alias lg='lazygit'

# --- yazi — cd into directory on exit ---
y() {
  local tmp
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd" || return
  fi
  rm -f -- "$tmp"
}

# --- Cheatsheets — focus existing window or launch in chromium app mode ---
_cheat() {
  local name="$1" title="$2"
  # Repo root via the ~/.zshrc-workstation symlink (→ <dotfiles>/workstation/zsh/…)
  local dotfiles_dir
  dotfiles_dir="$(readlink -f "$HOME/.zshrc-workstation")"
  dotfiles_dir="${dotfiles_dir%/workstation/zsh/*}"
  if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_tree 2>/dev/null \
      | grep -q "\"name\": \"$title\""; then
    swaymsg "[title=\"$title\"] focus" >/dev/null
  else
    nohup chromium \
      --app="file://${dotfiles_dir}/workstation/cheatsheets/$name/index.html" \
      --user-data-dir="${XDG_RUNTIME_DIR:-/tmp}/chromium-cheat-$name" \
      --no-first-run --no-default-browser-check \
      >/dev/null 2>&1 &
    disown
  fi
}
alias cheat='_cheat tools "Tools cheatsheet"'

# --- Pick a Chromium-family browser ---
# Prefers real Google Chrome when installed, then falls back to Chromium.
# Echoes the binary name; returns non-zero if none is found. Both accept the
# same `--app=` flag, so callers just substitute the resolved name.
_chrome_bin() {
  local b
  for b in google-chrome-stable google-chrome chromium chromium-browser; do
    if command -v "$b" >/dev/null 2>&1; then
      echo "$b"
      return 0
    fi
  done
  return 1
}

# --- Percent-encode a filesystem path for a file:// URI ---
# Iterates byte-by-byte (LC_ALL=C) so multi-byte UTF-8 (e.g. Cyrillic
# filenames) and reserved chars (space, #, ?) are encoded as %XX. Chrome will
# not open a raw file:// URI with unencoded UTF-8 or spaces, so this is
# required for non-ASCII filenames. `/` is left literal to keep path segments.
_uri_encode_path() {
  local s="$1" out="" i c
  local LC_ALL=C
  for (( i=0; i<${#s}; i++ )); do
    c="${s:$i:1}"
    case "$c" in
      [a-zA-Z0-9/._~-]) out+="$c" ;;
      *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

# --- Open a PDF in the browser ---
# Usage: `pdf <file.pdf>` opens that file; `pdf` with no arg fuzzy-picks one.
# The no-arg picker lists PDFs under the current dir FIRST, then the rest of
# $HOME (deduped); `--tiebreak=index` keeps that order so local PDFs sort on
# top until you type a query. Opens in browser app mode (clean window),
# preferring Chrome over Chromium.
pdf() {
  local file="$1"
  if [[ -z "$file" ]]; then
    file="$({ fd -e pdf --type f . "$PWD" 2>/dev/null; \
              fd -e pdf --type f . "$HOME" 2>/dev/null; } \
      | awk '!seen[$0]++' \
      | fzf --prompt='Open PDF: ' --height=40% --reverse --tiebreak=index)" || return
  fi
  [[ -n "$file" ]] || return
  if [[ ! -f "$file" ]]; then
    echo "pdf: no such file: $file" >&2
    return 1
  fi
  local browser
  browser="$(_chrome_bin)" || {
    echo "pdf: no chrome/chromium browser found" >&2
    return 1
  }
  # Resolve to an absolute path and a proper file:// URI.
  local abs uri
  abs="$(readlink -f -- "$file")"
  uri="file://$(_uri_encode_path "$abs")"
  nohup "$browser" \
    --app="$uri" \
    --no-first-run --no-default-browser-check \
    >/dev/null 2>&1 &
  disown
}

# --- Open a Word document in LibreOffice ---
# Usage: `doc <file>` opens it in LibreOffice Writer; `doc` with no arg
# fuzzy-picks a .doc/.docx under the current dir first, then the rest of $HOME
# (deduped, $PWD-prioritized via --tiebreak=index). Handles both .doc and
# .docx. Browsers can't render Word docs, so this routes to LibreOffice (the
# registered default), detached.
doc() {
  local file="$1"
  if [[ -z "$file" ]]; then
    file="$({ fd -e doc -e docx --type f . "$PWD" 2>/dev/null; \
              fd -e doc -e docx --type f . "$HOME" 2>/dev/null; } \
      | awk '!seen[$0]++' \
      | fzf --prompt='Open DOC: ' --height=40% --reverse --tiebreak=index)" || return
  fi
  [[ -n "$file" ]] || return
  if [[ ! -f "$file" ]]; then
    echo "doc: no such file: $file" >&2
    return 1
  fi
  nohup libreoffice "$file" >/dev/null 2>&1 &
  disown
}

# --- Auto-start Sway on tty1 ---
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = "1" ]; then
  export ELECTRON_OZONE_PLATFORM_HINT=wayland
  exec sway
fi
