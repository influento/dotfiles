# ~/.zshrc-workstation — Workstation-only zsh configuration
# Sourced from .zshrc on workstation profile only. Do not edit directly.

# --- Workstation aliases ---
alias lg='lazygit'

# --- yazi — cd into directory on exit ---
y() {
  local tmp
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd" || return
  fi
  rm -f -- "$tmp"
}

# --- Cheatsheets — focus existing window or launch in chromium app mode ---
_cheat() {
  local name="$1" title="$2"
  # Repo root via the ~/.zshrc-workstation symlink (→ <dotfiles>/workstation/zsh/…)
  local dotfiles_dir
  dotfiles_dir="$(readlink -f "$HOME/.zshrc-workstation")"
  dotfiles_dir="${dotfiles_dir%/workstation/zsh/*}"
  if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_tree 2>/dev/null \
      | grep -q "\"name\": \"$title\""; then
    swaymsg "[title=\"$title\"] focus" >/dev/null
  else
    nohup chromium \
      --app="file://${dotfiles_dir}/workstation/cheatsheets/$name/index.html" \
      --user-data-dir="${XDG_RUNTIME_DIR:-/tmp}/chromium-cheat-$name" \
      --no-first-run --no-default-browser-check \
      >/dev/null 2>&1 &
    disown
  fi
}
alias cheat='_cheat tools "Tools cheatsheet"'

# --- Open a PDF in the browser ---
# Usage: `pdf <file.pdf>` opens that file; `pdf` with no arg fuzzy-picks one
# under $HOME via fd+fzf. Opens in chromium app mode (clean window), detached.
pdf() {
  local file="$1"
  if [[ -z "$file" ]]; then
    file="$(fd -e pdf --type f . "$HOME" 2>/dev/null \
      | fzf --prompt='Open PDF: ' --height=40% --reverse)" || return
  fi
  [[ -n "$file" ]] || return
  if [[ ! -f "$file" ]]; then
    echo "pdf: no such file: $file" >&2
    return 1
  fi
  # Resolve to an absolute path and a proper file:// URI.
  local abs uri
  abs="$(readlink -f -- "$file")"
  uri="file://$abs"
  nohup chromium \
    --app="$uri" \
    --no-first-run --no-default-browser-check \
    >/dev/null 2>&1 &
  disown
}

# --- Auto-start Sway on tty1 ---
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = "1" ]; then
  export ELECTRON_OZONE_PLATFORM_HINT=wayland
  exec sway
fi
