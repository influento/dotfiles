# swayidle — Idle management daemon for Sway
#
# Timeline:
#   15 min → lock screen (swaylock)
#   30 min → turn off displays
#   60 min → suspend, then hibernate after HibernateDelaySec
#
# HibernateDelaySec is a system-level setting: arch-install
# modules/hibernate.sh sets 15 min on laptops and 1h on desktops. Suspend
# alone drains a laptop battery flat in a few days and loses a desktop's
# session in a power cut; hibernate keeps the session on disk.
#
# Display is turned back on when activity resumes (resume event).
# Lock is triggered before sleep to ensure screen is locked on wake.
#
# `nosleep awake` skips the lock and display-off: their commands check for its
# unit. Its sleep inhibitor already makes the 60 min suspend a no-op.
#
# Display power goes through `headless dpms` rather than `output * power off`:
# the wildcard would also power off the virtual output used by headless mode,
# and wlroots stops compositing a powered-off output, which freezes the VNC
# stream with no way to wake it from the remote side.

timeout 900 'systemctl --user is-active -q nosleep-awake || ~/.local/bin/lock'
timeout 1800 'systemctl --user is-active -q nosleep-awake || ~/.local/bin/headless dpms off' resume '~/.local/bin/headless dpms on'
timeout 3600 'systemctl suspend-then-hibernate'
before-sleep '~/.local/bin/lock'
lock '~/.local/bin/lock'
