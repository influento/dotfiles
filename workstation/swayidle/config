# swayidle — Idle management daemon for Sway
#
# Timeline:
#   15 min → lock screen (swaylock)
#   30 min → turn off displays
#   60 min → suspend
#
# Display is turned back on when activity resumes (resume event).
# Lock is triggered before sleep to ensure screen is locked on wake.

timeout 900 '~/.local/bin/lock'
timeout 1800 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
timeout 3600 'systemctl suspend'
before-sleep '~/.local/bin/lock'
lock '~/.local/bin/lock'
