#!/usr/bin/env bash
set -euo pipefail

# workbench — item lifecycle for tracked project work.
#
# IDs come from a counter in the shared git directory, so every worktree draws
# from one sequence and numbers can never collide or repeat.

WB=workbench
# Never pipe into a reader that stops early — 'grep -q', 'grep -m', 'head'.
# 'set -o pipefail' is on, and such a reader closes the pipe the moment it has
# what it needs; if the writer is still sending (anything past a few KB) it
# takes SIGPIPE, the pipeline reports 141, and the test reads as the OPPOSITE
# of what the data says — intermittently, since it is a race. Capture into a
# variable and read a herestring, or use a reader that consumes all of its input.
# The project-scoped commands, one thin skill each under commands/.
# Rendered as committed copies by init, so the list
# lives here. No /rename — a rename is a feature item; why the set is small
# is in the skill's rationale.md, "Why the commands are thin".
WB_COMMANDS="bug feature idea wb"
# The agent definitions, one .md each under agents/. Named here rather than
# globbed for the reason agent_sources() gives.
WB_AGENTS="wb-worker wb-reviewer wb-gate"
MARK_START='<!-- workbench:start -->'
MARK_END='<!-- workbench:end -->'
# One obvious sentence, one question: the caps that keep BACKLOG.md and
# DECISIONS.md from becoming the place long prose goes when nobody is reading.
IDEA_MAX=200
CALL_MAX=300
# Pre-merge rounds before the worker stops and asks.
REVIEW_HOLDS=3
# Line caps on the documents every session reads: root CLAUDE.md and the
# three under workbench/. Over one, 'status' names it and the docs review
# that cuts it. 'git config workbench.cap.<claude|glossary|backlog|decisions>'
# overrides, for a project whose document is legitimately larger.
CAP_CLAUDE=150
CAP_GLOSSARY=300
CAP_BACKLOG=400
CAP_DECISIONS=200

usage() {
  # Help asked for goes to stdout; help printed because a call was wrong is
  # an error and goes with the other errors.
  [ "${1:-2}" -eq 0 ] || exec >&2
  cat <<'EOF'
usage:
  workbench init [--force]             scaffold workbench/, render the skills as committed copies
                                       (--force overwrites a copy edited by hand)
  workbench adopt                      init, then survey an existing project
  workbench new <bug|feature> "<title>" allocate an id, write the file, commit it on the default branch
  workbench idea "<sentence>"          one backlog line, on the main checkout wherever it runs
  workbench call <id|-> "<question>"   one line under the item's '## Decisions' (DECISIONS.md for -):
                                       a call that is the user's, parked
  workbench find [<path>...] [--grep <word>]... [--all]
                                       items that touched these paths, newest first
  workbench start <id>                 commit the item as it stands, create its branch and worktree
  workbench round <id> <fixed> <stands>  record a review-dialog round; says whether another follows
  workbench effects <id>               existing exports and routes the branch changed, against
                                       the item's '## Side effects'; non-zero while one is unnamed
  workbench merge <id> "<subject>"     squash onto the default branch, drop the worktree and branch;
                                       needs evidence or a trigger status; runs 'git config
                                       workbench.premerge' in the worktree first, refusing on non-zero
                                       (workbench.guards: regex of steps start refuses as guards)
  workbench archive <id> [--discard]   move to archive, recording the merge commit;
                                       --discard drops what an abandoned branch carries
  workbench status                     in flight, duplicate ids, reports, documents over their line caps
  workbench review-check <report>      prove a sweep changed nothing tracked; a pre-merge's hold is counted
  workbench review-drop [--force] <report>  delete a report, its baseline and scratch
  workbench review <reason> [scope]    open a report; run by the sweep skill, not by hand

  reasons: pre-merge, docs
  state lives under workbench/
EOF
  exit "${1:-2}"
}

die() {
  echo "workbench: $1" >&2
  exit 1
}

# Memoized, as is main_root: the hooks call both several times per tool
# call, and a process never changes repository.
GIT_COMMON_DIR=""
git_common_dir() {
  if [ -z "$GIT_COMMON_DIR" ]; then
    local d
    d=$(git rev-parse --git-common-dir) || die "not inside a git repository"
    # --git-common-dir may be relative to the current directory
    GIT_COMMON_DIR=$(cd "$d" && pwd -P)
  fi
  printf '%s\n' "$GIT_COMMON_DIR"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# The main worktree, where the committed state lives: git lists it first,
# always. Not the parent of the common dir — that is no checkout at all for a
# bare repository, and it followed the logical path where repo_root gives the
# physical one, so a checkout reached through a symlink counted as two.
MAIN_ROOT=""
main_root() {
  [ -n "$MAIN_ROOT" ] || MAIN_ROOT=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  printf '%s\n' "$MAIN_ROOT"
}

# Both checkouts that may hold items: the main one, which holds every item
# from 'new' onward, and the current one, whose branch carries the copy an
# item is edited in — or an item written by hand and not yet landed.
wb_roots() {
  local cur main
  cur=$(repo_root)
  main=$(main_root)
  printf '%s\n' "$cur"
  [ "$main" != "$cur" ] && printf '%s\n' "$main"
  return 0
}

# $WB/<sub> in each checkout read from stdin, existing ones only. Any lookup
# over 'git worktree list' meets checkouts without it: a worktree branched
# before adoption, a detached one, one removed by hand and not yet pruned.
# find exits non-zero on a missing start path — even when -quit ended it on a
# hit — and under set -e that kills the caller without a word.
wb_dirs() {
  local sub="$1" r
  while IFS= read -r r; do
    [ -n "$r" ] && [ -d "$r/$WB/$sub" ] && printf '%s\n' "$r/$WB/$sub"
  done
  return 0
}

# find over wb_dirs, in the order the checkouts were given. No checkout has
# the directory → nothing, rc 0; a bare find would search the working
# directory instead.
wb_find() {
  local sub="$1" dirs=()
  shift
  mapfile -t dirs < <(wb_dirs "$sub")
  [ "${#dirs[@]}" -gt 0 ] || return 0
  find "${dirs[@]}" "$@" 2>/dev/null || true
}

# Everything the tool renders lives under one root: skills/ holds the two
# skills, named as they render; agents/ and commands/ are consumed by init,
# and this script sits in bin/. Nothing reaches outside that tree. Resolving
# from $0 keeps the path out of the script, so a moved checkout still works.
wb_root() {
  local self
  # $0 is a bare name when found on PATH, so resolve it before following links
  self=$(command -v -- "$0") || die "cannot locate the workbench script"
  self=$(readlink -f "$self")
  printf '%s\n' "${WORKBENCH_ROOT:-$(dirname "$self")/..}"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\+/-/g' \
    | cut -c1-50 \
    | sed -e 's/^-//' -e 's/-$//'
}

# A path as it appears in prose: bounded on both sides by something that
# cannot extend a path, a sentence-ending period allowed, so 'src' matches
# 'src/main.go', '`src`', 'src:12' and 'in src.' but not 'srcset', 'src.go'
# or 'resources'. Metacharacters in the path are literal.
path_re() {
  local p="${1%/}"
  p=$(printf '%s' "$p" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
  printf '(^|[^A-Za-z0-9_./-])%s(/|\\.?([^A-Za-z0-9_./-]|$))' "$p"
}

# An id is exactly <letter>-<number>, printed back with the number as the
# allocator writes it — three digits, more once past 999 — so 'b-1', 'b-01'
# and 'b-0001' all name b-001. Everything that resolves one globs on "$id-*",
# so a bare letter would match every item of that class and act on whichever
# one find happened to return first.
require_id() {
  [[ "$1" =~ ^([bf])-([0-9]+)$ ]] || die "'$1' is not an item id; ids look like b-038"
  printf '%s-%03d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))"
}

# A worktree branched before adoption has no $WB/ in its own checkout, yet may
# still create items. Adoption is a property of the repository, so any checkout
# carrying $WB/ satisfies it.
require_init() {
  local root
  while IFS= read -r root; do
    [ -d "$root/$WB" ] && return 0
  done < <(wb_roots)
  die "no $WB/ in this repository; run 'workbench init' first"
}

# Highest number already present, so a missing counter can be rebuilt from the
# repository itself rather than restarting at 1 and colliding with history.
# Over every checkout: an item that only exists in a sibling worktree has a
# number too.
highest_existing() {
  local max=0 n
  while IFS= read -r f; do
    n=$(basename "$f" | sed -n 's/^[bf]-\([0-9]\{1,\}\)-.*/\1/p')
    [ -n "$n" ] || continue
    n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done < <(wb_find items -name '[bf]-*.md' < <(all_roots))
  echo "$max"
}

next_id() {
  local seq_file lock_dir current
  seq_file="$(git_common_dir)/item-seq"
  lock_dir="$(git_common_dir)/item-seq.lock"

  # mkdir is atomic on POSIX filesystems, so this works without flock
  local waited=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 100 ] && die "could not acquire $lock_dir; if no 'workbench new' is running, it is stale — rmdir it and retry"
    sleep 0.05
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

  # The counter is a cache; the repository is the source of truth. A counter
  # left behind on this machine goes stale the moment items allocated on
  # another one are pulled in, so never allocate below what the tree holds.
  local seen
  seen=$(highest_existing)
  current=0
  [ -f "$seq_file" ] && current=$(cat "$seq_file")
  # A garbled counter is rebuilt from the tree, not tripped over.
  [[ "$current" =~ ^[0-9]+$ ]] || current=0
  [ "$seen" -gt "$current" ] && current=$seen
  current=$((current + 1))
  printf '%s\n' "$current" > "$seq_file"

  rmdir "$lock_dir"
  trap - EXIT
  printf '%03d\n' "$current"
}

# --- init -------------------------------------------------------------------

write_glossary() {
  cat > "$1" <<'EOF'
# Glossary

<!-- Domain language only: words this project uses in a narrower or different
     sense than they are used generally. Never well-known concepts.

     One entry per concept, never the same concept twice. Brief — a definition,
     not an explanation. Nothing that would have to change when the
     implementation changes; that is a spec, and it belongs elsewhere.

     A term is renamed in one commit, glossary entry and code together; that
     commit is its own item. Aliases are written as (was: old-term), and only
     once the old word survives in an archived item or a merged commit.

     A word rejected at coinage gets a row under a "Use, never" table
     (| Use | Never | Because |), in the same commit as the item that first
     used the chosen word, so the next session does not reach for it. -->
EOF
}

write_backlog() {
  cat > "$1" <<'EOF'
# Backlog

<!-- One line per idea. No id, no file, no thinking spent yet. Promoting a line
     to an item is where the thinking happens; delete the line when it goes. -->
EOF
}

write_decisions() {
  cat > "$1" <<'EOF'
# Decisions

<!-- One line per call that is the user's, was parked because they were not
     there, and belongs to no item: 'workbench call - "<question>"'. A call
     on an item goes under that item's '## Decisions' instead. The user
     answers by deciding, then deletes the line. Nothing here is a status
     report. -->
EOF
}

ensure_gitignore() {
  local root gi
  root=$(repo_root)
  gi="$root/.gitignore"
  # Skills are rendered copies, committed so every checkout and clone has
  # them; nothing here ignores them. settings.local.json is left ignored:
  # that file is per-user by Claude Code's own definition.
  local entry='.worktrees/'
  grep -qxF "$entry" "$gi" 2>/dev/null && return 0
  # A last line missing its newline would otherwise absorb the entry.
  [ ! -s "$gi" ] || [ -z "$(tail -c1 "$gi")" ] || echo >> "$gi"
  printf '%s\n' "$entry" >> "$gi"
  echo "  .gitignore += $entry"
}

# The skill sources, in the dotfiles tree beside this script: the workflow
# itself; the sweep, a separate skill so it can be forked fresh; and
# one thin user-only skill per command, so '/bug <title>' is a thing to type.
# The source directories, one per line. Each is named exactly as the skill it
# renders to — the directory name is the name Claude Code loads — so nothing
# here maps one to the other, and a renamed directory is a renamed skill.
skill_sources() {
  local base name
  base=$(readlink -f "$(wb_root)") || true
  [ -n "$base" ] && [ -d "$base" ] || die "workbench source not found at $(wb_root)"
  printf '%s\n' "$base/skills/workbench" "$base/skills/workbench-review"
  for name in $WB_COMMANDS; do printf '%s\n' "$base/commands/$name"; done
}

# What a rendered copy records about where it came from: the source hash on
# line 1, the copy's own hash on line 2. Content-addressed, so no version is
# bumped by hand; a changed source shows as stale, a changed copy as edited.
# Each file's relative path goes into the hash ahead of its content, so a
# rename or a move of text between files changes it too; the order is fixed
# under LC_ALL=C because the locale's collation would otherwise put the same
# tree in a different order on another machine. Symlinks are refused rather
# than hashed: a copy of one is a machine-local path.
STAMP=GENERATED
skill_hash() {
  local f
  f=$(find "$1" -type l -print -quit)
  [ -z "$f" ] || die "$f is a symlink; skill sources hold files only"
  {
    find "$1" -type f ! -path '*/__pycache__/*' ! -name "$STAMP" -printf '%P\0' \
      | LC_ALL=C sort -z \
      | while IFS= read -r -d '' f; do printf '%s\0' "$f"; cat "$1/$f"; done
  } | sha256sum | cut -c1-12
}

# current | stale | edited | missing — for the copy of <name> under <root>.
# A copy whose content no longer matches its own stamp was edited by hand,
# and init refuses to overwrite it without --force. The regex on the copy
# hash is why a stamp not carrying one reads as stale — re-rendered — rather
# than as edited, which init would refuse. Not only the older two-line format
# it was written for: any garbled second line lands there too, and
# re-rendering beats refusing every init until someone passes --force.
skill_state() {
  local root="$1" src="$2" dst src_hash copy_hash
  dst="$root/.claude/skills/$(basename "$src")"
  [ -f "$dst/$STAMP" ] || { echo missing; return; }
  src_hash=$(sed -n 1p "$dst/$STAMP")
  copy_hash=$(sed -n 2p "$dst/$STAMP")
  if [[ "$copy_hash" =~ ^[0-9a-f]{12}$ ]] && [ "$(skill_hash "$dst")" != "$copy_hash" ]; then
    echo edited
  elif [ "$src_hash" != "$(skill_hash "$src")" ]; then
    echo stale
  else
    echo current
  fi
}

# Copies, not links, and committed: a link is one machine's path and lives
# only in the checkout it was made in, so a worktree session or another
# clone had none of this. A copy is refreshed by re-running init, and
# 'status' says when one has fallen behind its source.
render_skills() {
  local force="${1:-0}" root src srcdir dst name hash state wanted=" "
  root=$(repo_root)
  srcdir=$(readlink -f "$(wb_root)")
  mkdir -p "$root/.claude/skills"

  while IFS= read -r src; do
    [ -d "$src" ] || die "skill source not found at $src"
    name=$(basename "$src")
    wanted="$wanted$name "
    dst="$root/.claude/skills/$name"
    hash=$(skill_hash "$src")
    state=

    if [ -L "$dst" ]; then
      rm "$dst"
      echo "  .claude/skills/$name: link replaced by a copy"
    elif [ -d "$dst" ]; then
      if [ ! -f "$dst/$STAMP" ]; then
        die "$dst exists and was not generated by workbench; move it away and re-run"
      fi
      state=$(skill_state "$root" "$src")
      if [ "$state" = edited ] && [ "$force" != 1 ]; then
        die "$dst was edited by hand since it was rendered; move the edit into the source, or 'workbench init --force' to overwrite it"
      fi
      [ "$state" != current ] || continue
      rm -rf "$dst"
    elif [ -e "$dst" ]; then
      die "$dst exists and is not a directory"
    fi

    cp -RL "$src" "$dst"
    find "$dst" -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
    printf '%s\n%s\n%s\n' "$hash" "$(skill_hash "$dst")" \
      "generated by 'workbench init' from workbench/${src#"$srcdir"/}; edit the source and re-run, never this copy" > "$dst/$STAMP"
    if [ "$state" = edited ]; then echo "  rendered .claude/skills/$name (the hand edit is gone)"; else echo "  rendered .claude/skills/$name"; fi
  done < <(skill_sources)

  # A copy this tool generated for a skill that no longer exists in the
  # source. Guarded by the stamp's own wording, not the file's presence, so
  # a foreign skill carrying a GENERATED file is left alone — and an edited
  # copy is refused the same way as above.
  local copy_hash
  for dst in "$root"/.claude/skills/*/; do
    dst=${dst%/}; name=$(basename "$dst")
    [ -f "$dst/$STAMP" ] || continue
    grep -q "generated by 'workbench init'" "$dst/$STAMP" || continue
    case "$wanted" in *" $name "*) continue ;; esac
    copy_hash=$(sed -n 2p "$dst/$STAMP")
    if [[ "$copy_hash" =~ ^[0-9a-f]{12}$ ]] && [ "$(skill_hash "$dst")" != "$copy_hash" ] && [ "$force" != 1 ]; then
      die "$dst is no longer a workbench skill but was edited by hand; move the edit somewhere, or 'workbench init --force' to remove it"
    fi
    rm -rf "$dst"
    echo "  removed .claude/skills/$name: no longer a workbench skill"
  done
}

# The agent sources, named the way the skills are: one line per agent, the
# basename being the name Claude Code loads. A list rather than a glob over
# agents/*.md, so a file that is not an agent — notes, a draft — cannot ship
# as one by sitting in the directory, and a source renamed fails loudly here
# instead of going silently absent from the project.
agent_sources() {
  local base name
  base=$(readlink -f "$(wb_root)") || true
  [ -n "$base" ] && [ -d "$base" ] || die "workbench source not found at $(wb_root)"
  for name in $WB_AGENTS; do printf '%s\n' "$base/agents/$name.md"; done
}

# Agent definitions go to .claude/agents/, copied whole: a worker that runs
# one item in its worktree, for a composing session to spawn. The copy is
# meant to be read, never edited — but unlike a skill, which is a directory
# and can hold a GENERATED stamp recording what it came from, an agent is a
# flat .md with nowhere to put one. So the check here is 'cmp' and the answer
# is one bit: a copy that differs is overwritten, whether the source moved on
# or someone edited the copy. A hand edit is lost without a prompt. Making
# that refusable needs somewhere to record two hashes — a sidecar manifest —
# and three static files have not earned the second bookkeeping format.
render_agents() {
  local root src dst name wanted=" "
  root=$(repo_root)
  mkdir -p "$root/.claude/agents"
  while IFS= read -r src; do
    [ -f "$src" ] || die "agent source not found at $src"
    name=$(basename "$src")
    wanted="$wanted$name "
    dst="$root/.claude/agents/$name"
    if [ -f "$dst" ] && cmp -s "$src" "$dst"; then continue; fi
    cp "$src" "$dst"
    echo "  rendered .claude/agents/$name"
  done < <(agent_sources)

  # A copy for an agent this tool no longer ships. Reachable only by the
  # deliberate two-step — dropped from WB_AGENTS and deleted from agents/ —
  # since agent_sources dies on a name it lists but cannot find. Guarded by
  # the marker in the copy's own frontmatter, so a project's own agent
  # sitting in the same directory is never touched: 'x-workbench' is carried
  # by the sources, which is what makes it true of the copies too, and an
  # unknown frontmatter key is inert (CLAUDE.md, "Platform facts").
  for dst in "$root"/.claude/agents/*.md; do
    [ -f "$dst" ] || continue
    name=$(basename "$dst")
    grep -q '^x-workbench:' "$dst" || continue
    case "$wanted" in *" $name "*) continue ;; esac
    rm -f "$dst"
    echo "  removed .claude/agents/$name: no longer a workbench agent"
  done
}

# The copies that no longer match: "<name>\t<stale|edited|missing>". Over the
# main checkout only: that is where init runs and what gets committed.
skill_drift() {
  local root src state
  root=$(main_root)
  while IFS= read -r src; do
    state=$(skill_state "$root" "$src")
    [ "$state" = current ] || printf '%s\t%s\n' "$(basename "$src")" "$state"
  done < <(skill_sources 2>/dev/null)
}

# The agent copies that no longer match: "<name>\tdiffers" or "<name>\tmissing".
# One bit where skill_drift has three, for the reason render_agents gives: with
# nothing recorded about where a copy came from, "differs" cannot be split into
# stale and edited, and saying only "differs" beats guessing which.
agent_drift() {
  local root src dst name
  root=$(main_root)
  while IFS= read -r src; do
    name=$(basename "$src")
    dst="$root/.claude/agents/$name"
    if [ ! -f "$dst" ]; then
      printf '%s\tmissing\n' "$name"
    elif ! cmp -s "$src" "$dst"; then
      printf '%s\tdiffers\n' "$name"
    fi
  done < <(agent_sources 2>/dev/null)
}

claude_md_block() {
  cat <<EOF
$MARK_START
## Workflow

Domain work in this repo is tracked with **workbench**. Before writing code for
any feature or bug fix, create an item (\`workbench new\`) and agree its
verification criterion. An area not yet understood well enough to write an
item for is a spike: a feature item whose criterion is the question it answers.
Housekeeping — configs, tooling, agent settings — is exempt and goes straight
to the main branch.

Rules: invoke the \`workbench\` skill. State: \`$WB/\`.
$MARK_END
EOF
}

# Written through readlink -f so a CLAUDE.md that is a symlink to AGENTS.md is
# edited in place rather than replaced by a regular file.
ensure_claude_md() {
  local root target tmp
  root=$(repo_root)
  target=$(readlink -f "$root/CLAUDE.md" 2>/dev/null || printf '%s' "$root/CLAUDE.md")

  if [ ! -f "$target" ]; then
    { echo "# $(basename "$root")"; echo; claude_md_block; } > "$target"
    echo "  created $(basename "$target") with the workbench block"
    return 0
  fi

  if grep -qF "$MARK_START" "$target"; then
    tmp=$(mktemp)
    claude_md_block > "$tmp.block"
    awk -v start="$MARK_START" -v end="$MARK_END" -v blockfile="$tmp.block" '
      $0 == start { while ((getline line < blockfile) > 0) print line; skip = 1; next }
      $0 == end   { skip = 0; next }
      !skip       { print }
    ' "$target" > "$tmp"
    # mktemp creates 0600; the replace must not carry that onto CLAUDE.md.
    chmod --reference="$target" "$tmp"
    mv "$tmp" "$target"
    rm -f "$tmp.block"
    echo "  refreshed the workbench block in $(basename "$target")"
  else
    { echo; claude_md_block; } >> "$target"
    echo "  appended the workbench block to $(basename "$target")"
  fi
}

# The session wiring, committed with the skills: 'workbench status' into
# context at every session start, the status line, and the permission the
# commands need. Merged into .claude/settings.json, never replacing it: a
# line already there is left alone, a statusLine the user set is never
# overridden.
ensure_settings() {
  local root f
  root=$(repo_root)
  f="$root/.claude/settings.json"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "  python3 not found; add to .claude/settings.json by hand: permissions.allow 'Bash(workbench:*)', 'Edit(workbench/reviews/**)', 'Edit(workbench/scratch/**)', and a SessionStart hook running 'command -v workbench >/dev/null && workbench status || true'"
    return 0
  fi
  mkdir -p "$root/.claude"
  # Memory in the tree: tracked, so every worktree and clone shares one store.
  # Claude Code wants the path absolute or '~/'-based, and the same '~/' path
  # holds on every machine laid out alike; a project outside ~ gets a note.
  local mem=
  # shellcheck disable=SC2088  # a literal '~/' — Claude Code expands it, on every machine
  case "$root" in "${HOME%/}"/*) mem="~/${root#"${HOME%/}"/}/.claude/memory" ;; esac
  python3 - "$f" "$mem" <<'PY'
import json, os, re, sys
path, mem = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    with open(path) as fh:
        raw = fh.read().strip()
    if raw:
        try:
            data = json.loads(raw)
        except ValueError:
            print("  .claude/settings.json is not valid JSON; left alone")
            sys.exit(0)
if not isinstance(data, dict):
    print("  .claude/settings.json is not a JSON object; left alone")
    sys.exit(0)
changed = []
# The settings are committed, so a clone on a machine without the CLI opens
# with them too: guarded, the hook stays quiet there instead of failing every
# session.
HOOK = "command -v workbench >/dev/null && workbench status || true"
# Shapes Claude Code would reject are skipped, not crashed on: a settings
# file is the user's, and init must still reach the steps after this one.
perms = data.setdefault("permissions", {})
allow = perms.setdefault("allow", []) if isinstance(perms, dict) else None
if not isinstance(allow, list):
    print("  permissions.allow is not a list in .claude/settings.json; left alone")
else:
    # The sweep's two paths, so the gate's Write lands whatever permission
    # mode the session that forked it runs in — a fork under dontAsk honours
    # an allow rule and nothing else. The rule is Edit(...): that form
    # governs every file-writing tool, and a Write(...) rule is accepted
    # and ignored (probed 2.1.263). references/rationale.md, "Why the
    # sweep's contract is not enforced by a hook".
    for rule in ("Bash(workbench:*)", "Edit(workbench/reviews/**)", "Edit(workbench/scratch/**)"):
        if rule not in allow:
            allow.append(rule)
            changed.append("permissions.allow += " + rule)
hooks = data.setdefault("hooks", {})
# One hook: 'status' into context at session start. Matched by its exact
# command, so a re-run adds nothing twice. The session layer an older init
# wired — signal and gate hooks, a status line — is taken out: its commands
# are gone from the CLI, and a gate hook left behind would refuse every tool
# call it matched.
OLD = re.compile(r"workbench (signal|gate) ")
if not isinstance(hooks, dict):
    print("  hooks is not an object in .claude/settings.json; left alone")
else:
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        for grp in groups:
            if isinstance(grp, dict) and isinstance(grp.get("hooks"), list):
                kept = [h for h in grp["hooks"] if not (isinstance(h, dict) and OLD.search(str(h.get("command", ""))))]
                if len(kept) != len(grp["hooks"]):
                    changed.append("hooks." + event + " -= the signal/gate hooks of an older workbench")
                    grp["hooks"] = kept
        hooks[event] = [g for g in groups if not (isinstance(g, dict) and isinstance(g.get("hooks"), list) and not g["hooks"])]
        if not hooks[event]:
            del hooks[event]
    groups = hooks.get("SessionStart")
    if groups is None:
        groups = hooks["SessionStart"] = []
    if not isinstance(groups, list):
        print("  hooks.SessionStart is not a list in .claude/settings.json; left alone")
    else:
        entries = [h for grp in groups if isinstance(grp, dict) and isinstance(grp.get("hooks"), list)
                   for h in grp["hooks"] if isinstance(h, dict)]
        if not any(h.get("command") == HOOK for h in entries):
            home = next((grp for grp in groups if isinstance(grp, dict) and isinstance(grp.get("hooks"), list)
                         and grp.get("matcher") in (None, "", "*")), None)
            if home is None:
                home = {"hooks": []}
                groups.append(home)
            home["hooks"].append({"type": "command", "command": HOOK})
            changed.append("hooks.SessionStart += workbench status")
line = data.get("statusLine")
if isinstance(line, dict) and "workbench statusline" in str(line.get("command", "")):
    del data["statusLine"]
    changed.append("statusLine -= workbench statusline (gone from the CLI)")
if mem:
    cur = data.get("autoMemoryDirectory")
    if cur is None:
        data["autoMemoryDirectory"] = mem
        changed.append("autoMemoryDirectory = " + mem)
    elif cur != mem:
        print("  autoMemoryDirectory is already " + cur + "; left alone")
else:
    print("  autoMemoryDirectory: the project is not under ~, so set it by hand (absolute path) for memory to live in the tree")
if changed:
    with open(path, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    for c in changed:
        print("  .claude/settings.json: " + c)
PY
  # A local override is how a clone at another path points memory into its
  # own tree, so only one that repeats the project value is worth a word.
  if [ -f "$root/.claude/settings.local.json" ]; then
    python3 - "$root/.claude" <<'PY'
import json, os, sys
def get(name):
    try:
        return json.load(open(os.path.join(sys.argv[1], name))).get("autoMemoryDirectory")
    except Exception:
        return None
if get("settings.local.json") and get("settings.local.json") == get("settings.json"):
    print("  settings.local.json sets autoMemoryDirectory to the same path as settings.json; the local one is redundant")
PY
  fi
}

cmd_init() {
  local root d force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) usage ;;
    esac
  done
  root=$(repo_root)
  # The skills, the settings and the CLAUDE.md block are tracked files, and
  # they are committed on the default branch. Run in a linked worktree, init
  # writes them onto that item's branch, where they ride its squash under its
  # trailer — the housekeeping-on-a-branch that 'land_item' and 'idea' avoid by
  # always landing on the main checkout. 'status' prints "run 'workbench
  # init'" from any checkout, so a worker session reaches this.
  local mainr
  mainr=$(main_root)
  [ "$root" = "$mainr" ] \
    || die "init writes tracked files that are committed on the default branch; run it in the main checkout: cd $mainr && workbench init"

  for d in items/bugs items/features items/archive reviews; do
    mkdir -p "$root/$WB/$d"
    [ -e "$root/$WB/$d/.gitkeep" ] || touch "$root/$WB/$d/.gitkeep"
  done

  [ -f "$root/$WB/GLOSSARY.md" ] || { write_glossary "$root/$WB/GLOSSARY.md"; echo "  wrote $WB/GLOSSARY.md"; }
  [ -f "$root/$WB/BACKLOG.md" ] || { write_backlog "$root/$WB/BACKLOG.md"; echo "  wrote $WB/BACKLOG.md"; }
  [ -f "$root/$WB/DECISIONS.md" ] || { write_decisions "$root/$WB/DECISIONS.md"; echo "  wrote $WB/DECISIONS.md"; }

  render_skills "$force"
  render_agents
  ensure_gitignore
  ensure_settings
  ensure_claude_md

  echo "workbench ready in $root"
  setup_checklist
}

# What has to be decided with the user rather than scaffolded. Printed so the
# agent running init has the list in front of it and takes each point to the
# user; the skill says how.
setup_checklist() {
  local root main
  root=$(repo_root)
  echo
  echo "setup — decide these with the user:"

  if main=$(git config --get workbench.main 2>/dev/null) && [ -n "$main" ]; then
    echo "  default branch    $main (git config workbench.main)"
  elif main=$(default_branch 2>/dev/null); then
    echo "  default branch    $main — squash merges land here; 'git config workbench.main <branch>' if that is wrong"
  else
    echo "  default branch    UNRESOLVED — set 'git config workbench.main <branch>' before the first merge"
  fi

  if grep -qs 'Bash(workbench:\*)' "$root/.claude/settings.json"; then
    echo "  permissions       .claude/settings.json allows Bash(workbench:*), written now; sweeps run other commands through Bash and prompt for each unless allowed there too, or run in auto mode"
  else
    echo "  permissions       .claude/settings.json lacks Bash(workbench:*) — add it by hand; sweeps prompt for every Bash command unless allowed there, or run in auto mode"
  fi

  echo "  commands          /bug /feature /idea /wb are rendered under .claude/skills/, project-scoped; each tells the agent what to run"
  echo "  session           .claude/settings.json runs 'workbench status' at session start and allows Bash(workbench:*) — the user may strike either. The allow rule covers 'archive --discard' and 'review-drop --force' too, so those run without a prompt; the skills have the agent confirm with the user first"
  local premerge
  premerge=$(git config --get workbench.premerge 2>/dev/null || true)
  if [ -n "$premerge" ]; then
    echo "  premerge          '$premerge' (git config workbench.premerge) runs in the branch's worktree before every squash; non-zero refuses the merge"
  else
    echo "  premerge          optional — 'git config workbench.premerge \"<command>\"' (tests, a lint gate) runs in the branch's worktree before every squash and refuses the merge on non-zero: the project's own tools, beside the review"
  fi
  local guards
  guards=$(git config --get workbench.guards 2>/dev/null || true)
  if [ -n "$guards" ]; then
    echo "  guards            '$guards' (git config workbench.guards): criterion steps matching it are refused at start as guards, with the built-in 'by inspection' and 'behaviour unchanged'"
  else
    echo "  guards            optional — 'git config workbench.guards \"<regex>\"' names the project's own tool runs (its gate, lint, typecheck, build) so a criterion step that only says one exits 0 is refused at start; the tool that installs those commands sets it"
  fi
  if [ -n "$(memory_dir_setting)" ]; then
    echo "  memory            autoMemoryDirectory points at .claude/memory/ in the tree: one store for every worktree, and for every clone at the same path under ~ ('status' warns in one laid out differently; .claude/settings.local.json overrides there); its edits land on the main checkout, commit them as housekeeping"
  else
    echo "  memory            autoMemoryDirectory is unset (the project is not under ~, so init cannot write a portable path): set it by hand in .claude/settings.json to the absolute path of .claude/memory here, one store for every worktree; or leave memory where Claude Code keeps it"
  fi
  echo "  commit            .claude/ with the rest: worktrees and other clones get the skills and settings from git, and 'workbench init' refreshes them when 'status' says they are stale"
  echo "  glossary          $WB/GLOSSARY.md is empty; seed it with words this project uses in its own sense"
}

cmd_adopt() {
  # Work sitting uncommitted at adoption has no item and never will — the
  # criterion cannot precede code that exists — and the first merge needs a
  # clean tree anyway. Swept into the first merge it lands under an unrelated
  # subject and nothing can find it. Commit it first, as the last
  # pre-adoption commit, so that is at least on record.
  local dirt
  dirt=$(git -C "$(repo_root)" status --porcelain --untracked-files=no || true)
  [ -z "$dirt" ] || die "the tree has uncommitted changes; commit them as the last pre-adoption commit, then adopt:
$(printf '%s\n' "$dirt" | sed 's/^/  /')"
  cmd_init "$@"
  cat <<EOF

Now survey, in a Claude Code session here, what work tracking already exists
— TODO files, issue lists, a roadmap in the docs — and take the list to the
user: what becomes a backlog line, what becomes an open item, what is left
alone. Nothing converts without their approval, and shipped work never gets a
backfilled item.
EOF
}

# --- items ------------------------------------------------------------------

write_bug() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## What was seen

<!-- The observed behaviour. Delete this comment. -->

## How to reproduce

<!-- Steps, or a note that it was found by reading code — that is fine and
     needs no apology. Best-effort: a bug with no reproduction still ships.
     Once it reproduces, cut steps one at a time until every one left is
     load-bearing. A flaky one is worked by raising its reproduction rate —
     loop it, parallelise, add stress — not by waiting for a clean run.
     Delete this comment. -->

## Root cause

<!-- Before writing this, once: 'workbench find <paths>' for the files involved.
     Read an item from the index only if its line matches this bug.
     The mechanism, on the side you control. "It behaves like X and that is the
     third party's decision" is a complete root cause. A suspected race is a
     mechanism: state it, mark the confidence unproven. A fact discovered here
     about a system you do not control is recorded here, not in a document of
     its own.
     Not obvious after a first look: name three to five candidate mechanisms
     before testing any, each with the change that would make the bug vanish,
     and test them one variable at a time; only the survivor is written here.
     Every probe log carries one tag, e.g. [DEBUG-a4f2], so removing them is
     one grep. Delete this comment. -->

## The fix

<!-- What changed. Delete this comment. -->

## Side effects

<!-- What works today and behaves differently once this lands: a route, an
     exported function's name, signature or result, a command's output, a
     stored format — each with who sees the difference. 'none' when nothing
     that exists changes. Agreed before start, like the criterion; one found
     after start is 'workbench call <id> "side effect: …"', never an edit
     here. merge refuses an export or route the branch changed that this
     does not name. Delete this comment. -->

## How to confirm it is fixed

<!-- REQUIRED, never omitted. Written before the code and specific enough to
     stand alone: name the command and the expected result. This is the
     contract. Delete this comment. -->

## Decisions

<!-- Open questions only, one line each, written by 'workbench call <id>':
     a call that is the user's, parked because they were not there. Answered
     by editing the field it changes and deleting the line; archive refuses
     an item with one open. Delete this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it,
     pasted in a fenced block — archive refuses an Evidence section without
     one. Delete this comment. -->
EOF
}

write_feature() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## Why

<!-- The problem being solved. Delete this comment. -->

## What changes

<!-- Observable behaviour of the project, not implementation. Delete this
     comment. -->

## What it touches

<!-- Areas, not a file list. Before writing this, once: 'workbench find <paths>'
     for the files involved; read an item from the index only if its line
     matches. Delete this comment. -->

## Side effects

<!-- What works today and behaves differently once this lands: a route, an
     exported function's name, signature or result, a command's output, a
     stored format — each with who sees the difference. 'none' when nothing
     that exists changes. Agreed before start, like the criterion; one found
     after start is 'workbench call <id> "side effect: …"', never an edit
     here. merge refuses an export or route the branch changed that this
     does not name. Delete this comment. -->

## How to confirm it works

<!-- The criterion. Written before the code and specific enough to stand alone:
     name the command and the expected result. This is the contract. Delete
     this comment. -->

## Decisions

<!-- Open questions only, one line each, written by 'workbench call <id>':
     a call that is the user's, parked because they were not there. Answered
     by editing the field it changes and deleting the line; archive refuses
     an item with one open. Delete this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it,
     pasted in a fenced block — archive refuses an Evidence section without
     one. Delete this comment. -->
EOF
}

cmd_new() {
  local class="${1:-}" title="${2:-}" letter dir slug num id path root
  [ $# -eq 2 ] && [ -n "$class" ] && [ -n "$title" ] || usage
  require_init
  case "$class" in
    bug) letter=b; dir=bugs ;;
    feature) letter=f; dir=features ;;
    *) die "class must be 'bug' or 'feature', got '$class'" ;;
  esac

  # The file lands on the default branch, wherever this runs — created in a
  # worktree it would otherwise ride that item's squash under its trailer —
  # so the main checkout must hold that branch. Checked before an id is
  # spent on a refusal.
  root=$(main_root)
  require_main_checked_out "$root"
  slug=$(slugify "$title")
  [ -n "$slug" ] || die "title produced an empty slug"

  num=$(next_id)
  id="$letter-$num"
  path="$root/$WB/items/$dir/$id-$slug.md"

  mkdir -p "$root/$WB/items/$dir"
  [ -e "$path" ] && die "$path already exists"

  case "$class" in
    bug) write_bug "$path" "$id" "$title" ;;
    feature) write_feature "$path" "$id" "$title" ;;
  esac

  land_item "$path" "new $id: $title"

  echo "$id"
  echo "$path" >&2
  echo "committed on $(default_branch); fill it, then 'workbench start $id'" >&2
}

# The main checkout holds the default branch, or a commit meant for it would
# land elsewhere.
require_main_checked_out() {
  local main on
  main=$(default_branch)
  on=$(git -C "$1" symbolic-ref -q --short HEAD || true)
  [ "$on" = "$main" ] || die "$1 has '${on:-a detached HEAD}' checked out, not $main; the item commit lands there"
}

# An item file is on the default branch from the moment it exists: 'new'
# lands the template, 'start' lands whatever was written since — the
# criterion — and from then on main's copy stands until the branch's copy
# overwrites it at merge. Only this path goes into the commit: with a
# pathspec, commit takes the file as it is in the tree and leaves the rest
# of the index alone, so a session's other pending edits on main stay where
# they were. Nothing pending, nothing committed.
land_item() {
  local path="$1" msg="$2" root
  root=$(main_root)
  require_main_checked_out "$root"
  git -C "$root" add -- "$path"
  git -C "$root" diff --cached --quiet -- "$path" && return 0
  git -C "$root" commit --quiet -m "$msg" -- "$path" \
    || die "the commit for ${path#"$root"/} was refused — a hook, or a merge in progress on $(default_branch); the file is staged in $root"
  echo "committed ${path#"$root"/} on $(default_branch)" >&2
}

# The item file, over every checkout, in the order a copy is authoritative:
# the item's own worktree first — the copy on its branch, the one edited —
# then the main checkout, which holds the item as it started and, once
# merged, as it ended. Every worktree cut after that inherits main's copy, so
# a sibling's is never the item's home — archive run from one must move
# main's copy, or main's stays open. Last the current checkout and the rest,
# for an item written by hand and not yet landed.
find_item() {
  local id="$1" b
  wb_find items -name "$id-*.md" -print -quit < <(
    {
      while IFS= read -r b; do worktree_of "$b"; done \
        < <(local_branches "$(main_root)" "$id")
      main_root
      repo_root
      all_roots
    } | awk 'NF && !seen[$0]++'
  )
}

# The checkout an item file belongs to. find_item may return a path from the
# main checkout while the caller stands in a linked worktree, so every path
# derived from an item must be rooted here and not at repo_root.
item_root() {
  printf '%s\n' "${1%/"$WB"/items/*}"
}

# Local branches for an item id, one per line. refs/heads lives in the common
# git directory and is shared by every worktree, so the set is the same from
# any checkout — the root is passed to pin the call, not to change the answer.
local_branches() {
  git -C "$1" for-each-ref --format='%(refname:short)' "refs/heads/$2-*"
}

# One item, one branch. $1 the id, for the message; $2 the branches already
# read. A checker, not a filter: 'b=$(require_one_branch …)' would run the die
# in a command substitution, where 'exit 1' leaves only that subshell and the
# refusal reaches the caller as an exit status for 'set -e' to notice — or,
# after a 'local', not at all. Called as a statement, the die is the script's.
require_one_branch() {
  case "$2" in
    *$'\n'*) die "several branches match $1-*:"$'\n'"$2" ;;
  esac
}

# The branch an item is on, if any: a local one, else one only fetched from
# origin — on another machine that ref may be the only trace that an item
# was started. The origin lookup stays written out: one site, and a different
# ref namespace than local_branches covers.
item_branch() {
  local b
  b=$(local_branches "$(main_root)" "$1")
  [ -n "$b" ] || b=$(git -C "$(main_root)" for-each-ref --format='%(refname:short)' "refs/remotes/origin/$1-*")
  require_one_branch "$1" "$b"
  printf '%s\n' "$b"
}

# The squash commit carrying an item's trailer, or empty when none does.
# $1 root, $2 branch, $3 id.
#
# Two things this centralises, and both are load-bearing. The '--' terminator:
# without it a path named for the default branch — a 'main' file or directory —
# makes the rev ambiguous and git exits 128, and the callers that swallowed
# stderr read that fatal as "no commit carries the trailer", which is the exact
# input they treat as benign. And a real git failure now dies rather than
# returning empty, so "no commit" means no commit.
#
# The branch is a parameter because default_branch makes unpinned git calls;
# resolving it in here would put back the very inconsistency this removes.
# Callers must declare the variable on a preceding line: 'local sha=$(merged_sha
# …)' takes local's own exit status and swallows the die below. The file has no
# 'local x=$(…)' anywhere, and that is what keeps the loud half real.
merged_sha() {
  [ -n "$1" ] || die "merged_sha: no root"
  git -C "$1" log "$2" --grep="^Item: $3\$" --format=%h -1 -- \
    || die "git log failed looking for 'Item: $3' on $2"
}

cmd_start() {
  local id="${1:-}" path='' branch root='' wt ref
  [ $# -eq 1 ] && [ -n "$id" ] || usage
  id=$(require_id "$id")
  require_init

  # Closed items first, before any ref is consulted: merge deletes the local
  # branch but never origin's, so on another machine the ref outlives the
  # merge and the archive, and resuming from it would cut a worktree on a
  # stale branch for a finished item. The trailer on the default branch is
  # the signal merge itself uses.
  path=$(find_item "$id")
  case "$path" in
    */items/archive/*) die "$id is already archived" ;;
  esac
  ref=$(item_branch "$id")
  local main prior
  main=$(default_branch)
  prior=$(merged_sha "$(main_root)" "$main" "$id")
  if [ -n "$prior" ]; then
    case "$ref" in
      origin/*) die "$id is already merged as $prior; $ref is a leftover — 'git push origin --delete ${ref#origin/}' removes it" ;;
      ?*) die "$id is already merged as $prior; $ref is a leftover — 'git branch -D $ref' removes it" ;;
      *) die "$id is already merged as $prior" ;;
    esac
  fi

  # A started item is edited on its branch, so once its worktree is gone —
  # removed by hand, or never cut here because the branch was fetched from
  # another machine — the ref is where the work is. Resume from it: a
  # worktree for the branch, nothing to commit.
  if [ -n "$ref" ]; then
    branch="${ref#origin/}"
    local at
    at=$(worktree_of "$branch")
    if [ -n "$at" ]; then
      [ -d "$at" ] || die "$branch's worktree $at was removed by hand; run 'git worktree prune', then retry"
      die "$id is already started; its worktree is $at"
    fi
    wt="$(main_root)/.worktrees/$branch"
    [ -e "$wt" ] && die "worktree already exists: $wt"
    case "$ref" in
      origin/*) git worktree add --quiet --track -b "$branch" "$wt" "$ref" ;;
      *) git worktree add --quiet "$wt" "$branch" ;;
    esac
    echo "resumed $branch in $wt" >&2
    # The branch exists already, so an empty criterion is a note rather
    # than a refusal.
    local f
    f=$(find "$wt/$WB/items" -name "$id-*.md" -print -quit 2>/dev/null || true)
    if [ -n "$f" ] && ! section_filled "$f" "$(criterion_heading "$id")"; then
      echo "note: $id's '$(criterion_heading "$id")' is empty; it is written and agreed before any code" >&2
    fi
    if [ -n "$f" ] && ! section_filled "$f" "$EFFECTS"; then
      echo "note: $id's '$EFFECTS' is empty; what works today and changes is named before any code, 'none' included" >&2
    fi
  else
    [ -n "$path" ] || die "no item matching '$id'"

    branch=$(basename "$path" .md)
    root=$(item_root "$path")
    local rel="${path#"$root"/}" mainr
    mainr=$(main_root)
    # Rule 2, held here because this is where code begins: the criterion
    # is written and agreed before the branch is cut. A template comment alone does not count. Before anything moves.
    require_closed_fences "$id" "$path"
    section_filled "$path" "$(criterion_heading "$id")" \
      || die "$id's '$(criterion_heading "$id")' is empty; it is written and agreed before any code — fill it, then start"
    # The other half of rule 2: a step that passes on the unchanged tree is
    # a guard — it proves the tools ran, not that the behaviour is there —
    # and the pre-merge review rejects it once the code is written
    # (rules/pre-merge.md). Refused here, while it is cheap to change.
    local guard
    guard=$(criterion_guard_steps "$path" "$(criterion_heading "$id")" "$root")
    [ -z "$guard" ] || die "$id's criterion has a step that is a guard, not a check: $guard— a check that passes on the unchanged tree says the tools ran, not that the behaviour is there; name a command whose result differs when the feature is missing, then start"
    # The other section agreed before code: what works today and will change.
    # 'none' is an answer; an empty section is the question never asked, and
    # merge would then refuse the first export the branch renames with nobody
    # having decided it. Refused here, while the item is still main's to edit.
    section_filled "$path" "$EFFECTS" \
      || die "$id's '$EFFECTS' is empty; name what works today and changes with this — a route, an export, an output — or 'none', then start"
    # An item is on the default branch from 'new' onward; one written by hand,
    # or by an older workbench, sits untracked in whatever checkout it was
    # written in, and is brought to the main checkout to land with the rest.
    # Committed on another checkout's branch it is refused: it would reach the
    # default branch twice, now and again under that branch's squash.
    if [ "$root" != "$mainr" ]; then
      ! git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1 \
        || die "$rel is committed on $(git -C "$root" rev-parse --abbrev-ref HEAD), not on $(default_branch); 'git rm' it there and commit, then start again"
      [ ! -e "$mainr/$rel" ] || die "$rel is both in $root and in $mainr; keep one"
      mkdir -p "$(dirname "$mainr/$rel")"
      mv "$path" "$mainr/$rel"
      # 'new' may have created the class directory just for this file.
      # Relative, so the walk up stops at the checkout rather than the root.
      (cd "$root" && rmdir -p --ignore-fail-on-non-empty "$(dirname "$rel")" 2>/dev/null) || true
      echo "moved $rel from $(basename "$root") to the main checkout" >&2
      path="$mainr/$rel"
      root="$mainr"
    fi
    # Always under the main checkout and off the default branch. Run from
    # inside another item's worktree, the new one would otherwise nest under
    # it — and vanish with it at that item's merge — and start from that
    # item's commits.
    wt="$mainr/.worktrees/$branch"

    [ -e "$wt" ] && die "worktree already exists: $wt"

    # What was written since 'new' — the criterion — is where the branch
    # starts from, so it lands on the default branch first. From here on
    # main's copy stands as the item started; the branch's is the one edited.
    land_item "$path" "start $id"
    git worktree add --quiet -b "$branch" "$wt" "$(default_branch)"
    echo "started $branch in $wt" >&2
  fi
  # The skills are tracked copies, so a committed .claude/ is in the new
  # checkout already; uncommitted, it is not, and a session opened there
  # has no commands or hook.
  [ -d "$wt/.claude/skills/workbench" ] \
    || echo "note: .claude/ is not committed on $(default_branch), so a session inside $wt lacks the workbench commands until it is" >&2

  # The dispatch line: stdout stays the path, which the skills read; the line
  # goes where a person reads.
  echo "dispatch: wb-worker $id in $wt" >&2
  echo "$wt"
}

# The checkout holding a branch, from git's own list rather than the
# .worktrees/<branch> convention: 'workbench start' run from a linked worktree
# nests its .worktrees/ there, and a worktree moved by hand is still a worktree.
worktree_of() {
  git worktree list --porcelain \
    | awk -v want="refs/heads/$1" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { if ($2 == want) { print wt; exit } }
      '
}

# worktree_of for a caller about to run git inside it. A worktree removed by
# hand stays listed until 'git worktree prune', and git's own error for the
# missing directory — "cannot change to …" — says nothing about that.
live_worktree_of() {
  local wt
  wt=$(worktree_of "$1")
  [ -z "$wt" ] || [ -d "$wt" ] \
    || die "the worktree for $1 is gone but still listed: $wt; run 'git worktree prune', then retry"
  printf '%s\n' "$wt"
}

# Existing declarations the branch changed: an exported symbol whose
# declaration line the diff removes or rewrites, a route string it removes or
# rewrites. Removed-side lines only — an added line is new behaviour, not a
# change to what works today — and a body edited under an unchanged signature
# is not seen here; that is the reviewer's "every function the diff changes,
# its callers found by grep". TypeScript and JavaScript exports, Go's
# capitalised funcs and types, Python's top-level defs, and a path literal
# in a route registration. Nothing under workbench/ or .claude/. Prints
# '<name>\t<file>', unique.
changed_declarations() {
  local root=$1 main=$2 branch=$3 T=$'\t' Q="[\"'\`]" NQ="[^\"'\`]"
  git -C "$root" diff "$main...$branch" -- . ":!$WB" ':!.claude' \
    | awk '/^\+\+\+ b\// { f = substr($0, 7); next } /^--- / { next } /^-/ { print f "\t" substr($0, 2) }' \
    | sed -nE \
        -e "s/^([^${T}]*)${T}[[:space:]]*export[[:space:]]+(default[[:space:]]+)?(async[[:space:]]+)?(abstract[[:space:]]+)?(function\*?|const|let|var|class|interface|type|enum)[[:space:]]+([A-Za-z_\$][A-Za-z0-9_\$]*).*/\6${T}\1/;t p" \
        -e "s/^([^${T}]*)${T}(func[[:space:]]+(\([^)]*\)[[:space:]]+)?|type[[:space:]]+)([A-Z][A-Za-z0-9_]*).*/\4${T}\1/;t p" \
        -e "s/^([^${T}]*)${T}(def|class)[[:space:]]+([A-Za-z][A-Za-z0-9_]*).*/\3${T}\1/;t p" \
        -e "s/^([^${T}]*)${T}.*\.(get|post|put|patch|delete|head|options|all|route|use|Handle|HandleFunc|GET|POST|PUT|PATCH|DELETE)\([[:space:]]*${Q}(\/${NQ}*)${Q}.*/\3${T}\1/;t p" \
        -e 'd' -e ':p' -e 'p' \
    | sort -u
}

# Each changed declaration against the item's '## Side effects': one the
# section names as a word is 'named', the rest 'unnamed' — 'called' when it
# sits only in an open line under '## Decisions', a question the user has not
# answered. Prints '<state>\t<name>\t<file>'.
side_effects_of() {
  local item=$1 root=$2 main=$3 branch=$4 body calls name file
  body=$(without_fences "$item" | sed -n "/^## $EFFECTS/,/^## /p" | tail -n +2 | grep -v '^## ' | strip_comments) || true
  calls=$(open_decisions_of "$item")
  while IFS=$'\t' read -r name file; do
    [ -n "$name" ] || continue
    if grep -qwF -- "$name" <<<"$body"; then echo "named	$name	$file"
    elif grep -qwF -- "$name" <<<"$calls"; then echo "called	$name	$file"
    else echo "unnamed	$name	$file"
    fi
  done < <(changed_declarations "$root" "$main" "$branch")
}

# What merge will hold the branch to, for the worker who cannot run merge:
# every existing declaration the branch changed and whether the item names
# it. Exit 1 while one is not — the worker's cue for 'workbench call'.
cmd_effects() {
  local id="${1:-}" root main branch wt item tmp='' out
  [ $# -eq 1 ] && [ -n "$id" ] || usage
  id=$(require_id "$id")
  require_init
  root=$(main_root)
  main=$(default_branch)
  branch=$(local_branches "$root" "$id")
  [ -n "$branch" ] || die "no branch named $id-*; effects are read from a started item's branch"
  require_one_branch "$id" "$branch"
  # The worktree's copy when there is one — the worker edits it there and
  # asks before committing — else the branch's.
  wt=$(live_worktree_of "$branch")
  [ -z "$wt" ] || item=$(find "$wt/$WB/items" -name "$id-*.md" -not -path '*/archive/*' -print -quit 2>/dev/null || true)
  if [ -z "${item:-}" ]; then
    item=$(git -C "$root" ls-tree -r --name-only "$branch" -- "$WB/items" | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
    [ -n "$item" ] || die "$id has no item file on $branch"
    tmp=$(mktemp)
    git -C "$root" show "$branch:$item" > "$tmp"
    item=$tmp
  fi
  out=$(side_effects_of "$item" "$root" "$main" "$branch")
  [ -z "$tmp" ] || rm -f "$tmp"
  if [ -z "$out" ]; then
    echo "$id: no existing export or route changed on $branch"
    return 0
  fi
  printf '%s\n' "$out" | awk -F'\t' '{ printf "%-8s %s  (%s)\n", $1, $2, $3 }'
  if grep -q '^unnamed' <<<"$out"; then
    echo "unnamed: an existing declaration the branch changed and '## $EFFECTS' does not name; 'workbench call $id \"side effect: …\"' parks it for the user" >&2
    return 1
  fi
  if grep -q '^called' <<<"$out"; then
    echo "called: parked under '## Decisions'; the user answers by naming it under '## $EFFECTS' and deleting the line" >&2
    return 1
  fi
}

# The squash commit is the whole point of the merge: the change lands on the
# default branch as one commit whose only body is the trailer. Everything the
# command checks exists to keep that commit honest — one branch, one item, one
# subject, no unrelated changes, nothing lost — and everything it cannot check
# (whether what could be verified was) is the review dialog's job, and the
# user's. So no evidence gate here: an item merges open as 'awaiting'.
#
# Every git call is pinned to the main checkout. The command may be run from
# the item's own worktree, which stops existing halfway through, and a bare
# 'git' there fails on a working directory that has gone.
cmd_merge() {
  local id="${1:-}" subject="${2:-}" branch main root wt
  [ $# -eq 2 ] && [ -n "$id" ] && [ -n "$subject" ] || usage
  id=$(require_id "$id")
  require_init
  case "$subject" in
    *$'\n'*) die "the subject must be a single line" ;;
    *"Item:"*) die "the subject must not carry the trailer; it is added here" ;;
  esac

  root=$(main_root)
  main=$(default_branch)

  # The branch is what merges, and it carries the ID, so resolve it directly.
  # The archive is still consulted — an archived item's branch is a
  # leftover, not work to merge.
  case "$(find_item "$id")" in
    */items/archive/*) die "$id is already archived" ;;
  esac
  local prior
  prior=$(merged_sha "$root" "$main" "$id")
  if [ -n "$prior" ]; then
    # The trailer is on the default branch, so the squash landed. If the branch
    # or its worktree is still here, the cleanup after that commit did not
    # finish — and a bare "already carries" leaves the user with a merged item,
    # two leftovers and nothing to run. Name them and hand over the commands.
    local left_branch left_wt
    left_branch=$(local_branches "$root" "$id" | head -1)
    left_wt=''
    [ -z "$left_branch" ] || left_wt=$(worktree_of "$left_branch")
    if [ -n "$left_branch" ]; then
      die "$id is already merged as $prior, but the cleanup after that commit did not finish. Left behind:
$([ -z "$left_wt" ] || printf '  worktree  %s\n' "$left_wt")  branch    $left_branch

Finish it with:
$([ -z "$left_wt" ] || printf "  git -C %s worktree remove %s\n" "$root" "$left_wt")  git -C $root branch -D $left_branch"
    fi
    die "$main already carries 'Item: $id' at $prior"
  fi
  branch=$(local_branches "$root" "$id")
  [ -n "$branch" ] || die "no branch named $id-*; nothing to merge"
  require_one_branch "$id" "$branch"

  # The merge gate asks whether everything verifiable was verified, and the
  # item file on the branch is the only witness — main's copy is the item as
  # it started. An 'open' item with no evidence block would merge as a claim
  # nobody made; one that cannot be verified yet says so with 'awaiting —
  # <trigger>' or 'unverified — <trigger>'. Read from the branch, not the
  # checkout: the file may sit edited and uncommitted in the worktree, and
  # that is refused further down.
  local item_on_branch tmp st
  item_on_branch=$(git -C "$root" ls-tree -r --name-only "$branch" -- "$WB/items" \
    | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
  # No copy on the branch is not "nothing to check": it is the witness missing,
  # and every check below — fences, status, the trigger, evidence — would be
  # skipped without a word. The item would merge as a claim nobody made.
  [ -n "$item_on_branch" ] \
    || die "$id has no item file on $branch; the branch copy is what the merge gate reads — restore it there, then retry"
  tmp=$(mktemp)
  git -C "$root" show "$branch:$item_on_branch" > "$tmp"
  closed_fences "$tmp" || { rm -f "$tmp"; die "$id has an unclosed \`\`\` fence on $branch; close it, then retry"; }
  st=$(item_status "$tmp")
  known_status "$st" || { rm -f "$tmp"; die "$id has 'status: $st' on $branch, which is not a status"; }
  case "$st" in
    awaiting*|unverified*)
      case "$st" in
        *—*|*" - "*) ;;
        *) rm -f "$tmp"; die "$id: '$st' must name its trigger, e.g. 'status: awaiting — the next deploy'" ;;
      esac ;;
    unreproduced*) rm -f "$tmp"; die "$id is unreproduced and never merges; 'workbench archive $id' retires the branch" ;;
    abandoned*) rm -f "$tmp"; die "$id is abandoned and never merges; 'workbench archive $id' retires the branch, '--discard' with the work on it" ;;
    *)
      has_evidence "$tmp" || { rm -f "$tmp"; die "$id is open with no evidence under '## Evidence' on $branch; record it, or set 'status: awaiting — <trigger>' / 'unverified — <trigger>' when the criterion cannot run yet"; } ;;
  esac
  # What works today and changes with this was agreed before start, or parked
  # as a call since. An export or route the branch rewrote that the section
  # does not name is neither: it lands with nobody having decided it, and the
  # caller that breaks is found on main. Refused; a name sitting only in an
  # open call is the user's question, answered by moving it into the section.
  local effects
  effects=$(side_effects_of "$tmp" "$root" "$main" "$branch" | grep -v '^named' || true)
  rm -f "$tmp"
  [ -z "$effects" ] || die "$id changes what works today and '## $EFFECTS' does not name it:
$(printf '%s\n' "$effects" | awk -F'\t' '{ printf "  %s  (%s)%s\n", $2, $3, ($1 == "called" ? " — parked under Decisions" : "") }')
name each under '## $EFFECTS' on the branch (delete its Decisions line once answered) and commit, then retry; 'workbench effects $id' lists them"

  # The squash needs the default branch checked out, and that checkout is the
  # main one: a linked worktree cannot hold a branch another checkout holds.
  local on
  on=$(git -C "$root" symbolic-ref -q --short HEAD || true)
  [ "$on" = "$main" ] || die "$root has '${on:-a detached HEAD}' checked out, not $main; the squash lands there"

  # Anything staged on main would go into the squash commit, so it is
  # refused. An unstaged edit would not: the commit takes the index, the
  # squash refuses to overwrite a modified file before writing anything, and
  # the reset that undoes a stopped squash keeps it. So those are tolerated —
  # the memory store in the tree is written by every session all day — with
  # one exception: git protects a modified file but not a missing one, so an
  # unstaged deletion of a file the branch touches would be quietly restored,
  # staged, and lost. Refused too.
  local dirt gone
  dirt=$(git -C "$root" status --porcelain --untracked-files=no | grep -v '^ M' || true)
  gone=$(printf '%s\n' "$dirt" | grep '^ D' | sed 's/^...//' || true)
  [ -z "$gone" ] || die "$root has an uncommitted deletion the squash would undo; commit or restore it first:
$(printf '%s\n' "$gone" | sed 's/^/  /')"
  [ -z "$dirt" ] || die "$root has staged changes; the squash commit would absorb them"

  wt=$(live_worktree_of "$branch")
  if [ -n "$wt" ]; then
    dirt=$(git -C "$wt" status --porcelain --untracked-files=all)
    if [ -n "$dirt" ]; then
      # A pre-merge report sits untracked in the worktree, so it is the usual
      # dirt here — and it wants dropping, not committing.
      if ! grep -qvE "^.. $WB/reviews/" <<<"$dirt"; then
        die "$wt still holds a review report; triage it, then 'workbench review-drop' it before merging:
$(printf '%s\n' "$dirt" | sed 's/^.. /  /')"
      fi
      # The item file is the one edit a worker is likeliest to leave
      # uncommitted — evidence pasted, not yet committed — so name it rather
      # than say "changes".
      local only
      only=$(printf '%s\n' "$dirt" | sed 's/^...//')
      if [ "$(printf '%s\n' "$only" | wc -l)" -eq 1 ]; then
        case "$only" in
          "$WB/items/"*"/$id-"*.md)
            die "$only is edited and not committed on the branch; commit it, then retry" ;;
        esac
        # A symlink is not a directory to git, so an ignore line with a
        # trailing slash ('node_modules/', 'target/') does not cover one.
        [ -L "$wt/$only" ] \
          && die "$wt has an untracked symlink, $only; ignore it with a '$only' line (no slash) in .gitignore, or remove it, then retry"
      fi
      die "$wt has uncommitted changes; commit or discard them first"
    fi
    # Removability is checked here, before anything lands, because the squash
    # is not transactional: the commit is written first and the worktree
    # removed after, so a removal that fails leaves the trailer on the default
    # branch with the branch and worktree still standing. Dirt is covered
    # above; a lock is the other refusal 'worktree remove' makes, and it is
    # cheap to ask about now rather than halfway through.
    if git -C "$root" worktree list --porcelain \
      | awk -v w="$wt" '$1=="worktree" { m = ($2 == w) } m && $1=="locked" { found=1 } END { exit !found }'; then
      die "the worktree $wt is locked, and merge removes it after the squash; 'git worktree unlock $wt' first, then retry"
    fi
  fi

  # Another item's file changed on this branch — written there by hand, or
  # edited there — would land on the default branch in this squash, under
  # this item's trailer, and that item's own merge would then collide. Any
  # class: ids share one sequence. Not the archive, a record move that
  # carries its own SHA and reaches a branch only by hand. A three-dot diff,
  # so items landed on the default branch since the cut are not in it.
  local foreign
  foreign=$(git -C "$root" diff --name-only "$main...$branch" \
    | grep -E "^$WB/items/[^/]+/[bf]-[0-9]+-[^/]*\.md\$" \
    | grep -v -e "^$WB/items/archive/" -e "/$id-" || true)
  [ -z "$foreign" ] || die "$branch carries another item's file; 'git rm' it here — after 'workbench start <id>' for that item if it is not started — then retry:
$(printf '%s\n' "$foreign" | sed 's/^/  /')"

  # The item is edited on its branch only, and main's copy stands as it
  # started until the squash overwrites it. The squash is a three-way merge,
  # so a main-side edit in a hunk the branch never touched would merge in
  # silently — a criterion changed under evidence recorded against the old
  # one. Refused outright: three-dot, so the copy is compared with the cut.
  if [ -n "$item_on_branch" ] && ! git -C "$root" diff --quiet "$branch...$main" -- "$item_on_branch"; then
    die "$main's copy of $id changed since $branch was cut; the item is edited on its branch only — revert it on $main, then retry"
  fi

  git -C "$root" merge-base --is-ancestor "$branch" "$main" \
    && die "$branch has nothing $main does not already have"

  # Refuse a conflicting branch before touching anything. A squash that stops
  # on conflicts leaves the main index half-merged, and the repair is the
  # user's rebase in the worktree anyway, so ask for it up front.
  if ! git -C "$root" merge-tree --write-tree "$main" "$branch" >/dev/null 2>&1; then
    die "$branch conflicts with $main; rebase it onto $main in its worktree, then retry"
  fi

  # The premerge command below runs on the branch tip. A branch cut before a
  # later merge would be tested without what that merge changed — a rename
  # landed on main, this branch still imports the old name: green in its
  # worktree, broken on main, and nothing downstream runs the tools on a
  # clean main. So while a premerge is set, the branch must contain main.
  # Except what the worker itself lands on main from its worktree — a
  # parked call, a new item — which touches only workbench/ and changes
  # nothing the premerge command tests.
  if [ -n "$(git -C "$root" config --get workbench.premerge 2>/dev/null || true)" ] \
     && ! git -C "$root" merge-base --is-ancestor "$main" "$branch" \
     && git -C "$root" diff --name-only "$branch...$main" | grep -qv "^$WB/"; then
    die "$branch is behind $main, and premerge would test it without what landed since; in ${wt:-its worktree} run 'git rebase $main', then retry"
  fi

  # The project's own gate — 'git config workbench.premerge "<command>"' —
  # run in the branch's worktree, last of the checks because it is the slow
  # one, and before anything lands. Its exit status is the verdict and its
  # output the reason, so both go where a person reads. The review dialog
  # is judgment and the user's to weigh; this is the project's tools, and
  # only unsetting the config skips it. A branch whose worktree is gone is refused, not passed
  # unchecked: the tools need the files.
  local premerge
  premerge=$(git -C "$root" config --get workbench.premerge 2>/dev/null || true)
  if [ -n "$premerge" ]; then
    [ -n "$wt" ] || die "workbench.premerge is set ('$premerge') and $branch has no worktree to run it in; 'workbench start $id' recreates one, then retry"
    echo "premerge: $premerge (in $wt)" >&2
    if ! (cd "$wt" && bash -c "$premerge") >&2; then
      # A worktree holds tracked files only; a check that needs the
      # project's dependencies has nothing to run until they are installed
      # there, and which ones is the project's business, not this tool's.
      die "$id: premerge check failed — '$premerge' exited non-zero in $wt; fix it on the branch, then retry. A worktree holds tracked files only: if the command wants the project's dependencies, install them there the way the project's rules say first"
    fi
  fi

  # merge-tree is a pre-check, not a guarantee — rename detection can differ —
  # and a commit hook can refuse. Either failure would leave the main index
  # half-squashed, the one state promised above never to leave, so both are
  # undone the way 'merge --abort' would.
  # Captured, not silenced: --quiet still leaves "Automatic merge went well"
  # on stderr, which is noise on success and evidence on failure.
  local squash
  squash=$(git -C "$root" merge --squash --quiet "$branch" 2>&1) \
    || {
      printf '%s\n' "$squash" >&2; unsquash "$root"
      # The dirt tolerated above is an unstaged edit on main; when the branch
      # touches the same file, git stops here to protect it, and the way
      # forward is to commit or discard that edit, not to rebase.
      if grep -q 'overwritten by merge' <<< "$squash"; then
        die "the squash stopped; $root is restored — an uncommitted edit on $main is in the way of the branch; commit or discard it, then retry"
      fi
      die "the squash stopped; $root is restored — rebase $branch onto $main in its worktree, then retry"
    }
  # Content that reached main by another route squashes to nothing, and the
  # commit would refuse with a message about staging; name the state instead.
  if git -C "$root" diff --cached --quiet; then
    unsquash "$root"
    die "$branch changes nothing on $main — everything on it is already there; archive the item instead, or 'git branch -D $branch' if it is done with"
  fi
  # The trailer is the message.
  local trailer="Item: $id"
  git -C "$root" commit --quiet -m "$subject" -m "$trailer" \
    || { unsquash "$root"; die "the squash commit was refused; $root is restored and nothing was removed"; }

  # git's own safety in 'branch -d' cannot apply after a squash — the branch is
  # never an ancestor of the commit — so the check it would have made is made
  # here instead: the commit just written is the one the trailer finds.
  local sha
  sha=$(merged_sha "$root" "$main" "$id")
  [ -n "$sha" ] && [ "$sha" = "$(git -C "$root" rev-parse --short HEAD)" ] \
    || die "the squash commit did not land on $main as expected; nothing removed"

  # Past this point the commit exists and cannot be taken back — 'unsquash' is
  # a reset of the index and working tree, so it has nothing to say about a
  # commit. A cleanup that fails therefore reports the half-state rather than
  # dying bare; the guard at the top of this function repeats it on a re-run.
  if [ -n "$wt" ] && ! git -C "$root" worktree remove "$wt"; then
    die "merged $id as $sha on $main, but removing the worktree failed. $wt and the branch $branch are still here; finish with 'git -C $root worktree remove $wt' and 'git -C $root branch -D $branch'"
  fi
  git -C "$root" branch -D --quiet "$branch" \
    || die "merged $id as $sha on $main, but the branch $branch could not be deleted; finish with 'git -C $root branch -D $branch'"
  rm -f "$(git_common_dir)/review-holds/$id"

  echo "merged $id as $sha on $main"
  # The branch's copy of the item file overwrote main's in the squash, so
  # read its status from the default branch.
  local item
  item=$(wb_find items -name "$id-*.md" -print -quit <<< "$root")
  case "$item" in
    */archive/*) echo "$id is already archived" >&2 ;;
    *)
      case "$(item_status "${item:-/dev/null}")" in
        awaiting*) echo "$id stays open until its trigger fires" >&2 ;;
        *) echo "next: workbench archive $id" >&2 ;;
      esac ;;
  esac
  if [ -n "$wt" ]; then
    case "$PWD" in
      "$wt"|"$wt"/*) echo "this shell's directory is gone; cd $root" >&2 ;;
    esac
  fi
}

item_status() {
  sed -n 's/^status: *//p' "$1" | head -1
}

# The status a listing shows. Archiving leaves the status line alone, so a
# plain 'open' under archive/ means verified and shipped; the unproved
# statuses say so themselves.
shown_status() {
  local st
  st=$(item_status "$1")
  case "$1" in */archive/*) [ "$st" = open ] && st=archived ;; esac
  printf '%s\n' "$st"
}

item_id() {
  basename "$1" | sed -n 's/^\([bf]-[0-9]\{1,\}\)-.*/\1/p'
}

# Undo a squash that did not reach its commit. Nothing was staged before the
# squash began, and --merge keeps what is unstaged — the edits merge
# tolerates on main — and leaves untracked files, a report or scratch,
# alone. The message file a stopped squash leaves would otherwise seed the
# next commit's message.
unsquash() {
  git -C "$1" reset -q --merge || echo "workbench: reset --merge failed; run it by hand in $1" >&2
  rm -f "$(git -C "$1" rev-parse --absolute-git-dir)/SQUASH_MSG"
}

# The branch squash commits land on. Repositories here are local-first, so the
# main/master leg is the common path and origin/HEAD the exception; an explicit
# 'git config workbench.main' answers an odd layout once.
default_branch() {
  local b
  b=$(git config --get workbench.main 2>/dev/null || true)
  [ -n "$b" ] || b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
  if [ -z "$b" ]; then
    for b in main master; do
      git rev-parse --verify -q "refs/heads/$b" >/dev/null && break
      b=
    done
  fi
  [ -n "$b" ] || die "cannot resolve the default branch; set 'git config workbench.main <branch>'"
  printf '%s\n' "$b"
}

# Evidence is present when the Evidence section holds a fenced block. Evidence
# is defined as actual output, and output is pasted, not typed — a bare "done"
# or "TBD" under the heading is exactly what this refuses.
# A fenced block under '## Evidence' itself — up to the next '## ', not to the
# end of the file. Evidence parked under a sibling heading left this section
# empty while the gate still passed.
# An item with its fenced blocks emptied: evidence is pasted output, and
# pasted output holds '## ' lines — a markdown diff, a script's comments —
# that would otherwise read as headings, end a section early, or count as a
# concept. The fence lines themselves stay, so a block is still seen.
without_fences() {
  awk '/^[[:space:]]*(```|~~~)/ { inside = !inside; print; next } !inside' "$1"
}

# HTML comments gone, both shapes: one closed on its own line, and one that
# spans lines. Every scan that asks whether a section holds anything runs
# through here first — a section holding nothing but the template's own
# instruction comment is empty, and reads that way only after this. Takes
# stdin so it composes in a pipeline; a file is '< "$f"'.
strip_comments() {
  sed -e 's/<!--.*-->//' -e '/<!--/,/-->/d'
}

# An odd number of fence lines: everything after the last one is inside a
# block to every scan above, so a criterion reads as empty and a section as
# missing with nothing to say why. Named at the gates, before those scans.
closed_fences() {
  local n
  n=$(grep -cE '^[[:space:]]*(```|~~~)' "$1" || true)
  [ $((n % 2)) -eq 0 ]
}

require_closed_fences() {
  closed_fences "$2" || die "$1 has an unclosed \`\`\` fence; close it, then retry"
}

has_evidence() {
  local body
  # 'grep -v' exits 1 when it filters everything out, which is an empty section,
  # not an error — the herestring grep below settles it either way.
  body=$(without_fences "$1" | sed -n '/^## Evidence/,/^## /p' \
    | tail -n +2 | grep -v '^## ' \
    | strip_comments) || true
  grep -qE '^[[:space:]]*(```|~~~)' <<<"$body"
}

# The '## ' headings a class may carry, in the order the template writes them.
# Anything else is a section the template did not ask for — "For the
# operator", "Decisions this took", "What this did not prove" — and those
# were where the archive grew long and the user's calls went to hide.
template_headings() {
  case "$1" in
    b-*) printf '%s\n' 'What was seen' 'How to reproduce' 'Root cause' 'The fix' 'Side effects' 'How to confirm it is fixed' 'Decisions' 'Evidence' ;;
    f-*) printf '%s\n' 'Why' 'What changes' 'What it touches' 'Side effects' 'How to confirm it works' 'Decisions' 'Evidence' ;;
  esac
}

# '## ' headings in the file that the class template does not have.
foreign_headings() {
  local id="$1" path="$2"
  comm -23 <(without_fences "$path" | sed -n 's/^## //p' | sort -u) <(template_headings "$id" | sort -u)
}

# A heading the template does have, but twice. foreign_headings compares sets,
# so a repeat collapses and passes it — and a second '## Evidence' splits the
# record in two, with the gates reading only as far as the first one.
repeated_headings() {
  without_fences "$1" | sed -n 's/^## //p' | sort | uniq -d
}

# The statuses items.md defines, and nothing else: an unknown status in an
# archive shows in every listing beside 'archived'.
known_status() {
  case "$1" in
    open|awaiting*|unverified*|unreproduced*|abandoned*) return 0 ;;
    *) return 1 ;;
  esac
}

# An unreproduced bug that was started has a branch holding nothing but its
# item file — there was nothing to fix — and a worktree the file was edited
# into. Archiving it means bringing the file back to the main checkout and
# dropping both. Only when the item is all the branch holds: anything else is
# work, and work merges or is discarded by hand, never here. The item file is
# itself always the dirty one — 'start' moved it in uncommitted, untracked
# to git, and the status edit came after — so it alone is exempt from both
# checks. Prints the path of the copy now in the main checkout.
#
# An abandoned branch is the other one that never merges, and it may carry
# whatever was built before the user dropped it. That is dropped only when
# asked (discard=1), and named as it goes.
retire_branch() {
  local id="$1" branch="$2" path="$3" discard="${4:-0}" main root wt other item_re hint dropped=0
  main=$(default_branch)
  root=$(main_root)
  wt=$(live_worktree_of "$branch")
  item_re="$WB/items/[^/]+/$id-[^/]*\\.md\$"
  case "$id:$(item_status "$path")" in
    *:abandoned*) hint="an abandoned item never merges: 'workbench archive $id --discard' drops the work, naming each file" ;;
    *) hint="merge $id, or remove the worktree and branch yourself, then archive" ;;
  esac

  if [ -n "$wt" ]; then
    other=$(git -C "$wt" status --porcelain --untracked-files=all | grep -vE "$item_re" || true)
    if [ -n "$other" ]; then
      [ "$discard" -eq 1 ] || die "$wt has changes beyond the item file:
$other
$hint"
      echo "dropping uncommitted changes in $wt:" >&2
      printf '%s\n' "$other" | sed 's/^/  /' >&2
      dropped=1
    fi
  fi
  other=$(git -C "$root" diff --name-only "$main...$branch" | grep -vE "^$item_re" || true)
  if [ -n "$other" ]; then
    [ "$discard" -eq 1 ] || die "$branch carries work beyond the item file:
$other
$hint"
    echo "dropping from $branch:" >&2
    printf '%s\n' "$other" | sed 's/^/  /' >&2
    dropped=1
  fi

  # Main's copy is the item as it started; the branch's is the item as it
  # ends, and that is the one archived. From the worktree when there is one
  # — a status set there and not yet committed counts, as above — else from
  # the branch itself, since the worktree gone by hand leaves find_item on
  # main's stale copy.
  local rel
  if [ -n "$wt" ]; then
    rel="${path#"$(item_root "$path")"/}"
  else
    rel=$(git -C "$root" ls-tree -r --name-only "$branch" -- "$WB/items" \
      | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
    [ -n "$rel" ] || die "$branch carries no item file for $id; nothing to archive from it"
  fi
  # Overwritten, not merged — so a main-side edit since the cut would be
  # lost without a word. Refused, as merge refuses it.
  git -C "$root" diff --quiet "$branch...$main" -- "$rel" \
    || die "$main's copy of $id changed since $branch was cut; the item is edited on its branch only — revert it on $main, then retry"
  mkdir -p "$root/$(dirname "$rel")"
  if [ -n "$wt" ]; then
    [ "$path" = "$root/$rel" ] || cp "$path" "$root/$rel"
  else
    git -C "$root" show "$branch:$rel" > "$root/$rel"
  fi
  # The branch's commits are the only record of what each round believed —
  # the item file is rewritten in place, and the archived copy is the last
  # one. A tag named by the id keeps them reachable once
  # the branch is gone: 'git log <id> -- <item file>' walks them. Annotated,
  # so push.followTags carries it with the next ordinary push.
  git -C "$root" tag -a -m "$id" "$id" "$branch" \
    || die "tag $id already exists; the branch's history would be lost under it — 'git tag -d $id' if it is a leftover, then retry"
  # --force only because of the item file just copied out; everything else
  # was verified clean above.
  [ -z "$wt" ] || git -C "$root" worktree remove --force "$wt"
  git -C "$root" branch -D --quiet "$branch"
  if [ "$dropped" -eq 1 ]; then
    echo "retired $branch as tag $id; its prototypes are gone from the tree" >&2
  else
    echo "retired $branch as tag $id; nothing but the item was on it" >&2
  fi
  printf '%s\n' "$root/$rel"
}

# A section holds something beyond its template comment.
# The first '## ' section of an item, comments stripped: Why for a feature,
# What was seen for a bug.
lead_section() {
  without_fences "$1" | awk '/^## / { n++ } n == 1' | tail -n +2 \
    | strip_comments
}

section_filled() {
  local body
  body=$(without_fences "$1" | sed -n "/^## $2/,/^## /p" | tail -n +2 | grep -v '^## ' \
    | strip_comments) || true
  grep -q '[^[:space:]]' <<<"$body"
}

# Criterion steps that check nothing: "by inspection", "behaviour unchanged".
# The same list rules/pre-merge.md holds against the finished item; here it
# stops the item before a branch is cut. Workbench knows no toolchain, so the
# steps that only prove a project's own tools ran — its gate, lint, typecheck
# or build exiting 0 — come from 'git config workbench.guards', an extended
# regex the tool that installs those commands sets beside workbench.premerge.
criterion_guard_steps() {
  local file=$1 heading=$2 root=$3 pat='by inspection|behaviou?r (is )?unchanged|still does what it did' extra
  extra=$(git -C "$root" config --get workbench.guards 2>/dev/null || true)
  [ -z "$extra" ] || pat="$pat|$extra"
  without_fences "$file" | sed -n "/^## $heading/,/^## /p" | tail -n +2 | grep -v '^## ' | strip_comments \
    | grep -iE -- "$pat" \
    | head -3 | sed 's/^[[:space:]]*//; s/$/ /' | tr -d '\n' || true
}

# The section that must be filled before an item starts: the criterion,
# agreed before any code.
criterion_heading() {
  echo "How to confirm"
}

# The section naming what works today and changes with the item. Filled
# before start, 'none' included; held against the branch at merge.
EFFECTS='Side effects'

cmd_archive() {
  local id="${1:-}" path root sha discard=0
  [ -n "$id" ] || usage
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --discard) discard=1; shift ;;
      *) usage ;;
    esac
  done
  id=$(require_id "$id")
  require_init

  # Over every checkout: a started item is edited in its worktree, while
  # archive is run from the main checkout.
  path=$(find_item "$id")
  case "$path" in
    */items/archive/*) die "$id is already archived" ;;
  esac

  local main branch
  main=$(default_branch)
  branch=$(local_branches "$(main_root)" "$id")
  require_one_branch "$id" "$branch"
  # Started with the worktree gone — removed, or never cut on this machine —
  # the branch's copy is the item and main's is the item as it started; the
  # checks below read the branch's. A worktree removed by hand and not yet
  # pruned reads the same way, and retire_branch says to prune.
  local tmp='' wt on_branch
  if [ -n "$branch" ]; then
    wt=$(worktree_of "$branch")
    if [ -z "$wt" ] || [ ! -d "$wt" ]; then
      on_branch=$(git ls-tree -r --name-only "$branch" -- "$WB/items" \
        | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
      if [ -n "$on_branch" ]; then
        tmp=$(mktemp)
        # Every refusal below would otherwise leave it behind.
        # shellcheck disable=SC2064
        trap "rm -f '$tmp'" EXIT
        git show "$branch:$on_branch" > "$tmp"
        path=$tmp
      fi
    fi
  fi
  # After the branch read: an item on its branch alone — started under an
  # older workbench, worktree gone — has no copy in any checkout.
  [ -n "$path" ] || die "no item matching '$id'"

  require_closed_fences "$id" "$path"
  local status
  status=$(item_status "$path")
  known_status "$status" \
    || die "$id has 'status: $status', which is not a status; the archive takes 'open' (with evidence), 'unreproduced', 'unverified — <trigger>' or 'abandoned — <why>'"
  # A status entered unattended is provisional until the user deletes the
  # marker; the archive is the locked record and takes no provisional
  # decision.
  case "$status" in
    *"(agent)"*) die "$id's 'status: $status' was entered unattended; confirm it by deleting the '(agent)' marker, or change it, then archive" ;;
  esac
  # --discard drops what a branch carries beyond the item: an abandoned
  # item's half-built work. Anything else on a branch is work that merges.
  if [ "$discard" -eq 1 ]; then
    case "$status" in
      abandoned*) ;;
      *) die "--discard is for abandoned items; $id merges or is retired as it is" ;;
    esac
  fi

  # The file is locked once archived, so its shape is checked on the way in:
  # only the headings the class template wrote. A section the template did
  # not ask for is a log, a parked call, or a second Evidence — none of which
  # belongs in the record.
  local extra
  extra=$(foreign_headings "$id" "$path")
  [ -z "$extra" ] || die "$id carries sections its template does not have; fold them into the template's sections or delete them:
$(printf '%s\n' "$extra" | sed 's/^/  ## /')"
  extra=$(repeated_headings "$path")
  [ -z "$extra" ] || die "$id carries these sections twice; the gates read only as far as the first, so fold each pair into one:
$(printf '%s\n' "$extra" | sed 's/^/  ## /')"
  extra=$(open_decisions_of "$path")
  [ -z "$extra" ] || die "$id has a decision waiting under '## Decisions'; answer it in the field it changes and delete the line, then archive:
$(printf '%s\n' "$extra" | sed 's/^/  /')"

    case "$status" in
      awaiting*)
        die "$id is awaiting a trigger and does not archive as-is. When the trigger
  fires, set 'status: open', record the evidence, then archive; or re-state it as
  'unverified — <trigger>' if no bound can be named." ;;
      unverified*)
        # The trigger is the whole value of an unverified archive: it is what a
        # later search matches on.
        case "$status" in
          *—*|*" - "*) ;;
          *) die "$id: 'unverified' must name its trigger, e.g. status: unverified — resolves when the server next pushes an announcement" ;;
        esac ;;
      unreproduced*) ;;
      abandoned*)
        # The why is the record — 'find' surfaces it on the paths the item
        # named — and shipped work is not abandoned: with the trailer on the
        # default branch the item merged, and it is archived as what it is.
        case "$status" in
          *—*|*" - "*) ;;
          *) die "$id: 'abandoned' must say why, e.g. status: abandoned — the realm yield turned out to be fixed upstream" ;;
        esac
        local shipped
        shipped=$(merged_sha "$(main_root)" "$main" "$id")
        [ -z "$shipped" ] || die "$id merged as $shipped; shipped work is not abandoned — archive it as 'open' with evidence, or 'unverified — <trigger>'" ;;
      *)
        if ! has_evidence "$path"; then
          die "$id has no evidence recorded; archive requires it (or status: unreproduced / unverified — <trigger> / abandoned — <why>)"
        fi ;;
    esac

  # A branch still standing means the item has not merged, and archiving now
  # would record 'commit: none' for good while the squash commit arrives
  # later. The branches that legitimately never merge — an unreproduced
  # bug's, an abandoned item's — are retired here.
  if [ -n "$branch" ]; then
    case "$id:$status" in
      *:abandoned*) path=$(retire_branch "$id" "$branch" "$path" "$discard") ;;
      *:unreproduced*) path=$(retire_branch "$id" "$branch" "$path") ;;
      *) die "$id still has branch $branch; merge it first — archive records the squash commit" ;;
    esac
  fi

  # The commit that carries this item's trailer, searched on the default branch
  # only. The squash commit is the one that legitimately carries the trailer
  # and it lives there; HEAD would miss it from a worktree branched before the
  # merge, and --all (or HEAD from the item's own worktree) could hit a branch
  # commit that the squash then discards — a dangling SHA in the archive.
  sha=$(merged_sha "$(main_root)" "$main" "$id")
  # Never fall back to HEAD: HEAD is whatever the checkout happens to sit on,
  # and recording it would write a commit into the archive that did not
  # implement the item. An item with no trailer — an unreproduced bug — says so.
  if [ -z "$sha" ]; then
    sha=none
    echo "no commit on $main carries 'Item: $id'; recorded as commit: none" >&2
  fi

  # Assigned here and not earlier, deliberately: retire_branch above returns a
  # new $path — main's copy, after it has removed the worktree — so a root taken
  # before that call points at a directory that no longer exists. Anything above
  # this line that needs the main checkout must say '$(main_root)', not '$root';
  # 'git -C ""' is a silent no-op that resolves against the caller's cwd, so an
  # empty $root would look like it worked.
  root=$(item_root "$path")
  local dest
  dest="$root/$WB/items/archive/$(basename "$path")"
  mkdir -p "$(dirname "$dest")"

  # An item created but never committed is untracked, so git mv cannot move it.
  # Every other failure is real and must not be swallowed. The commit line
  # goes on after the move: a move that fails leaves the file as it was, so a
  # re-run appends it once.
  if git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
    git -C "$root" mv "$path" "$dest"
  else
    mv "$path" "$dest"
  fi
  printf '\ncommit: %s\n' "$sha" >> "$dest"

  echo "archived $id at $sha"
  echo "next: git -C $root add -A $WB/items && git -C $root commit -m 'archive $id'" >&2
}

# One line per document over its cap: the file, its length against the cap,
# and the review that cuts it. Silent when every one is under. Caps are the
# CAP_* defaults unless 'git config workbench.cap.<name>' says otherwise; a
# value that is not a number falls back to the default rather than refusing.
cap_alert() {
  local mainr f name key cap n
  mainr=$(main_root)
  for f in "CLAUDE.md:claude:$CAP_CLAUDE" \
           "$WB/GLOSSARY.md:glossary:$CAP_GLOSSARY" \
           "$WB/BACKLOG.md:backlog:$CAP_BACKLOG" \
           "$WB/DECISIONS.md:decisions:$CAP_DECISIONS"; do
    name=${f%%:*}; key=${f#*:}; key=${key%%:*}; cap=${f##*:}
    [ -f "$mainr/$name" ] || continue
    n=$(git config --get "workbench.cap.$key" 2>/dev/null || true)
    case "$n" in ''|*[!0-9]*) ;; *) cap=$n ;; esac
    n=$(wc -l < "$mainr/$name")
    [ "$n" -le "$cap" ] || printf 'cap: %s %s/%s — run /workbench-review docs\n' "$name" "$n" "$cap"
  done
}

# --- hook input -------------------------------------------------------------

# The hook input, read once, and every field looked at pulled in one pass —
# a python3 per field is most of a hook's latency. Without python3, a sed
# that takes the first string under the key's last segment.
# Dotted paths out of a JSON object on stdin: one line per path, in argument
# order, empty for a path that is missing or whose value is not a string.
#
# The count is the contract. A missing field still gets its line, because
# every caller reads the output positionally — 'read_hook_input' binds them
# by index — and a dropped line would shift every field after it onto
# the wrong name. Callers still default with '${vals[i]:-}': command
# substitution eats trailing newlines, so an all-empty result arrives short.
#
# One invocation for all of them. A python3 start is ~15ms and this runs on
# every hook and every status-line repaint, so a call per field was most of
# what either cost.
#
# No jq leg. jq is on none of the machines this runs on, so it would be a
# third implementation no test could reach, and an unreachable leg is where a
# bug lives longest. (Elsewhere in this repo the convention is "jq, or fall
# back"; this is a call about this tool, not about that convention.)
json_fields() {
  local input k
  input=$(cat 2>/dev/null || true)
  if command -v python3 >/dev/null 2>&1; then
    # Never fails: unparseable input yields one empty line per path, which is
    # what the caller would have got from a refusal anyway.
    printf '%s' "$input" | python3 -c '
import json, re, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
for path in sys.argv[1:]:
    v = d
    for k in path.split("."):
        v = v.get(k) if isinstance(v, dict) else None
    if isinstance(v, str):
        print(re.sub(r"\s+", " ", v))
    elif isinstance(v, bool):
        print("true" if v else "false")
    elif isinstance(v, (int, float)):
        print(v)
    else:
        print("")' "$@" 2>/dev/null || true
    return 0
  fi
  # No python3: a text scan, one key at a time, matching the FIRST occurrence
  # of the path's last segment. A trailing '.*' is greedy, so a plain
  # 's/.*"key".*/\1/' takes the LAST match on the line — on a compact payload
  # that is a nested copy under some other object rather than the field asked
  # for.
  #
  # A heuristic, not a parser, and it stays one: it ignores the path's
  # prefix, and a nested key written *before* the real one still wins. It is
  # aimed at how these payloads are actually written, with the top-level
  # fields first. awk rather than 'grep -o | head -1' because 'head' closes
  # the pipe on its first line and the writer takes SIGPIPE, which under
  # 'set -o pipefail' is a 141 the caller reads as failure.
  for k in "$@"; do
    printf '%s' "$input" | awk -v key="${k##*.}" '
      !done && match($0, "\"" key "\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|-?[0-9][0-9.eE+-]*|true|false)") {
        s = substr($0, RSTART, RLENGTH)
        sub(/^[^:]*:[[:space:]]*/, "", s); gsub(/^"|"$/, "", s)
        print s; done = 1
      }
      END { if (!done) print "" }'
  done
}

hook_input=""
HOOK_FIELDS="source"
h_source=""
read_hook_input() {
  hook_input=$(cat 2>/dev/null || true)
  [ -n "$hook_input" ] || return 0
  local k vals=() i=0
  # ':-' below, not just the count from json_fields: a process substitution
  # ending in all-empty lines still arrives as fewer elements than fields.
  # shellcheck disable=SC2086
  mapfile -t vals < <(printf '%s' "$hook_input" | json_fields $HOOK_FIELDS)
  # shellcheck disable=SC2086
  for k in $HOOK_FIELDS; do
    printf -v "h_${k//./_}" '%s' "${vals[$i]:-}"; i=$((i + 1))
  done
}

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# --- round: the review dialog's accountant --------------------------------

# workbench round <id> <fixed> <stands>
# Records one round of the review dialog on the item — 'rounds: r1 5/2 ·
# r2 2/0 · stop' under its status line — and says what comes next. The rule
# is numeric so the worker cannot talk itself out of a third round or into
# a sixth: round 2 always; another while the last round fixed three or
# more, or as many as the round before it (two at least) — one fix after a
# clean round is a tail, not a trend; the cap parks it.
ROUND_CAP=5
cmd_round() {
  local id="${1:-}" fixed="${2:-}" stands="${3:-}"
  [ -n "$id" ] || usage
  [ $# -eq 3 ] || usage
  # Each on its own: concatenated, an empty count borrows the other's digits —
  # '' and '3' read as the single count '3' and passed.
  case "$fixed" in *[!0-9]*|'') die "fixed and stands are counts: workbench round $id <fixed> <stands>" ;; esac
  case "$stands" in *[!0-9]*|'') die "fixed and stands are counts: workbench round $id <fixed> <stands>" ;; esac
  id=$(require_id "$id")
  local path
  path=$(find_item "$id")
  [ -n "$path" ] || die "no item matching '$id'"
  grep -q '^status: ' "$path" || die "$path has no status line"
  local line prev_fixed=0 k=1 entries decision
  line=$(sed -n 's/^rounds: *//p' "$path" | head -1)
  if [ -n "$line" ]; then
    entries=$(printf '%s' "$line" | sed 's/ · \(stop\|call\|again\)$//')
    k=$(( $(printf '%s' "$entries" | grep -o 'r[0-9]*' | wc -l) + 1 ))
    prev_fixed=$(printf '%s' "$entries" | sed -n 's/.*r[0-9]* \([0-9]*\)\/[0-9]*$/\1/p')
    [ -n "$prev_fixed" ] || prev_fixed=0
    entries="$entries · r$k $fixed/$stands"
  else
    entries="r1 $fixed/$stands"
  fi
  if [ "$k" -eq 1 ]; then
    decision=again
  elif [ "$fixed" -lt 3 ] && [ "$fixed" -lt "$(( prev_fixed > 2 ? prev_fixed : 2 ))" ]; then
    decision=stop
  elif [ "$k" -ge "$ROUND_CAP" ]; then
    decision=call
  else
    decision=again
  fi
  local tmp
  tmp=$(mktemp)
  if [ -n "$line" ]; then
    sed "s|^rounds: .*|rounds: $entries · $decision|" "$path" > "$tmp"
  else
    awk -v r="rounds: $entries · $decision" '{ print } /^status: / && !done { print r; done = 1 }' "$path" > "$tmp"
  fi
  # mktemp creates 0600; the replace must not carry that onto the item file,
  # which is committed and read by everything downstream.
  chmod --reference="$path" "$tmp"
  mv -f "$tmp" "$path"
  echo "rounds: $entries"
  case "$decision" in
    again) echo "next: review again — a new reviewer, round $((k + 1))" ;;
    stop) echo "next: merge — workbench merge $id \"<subject>\"; /workbench-review pre-merge $id first when the user asks for the gate" ;;
    call) echo "next: call — $ROUND_CAP rounds and still finding; workbench call $id with the standing findings, then report blocked" ;;
  esac
}

# --- ideas ------------------------------------------------------------------

# One line onto the backlog, in the main checkout wherever this runs. The
# backlog is housekeeping and lands on the default branch; appended in a
# worktree it would ride that item's squash under its trailer. What it
# leaves behind is an unstaged edit on main, which merge tolerates.
cmd_idea() {
  local line="${1:-}" f
  [ $# -eq 1 ] && [ -n "$line" ] || usage
  require_init
  case "$line" in *$'\n'*) die "an idea is one line" ;; esac
  # One obvious sentence. A status report or a parked question at two hundred
  # words makes the backlog a mailbox; those have a place of their own:
  # 'workbench call'.
  [ "${#line}" -le "$IDEA_MAX" ] || die "an idea is one obvious sentence, under $IDEA_MAX characters; a question for the user is 'workbench call', a status is nowhere"
  f="$(main_root)/$WB/BACKLOG.md"
  [ -f "$f" ] || die "no $f; run 'workbench init' in the main checkout"
  # A last line missing its newline would otherwise absorb the entry.
  [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
  printf -- '- %s\n' "$line" >> "$f"
  echo "$f"
}

# A decision that is the user's, parked while they are not there: one line
# in the main checkout's DECISIONS.md, naming the item it came from. The user
# answers by editing the item and deleting the line; 'status' counts them.
cmd_call() {
  local id="${1:-}" line="${2:-}" f
  [ $# -eq 2 ] && [ -n "$id" ] && [ -n "$line" ] || usage
  require_init
  case "$id" in
    -) id='' ;;
    *) id=$(require_id "$id") ;;
  esac
  case "$line" in *$'\n'*) die "a call is one line" ;; esac
  [ "${#line}" -le "$CALL_MAX" ] || die "a call is one question under $CALL_MAX characters; the reasoning behind it belongs in the item"
  if [ -z "$id" ]; then
    f="$(main_root)/$WB/DECISIONS.md"
    [ -f "$f" ] || write_decisions "$f"
    [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
    printf -- '- %s\n' "$line" >> "$f"
    # Committed alone, like an item's start: the pre-merge gate reads git, and
    # a call left unstaged on main is one it cannot see.
    land_item "$f" "call parked"
    echo "$f"
    return 0
  fi
  # The question lives with the reasoning: in the item, in the copy that is
  # the item — its branch's once started, main's before. A started item's
  # call therefore lands on the branch, never on main, so the worker's own
  # question does not put its branch behind main at merge.
  f=$(find_item "$id")
  [ -n "$f" ] || die "no item matching '$id'"
  case "$f" in */items/archive/*) die "$id is archived; a call on it is a new item" ;; esac
  require_closed_fences "$id" "$f"
  local root
  root=$(item_root "$f")
  if ! grep -q '^## Decisions' "$f"; then
    # An item written before the section existed.
    [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
    printf '\n## Decisions\n' >> "$f"
  fi
  # The line goes at the end of the section: before the next heading, or at
  # the end of the file when Decisions is last.
  local tmp
  tmp=$(mktemp)
  awk -v l="- $line" '
    /^## Decisions/ { inside = 1 }
    inside && /^## / && !/^## Decisions/ { print l; print ""; inside = 0 }
    { print; prev = $0 }
    END { if (inside) { if (prev != "") print ""; print l } }' "$f" > "$tmp"
  mv "$tmp" "$f"
  if [ "$root" = "$(main_root)" ] && [ -z "$(worktree_of "$(basename "$f" .md)")" ]; then
    land_item "$f" "call $id"
  else
    git -C "$root" add -- "$f"
    git -C "$root" commit --quiet -m "call $id" -- "$f" \
      || die "the commit for ${f#"$root"/} was refused on $(git -C "$root" rev-parse --abbrev-ref HEAD); the file is staged in $root"
    echo "committed ${f#"$root"/} on $(git -C "$root" rev-parse --abbrev-ref HEAD)" >&2
  fi
  echo "$f"
}

# Open decision lines of one item file: the bullets under '## Decisions'.
open_decisions_of() {
  without_fences "$1" | sed -n '/^## Decisions/,/^## /p' | tail -n +2 | grep -v '^## ' \
    | strip_comments | grep '^- ' || true
}

open_calls() {
  local f
  f="$(main_root)/$WB/DECISIONS.md"
  [ -f "$f" ] || return 0
  grep -c '^- ' "$f" || true
}

# --- find -------------------------------------------------------------------

FIND_CAP=10

item_title() {
  sed -n '1s/^# [bf]-[0-9]* — //p' "$1"
}

# Every item file, open or archived, over both checkouts. Archived copies
# first: a worktree cut before an archive still carries the open copy, and a
# first-hit lookup by id must land on the record, not the leftover.
all_items() {
  wb_find items -name '[bf]-*.md' < <(wb_roots) \
    | awk '/\/archive\// { print; next } { rest = rest $0 "\n" } END { printf "%s", rest }'
}

# One index line per item: date, status, title. The date is the commit that
# carries the trailer for an archived item, or the last commit that touched an
# open one; an item never committed takes the file's own date, so the newest
# item sorts first rather than last.
index_line() {
  local f="$1" id date status
  id=$(item_id "$f")
  status=$(shown_status "$f")
  case "$f" in
    */archive/*)
      local sha
      sha=$(sed -n 's/^commit: *//p' "$f" | tail -1)
      date=$(git log -1 --format=%cs "$sha" -- 2>/dev/null || true) ;;
  esac
  [ -n "${date:-}" ] || date=$(git -C "$(item_root "$f")" log -1 --format=%cs -- "$f" 2>/dev/null || true)
  [ -n "${date:-}" ] || date=$(date -r "$f" +%F)
  printf '%s\t%s\t%s\t%s\n' "$date" "$id" "${2:-$status}" "$(item_title "$f")"
}

# Retrieval keyed to files, not topics: git already indexes which items touched
# a path, through the trailer, so the answer is exact and costs nothing to
# maintain. Words are opt-in and narrow that set, or search the items alone
# when no path is given. The output is an index, never bodies — one line per
# item, capped, with unreproduced and unverified items first regardless of age
# because an unproved claim on the file about to change is the hit that bites.
cmd_find() {
  local paths=() words=() all=0 arg
  require_init
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --grep) { [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; } || usage; words+=("$1"); shift ;;
      --all) all=1 ;;
      --) ;;
      -*) usage ;;
      *) paths+=("$arg") ;;
    esac
  done
  [ "${#paths[@]}" -gt 0 ] || [ "${#words[@]}" -gt 0 ] || usage

  # Paths are taken as the shell gives them, relative to the cwd or absolute,
  # while every git call below is pinned to the root — so make them
  # root-relative here, which is also how item text names them. An absolute
  # path outside this checkout stays as it is and matches nothing.
  local prefix top p i
  prefix=$(git rev-parse --show-prefix 2>/dev/null || true)
  top=$(git rev-parse --show-toplevel 2>/dev/null || true)
  for ((i = 0; i < ${#paths[@]}; i++)); do
    p="${paths[$i]}"
    case "$p" in
      "$top"/*) paths[i]="${p#"$top"/}" ;;
      /*) ;;
      *) paths[i]="$prefix${p#./}" ;;
    esac
  done

  local files=() f ids=() id items
  declare -A label=()
  if [ "${#paths[@]}" -gt 0 ]; then
    local main root
    main=$(default_branch)
    root=$(main_root)
    items=$(all_items)
    mapfile -t ids < <(git -C "$root" log "$main" --format='%(trailers:key=Item,valueonly)' -- "${paths[@]}" \
      | grep -E '^[bf]-[0-9]+$' | awk '!seen[$0]++')
    for id in ${ids+"${ids[@]}"}; do
      f=$(printf '%s\n' "$items" | grep -m1 "/$id-[^/]*\.md$" || true)
      [ -n "$f" ] && files+=("$f")
    done
    # An unproved item has no commit on the path, so the trailer cannot find
    # it; it names the path in its own text, and that is the link used here.
    # An abandoned one is the same detector — "this was tried and dropped,
    # here is why" — matched the same way, but not flagged first below: it
    # is a decision, not an unproved claim.
    # Matched on path boundaries: a scope of 'src' or 'api' as a bare
    # substring would hit every item using the word in any sense, and those
    # false hits would then sort to the top as flagged.
    local res=()
    for p in "${paths[@]}"; do res+=("$(path_re "$p")"); done
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$(item_status "$f")" in unreproduced*|unverified*|abandoned*) ;; *) continue ;; esac
      for p in "${res[@]}"; do
        if grep -qE -- "$p" "$f"; then files+=("$f"); break; fi
      done
    done < <(printf '%s\n' "$items" | grep '/archive/')
    # An open item on a sibling branch has no commit on the default branch
    # either, and it is the hit that matters most — work about to collide
    # with this. Matched by text like the unproved ones, and shown as its own
    # class, since a text match can be wrong where a trailer cannot. Only the
    # item the sibling's branch is named for: every other file there is
    # main's copy, inherited.
    local r here
    while IFS= read -r r; do
      here=$(item_id "$(git -C "$r" symbolic-ref -q --short HEAD 2>/dev/null || true)")
      [ -n "$here" ] || continue
      while IFS= read -r f; do
        for p in "${res[@]}"; do
          if grep -qE -- "$p" "$f"; then files+=("$f"); label[$f]="on-branch"; break; fi
        done
      done < <(find "$r/$WB/items" -path '*/archive/*' -prune -o -name "$here-*.md" -print 2>/dev/null)
    done < <(all_roots | grep -vxF -f <(wb_roots))
    # An open item here or in the main checkout has no commit on the path
    # either — created and not started, or started and not merged — and the
    # trailer cannot see it. Text-matched like the others, shown as 'open'.
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ "$(item_status "$f")" = open ] || continue
      for p in "${res[@]}"; do
        if grep -qE -- "$p" "$f"; then files+=("$f"); label[$f]="open"; break; fi
      done
    done < <(printf '%s\n' "$items" | grep -v '/archive/')
  else
    mapfile -t files < <(all_items)
  fi

  # One line per id, not per copy: from a sibling worktree cut before an
  # archive, all_items yields its open copy and main's archived one. The
  # archive/ path wins — it is the record — else the first hit keeps its label.
  local w kept=() order=() id
  declare -A pick=()
  for f in ${files+"${files[@]}"}; do
    id=$(item_id "$f")
    if [ -z "${pick[$id]+x}" ]; then
      order+=("$id"); pick[$id]=$f
    else
      case "$f" in */archive/*) case "${pick[$id]}" in */archive/*) ;; *) pick[$id]=$f ;; esac ;; esac
    fi
  done
  for id in ${order+"${order[@]}"}; do
    f=${pick[$id]}
    for w in ${words+"${words[@]}"}; do
      grep -qiF -- "$w" "$f" || continue 2
    done
    kept+=("$f")
  done

  if [ "${#kept[@]}" -eq 0 ]; then
    echo "no items"
    return 0
  fi

  # Flagged first, then newest. The flag column is stripped before printing.
  local lines
  lines=$(for f in "${kept[@]}"; do
    case "$(item_status "$f")" in
      unreproduced*|unverified*) printf '0\t' ;;
      *) printf '1\t' ;;
    esac
    printf '%s\t' "$(item_id "$f" | sed 's/^[bf]-//')"
    index_line "$f" ${label[$f]+"${label[$f]}"}
  done | sort -s -t "$(printf '\t')" -k1,1 -k3,3r -k2,2nr)

  local total shown
  total=$(printf '%s\n' "$lines" | wc -l)
  shown=$total
  [ "$all" -eq 1 ] || [ "$total" -le "$FIND_CAP" ] || shown=$FIND_CAP

  printf '%s\n' "$lines" \
    | awk -F '\t' -v n="$shown" 'NR <= n { printf "%-6s  %-10s  %-28s  %s\n", $4, $3, $5, $6 }'
  if [ "$shown" -lt "$total" ]; then
    echo "… $((total - shown)) more; narrow with a path or --grep, or pass --all"
  fi
}

# --- reviews ----------------------------------------------------------------

# In-flight work is branches plus items merged as 'awaiting', which have no
# branch left. Both halves are needed; neither alone is the answer.
#
# One line per item: from its own worktree when the branch has one — that is
# where the item is edited — else from the main checkout. Every worktree
# inherits main's copies, so a copy in a sibling is not a second item and is
# not counted, and an item archived on main whose open copy still sits in a
# worktree cut before the archive is archived, not open. Only an item on no
# branch and not on main — untracked in a sibling, written by hand or by an
# older workbench — is shown from where it is, and labelled.
status_lines() {
  local name="$1" f='' st own started='' where='' mainr d tmp=''
  shift
  mainr=$(main_root)
  own=$(worktree_of "${name%.md}")
  if [ -n "$own" ] && [ -d "$own" ]; then
    f=$(find "$own/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
    started='   started'
  fi
  if [ -z "$f" ]; then
    [ -z "$(find "$mainr/$WB/items/archive" -name "$name" -print -quit 2>/dev/null)" ] || return 0
    f=$(find "$mainr/$WB/items" -name "$name" -print -quit 2>/dev/null || true)
    # A branch with no worktree — removed by hand, or only fetched from
    # another machine — is started too; 'start' resumes it.
    # Not local_branches: that globs '<id>-*', and this asks whether a branch
    # of exactly this name exists. The two differ when one slug is a prefix of
    # another — b-1-foo would answer for b-1-foobar.
    [ -z "$(git -C "$mainr" for-each-ref --format='%(refname:short)' "refs/heads/${name%.md}")" ] || started='   started'
    if [ -n "$f" ] && ! git -C "$mainr" ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      where="   [not committed — 'workbench start' lands it]"
    fi
  fi
  if [ -z "$f" ]; then
    for d in "$@"; do
      f=$(find "$d" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
      [ -z "$f" ] || break
    done
    if [ -n "$f" ]; then
      where="   [in $(basename "$(item_root "$f")"), not on $(default_branch)]"
    elif [ -n "$started" ]; then
      # On its branch alone: read from there, and say so.
      local on_branch
      on_branch=$(git -C "$mainr" ls-tree -r --name-only "${name%.md}" -- "$WB/items" 2>/dev/null \
        | grep -F "/$name" | grep -v '/archive/' | head -1 || true)
      [ -n "$on_branch" ] || return 0
      tmp=$(mktemp)
      git -C "$mainr" show "${name%.md}:$on_branch" > "$tmp"
      f=$tmp
      where="   [on its branch only; 'workbench start' resumes it]"
    else
      return 0
    fi
  fi
  # Read, then remove: a temp file must not outlive a failed read.
  st=$(shown_status "$f" || true)$started
  [ -z "$tmp" ] || rm -f "$tmp"
  printf '  %-34s %s%s\n' "${name%.md}" "$st" "$where"
}

cmd_status() {
  local dirs=()
  require_init
  # Run by the SessionStart hook, which also fires on compaction — and the
  # compacted context has lost every invoked skill body and every path rule
  # it had read; only CLAUDE.md and this output come back (agent-kit's
  # README; not probed here). Say so first, so the next step is the skill.
  # Stdin is read only when something is already there: by hand it is a tty,
  # and a pipe with nothing on it must not block.
  if [ ! -t 0 ] && read -t 0 -r _ 2>/dev/null; then
    read_hook_input
    if [ "$h_source" = compact ]; then
      echo "compaction dropped the workbench skill body and every .claude/rules file from this context; invoke the workbench skill before the next step"
      echo
    fi
  fi
  # Every checkout: an item on a sibling worktree's branch is in flight too.
  mapfile -t dirs < <(wb_dirs items < <(all_roots))

  local names=() name
  mapfile -t names < <(open_names)

  # Before the items, so a session start reads it first: a file past its
  # line cap is a docs review to run, and the number says how far past.
  local alert
  alert=$(cap_alert)
  if [ -n "$alert" ]; then
    echo "$alert"
    echo
  fi
  # Per clone, like every workbench key: a fresh clone has none, and a merge
  # there runs no project check — said here, where every session start reads.
  if [ -z "$(git config --get workbench.premerge 2>/dev/null || true)" ]; then
    echo "premerge: unset — merges run no project check in this clone; git config workbench.premerge \"<the project's test or gate command>\""
    echo
  fi
  echo "open items"
  if [ "${#names[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    for name in "${names[@]}"; do status_lines "$name" "${dirs[@]}"; done
  fi

  echo
  echo "branches"
  git branch --format='  %(refname:short)' | grep -E '^  [bf]-[0-9]+-' \
    || echo "  (none)"

  # Merged and open: invisible to 'git branch', so nothing but a grep or a
  # sweep surfaces one whose trigger never fired. Merged means on the default
  # branch, so main's copies are the ones read; a worktree's copy of one is
  # inherited from there.
  echo
  echo "merged, still awaiting a trigger"
  local hits=()
  # 'awaiting' is chosen at pre-merge, so an item still on its branch carries
  # it too; that one is in flight and listed above, not merged.
  mapfile -t hits < <(awaiting_on_main)
  if [ "${#hits[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    local f
    for f in "${hits[@]}"; do
      printf '  %-34s %s\n' "$(basename "$f" .md)" "$(item_status "$f")"
    done
  fi

  # Merged and still 'open', with no branch: the trailer is on the default
  # branch and the file is not in the archive. Not a state the tables have —
  # it is an item that merged with its criterion unrun and never said so, or
  # one archived nowhere. Either archive it or give it the status it needs.
  echo
  echo "merged, still open — archive, or set 'awaiting — <trigger>' / 'unverified — <trigger>'"
  local mainr mainb mid limbo=0
  mainr=$(main_root)
  mainb=$(default_branch 2>/dev/null) || mainb=""
  if [ -n "$mainb" ]; then
    for name in "${names[@]}"; do
      mid=$(item_id "$name")
      [ -n "$mid" ] || continue
      [ -z "$(local_branches "$mainr" "$mid")" ] || continue
      f=$(find "$mainr/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
      [ -n "$f" ] || continue
      local st sha
      st=$(item_status "$f")
      case "$st" in awaiting*|unverified*) continue ;; esac
      sha=$(git -C "$mainr" log "$mainb" --grep="^Item: $mid\$" --format=%h -1)
      [ -n "$sha" ] || continue
      # Shipped work carrying a status that never merges: archive refuses
      # it, so skipped here it would be the one combination nothing lists.
      case "$st" in
        unreproduced*|abandoned*) printf '  %-34s merged as %s, yet \x27%s\x27 — archive will refuse; set open with evidence, or unverified — <trigger>\n' "${name%.md}" "$sha" "$st" ;;
        *) printf '  %-34s merged as %s\n' "${name%.md}" "$sha" ;;
      esac
      limbo=1
    done
  fi
  [ "$limbo" -eq 1 ] || echo "  (none)"

  # Decisions entered unattended, in the item files themselves — the marker
  # is what the user greps for, and a DECISIONS.md line can go without it.
  # From the copy that is the item: its branch's when it has one, else main's.
  local prov=() pf pl
  for name in "${names[@]}"; do
    pf=$(item_copy "$name")
    [ -n "$pf" ] || continue
    while IFS= read -r pl; do
      [ -n "$pl" ] || continue
      prov+=("$(printf '%-34s %s' "${name%.md}" "$pl")")
    done < <(without_fences "$pf" | grep -E '^status:.*\(agent\)' | sed 's/[[:space:]]*$//' || true)
  done
  if [ "${#prov[@]}" -gt 0 ]; then
    echo
    echo "provisional decisions (agent) — confirm by deleting the marker, or overrule in the item"
    printf '  %s\n' "${prov[@]}"
  fi

  # Decisions parked in the items themselves, from the copy that is the item.
  local dec=() dl
  for name in "${names[@]}"; do
    pf=$(item_copy "$name")
    [ -n "$pf" ] || continue
    while IFS= read -r dl; do
      [ -n "$dl" ] || continue
      dec+=("$(printf '%-34s %s' "${name%.md}" "${dl#- }")")
    done < <(open_decisions_of "$pf")
  done
  if [ "${#dec[@]}" -gt 0 ]; then
    echo
    echo "decisions waiting on the user — answer in the item, then delete the line"
    printf '  %s\n' "${dec[@]}"
  fi

  # Calls tied to no item.
  local calls
  calls=$(open_calls)
  if [ -n "$calls" ] && [ "$calls" -gt 0 ]; then
    echo
    echo "calls waiting on the user — $WB/DECISIONS.md"
    grep '^- ' "$mainr/$WB/DECISIONS.md" | sed 's/^- /  /'
  fi

  # Same ID under two slugs, open items and archive alike — the archive holds
  # the spent numbers a fresh allocation collides with. Names are deduplicated
  # first: the same file in two checkouts is one item. Cause and repair:
  # references/git.md, "Duplicate IDs across machines".
  local dupes
  dupes=$(wb_find items -name '[bf]-*-*.md' -print < <(all_roots) \
    | sed 's|.*/||' | sort -u \
    | sed -n 's|^\([bf]-[0-9]\{1,\}\)-.*|\1|p' | sort | uniq -d)
  if [ -n "$dupes" ]; then
    echo
    echo "DUPLICATE IDS — see references/git.md for repair"
    printf '%s\n' "$dupes" | sed 's/^/  /'
  fi

  # Rendered copies that no longer match. Listed, not fixed: init refreshes
  # them, and that is a commit the user makes. An edited copy is named apart
  # from a stale one, since init overwrites the first only when told to.
  local drift stale edited
  drift=$(skill_drift)
  stale=$(awk -F '\t' '$2 != "edited" { printf "%s ", $1 }' <<< "$drift")
  edited=$(awk -F '\t' '$2 == "edited" { printf "%s ", $1 }' <<< "$drift")
  if [ -n "${stale// /}" ]; then
    echo
    echo "skills behind their source — run 'workbench init', then commit .claude/"
    echo "  $stale"
  fi
  if [ -n "${edited// /}" ]; then
    echo
    echo "skills edited by hand under .claude/skills/ — move the edit into the source; 'workbench init --force' overwrites"
    echo "  $edited"
  fi
  # Agents are listed apart from the skills because the answer is weaker: a
  # copy that differs may be behind its source or may have been edited, and
  # nothing recorded here can tell them apart. Either way init overwrites it.
  local agents
  agents=$(agent_drift | awk -F '\t' '{ printf "%s ", $1 }')
  if [ -n "${agents// /}" ]; then
    echo
    echo "agents differ from their source — run 'workbench init', then commit .claude/"
    echo "  $agents"
  fi
  # The memory setting is a path, committed: a clone laid out differently
  # from the one init ran in points at a store that is not in its tree.
  local mem
  mem=$(memory_dir_setting)
  case "$mem" in
    "$(main_root)/.claude/memory" | "") ;;
    */.claude/memory)
      echo
      echo "memory: autoMemoryDirectory points at $mem, not this checkout's .claude/memory — the setting was written for a clone at another path; override it here in .claude/settings.local.json"
      ;;
  esac

  # Reports are untracked and live per checkout; baselines live in the shared
  # git directory. Classify each name over the union of both, from every
  # worktree, so the labels hold from any checkout:
  #   report + baseline  the sweep never returned (the invoker is blocked while
  #                      one runs, so nobody sees this mid-sweep) — or
  #                      review-check failed and left the baseline for a re-run
  #   report only        checked, waiting for triage
  #   baseline only      the report went without 'review-drop'
  local reports=() name
  mapfile -t reports < <({
    wb_find reviews -maxdepth 1 -name '*.md' < <(all_roots) | sed 's|.*/||'
    find "$(baseline_dir)" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | sed 's|.*/||'
  } | sort -u)
  if [ "${#reports[@]}" -gt 0 ]; then
    echo
    echo "reports"
    for name in "${reports[@]}"; do
      local has_report=0 has_base=0
      [ -n "$(find_report "$name")" ] && has_report=1
      [ -f "$(baseline_dir)/$name" ] && has_base=1
      if [ "$has_report" -eq 1 ] && [ "$has_base" -eq 1 ]; then
        printf '  %-40s unchecked — never returned, or review-check failed; inspect, then drop\n' "$name"
      elif [ "$has_report" -eq 1 ]; then
        printf '  %-40s awaiting triage\n' "$name"
      else
        printf '  %-40s stale marker — review-drop it\n' "$name"
      fi
    done
  fi
}

# Item names in flight, over every checkout, once each — an item is in the
# main checkout and in every worktree cut since it landed — and without those
# the main checkout has archived: a worktree cut before an archive keeps the
# open copy, and that copy is not an item.
# A branch named like an item whose file is in no checkout — started under
# an older workbench, worktree gone — is an item too, and is listed from the
# branch.
open_names() {
  local archived
  archived=$(find "$(main_root)/$WB/items/archive" -name '[bf]-*.md' 2>/dev/null | sed 's|.*/||')
  {
    wb_find items -path '*/archive/*' -prune -o -name '[bf]-*.md' -print < <(all_roots 2>/dev/null) | sed 's|.*/||'
    git for-each-ref --format='%(refname:short).md' 'refs/heads/[bf]-*' | grep -E '^[bf]-[0-9]+-'
  } | sort -u \
    | { if [ -n "$archived" ]; then grep -vxF -f <(printf '%s\n' "$archived") || true; else cat; fi; }
}

# The copy of an item that is the item: on its branch when it has a worktree,
# else in the main checkout — never a sibling's inherited copy. Empty for an
# item archived on main or held on its branch alone.
item_copy() {
  local name="$1" own f='' mainr
  mainr=$(main_root)
  own=$(worktree_of "${name%.md}")
  if [ -n "$own" ] && [ -d "$own" ]; then
    f=$(find "$own/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
  fi
  if [ -z "$f" ]; then
    [ -z "$(find "$mainr/$WB/items/archive" -name "$name" -print -quit 2>/dev/null)" ] || return 0
    f=$(find "$mainr/$WB/items" -name "$name" -print -quit 2>/dev/null || true)
  fi
  [ -z "$f" ] || printf '%s\n' "$f"
}

# Items merged as 'awaiting' — on the default branch, so read from the main
# checkout — whose branch is gone: one still on its branch is in flight.
awaiting_on_main() {
  local mainr h
  mainr=$(main_root)
  [ -d "$mainr/$WB/items" ] || return 0
  grep -rl '^status: awaiting' "$mainr/$WB/items" --exclude-dir=archive 2>/dev/null | sort \
    | while IFS= read -r h; do
        [ -n "$(local_branches "$mainr" "$(item_id "$h")")" ] || printf '%s\n' "$h"
      done
  return 0
}

# Every checkout of the repository, a removed-by-hand one included until it is
# pruned; wb_dirs drops those. Reports are untracked and stay in the checkout
# the sweep ran in, so unlike items — which wb_roots covers — a report can
# sit in any worktree, and only the full list finds it.
all_roots() {
  git worktree list --porcelain | sed -n 's/^worktree //p'
}

# A report by bare name or path, searched over every checkout.
find_report() {
  wb_find reviews -maxdepth 1 -name "$(basename "$1")" -print -quit < <(all_roots)
}

# A report holds findings when something other than the heading, the date
# line and HTML comments is present — structural,
# like has_evidence, because the baseline predates the skeleton and so holds
# no hash to compare against.
has_findings() {
  local body
  body=$(strip_comments < "$1" \
    | grep -v -e '^# ' -e '^date: ' -e '^checked: ') || true
  grep -q '[^[:space:]]' <<<"$body"
}

# The one removal path for a report, at either end of its life: an orphan left
# by a sweep that never returned, or a report whose triage is done. Deletes
# whichever of the report and its baseline exist, so neither can be left behind
# for the other to be forgotten about.
cmd_review_drop() {
  local report='' force='' name path base
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=--force ;;
      -*) usage ;;
      *) [ -z "$report" ] || usage; report="$1" ;;
    esac
    shift
  done
  [ -n "$report" ] || usage
  require_init

  name=$(basename "$report")
  path=$(find_report "$name")
  base="$(baseline_dir)/$name"
  [ -n "$path" ] || [ -f "$base" ] || die "no report or baseline named '$name'"

  # Triage leaves no mark on the report, so content alone cannot tell a triaged
  # report from one nobody has read. The baseline can: review-check removes it
  # on a clean pass, so while it exists the findings are unseen — or the check
  # failed, and they are the findings of a sweep that tampered with the tree.
  # Either way they do not vanish on a bare drop.
  if [ -n "$path" ] && [ -f "$base" ] && has_findings "$path" && [ "$force" != "--force" ]; then
    die "$name is unchecked and has findings; run review-check, or pass --force to discard them"
  fi

  # Scratch sits beside the report, in whichever checkout the sweep was rooted.
  local root d
  root=$(repo_root)
  [ -z "$path" ] || root=${path%/"$WB"/reviews/*}
  [ -n "$path" ] && rm -f "$path" && echo "deleted $path"
  [ -f "$base" ] && rm -f "$base" && echo "deleted baseline for $name"
  d=$(scratch_dir "$root" "$name")
  [ -d "$d" ] && rm -rf "$d" && echo "deleted scratch for $name"
  return 0
}

baseline_dir() {
  printf '%s\n' "$(git_common_dir)/review-baseline"
}

# Where a sweep may write besides its report: helper scripts, captured output,
# whatever investigation needs. The directory ignores itself, so it never
# shows in the snapshot and needs no entry in the project's .gitignore.
scratch_dir() {
  printf '%s\n' "$1/$WB/scratch/$(basename "$2" .md)"
}

ensure_scratch() {
  local d
  d=$(scratch_dir "$1" "$2")
  mkdir -p "$d"
  [ -f "$d/../.gitignore" ] || printf '*\n' > "$d/../.gitignore"
  printf '%s\n' "$d"
}

# 'git status --porcelain' reports status, not content: a file already showing
# ' M' still shows ' M' after further edits, so porcelain alone cannot tell a
# sweep's changes from the ones already in the tree. The snapshot therefore
# carries content too — a hash of each modified tracked file's diff, and one
# per untracked file — which is what makes the check hold on the dirty tree
# it exists for, and name the file when it does not.
# And HEAD itself: on a clean tree, an edit that is then committed leaves
# status, diff and the untracked set exactly as they were, and only the
# commit says anything happened. Same for a reset or an amend.
#
# Runs from the repository root, always. 'git status --porcelain' is
# root-relative wherever it runs, but 'git ls-files --others' is scoped to the
# current directory and prints paths relative to it — so an unpinned snapshot
# would depend on where it was taken, and the two are taken in different places:
# the baseline wherever the sweep stood, the check wherever the caller stands.
#
# Untracked files are listed one per line: porcelain otherwise collapses an
# untracked directory to a single 'dir/' entry, so a report in a reviews/ that
# holds nothing tracked would show as the directory rather than as itself.
# The diff is git's own, uncoloured: an external diff may print mtimes.
#
# A memory sweep reads the agent's store, outside the tree, and the fork can
# write there; so for that reason the store's files are hashed too, under
# absolute paths, which no tree entry can be confused with.
tree_snapshot() (
  cd "${1:-$(repo_root)}" || die "cannot reach the repository root"
  git status --porcelain --untracked-files=all | sed 's/^/S /'
  if git rev-parse --verify -q HEAD >/dev/null; then
    printf 'T %s\n' "$(git rev-parse HEAD)"
    git diff HEAD --name-only -z \
      | while IFS= read -r -d '' f; do
          printf 'W %s %s\n' "$f" "$(git diff HEAD --no-ext-diff --no-color -- "$f" | sha256sum | cut -d' ' -f1)"
        done
  fi
  git ls-files --others --exclude-standard -z \
    | while IFS= read -r -d '' f; do
        printf 'H %s %s\n' "$f" "$(sha256sum "$f" | cut -d' ' -f1)"
      done
  # Ignored by design — 'ensure_gitignore' keeps it that way — so both scans
  # above look straight past it. It is also where the project's permission
  # allow-list lives, so a sweep with Bash could widen what it is allowed to
  # do and pass. Its own row type, because the refusal wants to say which
  # file and why rather than read as a stray untracked write.
  local s
  while IFS= read -r s; do
    [ -f "$s" ] || continue
    printf 'P %s %s\n' "${s#"$PWD"/}" "$(sha256sum "$s" | cut -d' ' -f1)"
  done < <(printf '%s\n' "$PWD/.claude/settings.local.json" \
    "$(main_root)/.claude/settings.local.json" | awk '!seen[$0]++')
)

# Where Claude Code keeps this project's memory when a setting says so:
# 'autoMemoryDirectory', local settings over project over user, absolute or
# '~/'-based by Claude Code's own rule. Empty when unset.
memory_dir_setting() {
  local f v
  for f in "$(main_root)/.claude/settings.local.json" "$(main_root)/.claude/settings.json" "${HOME%/}/.claude/settings.json"; do
    [ -f "$f" ] || continue
    v=$(json_fields autoMemoryDirectory < "$f")
    [ -n "$v" ] || continue
    # shellcheck disable=SC2088  # the setting's own literal '~/'
    case "$v" in "~/"*) v="${HOME%/}/${v#\~/}" ;; esac
    printf '%s\n' "$v"
    return 0
  done
  return 0
}

# Baseline the CLI recorded before the sweep's first turn, against the tree
# now; the only acceptable delta is the report appearing. Why this and not a
# hook or the tool set: references/rationale.md, "Why the sweep's contract is
# not enforced by a hook".
cmd_review_check() {
  local report="${1:-}" name base root rel added removed
  [ -n "$report" ] || usage
  require_init

  name=$(basename "$report")
  base="$(baseline_dir)/$name"
  [ -f "$base" ] || die "no baseline for '$name'; open the report with 'workbench review'"

  # The report sits in the checkout the sweep ran in, which need not be the
  # one the check runs from; the snapshot is taken there as the baseline was.
  local found
  found=$(find_report "$name")
  [ -n "$found" ] || die "$WB/reviews/$name does not exist in any checkout; the sweep wrote no report"
  root=${found%/"$WB"/reviews/*}
  rel="$WB/reviews/$name"

  # Every untracked file is hashed, twice per sweep; build output left
  # unignored makes that a crawl. Said here, where a person is reading — the
  # sweep's own open cannot warn, since its stdout is the report path alone.
  local untracked
  untracked=$(git -C "$root" ls-files --others --exclude-standard | wc -l)
  [ "$untracked" -le "$SNAPSHOT_WARN" ] \
    || echo "hashing $untracked untracked files; ignore build output to make this quick" >&2

  # A skip-worktree (S) or assume-unchanged (the status letter in lowercase)
  # bit takes a tracked file out of both 'git status' and 'git diff HEAD', so
  # the snapshot cannot see it change at all: the file becomes an editable
  # blind spot for the whole sweep. Nothing workbench does sets these, so a bit
  # standing here is either the sweep's doing or a hand-set flag the reviewer
  # has to clear before the proof means anything.
  local hidden
  hidden=$(git -C "$root" ls-files -v | grep -E '^([a-z]|S) ' | sed 's/^..//' || true)
  [ -z "$hidden" ] || die "these files are hidden from git by a skip-worktree or assume-unchanged bit, so the review baseline cannot see them change; clear them with 'git update-index --no-skip-worktree --no-assume-unchanged <file>', then review again:
$(printf '%s\n' "$hidden" | sed 's/^/  /')"

  local now reason
  reason=$(sed -n 's/^R //p' "$base")
  now=$(tree_snapshot "$root" "$reason")
  added=$(comm -13 <(grep -v -e '^M ' -e '^R ' "$base" | sort) <(printf '%s\n' "$now" | sort))
  removed=$(comm -23 <(grep -v -e '^M ' -e '^R ' "$base" | sort) <(printf '%s\n' "$now" | sort))

  # The report appearing is the whole permitted delta: its porcelain line, and
  # its content hash. Everything else names something the sweep touched, and
  # the first delta fails.
  local bad=0 what
  # A file clean at open and edited since gains both a status line and a diff
  # hash; the status line names it, so its hash line stays quiet.
  declare -A wadded=() sadded=() padded=()
  while IFS= read -r line; do
    case "$line" in
      "S "*) sadded[${line:5}]=1 ;;
      # A protected file that changed shows as both a removed and an added row;
      # the added one carries the message, so the removal stays quiet.
      "P "*) what=${line#P }; padded[${what% *}]=1 ;;
    esac
  done <<< "$added"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "S ?? $rel") ;;
      "H $rel "*) ;;
      "W "*) what=${line#W }; what=${what% *}; wadded[$what]=1
             [ -n "${sadded[$what]:-}" ] || { echo "the sweep changed: $what" >&2; bad=1; } ;;
      "T "*) echo "the sweep moved HEAD to ${line#T }" >&2; bad=1 ;;
      "H "*) echo "the sweep wrote: ${line#H }" >&2; bad=1 ;;
      "P "*) what=${line#P }; what=${what% *}
             echo "the sweep changed: $what — git ignores it, but it carries this project's permission allow-list and memory path. If an 'always allow' was answered during the review, the permissions moved under it: put it back, or review again." >&2; bad=1 ;;
      "S ?? "*) echo "unexpected change: ${line#S }" >&2; bad=1 ;;  # its H line reports it
      "S "*) echo "unexpected change: ${line#S }" >&2; bad=1 ;;
      *) echo "unexpected change: $line" >&2; bad=1 ;;
    esac
  done <<< "$added"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "T "*) ;;   # already reported by its replacement on the added side
      "W "*) what=${line#W }; what=${what% *}
             # a moved hash is reported by its replacement; a vanished one is a revert
             [ -n "${wadded[$what]:-}" ] || { echo "the sweep reverted: $what" >&2; bad=1; } ;;
      "S ?? "*) bad=1 ;;   # its H line reports it
      "S "*) echo "the sweep reverted or staged: ${line#S }" >&2; bad=1 ;;
      "H "*) what=${line#H }; echo "the sweep removed: ${what% *}" >&2; bad=1 ;;
      "P "*) what=${line#P }; what=${what% *}
             [ -z "${padded[$what]:-}" ] || continue
             echo "the sweep removed: $what, which carries this project's permission allow-list and memory path" >&2; bad=1 ;;
      *) echo "the sweep reverted or staged: $line" >&2; bad=1 ;;
    esac
  done <<< "$removed"

  if [ "$bad" -ne 0 ]; then
    die "the sweep modified the tree beyond its report. Inspect the changes above
before triaging; the report may be reporting on code it edited. A file a build
or test run left behind counts too: ignore it or delete it, then re-run."
  fi

  # Nothing here proves the sweep read anything. What it proves is that the
  # evidence points at the tree as it stands — the one failure a sweep that
  # read nothing cannot avoid is citing a place that is not there.
  # The skeleton's own comments name every manifest file, so match against the
  # report with its comments stripped — what the sweep wrote, not what it got.
  local prose tok file line n
  prose=$(mktemp)
  strip_comments < "$root/$rel" > "$prose"

  # Every file in the tree, once, for the slashless tokens below.
  local index
  index=$(git -C "$root" ls-files --cached --others --exclude-standard)

  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    file=${tok%:*}; line=${tok##*:}
    file=${file#./}
    case "$file" in
      */*)
        if [ ! -f "$root/$file" ]; then
          echo "cites $tok, and $file is not in the tree" >&2; bad=1
        else
          n=$(grep -c '' "$root/$file" || true)
          [ "$line" -le "$n" ] || { echo "cites $tok, and $file has $n lines" >&2; bad=1; }
        fi ;;
      *)
        # Test runners and compilers cite basenames — 'pos_test.go:42' — so a
        # slashless token resolves against every file of that name, and passes
        # when any of them reaches the line: this check is "cites nowhere",
        # not "cites precisely". One that names no file is a host — 'db.internal:5432'
        # — when nothing in the tree carries its extension, and a bogus
        # citation otherwise. A dotless one — 'exit:1', 'localhost:5432' —
        # has no extension to ask about, so it is a word unless a file of that
        # name exists: 'Makefile:99' is checked when there is a Makefile and
        # passes when there is none. Decided from the tree, never from the report.
        local esc cands=() ok c
        esc=$(printf '%s' "$file" | sed 's/[][\\.*+?(){}|^$]/\\&/g')
        mapfile -t cands < <(printf '%s\n' "$index" | grep -E "(^|/)$esc\$" || true)
        if [ "${#cands[@]}" -eq 0 ]; then
          esc=$(printf '%s' "${file##*.}" | sed 's/[][\\.*+?(){}|^$]/\\&/g')
          if [[ "$file" == *.* ]] && grep -qE "\\.$esc\$" <<<"$index"; then
            echo "cites $tok, and no $file is in the tree" >&2; bad=1
          fi
        else
          ok=0
          for c in "${cands[@]}"; do
            n=$(grep -c '' "$root/$c" || true)
            [ "$line" -le "$n" ] && { ok=1; break; }
          done
          [ "$ok" -eq 1 ] || { echo "cites $tok, and no $file has $line lines" >&2; bad=1; }
        fi ;;
    esac
  done < <(citations "$prose")

  local missing=()
  mapfile -t missing < <(uncovered "$prose" "$base")
  rm -f "$prose"
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "in scope but never named in the report — unswept, or swept and unstated:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    bad=1
  fi

  if [ "$bad" -ne 0 ]; then
    die "the report does not hold up as written. Fix the citations or state the
coverage, then re-run review-check; or review-drop --force to discard it."
  fi

  # A pre-merge ends in a verdict, and the verdict is what merge reads: a
  # report without one is a review nobody finished, and the baseline stays so
  # it can be finished and checked again.
  local pid verdict=''
  pid=$(printf '%s' "$name" | sed -n 's/^[0-9]*-pre-merge-\([bf]-[0-9]\{1,\}\)\(-.*\)\{0,1\}\(\.[0-9]*\)\{0,1\}\.md$/\1/p')
  if [ -n "$pid" ]; then
    # pre-merge.md asks for the verdict as the last line with nothing after it,
    # and that is read literally here: the last non-blank line of the report,
    # comments stripped. Taking the last *matching* line instead let a verdict
    # sit under prose that qualifies or contradicts it, which is the one place
    # merge cannot afford ambiguity — it reads this line and nothing else.
    local tail_line stripped
    tail_line=$(strip_comments < "$root/$rel" \
      | grep -v '^[[:space:]]*$' | tail -1)
    verdict=$(printf '%s' "$tail_line" | sed -n 's/^verdict: *//p')
    case "$verdict" in
      merge|merge\ *|hold\ *) ;;
      "") stripped=$(strip_comments < "$root/$rel")
          if grep -q '^verdict: ' <<<"$stripped"; then
            die "$rel has a 'verdict:' line, but it must be the last line with nothing after it; move it to the end, then check again"
          fi
          die "$rel has no 'verdict:' line; a pre-merge ends with 'verdict: merge' or 'verdict: hold — <what must change>'" ;;
      *) die "$rel says 'verdict: $verdict'; it is 'merge' or 'hold — <what must change>'" ;;
    esac
  fi

  # Every report is checked once.
  rm -f "$base"
  echo "clean: $rel is the only change, its citations resolve, its scope is named"

  # A passed pre-merge is what 'merge' asks for, and the report is dropped
  # at triage, so the pass is recorded apart from it: the item id from the
  # report's name, the branch commit the sweep read. A branch that moves
  # after this is unreviewed again, which merge checks. A hold records
  # nothing but a count: the worker fixes and reviews again, with a fresh
  # reviewer, and at REVIEW_HOLDS holds it stops and asks.
  if [ -n "$pid" ]; then
    local pbranch holds
    pbranch=$(local_branches "$root" "$pid" | head -1)
    case "$verdict" in
      merge*)
        if [ -n "$pbranch" ]; then
          rm -f "$(git_common_dir)/review-holds/$pid"
          echo "verdict: merge for $pid at $(git -C "$root" rev-parse --short "$pbranch"); review-drop the report, then merge"
        fi ;;
      hold*)
        mkdir -p "$(git_common_dir)/review-holds"
        holds=$(( $(cat "$(git_common_dir)/review-holds/$pid" 2>/dev/null || echo 0) + 1 ))
        printf '%s\n' "$holds" > "$(git_common_dir)/review-holds/$pid"
        echo "verdict: ${verdict} — hold $holds of $REVIEW_HOLDS for $pid; fix on the branch, review-drop this report, then review again"
        [ "$holds" -lt "$REVIEW_HOLDS" ] || echo "$REVIEW_HOLDS holds: stop, 'workbench call $pid \"<the standing finding>\"', and leave the merge to the user" ;;
    esac
  fi
}

# The path:line tokens in a report — the evidence form the sweep is told to
# use. A clock time is cut by its leading digits; a URL's port arrives as
# '//host/path:port' once the scheme is cut at its colon. A token with neither
# slash nor dot — 'Makefile:99', 'exit:1' — is kept and resolved below. Real
# command output cites places outside the tree too — a host:port, a stack
# frame under /usr or ../vendor — and those are skipped by their shape. Only
# ever by shape: the sweep writes the whole report, so any region exempted (a
# fenced block, say) is a region it could hide a bogus citation in.
#
# Brackets and parentheses are path segments only when closed — 'app/[id]/',
# 'src/(group)/' — so that '(README.md:1)' and '[README.md:1]' in prose, or a
# markdown link, yield the path and not the bracket.
citations() {
  grep -oE '([A-Za-z0-9_.+/-]|\([A-Za-z0-9_.+-]+\)|\[[A-Za-z0-9_.+-]+\])+:[0-9]+' "$1" \
    | grep -v -e '://' -e '^//' -e '^/' -e '^\.\./' -e '^[0-9.]*:' | sort -u
}

# Manifest files the report never mentions. A file counts as mentioned by its
# own path or by any parent directory written with its trailing slash — "src/"
# standing alone, not "src/" as the head of another path — so a sweep that
# covered a directory says so once. A path is bounded by whitespace, quotes,
# brackets or ,;:* on either side, with an optional "./" before and a
# sentence-ending period after; every other character in it is literal, which
# is what keeps "(group)" and "+page" from reading as regex. Only the ERE
# metacharacters are escaped — a backslash before a space or an "@" is a
# "stray \" warning from grep 3.8 on. A bad pattern is fatal — grep's exit 2
# read as "not found" would credit every file.
uncovered() {
  local report="$1" base="$2" p cand found rc
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    found=0
    cand=$p
    while :; do
      rc=0
      grep -qE "(^|[[:space:]\`\"'(*,;:])(\./)?$(printf '%s' "$cand" | sed 's/[][\\.*+?(){}|^$]/\\&/g')(\.?([[:space:]\`\"'),;:*]|$))" "$report" || rc=$?
      [ "$rc" -le 1 ] || die "coverage check: bad pattern for '$cand'"
      if [ "$rc" -eq 0 ]; then
        found=1; break
      fi
      cand=${cand%/}
      case "$cand" in
        */*) cand="${cand%/*}/" ;;
        *) break ;;
      esac
    done
    [ "$found" -eq 1 ] || printf '%s\n' "$p"
  done < <(sed -n 's/^M //p' "$base")
}

# Nothing below writes to stderr short of die: the skill's open.sh hands the
# fork stdout on success and stderr on failure, so a warning belongs in the
# skeleton, where the sweep and then triage both read it.
cmd_review() {
  local reason="${1:-}" scope="${2:-}" root path stamp slug
  [ -n "$reason" ] || usage
  require_init

  case "$reason" in
    pre-merge|docs) ;;
    *) die "reason must be one of: pre-merge, docs" ;;
  esac

  root=$(repo_root)
  # A pre-merge is rooted at the item's worktree wherever it is invoked from:
  # the code under review is there, so the baseline, the manifest and every
  # citation resolve against it. The fork's tools do not follow on their own —
  # the skeleton says so, below.
  local item='' branch='' branches=''
  if [ "$reason" = pre-merge ] && [[ "$scope" =~ ^[bf]-[0-9]+$ ]]; then
    scope=$(require_id "$scope")
    item=$(find_item "$scope")
    [ -z "$item" ] || root=$(item_root "$item")
    # Several branches carrying the id is merge's to refuse; the sweep must
    # still return a report, so the first one's manifest and a note.
    branches=$(local_branches "$root" "$scope")
    branch=${branches%%$'\n'*}
    # A branch with no worktree is the one case where rooting silently lands on
    # the wrong tree: item files live on the default branch from creation, so
    # find_item above always resolves, and the reviewer, the baseline and
    # review-check would then all agree on main while review-check stamps the
    # pass on the branch commit — which nobody read. There is no inconsistency
    # left for anything downstream to catch, so it is refused here. An item with
    # no branch at all is a different thing and still reviews.
    if [ -n "$branch" ] && [ -z "$(live_worktree_of "$branch")" ]; then
      die "$scope's branch $branch has no worktree; a pre-merge must read the branch, not $(default_branch) — 'workbench start $scope' cuts one, or check $branch out in a worktree, then review"
    fi
    # The reviewer reads the tree while review-check records the branch
    # commit, so a worktree with uncommitted changes can never yield a pass
    # that merge accepts — one more round, guaranteed. Refused at open, the
    # cheap end. Reports are untracked in reviews/ by design and stay out of
    # the dirt check; a report still standing is refused just below, on its
    # own terms — the fresh reviewer must never see the last round's — and
    # again by merge, which will not squash a worktree that still holds one.
    # Both refusals are pre-merge-only: they sit inside this guard, so every
    # other reason opens a numbered sibling beside the leftover instead.
    if [ -n "$item" ] && [ -n "$branch" ]; then
      local dirt leftover
      dirt=$(git -C "$root" status --porcelain --untracked-files=all | grep -v " $WB/reviews/" || true)
      [ -z "$dirt" ] || die "$root has uncommitted changes; the review records the branch commit it read, so commit first — then review:
$(printf '%s\n' "$dirt" | sed 's/^/  /')"
      leftover=$(find "$root/$WB/reviews" -maxdepth 1 -name '*.md' -printf '%f\n' 2>/dev/null | sort || true)
      [ -z "$leftover" ] || die "$root still holds a review report; a fresh reviewer never sees the last round's — 'workbench review-drop' it, then review:
$(printf '%s\n' "$leftover" | sed 's/^/  /')"
    fi
  fi
  stamp=$(date +%Y%m%d)
  slug=$(slugify "${scope:-$reason}")
  path="$root/$WB/reviews/$stamp-$reason${scope:+-$slug}"

  # A same-day collision is an orphan from an aborted sweep, not an error:
  # number this one and let 'workbench status' show the other. The suffix is
  # '.N' — a hyphen would be ambiguous, since a scope slug may end in '-2'.
  # The baseline dir is shared by every worktree while reports are per
  # checkout, so the collision test covers both or a second worktree's sweep
  # would overwrite the first one's baseline.
  local n=1 candidate="$path.md"
  while [ -e "$candidate" ] || [ -e "$(baseline_dir)/$(basename "$candidate")" ]; do
    n=$((n + 1))
    candidate="$path.$n.md"
  done
  path=$candidate

  # The baseline 'review-check' compares against. In the git directory, not
  # the tree, or it would appear in its own diff; taken before the report is
  # written, so the report is the one expected delta. While it exists a sweep
  # is in flight or was aborted: 'review-check' removes it on a clean pass,
  # 'review-drop' otherwise.
  mkdir -p "$(baseline_dir)"
  # The scratch directory exists before the snapshot, so its self-ignore is
  # in place and nothing written there can ever show as a delta.
  ensure_scratch "$root" "$path" >/dev/null
  { tree_snapshot "$root" "$reason"; printf 'R %s\n' "$reason"; } > "$(baseline_dir)/$(basename "$path")"

  local stem
  stem=$(basename "$path" .md)
  # A branch cut before the init commit has no reviews/ yet; an empty
  # directory is invisible to the snapshot, so creating it here is safe.
  mkdir -p "$(dirname "$path")"
  cat > "$path" <<EOF
# Review — $reason${scope:+ — $scope}

date: $(date +%Y-%m-%d)

<!-- opened by workbench review; findings with evidence, no template.
     scratch: $WB/scratch/$stem/ — yours to write in. Anything else a build
     or test run leaves in the tree fails review-check: send it there, or
     delete it before returning. -->
EOF

  # A pre-merge reads the item as its branch has it — in that item's
  # worktree, not necessarily where the sweep runs. Name it, or say it was
  # not found:
  # a missing item is the sweep's to report back, so it gets a skeleton with
  # the note rather than a refusal.
  if [ "$reason" = pre-merge ]; then
    if [ -n "$item" ]; then
      printf '\n<!-- item: %s -->\n' "$item" >> "$path"
      if [ "$root" != "$(repo_root)" ]; then
        cat >> "$path" <<EOF

<!-- This sweep is rooted at $root — the item's worktree, not the checkout
     you were invoked in. Every path here is relative to it: prefix Bash
     commands with 'cd $root &&', and give Read, Write, Grep and Glob
     absolute paths under it. review-check resolves every citation against
     it. -->
EOF
      fi
      if [ "$branches" != "$branch" ]; then
        printf '\n<!-- several branches carry %s; the manifest is from %s. merge refuses\n     until one remains:\n%s\n-->\n' "$scope" "$branch" "$(printf '%s\n' "$branches" | sed 's/^/     /')" >> "$path"
      fi
    else
      printf '\n<!-- no item file matching "%s" in any checkout; ask for the id -->\n' "$scope" >> "$path"
    fi
  fi

  write_manifest "$path" "$(baseline_dir)/$(basename "$path")" "$scope" "$root" "$branch" "$reason"

  echo "$path"
}

# An unswept file and a clean one look the same in a report, so when the scope
# names paths, the skeleton lists what is in them and the baseline records the
# same list as 'M ' lines. review-check then names every file the report never
# mentions. Coverage stays self-reported — the sweep can name a file it never
# opened — but an area it forgot is no longer silent.
#
# Nested CLAUDE.md files are listed alongside because they load on Read only,
# never on cat, head or grep: a sweep that shells out for everything walks
# straight past the instructions for the area it is reviewing. The ones that
# cover a file sit anywhere on its path above the root, not only inside the
# scope — 'src/api/CLAUDE.md' governs 'src/api/handlers/' — so they are found
# by walking up from every manifest file.
#
# A pre-merge's scope is its branch: the files it changed against the default
# branch are the manifest, so a changed file the report never names is caught
# the same way an unswept one is.
MANIFEST_CAP=300
SNAPSHOT_WARN=500
guides_for() {
  local root="$1" f d g
  shift
  for f in "$@"; do
    d=$f
    while [ "${d%/*}" != "$d" ]; do
      d=${d%/*}
      for g in CLAUDE.md AGENTS.md; do
        [ -f "$root/$d/$g" ] && printf '%s/%s\n' "$d" "$g"
      done
    done
  done | sort -u
}

write_manifest() {
  local report="$1" base="$2" scope="$3" root="$4" branch="${5:-}" reason="${6:-}"

  local words=() w paths=()
  read -ra words <<< "$scope"
  for w in ${words+"${words[@]}"}; do
    [ -e "$root/$w" ] && paths+=("$w")
  done

  local files=() guides=()
  if [ -n "$branch" ]; then
    mapfile -t files < <(git -C "$root" diff --name-only "$(default_branch)...$branch" | sort -u)
    mapfile -t guides < <(guides_for "$root" ${files+"${files[@]}"})
  elif [ "${#words[@]}" -gt 0 ] && [ "${#paths[@]}" -eq "${#words[@]}" ]; then
    mapfile -t files < <(git -C "$root" ls-files --cached --others --exclude-standard -- "${paths[@]}" | sort -u)
    mapfile -t guides < <(guides_for "$root" ${files+"${files[@]}"})
  else
    # A scope that is not entirely paths is a topic: no manifest, and the
    # coverage check has nothing to hold the report to. Say so rather than
    # letting it read as covered. A pre-merge's scope is its id, never
    # paths, so it is not warned about.
    if [ "${#words[@]}" -gt 0 ] && [ "$reason" != pre-merge ]; then
      printf "\n<!-- scope '%s' is not all paths: a topic. No manifest, so coverage is\n     unchecked — say what was covered. -->\n" "$scope" >> "$report"
    fi
    mapfile -t guides < <(git -C "$root" ls-files -- '*/CLAUDE.md' '*/AGENTS.md' | grep '/')
  fi

  if [ "${#guides[@]}" -gt 0 ]; then
    {
      echo
      echo '<!-- CLAUDE.md under the scope. Read each before sweeping its area; they do'
      echo '     not auto-load on cat, head or grep:'
      printf '     %s\n' "${guides[@]}"
      echo '-->'
    } >> "$report"
  fi

  # A pre-merge whose branch has no diff against the default branch — the
  # work not yet committed — would get a skeleton with no manifest and no
  # note, and review-check nothing to hold the report to. Say why.
  if [ -n "$branch" ] && [ "${#files[@]}" -eq 0 ]; then
    printf '\n<!-- %s carries no commits beyond %s: no manifest, so nothing for\n     review-check to hold the report to. Commit the work on the branch — the\n     item file with its evidence among it — then reopen this review. -->\n' "$branch" "$(default_branch)" >> "$report"
    return 0
  fi

  [ "${#files[@]}" -gt 0 ] || return 0
  if [ "${#files[@]}" -gt "$MANIFEST_CAP" ]; then
    printf '\n<!-- scope holds %s files, above %s: no manifest, so coverage is\n     unchecked — say what was covered. -->\n' "${#files[@]}" "$MANIFEST_CAP" >> "$report"
    return 0
  fi

  {
    echo
    if [ -n "$branch" ]; then
      # The item is edited on the branch, so an item file not in the diff
      # means the evidence was never written there — worth a line of its own.
      if grep -qE "^$WB/items/[^/]+/[bf]-[0-9]+-[^/]*\.md\$" <<<"$(printf '%s\n' "${files[@]}")"; then
        echo "<!-- changed on the branch: ${#files[@]} files, the item file among them. Name each"
      else
        echo "<!-- changed on the branch: ${#files[@]} files, and the item file is not among them:"
        echo '     the branch holds no evidence and merge will refuse it. Name each'
      fi
      echo '     one the sweep covered, or the directory when a whole directory was;'
      echo '     review-check lists any the report never mentions:'
    else
      echo "<!-- in scope: ${#files[@]} files. Name each one the sweep covered, or the"
      echo '     directory when a whole directory was; review-check lists any the report'
      echo '     never mentions:'
    fi
    printf '     %s\n' "${files[@]}"
    echo '-->'
  } >> "$report"
  printf 'M %s\n' "${files[@]}" >> "$base"
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  adopt) shift; cmd_adopt "$@" ;;
  new) shift; cmd_new "$@" ;;
  start) shift; cmd_start "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  idea) shift; cmd_idea "$@" ;;
  call) shift; cmd_call "$@" ;;
  find) shift; cmd_find "$@" ;;
  archive) shift; cmd_archive "$@" ;;
  review) shift; cmd_review "$@" ;;
  status) shift; cmd_status "$@" ;;
  review-check) shift; cmd_review_check "$@" ;;
  review-drop) shift; cmd_review_drop "$@" ;;
  round) shift; cmd_round "$@" ;;
  effects) shift; cmd_effects "$@" ;;
  help|-h|--help) usage 0 ;;
  *) usage ;;
esac
