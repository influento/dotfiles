#!/usr/bin/env bash
set -euo pipefail

# workbench — item lifecycle for tracked project work.

WB=workbench
# Never pipe into a reader that stops early — 'grep -q', 'grep -m', 'head'.
# 'set -o pipefail' is on, and such a reader closes the pipe the moment it has
# what it needs; if the writer is still sending (anything past a few KB) it
# takes SIGPIPE, the pipeline reports 141, and the test reads as the OPPOSITE
# of what the data says — intermittently, since it is a race. Capture into a
# variable and read a herestring, or use a reader that consumes all of its input.
# The project-scoped commands, one thin skill each under commands/.
WB_COMMANDS="bug feature idea wb"
# The agent definitions under agents/, listed rather than globbed (agent_sources).
WB_AGENTS="wb-worker wb-reviewer"
MARK_START='<!-- workbench:start -->'
MARK_END='<!-- workbench:end -->'
# One obvious sentence, one question.
IDEA_MAX=200
CALL_MAX=300
# Line caps on the documents every session reads; 'git config
# workbench.cap.<name>' overrides.
CAP_CLAUDE=150
CAP_GLOSSARY=300
CAP_BACKLOG=400
CAP_DECISIONS=200

usage() {
  # Help asked for goes to stdout; help printed because a call was wrong is
  # an error and goes with the other errors.
  [ "${1:-2}" -eq 0 ] || exec >&2
  cat <<'EOF'
usage:
  workbench init [--force]             scaffold workbench/, render the skills as committed copies
                                       (--force overwrites a copy edited by hand)
  workbench adopt                      init, then survey an existing project
  workbench new <bug|feature> "<title>" allocate an id, write the file, commit it on the default branch
  workbench idea "<sentence>"          one backlog line, on the main checkout wherever it runs
  workbench call <id|-> "<question>"   one line under the item's '## Decisions' (DECISIONS.md for -):
                                       a call that is the user's, parked
  workbench start <id>                 commit the item as it stands, create its branch and worktree
  workbench round <id> <fixed> <stands>  record a review-dialog round; says whether another follows
  workbench merge <id> "<subject>"     squash onto the default branch, drop the worktree and branch;
                                       needs evidence or a trigger status; runs 'git config
                                       workbench.premerge' in the worktree first, refusing on non-zero
                                       (workbench.guards: regex of steps start refuses as guards)
  workbench archive <id> [--discard]   move to archive, recording the merge commit;
                                       --discard drops what an abandoned branch carries
  workbench status                     in flight, duplicate ids, documents over their line caps

  state lives under workbench/
EOF
  exit "${1:-2}"
}

die() {
  echo "workbench: $1" >&2
  exit 1
}

# Memoized: called several times per run.
GIT_COMMON_DIR=""
git_common_dir() {
  if [ -z "$GIT_COMMON_DIR" ]; then
    local d
    d=$(git rev-parse --git-common-dir) || die "not inside a git repository"
    # --git-common-dir may be relative to the current directory
    GIT_COMMON_DIR=$(cd "$d" && pwd -P)
  fi
  printf '%s\n' "$GIT_COMMON_DIR"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# The main worktree, where the committed state lives: git lists it first,
# always. Not the parent of the common dir — that is no checkout at all for a
# bare repository, and it followed the logical path where repo_root gives the
# physical one, so a checkout reached through a symlink counted as two.
MAIN_ROOT=""
main_root() {
  [ -n "$MAIN_ROOT" ] || MAIN_ROOT=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  printf '%s\n' "$MAIN_ROOT"
}

# The checkouts that may hold items: the current one and the main one.
wb_roots() {
  local cur main
  cur=$(repo_root)
  main=$(main_root)
  printf '%s\n' "$cur"
  [ "$main" != "$cur" ] && printf '%s\n' "$main"
  return 0
}

# $WB/<sub> in each checkout read from stdin, existing ones only — a worktree
# branched before adoption, a detached one, one removed by hand has none, and
# find exits non-zero on a missing start path, which under set -e kills the caller.
wb_dirs() {
  local sub="$1" r
  while IFS= read -r r; do
    [ -n "$r" ] && [ -d "$r/$WB/$sub" ] && printf '%s\n' "$r/$WB/$sub"
  done
  return 0
}

# find over wb_dirs; no checkout has the directory → nothing, rc 0.
wb_find() {
  local sub="$1" dirs=()
  shift
  mapfile -t dirs < <(wb_dirs "$sub")
  [ "${#dirs[@]}" -gt 0 ] || return 0
  find "${dirs[@]}" "$@" 2>/dev/null || true
}

# The source tree this script sits in, or WORKBENCH_ROOT.
wb_root() {
  local self
  # $0 is a bare name when found on PATH, so resolve it before following links
  self=$(command -v -- "$0") || die "cannot locate the workbench script"
  self=$(readlink -f "$self")
  printf '%s\n' "${WORKBENCH_ROOT:-$(dirname "$self")/..}"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\+/-/g' \
    | cut -c1-50 \
    | sed -e 's/^-//' -e 's/-$//'
}

# <letter>-<number>, printed back three digits wide so 'b-1' names b-001;
# everything downstream globs on "$id-*".
require_id() {
  [[ "$1" =~ ^([bf])-([0-9]+)$ ]] || die "'$1' is not an item id; ids look like b-038"
  printf '%s-%03d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))"
}

# Adoption is a property of the repository: any checkout carrying $WB/ satisfies it.
require_init() {
  local root
  while IFS= read -r root; do
    [ -d "$root/$WB" ] && return 0
  done < <(wb_roots)
  die "no $WB/ in this repository; run 'workbench init' first"
}

# Highest number in any checkout, to rebuild a missing counter.
highest_existing() {
  local max=0 n
  while IFS= read -r f; do
    n=$(basename "$f" | sed -n 's/^[bf]-\([0-9]\{1,\}\)-.*/\1/p')
    [ -n "$n" ] || continue
    n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done < <(wb_find items -name '[bf]-*.md' < <(all_roots))
  echo "$max"
}

next_id() {
  local seq_file lock_dir current
  seq_file="$(git_common_dir)/item-seq"
  lock_dir="$(git_common_dir)/item-seq.lock"

  # mkdir is atomic on POSIX filesystems, so this works without flock
  local waited=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 100 ] && die "could not acquire $lock_dir; if no 'workbench new' is running, it is stale — rmdir it and retry"
    sleep 0.05
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

  # The counter is a cache; never allocate below what the tree holds.
  local seen
  seen=$(highest_existing)
  current=0
  [ -f "$seq_file" ] && current=$(cat "$seq_file")
  # A garbled counter is rebuilt from the tree, not tripped over.
  [[ "$current" =~ ^[0-9]+$ ]] || current=0
  [ "$seen" -gt "$current" ] && current=$seen
  current=$((current + 1))
  printf '%s\n' "$current" > "$seq_file"

  rmdir "$lock_dir"
  trap - EXIT
  printf '%03d\n' "$current"
}

# --- init -------------------------------------------------------------------

write_glossary() {
  cat > "$1" <<'EOF'
# Glossary

<!-- Domain language only: words this project uses in a narrower or different
     sense than they are used generally. Never well-known concepts.

     One entry per concept, never the same concept twice. Brief — a definition,
     not an explanation. Nothing that would have to change when the
     implementation changes; that is a spec, and it belongs elsewhere.

     A term is renamed in one commit, glossary entry and code together; that
     commit is its own item. Aliases are written as (was: old-term), and only
     once the old word survives in an archived item or a merged commit.

     A word rejected at coinage gets a row under a "Use, never" table
     (| Use | Never | Because |), in the same commit as the item that first
     used the chosen word, so the next session does not reach for it. -->
EOF
}

write_backlog() {
  cat > "$1" <<'EOF'
# Backlog

<!-- One line per idea. No id, no file, no thinking spent yet. Promoting a line
     to an item is where the thinking happens; delete the line when it goes. -->
EOF
}

write_decisions() {
  cat > "$1" <<'EOF'
# Decisions

<!-- One line per call that is the user's, was parked because they were not
     there, and belongs to no item: 'workbench call - "<question>"'. A call
     on an item goes under that item's '## Decisions' instead. The user
     answers by deciding, then deletes the line. Nothing here is a status
     report. -->
EOF
}

ensure_gitignore() {
  local root gi
  root=$(repo_root)
  gi="$root/.gitignore"
  local entry='.worktrees/'
  grep -qxF "$entry" "$gi" 2>/dev/null && return 0
  # A last line missing its newline would otherwise absorb the entry.
  [ ! -s "$gi" ] || [ -z "$(tail -c1 "$gi")" ] || echo >> "$gi"
  printf '%s\n' "$entry" >> "$gi"
  echo "  .gitignore += $entry"
}

# The skill sources: the workflow and one thin skill per command. Each
# directory is named exactly as the skill it renders to.
skill_sources() {
  local base name
  base=$(readlink -f "$(wb_root)") || true
  [ -n "$base" ] && [ -d "$base" ] || die "workbench source not found at $(wb_root)"
  printf '%s\n' "$base/skills/workbench"
  for name in $WB_COMMANDS; do printf '%s\n' "$base/commands/$name"; done
}

# Stamp: the source hash on line 1, the copy's own on line 2. Paths go into
# the hash ahead of content, sorted under LC_ALL=C so every machine agrees;
# symlinks are refused, a copy of one being a machine-local path.
STAMP=GENERATED
skill_hash() {
  local f
  f=$(find "$1" -type l -print -quit)
  [ -z "$f" ] || die "$f is a symlink; skill sources hold files only"
  {
    find "$1" -type f ! -path '*/__pycache__/*' ! -name "$STAMP" -printf '%P\0' \
      | LC_ALL=C sort -z \
      | while IFS= read -r -d '' f; do printf '%s\0' "$f"; cat "$1/$f"; done
  } | sha256sum | cut -c1-12
}

# current | stale | edited | missing. A stamp without a valid copy hash
# reads as stale (re-rendered), not edited (refused).
skill_state() {
  local root="$1" src="$2" dst src_hash copy_hash
  dst="$root/.claude/skills/$(basename "$src")"
  [ -f "$dst/$STAMP" ] || { echo missing; return; }
  src_hash=$(sed -n 1p "$dst/$STAMP")
  copy_hash=$(sed -n 2p "$dst/$STAMP")
  if [[ "$copy_hash" =~ ^[0-9a-f]{12}$ ]] && [ "$(skill_hash "$dst")" != "$copy_hash" ]; then
    echo edited
  elif [ "$src_hash" != "$(skill_hash "$src")" ]; then
    echo stale
  else
    echo current
  fi
}

render_skills() {
  local force="${1:-0}" root src srcdir dst name hash state wanted=" "
  root=$(repo_root)
  srcdir=$(readlink -f "$(wb_root)")
  mkdir -p "$root/.claude/skills"

  while IFS= read -r src; do
    [ -d "$src" ] || die "skill source not found at $src"
    name=$(basename "$src")
    wanted="$wanted$name "
    dst="$root/.claude/skills/$name"
    hash=$(skill_hash "$src")
    state=

    if [ -L "$dst" ]; then
      rm "$dst"
      echo "  .claude/skills/$name: link replaced by a copy"
    elif [ -d "$dst" ]; then
      if [ ! -f "$dst/$STAMP" ]; then
        die "$dst exists and was not generated by workbench; move it away and re-run"
      fi
      state=$(skill_state "$root" "$src")
      if [ "$state" = edited ] && [ "$force" != 1 ]; then
        die "$dst was edited by hand since it was rendered; move the edit into the source, or 'workbench init --force' to overwrite it"
      fi
      [ "$state" != current ] || continue
      rm -rf "$dst"
    elif [ -e "$dst" ]; then
      die "$dst exists and is not a directory"
    fi

    cp -RL "$src" "$dst"
    find "$dst" -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
    printf '%s\n%s\n%s\n' "$hash" "$(skill_hash "$dst")" \
      "generated by 'workbench init' from workbench/${src#"$srcdir"/}; edit the source and re-run, never this copy" > "$dst/$STAMP"
    if [ "$state" = edited ]; then echo "  rendered .claude/skills/$name (the hand edit is gone)"; else echo "  rendered .claude/skills/$name"; fi
  done < <(skill_sources)

  # A generated copy for a skill no longer in the source; guarded by the
  # stamp's own wording, and an edited one is refused as above.
  local copy_hash
  for dst in "$root"/.claude/skills/*/; do
    dst=${dst%/}; name=$(basename "$dst")
    [ -f "$dst/$STAMP" ] || continue
    grep -q "generated by 'workbench init'" "$dst/$STAMP" || continue
    case "$wanted" in *" $name "*) continue ;; esac
    copy_hash=$(sed -n 2p "$dst/$STAMP")
    if [[ "$copy_hash" =~ ^[0-9a-f]{12}$ ]] && [ "$(skill_hash "$dst")" != "$copy_hash" ] && [ "$force" != 1 ]; then
      die "$dst is no longer a workbench skill but was edited by hand; move the edit somewhere, or 'workbench init --force' to remove it"
    fi
    rm -rf "$dst"
    echo "  removed .claude/skills/$name: no longer a workbench skill"
  done
}

# A list, not a glob: a stray file cannot ship as an agent, and a renamed
# source fails loudly.
agent_sources() {
  local base name
  base=$(readlink -f "$(wb_root)") || true
  [ -n "$base" ] && [ -d "$base" ] || die "workbench source not found at $(wb_root)"
  for name in $WB_AGENTS; do printf '%s\n' "$base/agents/$name.md"; done
}

# An agent is a flat .md with nowhere to hold a stamp, so the check is cmp
# and a differing copy is overwritten either way.
render_agents() {
  local root src dst name wanted=" "
  root=$(repo_root)
  mkdir -p "$root/.claude/agents"
  while IFS= read -r src; do
    [ -f "$src" ] || die "agent source not found at $src"
    name=$(basename "$src")
    wanted="$wanted$name "
    dst="$root/.claude/agents/$name"
    if [ -f "$dst" ] && cmp -s "$src" "$dst"; then continue; fi
    cp "$src" "$dst"
    echo "  rendered .claude/agents/$name"
  done < <(agent_sources)

  # Reap a copy for an agent no longer shipped, guarded by the marker in its
  # own frontmatter so a project's own agent is never touched.
  for dst in "$root"/.claude/agents/*.md; do
    [ -f "$dst" ] || continue
    name=$(basename "$dst")
    grep -q '^x-workbench:' "$dst" || continue
    case "$wanted" in *" $name "*) continue ;; esac
    rm -f "$dst"
    echo "  removed .claude/agents/$name: no longer a workbench agent"
  done
}

# The copies that no longer match: "<name>\t<stale|edited|missing>", main checkout only.
skill_drift() {
  local root src state
  root=$(main_root)
  while IFS= read -r src; do
    state=$(skill_state "$root" "$src")
    [ "$state" = current ] || printf '%s\t%s\n' "$(basename "$src")" "$state"
  done < <(skill_sources 2>/dev/null)
}

# "<name>\tdiffers|missing": with no stamp, stale and edited cannot be told apart.
agent_drift() {
  local root src dst name
  root=$(main_root)
  while IFS= read -r src; do
    name=$(basename "$src")
    dst="$root/.claude/agents/$name"
    if [ ! -f "$dst" ]; then
      printf '%s\tmissing\n' "$name"
    elif ! cmp -s "$src" "$dst"; then
      printf '%s\tdiffers\n' "$name"
    fi
  done < <(agent_sources 2>/dev/null)
}

claude_md_block() {
  cat <<EOF
$MARK_START
## Workflow

Domain work in this repo is tracked with **workbench**. Before writing code for
any feature or bug fix, create an item (\`workbench new\`) and agree its
verification criterion. An area not yet understood well enough to write an
item for is a spike: a feature item whose criterion is the question it answers.
Housekeeping — configs, tooling, agent settings — is exempt and goes straight
to the main branch.

Rules: invoke the \`workbench\` skill. State: \`$WB/\`.
$MARK_END
EOF
}

# Written through readlink -f so a CLAUDE.md that is a symlink to AGENTS.md is
# edited in place rather than replaced by a regular file.
ensure_claude_md() {
  local root target tmp
  root=$(repo_root)
  target=$(readlink -f "$root/CLAUDE.md" 2>/dev/null || printf '%s' "$root/CLAUDE.md")

  if [ ! -f "$target" ]; then
    { echo "# $(basename "$root")"; echo; claude_md_block; } > "$target"
    echo "  created $(basename "$target") with the workbench block"
    return 0
  fi

  if grep -qF "$MARK_START" "$target"; then
    tmp=$(mktemp)
    claude_md_block > "$tmp.block"
    awk -v start="$MARK_START" -v end="$MARK_END" -v blockfile="$tmp.block" '
      $0 == start { while ((getline line < blockfile) > 0) print line; skip = 1; next }
      $0 == end   { skip = 0; next }
      !skip       { print }
    ' "$target" > "$tmp"
    # mktemp creates 0600; the replace must not carry that onto CLAUDE.md.
    chmod --reference="$target" "$tmp"
    mv "$tmp" "$target"
    rm -f "$tmp.block"
    echo "  refreshed the workbench block in $(basename "$target")"
  else
    { echo; claude_md_block; } >> "$target"
    echo "  appended the workbench block to $(basename "$target")"
  fi
}

# Merged into .claude/settings.json, never replacing it.
ensure_settings() {
  local root f
  root=$(repo_root)
  f="$root/.claude/settings.json"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "  python3 not found; add to .claude/settings.json by hand: permissions.allow 'Bash(workbench:*)' and a SessionStart hook running 'command -v workbench >/dev/null && workbench status || true'"
    return 0
  fi
  mkdir -p "$root/.claude"
  # Memory in the tree; Claude Code wants the path absolute or '~/'-based.
  local mem=
  # shellcheck disable=SC2088  # a literal '~/' — Claude Code expands it, on every machine
  case "$root" in "${HOME%/}"/*) mem="~/${root#"${HOME%/}"/}/.claude/memory" ;; esac
  python3 - "$f" "$mem" <<'PY'
import json, os, re, sys
path, mem = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    with open(path) as fh:
        raw = fh.read().strip()
    if raw:
        try:
            data = json.loads(raw)
        except ValueError:
            print("  .claude/settings.json is not valid JSON; left alone")
            sys.exit(0)
if not isinstance(data, dict):
    print("  .claude/settings.json is not a JSON object; left alone")
    sys.exit(0)
changed = []
# Guarded so a clone without the CLI stays quiet.
HOOK = "command -v workbench >/dev/null && workbench status || true"
# Shapes Claude Code would reject are skipped, not crashed on.
perms = data.setdefault("permissions", {})
allow = perms.setdefault("allow", []) if isinstance(perms, dict) else None
if not isinstance(allow, list):
    print("  permissions.allow is not a list in .claude/settings.json; left alone")
else:
    for rule in ("Bash(workbench:*)",):
        if rule not in allow:
            allow.append(rule)
            changed.append("permissions.allow += " + rule)
hooks = data.setdefault("hooks", {})
# Matched by exact command, so a re-run adds nothing twice. The signal and
# gate hooks of an older init are removed: a gate hook left behind would
# refuse every tool call it matched.
OLD = re.compile(r"workbench (signal|gate) ")
if not isinstance(hooks, dict):
    print("  hooks is not an object in .claude/settings.json; left alone")
else:
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        for grp in groups:
            if isinstance(grp, dict) and isinstance(grp.get("hooks"), list):
                kept = [h for h in grp["hooks"] if not (isinstance(h, dict) and OLD.search(str(h.get("command", ""))))]
                if len(kept) != len(grp["hooks"]):
                    changed.append("hooks." + event + " -= the signal/gate hooks of an older workbench")
                    grp["hooks"] = kept
        hooks[event] = [g for g in groups if not (isinstance(g, dict) and isinstance(g.get("hooks"), list) and not g["hooks"])]
        if not hooks[event]:
            del hooks[event]
    groups = hooks.get("SessionStart")
    if groups is None:
        groups = hooks["SessionStart"] = []
    if not isinstance(groups, list):
        print("  hooks.SessionStart is not a list in .claude/settings.json; left alone")
    else:
        entries = [h for grp in groups if isinstance(grp, dict) and isinstance(grp.get("hooks"), list)
                   for h in grp["hooks"] if isinstance(h, dict)]
        if not any(h.get("command") == HOOK for h in entries):
            home = next((grp for grp in groups if isinstance(grp, dict) and isinstance(grp.get("hooks"), list)
                         and grp.get("matcher") in (None, "", "*")), None)
            if home is None:
                home = {"hooks": []}
                groups.append(home)
            home["hooks"].append({"type": "command", "command": HOOK})
            changed.append("hooks.SessionStart += workbench status")
line = data.get("statusLine")
if isinstance(line, dict) and "workbench statusline" in str(line.get("command", "")):
    del data["statusLine"]
    changed.append("statusLine -= workbench statusline (gone from the CLI)")
if mem:
    cur = data.get("autoMemoryDirectory")
    if cur is None:
        data["autoMemoryDirectory"] = mem
        changed.append("autoMemoryDirectory = " + mem)
    elif cur != mem:
        print("  autoMemoryDirectory is already " + cur + "; left alone")
else:
    print("  autoMemoryDirectory: the project is not under ~, so set it by hand (absolute path) for memory to live in the tree")
if changed:
    with open(path, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    for c in changed:
        print("  .claude/settings.json: " + c)
PY
  if [ -f "$root/.claude/settings.local.json" ]; then
    python3 - "$root/.claude" <<'PY'
import json, os, sys
def get(name):
    try:
        return json.load(open(os.path.join(sys.argv[1], name))).get("autoMemoryDirectory")
    except Exception:
        return None
if get("settings.local.json") and get("settings.local.json") == get("settings.json"):
    print("  settings.local.json sets autoMemoryDirectory to the same path as settings.json; the local one is redundant")
PY
  fi
}

cmd_init() {
  local root d force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) usage ;;
    esac
  done
  root=$(repo_root)
  # Tracked files, committed on the default branch: in a linked worktree they
  # would ride that item's squash.
  local mainr
  mainr=$(main_root)
  [ "$root" = "$mainr" ] \
    || die "init writes tracked files that are committed on the default branch; run it in the main checkout: cd $mainr && workbench init"

  for d in items/bugs items/features items/archive; do
    mkdir -p "$root/$WB/$d"
    [ -e "$root/$WB/$d/.gitkeep" ] || touch "$root/$WB/$d/.gitkeep"
  done

  [ -f "$root/$WB/GLOSSARY.md" ] || { write_glossary "$root/$WB/GLOSSARY.md"; echo "  wrote $WB/GLOSSARY.md"; }
  [ -f "$root/$WB/BACKLOG.md" ] || { write_backlog "$root/$WB/BACKLOG.md"; echo "  wrote $WB/BACKLOG.md"; }
  [ -f "$root/$WB/DECISIONS.md" ] || { write_decisions "$root/$WB/DECISIONS.md"; echo "  wrote $WB/DECISIONS.md"; }

  render_skills "$force"
  render_agents
  ensure_gitignore
  ensure_settings
  ensure_claude_md

  echo "workbench ready in $root"
  setup_checklist
}

# What has to be decided with the user rather than scaffolded; the skill
# takes each line to the user.
setup_checklist() {
  local root main premerge guards
  root=$(repo_root)
  echo
  echo "setup — decide these with the user:"
  if main=$(git config --get workbench.main 2>/dev/null) && [ -n "$main" ]; then
    echo "  default branch    $main (git config workbench.main)"
  elif main=$(default_branch 2>/dev/null); then
    echo "  default branch    $main — squash merges land here; 'git config workbench.main <branch>' if that is wrong"
  else
    echo "  default branch    UNRESOLVED — set 'git config workbench.main <branch>' before the first merge"
  fi
  premerge=$(git config --get workbench.premerge 2>/dev/null || true)
  if [ -n "$premerge" ]; then
    echo "  premerge          '$premerge' runs in the branch's worktree before every squash; non-zero refuses the merge"
  else
    echo "  premerge          unset — 'git config workbench.premerge \"<command>\"' (tests, a lint gate) runs in the branch's worktree before every squash; non-zero refuses the merge. Per clone"
  fi
  guards=$(git config --get workbench.guards 2>/dev/null || true)
  if [ -n "$guards" ]; then
    echo "  guards            '$guards' — a criterion step matching it is refused at start, with the built-in 'by inspection' and 'behaviour unchanged'"
  else
    echo "  guards            unset — 'git config workbench.guards \"<regex>\"' names the tool runs (gate, lint, typecheck, build) a criterion step may not consist of; the tool that installs them sets it"
  fi
  if [ -n "$(memory_dir_setting)" ]; then
    echo "  memory            autoMemoryDirectory points at .claude/memory/ in the tree: one store for every worktree, and for every clone at the same path under ~; its edits are unstaged housekeeping on main, commit them"
  else
    echo "  memory            autoMemoryDirectory is unset (the project is not under ~): set it by hand in .claude/settings.json to the absolute path of .claude/memory, or leave memory where Claude Code keeps it"
  fi
  echo "  glossary          $WB/GLOSSARY.md is empty; seed it with the user's words for what this project means in its own sense"
}

cmd_adopt() {
  # Uncommitted work at adoption has no item and never will; committed as the
  # last pre-adoption commit it is at least on record.
  local dirt
  dirt=$(git -C "$(repo_root)" status --porcelain --untracked-files=no || true)
  [ -z "$dirt" ] || die "the tree has uncommitted changes; commit them as the last pre-adoption commit, then adopt:
$(printf '%s\n' "$dirt" | sed 's/^/  /')"
  cmd_init "$@"
  cat <<EOF

Now survey what work tracking already exists — TODO files, issue lists, a
roadmap — and take the list to the user: backlog line, open item, or left
alone. Nothing converts without their approval; shipped work never gets a
backfilled item.
EOF
}

# --- items ------------------------------------------------------------------

write_bug() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## What was seen

<!-- The observed behaviour. Delete this comment. -->

## How to reproduce

<!-- Steps, or a note that it was found by reading code — that is fine and
     needs no apology. Best-effort: a bug with no reproduction still ships.
     Once it reproduces, cut steps one at a time until every one left is
     load-bearing. A flaky one is worked by raising its reproduction rate —
     loop it, parallelise, add stress — not by waiting for a clean run.
     Delete this comment. -->

## Root cause

<!-- The mechanism, on the side you control. "It behaves like X and that is the
     third party's decision" is a complete root cause. A suspected race is a
     mechanism: state it, mark the confidence unproven. A fact discovered here
     about a system you do not control is recorded here, not in a document of
     its own.
     Not obvious after a first look: name three to five candidate mechanisms
     before testing any, each with the change that would make the bug vanish,
     and test them one variable at a time; only the survivor is written here.
     Every probe log carries one tag, e.g. [DEBUG-a4f2], so removing them is
     one grep. Delete this comment. -->

## The fix

<!-- What changed. Delete this comment. -->

## Side effects

<!-- What works today and behaves differently once this lands: a route, an
     exported function's name, signature or result, a command's output, a
     stored format — each with who sees the difference. 'none' when nothing
     that exists changes. Agreed before start, like the criterion; one found
     after start is 'workbench call <id> "side effect: …"', never an edit
     here. Delete this comment. -->

## How to confirm it is fixed

<!-- REQUIRED, never omitted. Written before the code and specific enough to
     stand alone: name the command and the expected result. This is the
     contract. Delete this comment. -->

## Decisions

<!-- Open questions only, one line each, written by 'workbench call <id>':
     a call that is the user's, parked because they were not there. Answered
     by editing the field it changes and deleting the line; archive refuses
     an item with one open. Delete this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it,
     pasted in a fenced block — archive refuses an Evidence section without
     one. Delete this comment. -->
EOF
}

write_feature() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## Why

<!-- The problem being solved. Delete this comment. -->

## What changes

<!-- Observable behaviour of the project, not implementation. Delete this
     comment. -->

## What it touches

<!-- Areas, not a file list. Delete this comment. -->

## Side effects

<!-- What works today and behaves differently once this lands: a route, an
     exported function's name, signature or result, a command's output, a
     stored format — each with who sees the difference. 'none' when nothing
     that exists changes. Agreed before start, like the criterion; one found
     after start is 'workbench call <id> "side effect: …"', never an edit
     here. Delete this comment. -->

## How to confirm it works

<!-- The criterion. Written before the code and specific enough to stand alone:
     name the command and the expected result. This is the contract. Delete
     this comment. -->

## Decisions

<!-- Open questions only, one line each, written by 'workbench call <id>':
     a call that is the user's, parked because they were not there. Answered
     by editing the field it changes and deleting the line; archive refuses
     an item with one open. Delete this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it,
     pasted in a fenced block — archive refuses an Evidence section without
     one. Delete this comment. -->
EOF
}

cmd_new() {
  local class="${1:-}" title="${2:-}" letter dir slug num id path root
  [ $# -eq 2 ] && [ -n "$class" ] && [ -n "$title" ] || usage
  require_init
  case "$class" in
    bug) letter=b; dir=bugs ;;
    feature) letter=f; dir=features ;;
    *) die "class must be 'bug' or 'feature', got '$class'" ;;
  esac

  # Lands on the default branch wherever this runs, so the main checkout must
  # hold that branch; checked before an id is spent.
  root=$(main_root)
  require_main_checked_out "$root"
  slug=$(slugify "$title")
  [ -n "$slug" ] || die "title produced an empty slug"

  num=$(next_id)
  id="$letter-$num"
  path="$root/$WB/items/$dir/$id-$slug.md"

  mkdir -p "$root/$WB/items/$dir"
  [ -e "$path" ] && die "$path already exists"

  case "$class" in
    bug) write_bug "$path" "$id" "$title" ;;
    feature) write_feature "$path" "$id" "$title" ;;
  esac

  land_item "$path" "new $id: $title"

  echo "$id"
  echo "$path" >&2
  echo "committed on $(default_branch); fill it, then 'workbench start $id'" >&2
}

# The main checkout holds the default branch, or a commit meant for it lands elsewhere.
require_main_checked_out() {
  local main on
  main=$(default_branch)
  on=$(git -C "$1" symbolic-ref -q --short HEAD || true)
  [ "$on" = "$main" ] || die "$1 has '${on:-a detached HEAD}' checked out, not $main; the item commit lands there"
}

# 'new' lands the template, 'start' the criterion. Only this path goes into
# the commit, so a session's other pending edits on main stay where they were.
land_item() {
  local path="$1" msg="$2" root
  root=$(main_root)
  require_main_checked_out "$root"
  git -C "$root" add -- "$path"
  git -C "$root" diff --cached --quiet -- "$path" && return 0
  git -C "$root" commit --quiet -m "$msg" -- "$path" \
    || die "the commit for ${path#"$root"/} was refused — a hook, or a merge in progress on $(default_branch); the file is staged in $root"
  echo "committed ${path#"$root"/} on $(default_branch)" >&2
}

# The item file, in the order a copy is authoritative: the item's own
# worktree, then the main checkout, then the current checkout and the rest
# (an item written by hand, not yet landed). A sibling's inherited copy is
# never the item's home.
find_item() {
  local id="$1" b
  wb_find items -name "$id-*.md" -print -quit < <(
    {
      while IFS= read -r b; do worktree_of "$b"; done \
        < <(local_branches "$(main_root)" "$id")
      main_root
      repo_root
      all_roots
    } | awk 'NF && !seen[$0]++'
  )
}

# The checkout an item file belongs to; paths derived from an item are rooted here.
item_root() {
  printf '%s\n' "${1%/"$WB"/items/*}"
}

# Local branches for an item id. refs/heads is shared by every worktree; the
# root only pins the call.
local_branches() {
  git -C "$1" for-each-ref --format='%(refname:short)' "refs/heads/$2-*"
}

# One item, one branch. A checker, not a filter: in a command substitution
# the die would leave only the subshell, and after a 'local' not even that.
require_one_branch() {
  case "$2" in
    *$'\n'*) die "several branches match $1-*:"$'\n'"$2" ;;
  esac
}

# A local branch, else one only fetched from origin — another machine's start.
item_branch() {
  local b
  b=$(local_branches "$(main_root)" "$1")
  [ -n "$b" ] || b=$(git -C "$(main_root)" for-each-ref --format='%(refname:short)' "refs/remotes/origin/$1-*")
  require_one_branch "$1" "$b"
  printf '%s\n' "$b"
}

# The squash commit carrying an item's trailer, or empty. $1 root, $2 branch, $3 id.
# The '--' is load-bearing: without it a file named for the default branch
# makes the rev ambiguous, git exits 128, and callers that swallow stderr read
# that as "no commit". A real git failure dies, so empty means no commit —
# which is why no caller writes 'local x=$(merged_sha …)': local's exit
# status would swallow the die.
merged_sha() {
  [ -n "$1" ] || die "merged_sha: no root"
  git -C "$1" log "$2" --grep="^Item: $3\$" --format=%h -1 -- \
    || die "git log failed looking for 'Item: $3' on $2"
}

cmd_start() {
  local id="${1:-}" path='' branch root='' wt ref
  [ $# -eq 1 ] && [ -n "$id" ] || usage
  id=$(require_id "$id")
  require_init

  # Closed items first: merge deletes the local branch but never origin's, so
  # on another machine the ref outlives the merge.
  path=$(find_item "$id")
  case "$path" in
    */items/archive/*) die "$id is already archived" ;;
  esac
  ref=$(item_branch "$id")
  local main prior
  main=$(default_branch)
  prior=$(merged_sha "$(main_root)" "$main" "$id")
  if [ -n "$prior" ]; then
    case "$ref" in
      origin/*) die "$id is already merged as $prior; $ref is a leftover — 'git push origin --delete ${ref#origin/}' removes it" ;;
      ?*) die "$id is already merged as $prior; $ref is a leftover — 'git branch -D $ref' removes it" ;;
      *) die "$id is already merged as $prior" ;;
    esac
  fi

  # Once its worktree is gone the ref is where the work is; resume from it.
  if [ -n "$ref" ]; then
    branch="${ref#origin/}"
    local at
    at=$(worktree_of "$branch")
    if [ -n "$at" ]; then
      [ -d "$at" ] || die "$branch's worktree $at was removed by hand; run 'git worktree prune', then retry"
      die "$id is already started; its worktree is $at"
    fi
    wt="$(main_root)/.worktrees/$branch"
    [ -e "$wt" ] && die "worktree already exists: $wt"
    case "$ref" in
      origin/*) git worktree add --quiet --track -b "$branch" "$wt" "$ref" ;;
      *) git worktree add --quiet "$wt" "$branch" ;;
    esac
    echo "resumed $branch in $wt" >&2
    # The branch exists already, so an empty section is a note.
    local f
    f=$(find "$wt/$WB/items" -name "$id-*.md" -print -quit 2>/dev/null || true)
    if [ -n "$f" ] && ! section_filled "$f" "$(criterion_heading "$id")"; then
      echo "note: $id's '$(criterion_heading "$id")' is empty; it is written and agreed before any code" >&2
    fi
    if [ -n "$f" ] && ! section_filled "$f" "$EFFECTS"; then
      echo "note: $id's '$EFFECTS' is empty; name what works today and changes, or 'none'" >&2
    fi
  else
    [ -n "$path" ] || die "no item matching '$id'"

    branch=$(basename "$path" .md)
    root=$(item_root "$path")
    local rel="${path#"$root"/}" mainr
    mainr=$(main_root)
    # The criterion is agreed before the branch is cut; a template comment alone does not count.
    require_closed_fences "$id" "$path"
    section_filled "$path" "$(criterion_heading "$id")" \
      || die "$id's '$(criterion_heading "$id")' is empty; it is written and agreed before any code — fill it, then start"
    # A guard step proves the tools ran, not that the behaviour is there.
    local guard
    guard=$(criterion_guard_steps "$path" "$(criterion_heading "$id")" "$root")
    [ -z "$guard" ] || die "$id's criterion has a step that is a guard, not a check: $guard— name a command whose result differs when the feature is missing, then start"
    # 'none' is an answer; an empty section is the question never asked.
    section_filled "$path" "$EFFECTS" \
      || die "$id's '$EFFECTS' is empty; name what works today and changes — a route, an export, an output — or 'none', then start"
    # A hand-written item is brought to the main checkout to land; one committed
    # on another checkout's branch would reach the default branch twice.
    if [ "$root" != "$mainr" ]; then
      ! git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1 \
        || die "$rel is committed on $(git -C "$root" rev-parse --abbrev-ref HEAD), not on $(default_branch); 'git rm' it there and commit, then start again"
      [ ! -e "$mainr/$rel" ] || die "$rel is both in $root and in $mainr; keep one"
      mkdir -p "$(dirname "$mainr/$rel")"
      mv "$path" "$mainr/$rel"
      # 'new' may have created the class directory just for this file.
      # Relative, so the walk up stops at the checkout rather than the root.
      (cd "$root" && rmdir -p --ignore-fail-on-non-empty "$(dirname "$rel")" 2>/dev/null) || true
      echo "moved $rel from $(basename "$root") to the main checkout" >&2
      path="$mainr/$rel"
      root="$mainr"
    fi
    # Under the main checkout and off the default branch, never nested in
    # another item's worktree.
    wt="$mainr/.worktrees/$branch"

    [ -e "$wt" ] && die "worktree already exists: $wt"

    # The criterion lands on the default branch first; main's copy then stands
    # as the item started.
    land_item "$path" "start $id"
    git worktree add --quiet -b "$branch" "$wt" "$(default_branch)"
    echo "started $branch in $wt" >&2
  fi
  # An uncommitted .claude/ is not in the new checkout.
  [ -d "$wt/.claude/skills/workbench" ] \
    || echo "note: .claude/ is not committed on $(default_branch), so a session inside $wt lacks the workbench commands until it is" >&2

  # stdout stays the path, which the skills read.
  echo "dispatch: wb-worker $id in $wt" >&2
  echo "$wt"
}

# From git's own list, not the .worktrees/<branch> convention: a worktree
# moved by hand is still a worktree.
worktree_of() {
  git worktree list --porcelain \
    | awk -v want="refs/heads/$1" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { if ($2 == want) { print wt; exit } }
      '
}

# worktree_of for a caller about to run git inside it: a worktree removed by
# hand stays listed until 'git worktree prune'.
live_worktree_of() {
  local wt
  wt=$(worktree_of "$1")
  [ -z "$wt" ] || [ -d "$wt" ] \
    || die "the worktree for $1 is gone but still listed: $wt; run 'git worktree prune', then retry"
  printf '%s\n' "$wt"
}

# Existing declarations the branch changed: removed-side diff lines only, so
# an added line is new behaviour and a body edited under an unchanged
# signature is not seen (the reviewer's job). TS/JS exports, Go's capitalised
# funcs and types, Python's top-level defs, route path literals. Nothing under
# workbench/ or .claude/. Prints '<name>\t<file>', unique.
# One squash commit whose only body is the trailer; every check keeps that
# commit honest. No evidence gate beyond the status: an item merges open as
# 'awaiting'. No fresh-context check of the item either; CLAUDE.md,
# "Measured", says why it came out. Every git call is pinned to the main checkout, since the item's
# worktree stops existing halfway through.
cmd_merge() {
  local id="${1:-}" subject="${2:-}" branch main root wt
  [ $# -eq 2 ] && [ -n "$id" ] && [ -n "$subject" ] || usage
  id=$(require_id "$id")
  require_init
  case "$subject" in
    *$'\n'*) die "the subject must be a single line" ;;
    *"Item:"*) die "the subject must not carry the trailer; it is added here" ;;
  esac

  root=$(main_root)
  main=$(default_branch)

  case "$(find_item "$id")" in
    */items/archive/*) die "$id is already archived" ;;
  esac
  local prior
  prior=$(merged_sha "$root" "$main" "$id")
  if [ -n "$prior" ]; then
    # The squash landed but the cleanup did not finish: name the leftovers and the commands.
    local left_branch left_wt
    left_branch=$(local_branches "$root" "$id" | head -1)
    left_wt=''
    [ -z "$left_branch" ] || left_wt=$(worktree_of "$left_branch")
    if [ -n "$left_branch" ]; then
      die "$id is already merged as $prior, but the cleanup after that commit did not finish. Left behind:
$([ -z "$left_wt" ] || printf '  worktree  %s\n' "$left_wt")  branch    $left_branch

Finish it with:
$([ -z "$left_wt" ] || printf "  git -C %s worktree remove %s\n" "$root" "$left_wt")  git -C $root branch -D $left_branch"
    fi
    die "$main already carries 'Item: $id' at $prior"
  fi
  branch=$(local_branches "$root" "$id")
  [ -n "$branch" ] || die "no branch named $id-*; nothing to merge"
  require_one_branch "$id" "$branch"

  # Read from the branch, not the checkout: the file may sit edited and
  # uncommitted in the worktree, refused further down.
  local item_on_branch tmp st
  item_on_branch=$(git -C "$root" ls-tree -r --name-only "$branch" -- "$WB/items" \
    | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
  # No copy on the branch is the witness missing, not nothing to check.
  [ -n "$item_on_branch" ] \
    || die "$id has no item file on $branch; merge reads the branch's copy — restore it there, then retry"
  tmp=$(mktemp)
  git -C "$root" show "$branch:$item_on_branch" > "$tmp"
  closed_fences "$tmp" || { rm -f "$tmp"; die "$id has an unclosed \`\`\` fence on $branch; close it, then retry"; }
  st=$(item_status "$tmp")
  known_status "$st" || { rm -f "$tmp"; die "$id has 'status: $st' on $branch, which is not a status"; }
  case "$st" in
    awaiting*|unverified*)
      case "$st" in
        *—*|*" - "*) ;;
        *) rm -f "$tmp"; die "$id: '$st' must name its trigger, e.g. 'status: awaiting — the next deploy'" ;;
      esac ;;
    unreproduced*) rm -f "$tmp"; die "$id is unreproduced and never merges; 'workbench archive $id' retires the branch" ;;
    abandoned*) rm -f "$tmp"; die "$id is abandoned and never merges; 'workbench archive $id' retires the branch, '--discard' with the work on it" ;;
    *)
      has_evidence "$tmp" || { rm -f "$tmp"; die "$id is open with no evidence under '## Evidence' on $branch; record it, or set 'status: awaiting — <trigger>' / 'unverified — <trigger>' when the criterion cannot run yet"; } ;;
  esac
  rm -f "$tmp"

  # The squash needs the default branch checked out, in the main checkout.
  local on
  on=$(git -C "$root" symbolic-ref -q --short HEAD || true)
  [ "$on" = "$main" ] || die "$root has '${on:-a detached HEAD}' checked out, not $main; the squash lands there"

  # Anything staged on main would go into the squash commit, so it is
  # refused. An unstaged edit would not: the commit takes the index, the
  # squash refuses to overwrite a modified file before writing anything, and
  # the reset that undoes a stopped squash keeps it. So those are tolerated —
  # the memory store in the tree is written by every session all day — with
  # one exception: git protects a modified file but not a missing one, so an
  # unstaged deletion of a file the branch touches would be quietly restored,
  # staged, and lost. Refused too.
  local dirt gone
  dirt=$(git -C "$root" status --porcelain --untracked-files=no | grep -v '^ M' || true)
  gone=$(printf '%s\n' "$dirt" | grep '^ D' | sed 's/^...//' || true)
  [ -z "$gone" ] || die "$root has an uncommitted deletion the squash would undo; commit or restore it first:
$(printf '%s\n' "$gone" | sed 's/^/  /')"
  [ -z "$dirt" ] || die "$root has staged changes; the squash commit would absorb them"

  wt=$(live_worktree_of "$branch")
  if [ -n "$wt" ]; then
    dirt=$(git -C "$wt" status --porcelain --untracked-files=all)
    if [ -n "$dirt" ]; then
      # The item file is the likeliest uncommitted edit: name it.
      local only
      only=$(printf '%s\n' "$dirt" | sed 's/^...//')
      if [ "$(printf '%s\n' "$only" | wc -l)" -eq 1 ]; then
        case "$only" in
          "$WB/items/"*"/$id-"*.md)
            die "$only is edited and not committed on the branch; commit it, then retry" ;;
        esac
        # A symlink is not a directory to git, so an ignore line with a
        # trailing slash ('node_modules/', 'target/') does not cover one.
        [ -L "$wt/$only" ] \
          && die "$wt has an untracked symlink, $only; ignore it with a '$only' line (no slash) in .gitignore, or remove it, then retry"
      fi
      die "$wt has uncommitted changes; commit or discard them first"
    fi
    # Checked before anything lands: the squash is not transactional, and a
    # locked worktree fails 'worktree remove' after the commit.
    if git -C "$root" worktree list --porcelain \
      | awk -v w="$wt" '$1=="worktree" { m = ($2 == w) } m && $1=="locked" { found=1 } END { exit !found }'; then
      die "the worktree $wt is locked, and merge removes it after the squash; 'git worktree unlock $wt' first, then retry"
    fi
  fi

  # Another item's file on this branch would land under this trailer and
  # collide at that item's own merge. Three-dot, so items landed since the cut
  # are not in it.
  local foreign
  foreign=$(git -C "$root" diff --name-only "$main...$branch" \
    | grep -E "^$WB/items/[^/]+/[bf]-[0-9]+-[^/]*\.md\$" \
    | grep -v -e "^$WB/items/archive/" -e "/$id-" || true)
  [ -z "$foreign" ] || die "$branch carries another item's file; 'git rm' it here — after 'workbench start <id>' for that item if it is not started — then retry:
$(printf '%s\n' "$foreign" | sed 's/^/  /')"

  # Main's copy must stand as it started: the squash is a three-way merge, so a
  # main-side edit in a hunk the branch never touched would merge in silently.
  if [ -n "$item_on_branch" ] && ! git -C "$root" diff --quiet "$branch...$main" -- "$item_on_branch"; then
    die "$main's copy of $id changed since $branch was cut; the item is edited on its branch only — revert it on $main, then retry"
  fi

  git -C "$root" merge-base --is-ancestor "$branch" "$main" \
    && die "$branch has nothing $main does not already have"

  # A squash that stops on conflicts leaves the main index half-merged; ask for
  # the rebase up front.
  if ! git -C "$root" merge-tree --write-tree "$main" "$branch" >/dev/null 2>&1; then
    die "$branch conflicts with $main; rebase it onto $main in its worktree, then retry"
  fi

  # premerge runs on the branch tip: a branch behind main would be tested
  # without what landed since. Except what the worker lands on main from its
  # worktree — a call, a new item — which touches only workbench/.
  if [ -n "$(git -C "$root" config --get workbench.premerge 2>/dev/null || true)" ] \
     && ! git -C "$root" merge-base --is-ancestor "$main" "$branch" \
     && git -C "$root" diff --name-only "$branch...$main" | grep -qv "^$WB/"; then
    die "$branch is behind $main, and premerge would test it without what landed since; in ${wt:-its worktree} run 'git rebase $main', then retry"
  fi

  # The project's own gate, last because it is slow, before anything lands;
  # only unsetting the config skips it.
  local premerge
  premerge=$(git -C "$root" config --get workbench.premerge 2>/dev/null || true)
  if [ -n "$premerge" ]; then
    [ -n "$wt" ] || die "workbench.premerge is set ('$premerge') and $branch has no worktree to run it in; 'workbench start $id' recreates one, then retry"
    echo "premerge: $premerge (in $wt)" >&2
    if ! (cd "$wt" && bash -c "$premerge") >&2; then
      die "$id: premerge check failed — '$premerge' exited non-zero in $wt; fix it on the branch, then retry. A worktree holds tracked files only: if the command wants the project's dependencies, install them there first"
    fi
  fi

  # merge-tree is a pre-check, not a guarantee — rename detection can differ —
  # and a commit hook can refuse. Either failure would leave the main index
  # half-squashed, the one state promised above never to leave, so both are
  # undone the way 'merge --abort' would.
  # Captured, not silenced: --quiet still leaves "Automatic merge went well"
  # on stderr, which is noise on success and evidence on failure.
  local squash
  squash=$(git -C "$root" merge --squash --quiet "$branch" 2>&1) \
    || {
      printf '%s\n' "$squash" >&2; unsquash "$root"
      # git stops here to protect the unstaged edit tolerated above.
      if grep -q 'overwritten by merge' <<< "$squash"; then
        die "the squash stopped; $root is restored — an uncommitted edit on $main is in the way of the branch; commit or discard it, then retry"
      fi
      die "the squash stopped; $root is restored — rebase $branch onto $main in its worktree, then retry"
    }
  # Content that reached main by another route squashes to nothing, and the
  # commit would refuse with a message about staging; name the state instead.
  if git -C "$root" diff --cached --quiet; then
    unsquash "$root"
    die "$branch changes nothing on $main — everything on it is already there; archive the item instead, or 'git branch -D $branch' if it is done with"
  fi
  # The trailer is the message.
  local trailer="Item: $id"
  git -C "$root" commit --quiet -m "$subject" -m "$trailer" \
    || { unsquash "$root"; die "the squash commit was refused; $root is restored and nothing was removed"; }

  # git's own safety in 'branch -d' cannot apply after a squash — the branch is
  # never an ancestor of the commit — so the check it would have made is made
  # here instead: the commit just written is the one the trailer finds.
  local sha
  sha=$(merged_sha "$root" "$main" "$id")
  [ -n "$sha" ] && [ "$sha" = "$(git -C "$root" rev-parse --short HEAD)" ] \
    || die "the squash commit did not land on $main as expected; nothing removed"

  # Past this point the commit exists; a failing cleanup reports the half-state,
  # and the guard at the top repeats it on a re-run.
  if [ -n "$wt" ] && ! git -C "$root" worktree remove "$wt"; then
    die "merged $id as $sha on $main, but removing the worktree failed. $wt and the branch $branch are still here; finish with 'git -C $root worktree remove $wt' and 'git -C $root branch -D $branch'"
  fi
  git -C "$root" branch -D --quiet "$branch" \
    || die "merged $id as $sha on $main, but the branch $branch could not be deleted; finish with 'git -C $root branch -D $branch'"

  echo "merged $id as $sha on $main"
  # The branch's copy overwrote main's in the squash; read the status from there.
  local item
  item=$(wb_find items -name "$id-*.md" -print -quit <<< "$root")
  case "$item" in
    */archive/*) echo "$id is already archived" >&2 ;;
    *)
      case "$(item_status "${item:-/dev/null}")" in
        awaiting*) echo "$id stays open until its trigger fires" >&2 ;;
        *) echo "next: workbench archive $id" >&2 ;;
      esac ;;
  esac
  if [ -n "$wt" ]; then
    case "$PWD" in
      "$wt"|"$wt"/*) echo "this shell's directory is gone; cd $root" >&2 ;;
    esac
  fi
}

item_status() {
  sed -n 's/^status: *//p' "$1" | head -1
}

# The status a listing shows. Archiving leaves the status line alone, so a
# plain 'open' under archive/ means verified and shipped; the unproved
# statuses say so themselves.
shown_status() {
  local st
  st=$(item_status "$1")
  case "$1" in */archive/*) [ "$st" = open ] && st=archived ;; esac
  printf '%s\n' "$st"
}

item_id() {
  basename "$1" | sed -n 's/^\([bf]-[0-9]\{1,\}\)-.*/\1/p'
}

# Undo a squash that did not reach its commit; --merge keeps the unstaged
# edits merge tolerates. The SQUASH_MSG would otherwise seed the next commit.
unsquash() {
  git -C "$1" reset -q --merge || echo "workbench: reset --merge failed; run it by hand in $1" >&2
  rm -f "$(git -C "$1" rev-parse --absolute-git-dir)/SQUASH_MSG"
}

# The branch squash commits land on; 'git config workbench.main' answers an odd layout once.
default_branch() {
  local b
  b=$(git config --get workbench.main 2>/dev/null || true)
  [ -n "$b" ] || b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
  if [ -z "$b" ]; then
    for b in main master; do
      git rev-parse --verify -q "refs/heads/$b" >/dev/null && break
      b=
    done
  fi
  [ -n "$b" ] || die "cannot resolve the default branch; set 'git config workbench.main <branch>'"
  printf '%s\n' "$b"
}

# Fences emptied: pasted output holds '## ' lines that would read as headings.
# The fence lines stay, so a block is still seen.
without_fences() {
  awk '/^[[:space:]]*(```|~~~)/ { inside = !inside; print; next } !inside' "$1"
}

# HTML comments gone, both shapes; a section holding only the template's
# comment is empty. Takes stdin.
strip_comments() {
  sed -e 's/<!--.*-->//' -e '/<!--/,/-->/d'
}

# Odd fence count: everything after the last fence is inside a block to every scan.
closed_fences() {
  local n
  n=$(grep -cE '^[[:space:]]*(```|~~~)' "$1" || true)
  [ $((n % 2)) -eq 0 ]
}

require_closed_fences() {
  closed_fences "$2" || die "$1 has an unclosed \`\`\` fence; close it, then retry"
}

has_evidence() {
  local body
  # 'grep -v' exits 1 when it filters everything out, which is an empty section,
  # not an error — the herestring grep below settles it either way.
  body=$(without_fences "$1" | sed -n '/^## Evidence/,/^## /p' \
    | tail -n +2 | grep -v '^## ' \
    | strip_comments) || true
  grep -qE '^[[:space:]]*(```|~~~)' <<<"$body"
}

# The '## ' headings a class may carry, in template order.
template_headings() {
  case "$1" in
    b-*) printf '%s\n' 'What was seen' 'How to reproduce' 'Root cause' 'The fix' 'Side effects' 'How to confirm it is fixed' 'Decisions' 'Evidence' ;;
    f-*) printf '%s\n' 'Why' 'What changes' 'What it touches' 'Side effects' 'How to confirm it works' 'Decisions' 'Evidence' ;;
  esac
}

# '## ' headings in the file that the class template does not have.
foreign_headings() {
  local id="$1" path="$2"
  comm -23 <(without_fences "$path" | sed -n 's/^## //p' | sort -u) <(template_headings "$id" | sort -u)
}

# A template heading twice: foreign_headings compares sets, and a second
# '## Evidence' splits the record with the gates reading only the first.
repeated_headings() {
  without_fences "$1" | sed -n 's/^## //p' | sort | uniq -d
}

# The statuses items.md defines, and nothing else.
known_status() {
  case "$1" in
    open|awaiting*|unverified*|unreproduced*|abandoned*) return 0 ;;
    *) return 1 ;;
  esac
}

# Retire a branch that never merges: an unreproduced bug's holds only its
# item file, an abandoned item's whatever was built, dropped only with
# discard=1 and named as it goes. The item file is always the dirty one and
# alone is exempt. Prints the path of the copy now in the main checkout.
retire_branch() {
  local id="$1" branch="$2" path="$3" discard="${4:-0}" main root wt other item_re hint dropped=0
  main=$(default_branch)
  root=$(main_root)
  wt=$(live_worktree_of "$branch")
  item_re="$WB/items/[^/]+/$id-[^/]*\\.md\$"
  case "$id:$(item_status "$path")" in
    *:abandoned*) hint="an abandoned item never merges: 'workbench archive $id --discard' drops the work, naming each file" ;;
    *) hint="merge $id, or remove the worktree and branch yourself, then archive" ;;
  esac

  if [ -n "$wt" ]; then
    other=$(git -C "$wt" status --porcelain --untracked-files=all | grep -vE "$item_re" || true)
    if [ -n "$other" ]; then
      [ "$discard" -eq 1 ] || die "$wt has changes beyond the item file:
$other
$hint"
      echo "dropping uncommitted changes in $wt:" >&2
      printf '%s\n' "$other" | sed 's/^/  /' >&2
      dropped=1
    fi
  fi
  other=$(git -C "$root" diff --name-only "$main...$branch" | grep -vE "^$item_re" || true)
  if [ -n "$other" ]; then
    [ "$discard" -eq 1 ] || die "$branch carries work beyond the item file:
$other
$hint"
    echo "dropping from $branch:" >&2
    printf '%s\n' "$other" | sed 's/^/  /' >&2
    dropped=1
  fi

  # The branch's copy is the one archived: from the worktree when there is one
  # (an uncommitted status edit counts), else from the branch itself.
  local rel
  if [ -n "$wt" ]; then
    rel="${path#"$(item_root "$path")"/}"
  else
    rel=$(git -C "$root" ls-tree -r --name-only "$branch" -- "$WB/items" \
      | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
    [ -n "$rel" ] || die "$branch carries no item file for $id; nothing to archive from it"
  fi
  # Overwritten, not merged — so a main-side edit since the cut would be
  # lost without a word. Refused, as merge refuses it.
  git -C "$root" diff --quiet "$branch...$main" -- "$rel" \
    || die "$main's copy of $id changed since $branch was cut; the item is edited on its branch only — revert it on $main, then retry"
  mkdir -p "$root/$(dirname "$rel")"
  if [ -n "$wt" ]; then
    [ "$path" = "$root/$rel" ] || cp "$path" "$root/$rel"
  else
    git -C "$root" show "$branch:$rel" > "$root/$rel"
  fi
  # A tag named by the id keeps the branch's commits reachable — what each
  # round believed. Annotated, so push.followTags carries it.
  git -C "$root" tag -a -m "$id" "$id" "$branch" \
    || die "tag $id already exists; the branch's history would be lost under it — 'git tag -d $id' if it is a leftover, then retry"
  # --force only because of the item file just copied out; everything else
  # was verified clean above.
  [ -z "$wt" ] || git -C "$root" worktree remove --force "$wt"
  git -C "$root" branch -D --quiet "$branch"
  if [ "$dropped" -eq 1 ]; then
    echo "retired $branch as tag $id; its prototypes are gone from the tree" >&2
  else
    echo "retired $branch as tag $id; nothing but the item was on it" >&2
  fi
  printf '%s\n' "$root/$rel"
}

# The first '## ' section, comments stripped: Why for a feature, What was
# seen for a bug.
lead_section() {
  without_fences "$1" | awk '/^## / { n++ } n == 1' | tail -n +2 \
    | strip_comments
}

section_filled() {
  local body
  body=$(without_fences "$1" | sed -n "/^## $2/,/^## /p" | tail -n +2 | grep -v '^## ' \
    | strip_comments) || true
  grep -q '[^[:space:]]' <<<"$body"
}

# Criterion steps that check nothing: the built-in pair, plus 'git config
# workbench.guards', an extended regex the installing tool sets.
criterion_guard_steps() {
  local file=$1 heading=$2 root=$3 pat='by inspection|behaviou?r (is )?unchanged|still does what it did' extra
  extra=$(git -C "$root" config --get workbench.guards 2>/dev/null || true)
  [ -z "$extra" ] || pat="$pat|$extra"
  without_fences "$file" | sed -n "/^## $heading/,/^## /p" | tail -n +2 | grep -v '^## ' | strip_comments \
    | grep -iE -- "$pat" \
    | head -3 | sed 's/^[[:space:]]*//; s/$/ /' | tr -d '\n' || true
}

# The criterion heading's common prefix, both classes.
criterion_heading() {
  echo "How to confirm"
}

EFFECTS='Side effects'

cmd_archive() {
  local id="${1:-}" path root sha discard=0
  [ -n "$id" ] || usage
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --discard) discard=1; shift ;;
      *) usage ;;
    esac
  done
  id=$(require_id "$id")
  require_init

  path=$(find_item "$id")
  case "$path" in
    */items/archive/*) die "$id is already archived" ;;
  esac

  local main branch
  main=$(default_branch)
  branch=$(local_branches "$(main_root)" "$id")
  require_one_branch "$id" "$branch"
  # Started with the worktree gone: the checks read the branch's copy.
  local tmp='' wt on_branch
  if [ -n "$branch" ]; then
    wt=$(worktree_of "$branch")
    if [ -z "$wt" ] || [ ! -d "$wt" ]; then
      on_branch=$(git ls-tree -r --name-only "$branch" -- "$WB/items" \
        | grep -E "/$id-[^/]*\.md\$" | grep -v '/archive/' | head -1 || true)
      if [ -n "$on_branch" ]; then
        tmp=$(mktemp)
        # Every refusal below would otherwise leave it behind.
        # shellcheck disable=SC2064
        trap "rm -f '$tmp'" EXIT
        git show "$branch:$on_branch" > "$tmp"
        path=$tmp
      fi
    fi
  fi
  # An item on its branch alone has no copy in any checkout.
  [ -n "$path" ] || die "no item matching '$id'"

  require_closed_fences "$id" "$path"
  local status
  status=$(item_status "$path")
  known_status "$status" \
    || die "$id has 'status: $status', which is not a status; the archive takes 'open' (with evidence), 'unreproduced', 'unverified — <trigger>' or 'abandoned — <why>'"
  # The archive is the locked record and takes no provisional decision.
  case "$status" in
    *"(agent)"*) die "$id's 'status: $status' was entered unattended; confirm it by deleting the '(agent)' marker, or change it, then archive" ;;
  esac
  if [ "$discard" -eq 1 ]; then
    case "$status" in
      abandoned*) ;;
      *) die "--discard is for abandoned items; $id merges or is retired as it is" ;;
    esac
  fi

  # Locked once archived, so its shape is checked on the way in.
  local extra
  extra=$(foreign_headings "$id" "$path")
  [ -z "$extra" ] || die "$id carries sections its template does not have; fold them into the template's sections or delete them:
$(printf '%s\n' "$extra" | sed 's/^/  ## /')"
  extra=$(repeated_headings "$path")
  [ -z "$extra" ] || die "$id carries these sections twice; the gates read only as far as the first, so fold each pair into one:
$(printf '%s\n' "$extra" | sed 's/^/  ## /')"
  extra=$(open_decisions_of "$path")
  [ -z "$extra" ] || die "$id has a decision waiting under '## Decisions'; answer it in the field it changes and delete the line, then archive:
$(printf '%s\n' "$extra" | sed 's/^/  /')"

  case "$status" in
    awaiting*)
      die "$id is awaiting a trigger and does not archive as-is; when it fires set 'status: open', record the evidence, then archive, or re-state it as 'unverified — <trigger>' if no bound can be named" ;;
    unverified*)
      case "$status" in
        *—*|*" - "*) ;;
        *) die "$id: 'unverified' must name its trigger, e.g. status: unverified — resolves when the server next pushes an announcement" ;;
      esac ;;
    unreproduced*) ;;
    abandoned*)
      case "$status" in
        *—*|*" - "*) ;;
        *) die "$id: 'abandoned' must say why, e.g. status: abandoned — the realm yield turned out to be fixed upstream" ;;
      esac
      local shipped
      shipped=$(merged_sha "$(main_root)" "$main" "$id")
      [ -z "$shipped" ] || die "$id merged as $shipped; shipped work is not abandoned — archive it as 'open' with evidence, or 'unverified — <trigger>'" ;;
    *)
      has_evidence "$path" \
        || die "$id has no evidence recorded; archive requires it (or status: unreproduced / unverified — <trigger> / abandoned — <why>)" ;;
  esac

  # A branch still standing means the item has not merged; the branches that
  # never merge are retired here.
  if [ -n "$branch" ]; then
    case "$id:$status" in
      *:abandoned*) path=$(retire_branch "$id" "$branch" "$path" "$discard") ;;
      *:unreproduced*) path=$(retire_branch "$id" "$branch" "$path") ;;
      *) die "$id still has branch $branch; merge it first — archive records the squash commit" ;;
    esac
  fi

  # On the default branch only: HEAD is whatever the checkout sits on, and
  # --all could hit a branch commit the squash then discards. Never fall back
  # to HEAD; an item with no trailer records 'none'.
  sha=$(merged_sha "$(main_root)" "$main" "$id")
  if [ -z "$sha" ]; then
    sha=none
    echo "no commit on $main carries 'Item: $id'; recorded as commit: none" >&2
  fi

  # Assigned after retire_branch, which returns a new $path once the worktree
  # is gone; above this line say '$(main_root)', not '$root' — 'git -C ""' is
  # a silent no-op against the caller's cwd.
  root=$(item_root "$path")
  local dest
  dest="$root/$WB/items/archive/$(basename "$path")"
  mkdir -p "$(dirname "$dest")"

  # An untracked item cannot be 'git mv'ed. The commit line goes on after the
  # move, so a re-run appends it once.
  if git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
    git -C "$root" mv "$path" "$dest"
  else
    mv "$path" "$dest"
  fi
  printf '\ncommit: %s\n' "$sha" >> "$dest"

  echo "archived $id at $sha"
  echo "next: git -C $root add -A $WB/items && git -C $root commit -m 'archive $id'" >&2
}

# One line per document over its cap; 'git config workbench.cap.<name>'
# overrides, a non-number falling back to the default.
cap_alert() {
  local mainr f name key cap n
  mainr=$(main_root)
  for f in "CLAUDE.md:claude:$CAP_CLAUDE" \
           "$WB/GLOSSARY.md:glossary:$CAP_GLOSSARY" \
           "$WB/BACKLOG.md:backlog:$CAP_BACKLOG" \
           "$WB/DECISIONS.md:decisions:$CAP_DECISIONS"; do
    name=${f%%:*}; key=${f#*:}; key=${key%%:*}; cap=${f##*:}
    [ -f "$mainr/$name" ] || continue
    n=$(git config --get "workbench.cap.$key" 2>/dev/null || true)
    case "$n" in ''|*[!0-9]*) ;; *) cap=$n ;; esac
    n=$(wc -l < "$mainr/$name")
    [ "$n" -le "$cap" ] || printf 'cap: %s %s/%s — cut it; docs.md, Line caps\n' "$name" "$n" "$cap"
  done
}

# --- hook input -------------------------------------------------------------

# Dotted paths out of a JSON object on stdin, one line per path in argument
# order, empty for a missing or non-string value — the count is the contract,
# read_hook_input binds positionally. One python3 for all of them: a start is
# ~15ms and this runs on every hook. Without python3, a text scan.
json_fields() {
  local input k
  input=$(cat 2>/dev/null || true)
  if command -v python3 >/dev/null 2>&1; then
    # Never fails: unparseable input yields one empty line per path.
    printf '%s' "$input" | python3 -c '
import json, re, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = None
for path in sys.argv[1:]:
    v = d
    for k in path.split("."):
        v = v.get(k) if isinstance(v, dict) else None
    if isinstance(v, str):
        print(re.sub(r"\s+", " ", v))
    elif isinstance(v, bool):
        print("true" if v else "false")
    elif isinstance(v, (int, float)):
        print(v)
    else:
        print("")' "$@" 2>/dev/null || true
    return 0
  fi
  # The FIRST occurrence of the path's last segment — a greedy sed would take
  # the last, a nested copy. A heuristic aimed at how these payloads are
  # written. awk rather than 'grep -o | head -1': head closes the pipe and the
  # writer takes SIGPIPE.
  for k in "$@"; do
    printf '%s' "$input" | awk -v key="${k##*.}" '
      !done && match($0, "\"" key "\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|-?[0-9][0-9.eE+-]*|true|false)") {
        s = substr($0, RSTART, RLENGTH)
        sub(/^[^:]*:[[:space:]]*/, "", s); gsub(/^"|"$/, "", s)
        print s; done = 1
      }
      END { if (!done) print "" }'
  done
}

hook_input=""
HOOK_FIELDS="source"
h_source=""
read_hook_input() {
  hook_input=$(cat 2>/dev/null || true)
  [ -n "$hook_input" ] || return 0
  local k vals=() i=0
  # ':-' below, not just the count from json_fields: a process substitution
  # ending in all-empty lines still arrives as fewer elements than fields.
  # shellcheck disable=SC2086
  mapfile -t vals < <(printf '%s' "$hook_input" | json_fields $HOOK_FIELDS)
  # shellcheck disable=SC2086
  for k in $HOOK_FIELDS; do
    printf -v "h_${k//./_}" '%s' "${vals[$i]:-}"; i=$((i + 1))
  done
}

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# --- round: the review dialog's accountant --------------------------------

# Records one round of the review dialog on the item — 'rounds: r1 5/2 · r2
# 2/0 · stop' under its status line — and says what comes next. Numeric so
# the worker cannot argue: round 2 always; another while the last round fixed
# three or more, or as many as the round before (two at least); the cap
# parks it.
ROUND_CAP=5
cmd_round() {
  local id="${1:-}" fixed="${2:-}" stands="${3:-}"
  [ -n "$id" ] || usage
  [ $# -eq 3 ] || usage
  # Each on its own: concatenated, an empty count borrows the other's digits —
  # '' and '3' read as the single count '3' and passed.
  case "$fixed" in *[!0-9]*|'') die "fixed and stands are counts: workbench round $id <fixed> <stands>" ;; esac
  case "$stands" in *[!0-9]*|'') die "fixed and stands are counts: workbench round $id <fixed> <stands>" ;; esac
  id=$(require_id "$id")
  local path
  path=$(find_item "$id")
  [ -n "$path" ] || die "no item matching '$id'"
  grep -q '^status: ' "$path" || die "$path has no status line"
  local line prev_fixed=0 k=1 entries decision
  line=$(sed -n 's/^rounds: *//p' "$path" | head -1)
  if [ -n "$line" ]; then
    entries=$(printf '%s' "$line" | sed 's/ · \(stop\|call\|again\)$//')
    k=$(( $(printf '%s' "$entries" | grep -o 'r[0-9]*' | wc -l) + 1 ))
    prev_fixed=$(printf '%s' "$entries" | sed -n 's/.*r[0-9]* \([0-9]*\)\/[0-9]*$/\1/p')
    [ -n "$prev_fixed" ] || prev_fixed=0
    entries="$entries · r$k $fixed/$stands"
  else
    entries="r1 $fixed/$stands"
  fi
  if [ "$k" -eq 1 ]; then
    decision=again
  elif [ "$fixed" -lt 3 ] && [ "$fixed" -lt "$(( prev_fixed > 2 ? prev_fixed : 2 ))" ]; then
    decision=stop
  elif [ "$k" -ge "$ROUND_CAP" ]; then
    decision=call
  else
    decision=again
  fi
  local tmp
  tmp=$(mktemp)
  if [ -n "$line" ]; then
    sed "s|^rounds: .*|rounds: $entries · $decision|" "$path" > "$tmp"
  else
    awk -v r="rounds: $entries · $decision" '{ print } /^status: / && !done { print r; done = 1 }' "$path" > "$tmp"
  fi
  # mktemp creates 0600; the replace must not carry that onto the item file.
  chmod --reference="$path" "$tmp"
  mv -f "$tmp" "$path"
  echo "rounds: $entries"
  case "$decision" in
    again) echo "next: review again — a new reviewer, round $((k + 1))" ;;
    stop) echo "next: merge — workbench merge $id \"<subject>\"" ;;
    call) echo "next: call — $ROUND_CAP rounds and still finding; workbench call $id with the standing findings, then report blocked" ;;
  esac
}

# --- ideas ------------------------------------------------------------------

# One line onto the main checkout's backlog wherever this runs; an unstaged
# edit on main, which merge tolerates.
cmd_idea() {
  local line="${1:-}" f
  [ $# -eq 1 ] && [ -n "$line" ] || usage
  require_init
  case "$line" in *$'\n'*) die "an idea is one line" ;; esac
  [ "${#line}" -le "$IDEA_MAX" ] || die "an idea is one obvious sentence, under $IDEA_MAX characters; a question for the user is 'workbench call'"
  f="$(main_root)/$WB/BACKLOG.md"
  [ -f "$f" ] || die "no $f; run 'workbench init' in the main checkout"
  # A last line missing its newline would otherwise absorb the entry.
  [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
  printf -- '- %s\n' "$line" >> "$f"
  echo "$f"
}

# A decision that is the user's, parked: one line under the item's
# '## Decisions', or in DECISIONS.md for '-'.
cmd_call() {
  local id="${1:-}" line="${2:-}" f
  [ $# -eq 2 ] && [ -n "$id" ] && [ -n "$line" ] || usage
  require_init
  case "$id" in
    -) id='' ;;
    *) id=$(require_id "$id") ;;
  esac
  case "$line" in *$'\n'*) die "a call is one line" ;; esac
  [ "${#line}" -le "$CALL_MAX" ] || die "a call is one question under $CALL_MAX characters; the reasoning stays in the item"
  if [ -z "$id" ]; then
    f="$(main_root)/$WB/DECISIONS.md"
    [ -f "$f" ] || write_decisions "$f"
    [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
    printf -- '- %s\n' "$line" >> "$f"
    # Committed alone, like an item's start: the reviewer reads git, and a
    # call left unstaged on main is one it cannot see.
    land_item "$f" "call parked"
    echo "$f"
    return 0
  fi
  # A started item's call lands on the branch, never on main, so the worker's
  # own question does not put its branch behind main.
  f=$(find_item "$id")
  [ -n "$f" ] || die "no item matching '$id'"
  case "$f" in */items/archive/*) die "$id is archived; a call on it is a new item" ;; esac
  require_closed_fences "$id" "$f"
  local root
  root=$(item_root "$f")
  if ! grep -q '^## Decisions' "$f"; then
    # An item written before the section existed.
    [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
    printf '\n## Decisions\n' >> "$f"
  fi
  # At the end of the section.
  local tmp
  tmp=$(mktemp)
  awk -v l="- $line" '
    /^## Decisions/ { inside = 1 }
    inside && /^## / && !/^## Decisions/ { print l; print ""; inside = 0 }
    { print; prev = $0 }
    END { if (inside) { if (prev != "") print ""; print l } }' "$f" > "$tmp"
  mv "$tmp" "$f"
  if [ "$root" = "$(main_root)" ] && [ -z "$(worktree_of "$(basename "$f" .md)")" ]; then
    land_item "$f" "call $id"
  else
    git -C "$root" add -- "$f"
    git -C "$root" commit --quiet -m "call $id" -- "$f" \
      || die "the commit for ${f#"$root"/} was refused on $(git -C "$root" rev-parse --abbrev-ref HEAD); the file is staged in $root"
    echo "committed ${f#"$root"/} on $(git -C "$root" rev-parse --abbrev-ref HEAD)" >&2
  fi
  echo "$f"
}

# Open decision lines of one item file: the bullets under '## Decisions'.
open_decisions_of() {
  without_fences "$1" | sed -n '/^## Decisions/,/^## /p' | tail -n +2 | grep -v '^## ' \
    | strip_comments | grep '^- ' || true
}

open_calls() {
  local f
  f="$(main_root)/$WB/DECISIONS.md"
  [ -f "$f" ] || return 0
  grep -c '^- ' "$f" || true
}

# --- status -----------------------------------------------------------------

# One line per item: from its own worktree when the branch has one, else
# from the main checkout. A sibling's inherited copy is not counted, an item
# archived on main is archived, and an item on no branch and not on main
# (untracked in a sibling) is shown from where it is, labelled.
status_lines() {
  local name="$1" f='' st own started='' where='' mainr d tmp=''
  shift
  mainr=$(main_root)
  own=$(worktree_of "${name%.md}")
  if [ -n "$own" ] && [ -d "$own" ]; then
    f=$(find "$own/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
    started='   started'
  fi
  if [ -z "$f" ]; then
    [ -z "$(find "$mainr/$WB/items/archive" -name "$name" -print -quit 2>/dev/null)" ] || return 0
    f=$(find "$mainr/$WB/items" -name "$name" -print -quit 2>/dev/null || true)
    # A branch with no worktree is started too. Not local_branches: that globs
    # '<id>-*', and b-1-foo would answer for b-1-foobar.
    [ -z "$(git -C "$mainr" for-each-ref --format='%(refname:short)' "refs/heads/${name%.md}")" ] || started='   started'
    if [ -n "$f" ] && ! git -C "$mainr" ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      where="   [not committed — 'workbench start' lands it]"
    fi
  fi
  if [ -z "$f" ]; then
    for d in "$@"; do
      f=$(find "$d" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
      [ -z "$f" ] || break
    done
    if [ -n "$f" ]; then
      where="   [in $(basename "$(item_root "$f")"), not on $(default_branch)]"
    elif [ -n "$started" ]; then
      # On its branch alone: read from there, and say so.
      local on_branch
      on_branch=$(git -C "$mainr" ls-tree -r --name-only "${name%.md}" -- "$WB/items" 2>/dev/null \
        | grep -F "/$name" | grep -v '/archive/' | head -1 || true)
      [ -n "$on_branch" ] || return 0
      tmp=$(mktemp)
      git -C "$mainr" show "${name%.md}:$on_branch" > "$tmp"
      f=$tmp
      where="   [on its branch only; 'workbench start' resumes it]"
    else
      return 0
    fi
  fi
  # Read, then remove: a temp file must not outlive a failed read.
  st=$(shown_status "$f" || true)$started
  [ -z "$tmp" ] || rm -f "$tmp"
  printf '  %-34s %s%s\n' "${name%.md}" "$st" "$where"
}

cmd_status() {
  local dirs=()
  require_init
  # The SessionStart hook also fires on compaction, which drops every invoked
  # skill body and path rule; say so first. Stdin is read only when something
  # is there: by hand it is a tty.
  if [ ! -t 0 ] && read -t 0 -r _ 2>/dev/null; then
    read_hook_input
    if [ "$h_source" = compact ]; then
      echo "compaction dropped the workbench skill body and every .claude/rules file from this context; invoke the workbench skill before the next step"
      echo
    fi
  fi
  # Every checkout: an item on a sibling worktree's branch is in flight too.
  mapfile -t dirs < <(wb_dirs items < <(all_roots))

  local names=() name
  mapfile -t names < <(open_names)

  # Before the items, so a session start reads it first.
  local alert
  alert=$(cap_alert)
  if [ -n "$alert" ]; then
    echo "$alert"
    echo
  fi
  # Per clone: a fresh clone has none.
  if [ -z "$(git config --get workbench.premerge 2>/dev/null || true)" ]; then
    echo "premerge: unset — merges run no project check in this clone; git config workbench.premerge \"<the project's test or gate command>\""
    echo
  fi
  echo "open items"
  if [ "${#names[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    for name in "${names[@]}"; do status_lines "$name" "${dirs[@]}"; done
  fi

  echo
  echo "branches"
  git branch --format='  %(refname:short)' | grep -E '^  [bf]-[0-9]+-' \
    || echo "  (none)"

  # Merged and open: invisible to 'git branch'. Merged means on the default
  # branch, so main's copies are read.
  echo
  echo "merged, still awaiting a trigger"
  local hits=()
  # 'awaiting' is chosen before merge, so an item still on its branch carries
  # it too; that one is in flight and listed above, not merged.
  mapfile -t hits < <(awaiting_on_main)
  if [ "${#hits[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    local f
    for f in "${hits[@]}"; do
      printf '  %-34s %s\n' "$(basename "$f" .md)" "$(item_status "$f")"
    done
  fi

  # Merged and still 'open', with no branch: an item that merged with its
  # criterion unrun and never said so.
  echo
  echo "merged, still open — archive, or set 'awaiting — <trigger>' / 'unverified — <trigger>'"
  local mainr mainb mid limbo=0
  mainr=$(main_root)
  mainb=$(default_branch 2>/dev/null) || mainb=""
  if [ -n "$mainb" ]; then
    for name in "${names[@]}"; do
      mid=$(item_id "$name")
      [ -n "$mid" ] || continue
      [ -z "$(local_branches "$mainr" "$mid")" ] || continue
      f=$(find "$mainr/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
      [ -n "$f" ] || continue
      local st sha
      st=$(item_status "$f")
      case "$st" in awaiting*|unverified*) continue ;; esac
      sha=$(merged_sha "$mainr" "$mainb" "$mid")
      [ -n "$sha" ] || continue
      # Shipped work carrying a status that never merges: archive refuses it.
      case "$st" in
        unreproduced*|abandoned*) printf '  %-34s merged as %s, yet \x27%s\x27 — archive will refuse; set open with evidence, or unverified — <trigger>\n' "${name%.md}" "$sha" "$st" ;;
        *) printf '  %-34s merged as %s\n' "${name%.md}" "$sha" ;;
      esac
      limbo=1
    done
  fi
  [ "$limbo" -eq 1 ] || echo "  (none)"

  # Provisional decisions, from the copy that is the item.
  local prov=() pf pl
  for name in "${names[@]}"; do
    pf=$(item_copy "$name")
    [ -n "$pf" ] || continue
    while IFS= read -r pl; do
      [ -n "$pl" ] || continue
      prov+=("$(printf '%-34s %s' "${name%.md}" "$pl")")
    done < <(without_fences "$pf" | grep -E '^status:.*\(agent\)' | sed 's/[[:space:]]*$//' || true)
  done
  if [ "${#prov[@]}" -gt 0 ]; then
    echo
    echo "provisional decisions (agent) — confirm by deleting the marker, or overrule in the item"
    printf '  %s\n' "${prov[@]}"
  fi

  # Decisions parked in the items themselves, from the copy that is the item.
  local dec=() dl
  for name in "${names[@]}"; do
    pf=$(item_copy "$name")
    [ -n "$pf" ] || continue
    while IFS= read -r dl; do
      [ -n "$dl" ] || continue
      dec+=("$(printf '%-34s %s' "${name%.md}" "${dl#- }")")
    done < <(open_decisions_of "$pf")
  done
  if [ "${#dec[@]}" -gt 0 ]; then
    echo
    echo "decisions waiting on the user — answer in the item, then delete the line"
    printf '  %s\n' "${dec[@]}"
  fi

  # Calls tied to no item.
  local calls
  calls=$(open_calls)
  if [ -n "$calls" ] && [ "$calls" -gt 0 ]; then
    echo
    echo "calls waiting on the user — $WB/DECISIONS.md"
    grep '^- ' "$mainr/$WB/DECISIONS.md" | sed 's/^- /  /'
  fi

  # Same ID under two slugs, archive included; names deduplicated first.
  # Repair: references/git.md.
  local dupes
  dupes=$(wb_find items -name '[bf]-*-*.md' -print < <(all_roots) \
    | sed 's|.*/||' | sort -u \
    | sed -n 's|^\([bf]-[0-9]\{1,\}\)-.*|\1|p' | sort | uniq -d)
  if [ -n "$dupes" ]; then
    echo
    echo "DUPLICATE IDS — see references/git.md for repair"
    printf '%s\n' "$dupes" | sed 's/^/  /'
  fi

  # Listed, not fixed: init refreshes them, and that is the user's commit.
  local drift stale edited
  drift=$(skill_drift)
  stale=$(awk -F '\t' '$2 != "edited" { printf "%s ", $1 }' <<< "$drift")
  edited=$(awk -F '\t' '$2 == "edited" { printf "%s ", $1 }' <<< "$drift")
  if [ -n "${stale// /}" ]; then
    echo
    echo "skills behind their source — run 'workbench init', then commit .claude/"
    echo "  $stale"
  fi
  if [ -n "${edited// /}" ]; then
    echo
    echo "skills edited by hand under .claude/skills/ — move the edit into the source; 'workbench init --force' overwrites"
    echo "  $edited"
  fi
  # One bit for agents: differs, whether stale or edited.
  local agents
  agents=$(agent_drift | awk -F '\t' '{ printf "%s ", $1 }')
  if [ -n "${agents// /}" ]; then
    echo
    echo "agents differ from their source — run 'workbench init', then commit .claude/"
    echo "  $agents"
  fi
  # The memory setting is a committed path; a clone laid out differently
  # points elsewhere.
  local mem
  mem=$(memory_dir_setting)
  case "$mem" in
    "$(main_root)/.claude/memory" | "") ;;
    */.claude/memory)
      echo
      echo "memory: autoMemoryDirectory points at $mem, not this checkout's .claude/memory — the setting was written for a clone at another path; override it here in .claude/settings.local.json"
      ;;
  esac
}

# Item names in flight over every checkout, once each, minus those archived
# on main; a branch named like an item whose file is in no checkout counts too.
open_names() {
  local archived
  archived=$(find "$(main_root)/$WB/items/archive" -name '[bf]-*.md' 2>/dev/null | sed 's|.*/||')
  {
    wb_find items -path '*/archive/*' -prune -o -name '[bf]-*.md' -print < <(all_roots 2>/dev/null) | sed 's|.*/||'
    git for-each-ref --format='%(refname:short).md' 'refs/heads/[bf]-*' | grep -E '^[bf]-[0-9]+-'
  } | sort -u \
    | { if [ -n "$archived" ]; then grep -vxF -f <(printf '%s\n' "$archived") || true; else cat; fi; }
}

# The copy of an item that is the item: on its branch when it has a worktree,
# else in the main checkout — never a sibling's inherited copy. Empty for an
# item archived on main or held on its branch alone.
item_copy() {
  local name="$1" own f='' mainr
  mainr=$(main_root)
  own=$(worktree_of "${name%.md}")
  if [ -n "$own" ] && [ -d "$own" ]; then
    f=$(find "$own/$WB/items" -path '*/archive/*' -prune -o -name "$name" -print -quit 2>/dev/null || true)
  fi
  if [ -z "$f" ]; then
    [ -z "$(find "$mainr/$WB/items/archive" -name "$name" -print -quit 2>/dev/null)" ] || return 0
    f=$(find "$mainr/$WB/items" -name "$name" -print -quit 2>/dev/null || true)
  fi
  [ -z "$f" ] || printf '%s\n' "$f"
}

# Items merged as 'awaiting' — on the default branch, so read from the main
# checkout — whose branch is gone: one still on its branch is in flight.
awaiting_on_main() {
  local mainr h
  mainr=$(main_root)
  [ -d "$mainr/$WB/items" ] || return 0
  grep -rl '^status: awaiting' "$mainr/$WB/items" --exclude-dir=archive 2>/dev/null | sort \
    | while IFS= read -r h; do
        [ -n "$(local_branches "$mainr" "$(item_id "$h")")" ] || printf '%s\n' "$h"
      done
  return 0
}

# Every checkout of the repository, a removed-by-hand one included until it is
# pruned; wb_dirs drops those.
all_roots() {
  git worktree list --porcelain | sed -n 's/^worktree //p'
}

# 'autoMemoryDirectory': local settings over project over user; empty when unset.
memory_dir_setting() {
  local f v
  for f in "$(main_root)/.claude/settings.local.json" "$(main_root)/.claude/settings.json" "${HOME%/}/.claude/settings.json"; do
    [ -f "$f" ] || continue
    v=$(json_fields autoMemoryDirectory < "$f")
    [ -n "$v" ] || continue
    # shellcheck disable=SC2088  # the setting's own literal '~/'
    case "$v" in "~/"*) v="${HOME%/}/${v#\~/}" ;; esac
    printf '%s\n' "$v"
    return 0
  done
  return 0
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  adopt) shift; cmd_adopt "$@" ;;
  new) shift; cmd_new "$@" ;;
  start) shift; cmd_start "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  idea) shift; cmd_idea "$@" ;;
  call) shift; cmd_call "$@" ;;
  archive) shift; cmd_archive "$@" ;;
  status) shift; cmd_status "$@" ;;
  round) shift; cmd_round "$@" ;;
  help|-h|--help) usage 0 ;;
  *) usage ;;
esac
