{
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*_rsa)",
      "Read(**/*_ed25519)",
      "Read(~/.config/gh/hosts.yml)"
    ],
    "defaultMode": "auto"
  },
  "language": "English",
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "editorMode": "vim",
  "showTurnDuration": true,
  "skipAutoPermissionPrompt": true
}
