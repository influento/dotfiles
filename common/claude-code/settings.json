{
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Bash(pacman:*)",
      "Bash(pgrep:*)",
      "Bash(sudo pacman:*)",
      "Bash(yay:*)",
      "Bash(auto-update:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev*)",
      "Read(**/.env.prod*)",
      "Read(**/.env.stag*)",
      "Read(**/.env.test*)",
      "Read(**/.env.ci)",
      "Read(**/.env.vault)",
      "Read(**/secrets/**)",
      "Read(**/credentials)",
      "Read(**/*credentials.json)",
      "Read(**/*credentials.yaml)",
      "Read(**/*credentials.yml)",
      "Read(**/*credentials.toml)",
      "Read(**/*credentials.ini)",
      "Read(**/*credentials.conf)",
      "Read(**/*credentials.txt)",
      "Read(**/*credentials.enc)",
      "Read(**/*secret)",
      "Read(**/*secrets)",
      "Read(**/*secret.json)",
      "Read(**/*secrets.json)",
      "Read(**/*secret.yaml)",
      "Read(**/*secrets.yaml)",
      "Read(**/*secret.yml)",
      "Read(**/*secrets.yml)",
      "Read(**/*secret.toml)",
      "Read(**/*secrets.toml)",
      "Read(**/*secret.ini)",
      "Read(**/*secrets.ini)",
      "Read(**/*secret.conf)",
      "Read(**/*secrets.conf)",
      "Read(**/*secret.txt)",
      "Read(**/*secrets.txt)",
      "Read(**/*secret.env)",
      "Read(**/*secrets.env)",
      "Read(**/*secret.enc)",
      "Read(**/*secrets.enc)",
      "Read(**/*secret.tfvars)",
      "Read(**/*secrets.tfvars)",
      "Read(**/*secret.key)",
      "Read(**/*secrets.key)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(**/*.pem)",
      "Read(**/*_rsa)",
      "Read(**/*_ed25519)",
      "Read(~/.config/gh/hosts.yml)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "outputStyle": "Concise",
  "language": "English",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "showTurnDuration": true,
  "skipAutoPermissionPrompt": true
}
