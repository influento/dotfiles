{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "!repos/**",
      "!.worktrees/**",
      "!dist/**",
      "!coverage/**"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
