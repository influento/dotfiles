#!/usr/bin/env bash
set -euo pipefail

# claude-tmux — Claude Code hooks in, tmux-attention flags out.
#
# `signal` is run by the hooks in common/claude-code/settings.json, one call per
# event, and translates the event into a tmux-attention state for the pane the
# session runs in ($TMUX_PANE, inherited by every hook). It also keeps one
# record per pane under ~/.local/state/claude-tmux/ — session id, transcript,
# cwd, last state, and the pane's session:window.pane target — which
# `restore` reads after a reboot to bring the conversation back with
# `claude --resume` and re-flag the pane. The file is named by the pane id,
# which holds for the server's life; the target is refreshed on every
# transition, because window and pane indexes shift whenever a window to the
# left closes (renumber-windows) or a pane above is killed.
#
#   event                                  state
#   UserPromptSubmit, PreToolUse,           working
#   PostToolUse
#   PreToolUse AskUserQuestion              needs-you   "question: …"
#   PermissionRequest                       needs-you   "Bash(…)", "Edit(file)"
#   Notification elicitation_dialog,        needs-you   the message
#   Notification agent_needs_input
#   Stop                                    done
#   SessionStart                            idle, or the recorded flag when
#                                           `restore` launched this resume
#   SessionEnd                              idle; the record is dropped unless
#                                           the reason is "other" (a kill)
#
# Every flag is set --owner claude, so a claude that dies without SessionEnd
# firing takes its flag with it on the next tmux-attention sweep.
#
# Outside workbench a window running claude is named "claude" like every
# other. On Stop, while the window still carries tmux's automatic name, it
# takes the first words of the first prompt; SessionEnd hands the name back
# to tmux when it is still the one set here. A window the user named is never
# touched: renaming turns automatic-rename off, and that is the check.
#
# A title must not outlive its claude. tmux-resurrect saves a titled window
# as user-named and restores names by window index, so after windows close
# and the rest renumber, a restore stamps a dead session's title on whatever
# window sits at that index now, and it can never rename itself again. So
# `sync` rewrites each save to show those windows as "claude" with
# automatic-rename on (the record keeps the title and SessionStart puts it
# back on a resume), and `sweep` hands the name back on any titled window
# with no claude in it, which is what a pane killed with claude inside
# leaves behind. The titled window carries @claude_title so the sweep needs
# no record. The sweep also runs the other way, putting a recorded title
# back on a claude that is running under the automatic name again.
#
# What a restored flag means: the state is information, not a live prompt.
# A permission or question that was pending before the restart is gone with
# the process; the pane comes back as needs-you with "before restart: …" so
# you know to answer or say "continue". A turn cut mid-work comes back as
# needs-you "interrupted mid-turn". An unread done stays done.
#
# Outside tmux every subcommand exits 0 silently. In wb-* sessions workbench
# owns the window title and the needs-you notification, so flags there are set
# --quiet and restore leaves those panes to `workbench open`.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux"

usage() {
  cat >&2 <<'EOF'
usage:
  claude-tmux signal <start|end|working|question|permission|notification|stop>
                        run by the Claude Code hooks; reads the hook JSON on stdin
  claude-tmux restore   after tmux-attach restored the layout: resume recorded
                        sessions in their panes and re-flag them
  claude-tmux sync      refresh every record's target from the live panes and
                        keep claude titles out of the save; run by
                        tmux-resurrect after each save
  claude-tmux sweep     hand back the name of every claude-titled window that
                        no longer runs claude
  claude-tmux records   print the records
EOF
  exit 2
}

# --- hook input --------------------------------------------------------------

# Dotted paths out of the JSON on stdin, one line each in argument order,
# empty for a missing path. One python3 start per call, so `signal` only
# parses when the state depends on the payload.
json_fields() {
  local input
  input=$(cat 2>/dev/null || true)
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$input" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
for p in sys.argv[1:]:
    v = d
    for k in p.split("."):
        if isinstance(v, list):
            try:
                v = v[int(k)]
            except Exception:
                v = None
        elif isinstance(v, dict):
            v = v.get(k)
        else:
            v = None
        if v is None:
            break
    if isinstance(v, bool):
        v = "true" if v else "false"
    print("" if v is None or isinstance(v, (dict, list)) else str(v).replace("\n", " "))
' "$@"
  else
    local p
    for p in "$@"; do
      printf '%s' "$input" | sed -n "s/.*\"${p##*.}\" *: *\"\([^\"]*\)\".*/\1/p" | head -1
      echo
    done
  fi
}

# --- pane records ------------------------------------------------------------

# The record's key: the pane id, stable while the server lives.
pane_key() { printf '%s' "${TMUX_PANE:-}"; }

# Where the pane is right now, the form tmux-resurrect saves and send-keys takes.
pane_target() {
  tmux display -p -t "$TMUX_PANE" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true
}

record_path() { printf '%s/%s\n' "$STATE_DIR" "${1//\//_}"; }

# record_write <key> <field=value>...: merge fields into the record.
record_write() {
  local key="$1" f tmp
  shift
  mkdir -p "$STATE_DIR"
  f=$(record_path "$key")
  tmp=$(mktemp "$STATE_DIR/.tmp.XXXXXX")
  {
    [ ! -f "$f" ] || cat "$f"
    printf '%s\n' "$@"
    printf 'updated=%s\n' "$(date +%s)"
  } | awk -F= '{ v[$1] = substr($0, index($0, "=") + 1); if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 } } END { for (i = 1; i <= n; i++) printf "%s=%s\n", order[i], v[order[i]] }' > "$tmp"
  mv -f "$tmp" "$f"
}

record_get() {
  local f
  f=$(record_path "$1")
  [ -f "$f" ] || return 0
  sed -n "s/^$2=//p" "$f" | head -1
}

record_drop() { rm -f "$(record_path "$1")"; }

# mark <field=value>...: this pane's record, its target refreshed.
mark() { record_write "$(pane_key)" "target=$(pane_target)" "$@"; }

in_workbench_session() {
  case "$(tmux display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)" in
    wb-*) return 0 ;;
    *) return 1 ;;
  esac
}

# The flag belongs to the claude process: tmux-attention drops it on its own
# once the pane's foreground command is something else, which is what a
# crash, an OOM kill or a closed terminal look like when no SessionEnd fires.
flag() {
  local quiet=()
  ! in_workbench_session || quiet=(--quiet)
  tmux-attention set "$@" --pane "$TMUX_PANE" --owner claude "${quiet[@]}"
}

# --- window title ------------------------------------------------------------

TITLE_WORDS=3
TITLE_CHARS=15

# The first real prompt of a transcript, cut to a window name: slash commands
# and the harness's own <tagged> messages are skipped, tool results are not
# prompts. Nothing when the transcript has no prompt yet.
first_prompt_title() {
  [ -f "${1:-}" ] && command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$1" "$TITLE_WORDS" "$TITLE_CHARS" <<'PY'
import json, re, sys
path, words, chars = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
for line in open(path, encoding="utf-8", errors="replace"):
    try:
        d = json.loads(line)
    except Exception:
        continue
    if d.get("type") != "user":
        continue
    c = (d.get("message") or {}).get("content")
    if isinstance(c, list):
        if any(isinstance(p, dict) and p.get("type") == "tool_result" for p in c):
            continue
        c = " ".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
    if not isinstance(c, str):
        continue
    t = re.sub(r"\s+", " ", c).strip()
    if not t or t[0] in "</":
        continue
    # Openers carry no meaning in three words: "can you fix" says less
    # than "fix the waybar".
    t = re.sub(r"^(?:(?:hey|hi|hello|ok|okay|so|now|please|pls|also|and|can you|could you|would you|will you|let'?s|i want you to|i need you to|i'd like you to)[ ,:]+)+", "", t, flags=re.I)
    # A hard cut at the character limit, mid-word if need be; the trailing
    # space or punctuation it can leave behind is trimmed.
    t = " ".join(t.replace("#", "").split(" ")[:words])[:chars]
    print(t.rstrip(" .,;:!?-"))
    break
PY
}

# On Stop: name the window from the first prompt, once, while tmux still
# names it automatically. Records the name so `end` can tell it apart from
# one the user set later.
title_window() {
  ! in_workbench_session || return 0
  [ "$(tmux display -p -t "$TMUX_PANE" '#{automatic-rename}' 2>/dev/null || true)" = 1 ] || return 0
  local key transcript title
  key=$(pane_key)
  transcript=$(json_fields transcript_path)
  [ -n "$transcript" ] || transcript=$(record_get "$key" transcript)
  title=$(first_prompt_title "$transcript")
  [ -n "$title" ] || return 0
  apply_title "$title" || return 0
  [ -z "$key" ] || mark "title=$title"
}

apply_title() {
  tmux rename-window -t "$TMUX_PANE" "$1" 2>/dev/null || return 1
  tmux set -w -t "$TMUX_PANE" @claude_title "$1" 2>/dev/null || true
}

# On SessionEnd: the name goes back to tmux when it is still the one set here.
untitle_window() {
  local title
  title=$(record_get "${1:-}" title)
  [ -n "$title" ] || return 0
  [ "$(tmux display -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || true)" = "$title" ] || return 0
  release_title "$TMUX_PANE"
}

# The window named by <target> names itself again.
release_title() {
  tmux set -w -t "$1" automatic-rename on 2>/dev/null || true
  tmux set -wu -t "$1" @claude_title 2>/dev/null || true
}

# Every title on record, one per line.
recorded_titles() {
  [ -d "$STATE_DIR" ] || return 0
  sed -n 's/^title=\(.\+\)$/\1/p' "$STATE_DIR"/* 2>/dev/null | sort -u
}

# Windows that carry a claude title and run no claude name themselves again.
# A pane killed with claude inside fires no SessionEnd, so nothing else
# would; the title is known from @claude_title or from a record.
cmd_sweep() {
  command -v tmux >/dev/null 2>&1 || return 0
  local us=$'\x1f' titles win name marked cmds
  titles=$(recorded_titles)
  while IFS="$us" read -r win name marked cmds; do
    if [ "$marked" != "$name" ]; then
      [ -n "$titles" ] || continue
      grep -qxF "$name" <<< "$titles" || continue
    fi
    case "$cmds" in *" claude "*) continue ;; esac
    release_title "$win"
  done < <(tmux list-panes -a -F "#{window_id}${us}#{window_name}${us}#{@claude_title}${us}#{pane_current_command}" 2>/dev/null \
    | awk -F "$us" -v OFS="$us" '{ w = $1; if (!(w in name)) { order[++n] = w; name[w] = $2; marked[w] = $3; cmds[w] = " " } cmds[w] = cmds[w] $4 " " }
        END { for (i = 1; i <= n; i++) print order[i], name[order[i]], marked[order[i]], cmds[order[i]] }')
  # And the other way round: a claude still running under tmux's automatic
  # name gets its recorded title back. A restore onto a live server does
  # that, since the save shows the window as "claude".
  [ -d "$STATE_DIR" ] || return 0
  local f key title cmd auto
  for f in "$STATE_DIR"/*; do
    [ -f "$f" ] || continue
    key=$(basename "$f")
    title=$(sed -n 's/^title=//p' "$f" | head -1)
    [ -n "$title" ] || continue
    IFS="$us" read -r cmd auto < <(tmux display -p -t "$key" "#{pane_current_command}${us}#{automatic-rename}" 2>/dev/null) || continue
    [ "$cmd" = claude ] && [ "$auto" = 1 ] || continue
    tmux rename-window -t "$key" "$title" 2>/dev/null || continue
    tmux set -w -t "$key" @claude_title "$title" 2>/dev/null || true
  done
}

# --- signal ------------------------------------------------------------------

# A short label for what a tool wants: Bash(the command), Edit(the file).
tool_label() {
  local name="$1" command="$2" file="$3" pattern="$4"
  case "$name" in
    Bash) printf 'Bash(%.48s)' "$command" ;;
    Edit|Write|Read|NotebookEdit) printf '%s(%s)' "$name" "${file##*/}" ;;
    Grep|Glob) printf '%s(%.32s)' "$name" "$pattern" ;;
    *) printf '%s' "$name" ;;
  esac
}

cmd_signal() {
  local what="${1:-}" key prev
  [ -n "$what" ] || usage
  [ $# -eq 1 ] || usage
  [ -n "${TMUX_PANE:-}" ] || return 0
  command -v tmux-attention >/dev/null 2>&1 || return 0
  case "$what" in
    working)
      prev=$(flag working) || true
      [ -z "$prev" ] || mark "state=working" "reason="
      ;;
    start)
      local vals=() sid transcript cwd source
      mapfile -t vals < <(json_fields session_id transcript_path cwd source)
      sid=${vals[0]:-}; transcript=${vals[1]:-}; cwd=${vals[2]:-}; source=${vals[3]:-}
      # Compaction restarts the session mid-turn: nothing changed for the pane.
      [ "$source" != compact ] || return 0
      key=$(pane_key)
      [ -n "$key" ] || return 0
      local restoring state reason
      restoring=$(record_get "$key" restore)
      state=$(record_get "$key" state)
      reason=$(record_get "$key" reason)
      if [ "$restoring" = 1 ] && [ "$source" = resume ] && [ "$sid" = "$(record_get "$key" session_id)" ]; then
        case "$state" in
          needs-you) flag needs-you --reason "before restart: ${reason:-waiting on you}" >/dev/null ;;
          working) flag needs-you --reason "interrupted mid-turn" >/dev/null; state=needs-you; reason="interrupted mid-turn" ;;
          done) flag "done" --reason "$reason" >/dev/null ;;
          *) tmux-attention clear --pane "$TMUX_PANE"; state=idle ;;
        esac
      else
        tmux-attention clear --pane "$TMUX_PANE"
        state=idle; reason=''
      fi
      # The title stays across a restore: the save shows the window as
      # "claude", so the record is what puts the name back, and what lets
      # SessionEnd hand it to tmux again.
      local title=''
      [ "$restoring" != 1 ] || title=$(record_get "$key" title)
      [ -z "$title" ] || apply_title "$title" || true
      mark "session_id=$sid" "transcript=$transcript" "cwd=$cwd" "state=$state" "reason=$reason" "restore=" "title=$title"
      ;;
    end)
      local reason
      reason=$(json_fields reason)
      key=$(pane_key)
      tmux-attention clear --pane "$TMUX_PANE"
      untitle_window "$key"
      [ -z "$key" ] || case "$reason" in
        other) mark "state=$(record_get "$key" state)" ;;
        *) record_drop "$key" ;;
      esac
      ;;
    question)
      local q
      q=$(json_fields tool_input.questions.0.question)
      q="question: ${q:-Claude asks}"
      prev=$(flag needs-you --reason "$q") || true
      [ -z "$prev" ] || mark "state=needs-you" "reason=$q"
      ;;
    permission)
      local vals=() label
      mapfile -t vals < <(json_fields tool_name tool_input.command tool_input.file_path tool_input.pattern)
      label=$(tool_label "${vals[0]:-tool}" "${vals[1]:-}" "${vals[2]:-}" "${vals[3]:-}")
      prev=$(flag needs-you --reason "$label") || true
      [ -z "$prev" ] || mark "state=needs-you" "reason=$label"
      ;;
    notification)
      local msg
      msg=$(json_fields message)
      msg=${msg:-needs input}
      prev=$(flag needs-you --reason "${msg:0:64}") || true
      [ -z "$prev" ] || mark "state=needs-you" "reason=${msg:0:64}"
      ;;
    stop)
      prev=$(flag "done" --reason "turn ended") || true
      [ -z "$prev" ] || mark "state=done" "reason=turn ended"
      title_window
      ;;
    *) usage ;;
  esac
  return 0
}

# --- restore -----------------------------------------------------------------

# The panes tmux-resurrect last saw running claude, as "session:window.pane"
# keys. A record alone is not enough: `claude -p` ends its session with
# reason "other" too, the same as a kill, so a pane that ran a one-shot and
# went back to its shell would otherwise be resumed on the next boot.
RESURRECT_DIR="${TMUX_RESURRECT_DIR:-$HOME/.local/share/tmux/resurrect}"
resurrect_claude_panes() {
  [ -f "$RESURRECT_DIR/last" ] || return 0
  awk -F'\t' '$1 == "pane" && $10 == "claude" { print $2 ":" $3 "." $6 }' "$RESURRECT_DIR/last"
}

# For every record whose target resurrect saw running claude, is back as a
# plain shell in the same directory, and whose transcript still exists: type
# `claude --resume <id>` into it and mark the record so the SessionStart hook
# re-applies the flag. The new server hands out pane ids afresh, so the
# record moves to the id its target has now, where that hook will look.
# Records with no transcript, or older than a week, are dropped.
cmd_restore() {
  [ -d "$STATE_DIR" ] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  local f key target sid transcript cwd updated now cmd path id saved
  saved=$(resurrect_claude_panes)
  now=$(date +%s)
  for f in "$STATE_DIR"/*; do
    [ -f "$f" ] || continue
    key=$(basename "$f")
    target=$(sed -n 's/^target=//p' "$f" | head -1)
    sid=$(sed -n 's/^session_id=//p' "$f" | head -1)
    transcript=$(sed -n 's/^transcript=//p' "$f" | head -1)
    cwd=$(sed -n 's/^cwd=//p' "$f" | head -1)
    updated=$(sed -n 's/^updated=//p' "$f" | head -1)
    if [ -z "$sid" ] || [ -z "$target" ] || [ ! -f "$transcript" ] || [ $((now - ${updated:-0})) -gt 604800 ]; then
      rm -f "$f"
      continue
    fi
    case "$target" in wb-*) continue ;; esac
    grep -qxF "$target" <<< "$saved" || continue
    IFS=$'\t' read -r id cmd path < <(tmux display -p -t "$target" $'#{pane_id}\t#{pane_current_command}\t#{pane_current_path}' 2>/dev/null || true)
    case "$cmd" in zsh|bash|fish|sh) ;; *) continue ;; esac
    [ "$path" = "$cwd" ] || continue
    [ "$id" = "$key" ] || mv -f "$f" "$(record_path "$id")"
    record_write "$id" "restore=1"
    tmux send-keys -t "$target" "claude --resume $sid" Enter
    echo "claude-tmux: resuming $sid in $target" >&2
  done
}

# Every record's target as of now, for the panes still on this server. A pane
# that has not transitioned since a window to its left closed still carries
# the old indexes; tmux-resurrect runs this right after each save, so the
# targets match the layout `restore` will read back.
cmd_sync() {
  cmd_sweep
  if [ -d "$STATE_DIR" ]; then
    local id target f
    while IFS=$'\t' read -r id target; do
      f=$(record_path "$id")
      [ -f "$f" ] || continue
      [ "$(sed -n 's/^target=//p' "$f" | head -1)" = "$target" ] || record_write "$id" "target=$target"
    done < <(tmux list-panes -a -F $'#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)
  fi
  untitle_save
}

# The save tmux-resurrect just wrote, with every claude-titled window shown
# as "claude" under automatic-rename, so no restore ever re-applies a title:
# the record does that, on the pane that actually resumes the session.
untitle_save() {
  local save titles tmp
  save=$(readlink -f "$RESURRECT_DIR/last" 2>/dev/null || true)
  [ -n "$save" ] && [ -f "$save" ] || return 0
  titles=$( { recorded_titles; tmux list-windows -a -F '#{@claude_title}' 2>/dev/null; } | sed '/^$/d' | sort -u)
  [ -n "$titles" ] || return 0
  tmp=$(mktemp "$save.XXXXXX")
  awk -F'\t' -v OFS='\t' -v titles="$titles" '
    BEGIN { n = split(titles, t, "\n"); for (i = 1; i <= n; i++) claude[t[i]] = 1 }
    $1 == "window" && substr($4, 2) in claude { $4 = ":claude"; $8 = ":" }
    { print }
  ' "$save" > "$tmp" || { rm -f "$tmp"; return 0; }
  mv -f "$tmp" "$save"
}

cmd_records() {
  [ -d "$STATE_DIR" ] || return 0
  local f
  for f in "$STATE_DIR"/*; do
    [ -f "$f" ] || continue
    echo "$(basename "$f"): $(tr '\n' ' ' < "$f")"
  done
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  signal) cmd_signal "$@" ;;
  restore) cmd_restore ;;
  sync) cmd_sync ;;
  sweep) cmd_sweep ;;
  records) cmd_records ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
