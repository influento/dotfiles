#!/usr/bin/env bash
set -euo pipefail

# workbench — item lifecycle for tracked project work.
#
# IDs come from a counter in the shared git directory, so every worktree draws
# from one sequence and numbers can never collide or repeat.

WB=workbench
MARK_START='<!-- workbench:start -->'
MARK_END='<!-- workbench:end -->'

usage() {
  cat <<'EOF'
usage:
  workbench init                       scaffold workbench/ and link the skill
  workbench adopt                      init, then survey an existing project
  workbench new <bug|feature|rename> "<title>" [--milestone <slug>]
                                       allocate an id, write the file
  workbench find [<path>...] [--grep <word>...] [--all]
                                       items that touched these paths, newest first
  workbench milestone "<title>"        open a big-picture goal under workbench/milestones/
  workbench milestone archive <slug>   close it, once its items are archived and evidence is in
  workbench start <id>                 create the branch and worktree for an item
  workbench merge <id> "<subject>"     squash onto the default branch, drop the worktree and branch
  workbench archive <id>               move to archive, recording the merge commit
  workbench status                     in flight, duplicate ids, reports
  workbench watch "<title>"            write the contract a watch shift runs under
  workbench review-check <report>      prove a sweep changed nothing tracked
  workbench review-drop <report> [--force]  delete a report, its baseline and scratch
  workbench review <reason> [scope]    open a report; run by the sweep skill, not by hand

  reasons: sweep, pre-merge, docs, memory, adopt, watch
  state lives under workbench/
EOF
  exit 2
}

die() {
  echo "workbench: $1" >&2
  exit 1
}

git_common_dir() {
  local d
  d=$(git rev-parse --git-common-dir) || die "not inside a git repository"
  # --git-common-dir may be relative to the current directory
  (cd "$d" && pwd)
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# The main worktree, where the committed state lives. A linked worktree's
# common dir is always <main>/.git, so its parent is the main checkout.
main_root() {
  dirname "$(git_common_dir)"
}

# Both checkouts that may hold items: the current one, because an item file
# lives on its branch, and the main one, which holds everything merged.
wb_roots() {
  local cur main
  cur=$(repo_root)
  main=$(main_root)
  printf '%s\n' "$cur"
  [ "$main" != "$cur" ] && printf '%s\n' "$main"
  return 0
}

# The skill source sits beside this script in the dotfiles tree. Resolving it
# from $0 keeps the path out of the script, so a moved checkout still works.
skill_source() {
  local self
  # $0 is a bare name when found on PATH, so resolve it before following links
  self=$(command -v -- "$0") || die "cannot locate the workbench script"
  self=$(readlink -f "$self")
  printf '%s\n' "${WORKBENCH_SKILL_SRC:-$(dirname "$self")/../claude-code/skills-optional/workbench}"
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\+/-/g' \
    | cut -c1-50 \
    | sed -e 's/^-//' -e 's/-$//'
}

# A worktree branched before adoption has no $WB/ in its own checkout, yet may
# still create items. Adoption is a property of the repository, so any checkout
# carrying $WB/ satisfies it.
require_init() {
  local root
  while IFS= read -r root; do
    [ -d "$root/$WB" ] && return 0
  done < <(wb_roots)
  die "no $WB/ in this repository; run 'workbench init' first"
}

# Highest number already present, so a missing counter can be rebuilt from the
# repository itself rather than restarting at 1 and colliding with history.
# Over every checkout: an item that only exists in a sibling worktree has a
# number too.
highest_existing() {
  local max=0 n roots=()
  mapfile -t roots < <(all_roots)
  while IFS= read -r f; do
    n=$(basename "$f" | sed -n 's/^[bfr]-\([0-9]\{1,\}\)-.*/\1/p')
    [ -n "$n" ] || continue
    n=$((10#$n))
    [ "$n" -gt "$max" ] && max=$n
  done < <(find "${roots[@]/%//$WB\/items}" -name '[bfr]-*.md' 2>/dev/null)
  echo "$max"
}

next_id() {
  local seq_file lock_dir current
  seq_file="$(git_common_dir)/item-seq"
  lock_dir="$(git_common_dir)/item-seq.lock"

  # mkdir is atomic on POSIX filesystems, so this works without flock
  local waited=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 100 ] && die "could not acquire $lock_dir"
    sleep 0.05
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

  # The counter is a cache; the repository is the source of truth. A counter
  # left behind on this machine goes stale the moment items allocated on
  # another one are pulled in, so never allocate below what the tree holds.
  local seen
  seen=$(highest_existing)
  current=0
  [ -f "$seq_file" ] && current=$(cat "$seq_file")
  [ "$seen" -gt "$current" ] && current=$seen
  current=$((current + 1))
  printf '%s\n' "$current" > "$seq_file"

  rmdir "$lock_dir"
  trap - EXIT
  printf '%03d\n' "$current"
}

# --- init -------------------------------------------------------------------

write_glossary() {
  cat > "$1" <<'EOF'
# Glossary

<!-- Domain language only: words this project uses in a narrower or different
     sense than they are used generally. Never well-known concepts.

     One entry per concept, never the same concept twice. Brief — a definition,
     not an explanation. Nothing that would have to change when the
     implementation changes; that is a spec, and it belongs elsewhere.

     A term is renamed by `workbench new rename`, and the entry changes in the
     same commit as the code. Aliases are written as (was: old-term), and only
     once the old word survives in an archived item or a merged commit. -->
EOF
}

write_backlog() {
  cat > "$1" <<'EOF'
# Backlog

<!-- One line per idea. No id, no file, no thinking spent yet. Promoting a line
     to an item is where the thinking happens; delete the line when it goes. -->
EOF
}

ensure_gitignore() {
  local root gi
  root=$(repo_root)
  gi="$root/.gitignore"
  local entry
  for entry in '.claude/skills/workbench' '.claude/skills/workbench-review' '.worktrees/'; do
    grep -qxF "$entry" "$gi" 2>/dev/null && continue
    printf '%s\n' "$entry" >> "$gi"
    echo "  .gitignore += $entry"
  done
}

# Two skills: the workflow itself, and the sweep, which is a separate skill so
# it can be user-only and forked. Both are symlinks into the dotfiles tree.
link_skill() {
  local root base src dst name
  root=$(repo_root)
  base=$(readlink -f "$(skill_source)") || true
  [ -n "$base" ] && [ -d "$base" ] || die "skill source not found at $(skill_source)"

  mkdir -p "$root/.claude/skills"

  for name in workbench workbench-review; do
    src="$(dirname "$base")/$name"
    [ -d "$src" ] || die "skill source not found at $src"
    dst="$root/.claude/skills/$name"

    if [ -L "$dst" ]; then
      [ "$(readlink -f "$dst")" = "$src" ] && continue
      die "$dst points somewhere else; remove it and re-run"
    fi
    [ -e "$dst" ] && die "$dst exists and is not a symlink"

    ln -s "$src" "$dst"
    echo "  linked .claude/skills/$name -> $src"
  done
}

claude_md_block() {
  cat <<EOF
$MARK_START
## Workflow

Domain work in this repo is tracked with **workbench**. Before writing code for
any feature or bug fix, create an item (\`workbench new\`) and agree its
verification criterion. Housekeeping — configs, tooling, agent settings — is
exempt and goes straight to the main branch.

Rules: invoke the \`workbench\` skill. State: \`$WB/\`.
$MARK_END
EOF
}

# Written through readlink -f so a CLAUDE.md that is a symlink to AGENTS.md is
# edited in place rather than replaced by a regular file.
ensure_claude_md() {
  local root target tmp
  root=$(repo_root)
  target=$(readlink -f "$root/CLAUDE.md" 2>/dev/null || printf '%s' "$root/CLAUDE.md")

  if [ ! -f "$target" ]; then
    { echo "# $(basename "$root")"; echo; claude_md_block; } > "$target"
    echo "  created $(basename "$target") with the workbench block"
    return 0
  fi

  if grep -qF "$MARK_START" "$target"; then
    tmp=$(mktemp)
    claude_md_block > "$tmp.block"
    awk -v start="$MARK_START" -v end="$MARK_END" -v blockfile="$tmp.block" '
      $0 == start { while ((getline line < blockfile) > 0) print line; skip = 1; next }
      $0 == end   { skip = 0; next }
      !skip       { print }
    ' "$target" > "$tmp"
    mv "$tmp" "$target"
    rm -f "$tmp.block"
    echo "  refreshed the workbench block in $(basename "$target")"
  else
    { echo; claude_md_block; } >> "$target"
    echo "  appended the workbench block to $(basename "$target")"
  fi
}

cmd_init() {
  local root d
  root=$(repo_root)

  for d in items/bugs items/features items/renames items/archive reviews; do
    mkdir -p "$root/$WB/$d"
    [ -e "$root/$WB/$d/.gitkeep" ] || touch "$root/$WB/$d/.gitkeep"
  done

  [ -f "$root/$WB/GLOSSARY.md" ] || { write_glossary "$root/$WB/GLOSSARY.md"; echo "  wrote $WB/GLOSSARY.md"; }
  [ -f "$root/$WB/BACKLOG.md" ] || { write_backlog "$root/$WB/BACKLOG.md"; echo "  wrote $WB/BACKLOG.md"; }

  link_skill
  ensure_gitignore
  ensure_claude_md

  echo "workbench ready in $root"
  setup_checklist
}

# What has to be decided with the user rather than scaffolded. Printed so the
# agent running init has the list in front of it and takes each point to the
# user; the skill says how.
setup_checklist() {
  local root main
  root=$(repo_root)
  echo
  echo "setup — decide these with the user:"

  if main=$(git config --get workbench.main 2>/dev/null) && [ -n "$main" ]; then
    echo "  default branch    $main (git config workbench.main)"
  elif main=$(default_branch 2>/dev/null); then
    echo "  default branch    $main — squash merges land here; 'git config workbench.main <branch>' if that is wrong"
  else
    echo "  default branch    UNRESOLVED — set 'git config workbench.main <branch>' before the first merge"
  fi

  if [ -f "$root/.claude/settings.json" ]; then
    echo "  permissions       .claude/settings.json exists; sweeps and watch shifts run the commands they need through Bash and prompt for each unless allowed there"
  else
    echo "  permissions       no .claude/settings.json; sweeps and watch shifts prompt for every Bash command they run — allow-list them there, or run in auto mode"
  fi

  echo "  glossary          $WB/GLOSSARY.md is empty; seed it with words this project uses in its own sense"
  echo "  milestones        optional, big-picture only — 'workbench milestone \"<title>\"' when there is one, now or later; items need not name one"
  echo "  watch             optional — only if the app runs as a service the user wants watched unattended, now or whenever it does: 'workbench watch \"<title>\"' writes the contract"
}

cmd_adopt() {
  cmd_init
  cat <<EOF

Now run the survey from a Claude Code session in this project:

  /workbench-review adopt

It sweeps what work tracking already exists here into a report; triage then
decides what becomes a backlog line, what becomes an open item, and what to
leave alone. Nothing converts without your approval, and shipped work never
gets a backfilled item.
EOF
}

# --- items ------------------------------------------------------------------

write_bug() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## What was seen

<!-- The observed behaviour. Delete this comment. -->

## How to reproduce

<!-- Steps, or a note that it was found by reading code — that is fine and
     needs no apology. Best-effort: a bug with no reproduction still ships.
     Delete this comment. -->

## Root cause

<!-- Before writing this, once: 'workbench find <paths>' for the files involved.
     Read an item from the index only if its line matches this bug.
     The mechanism, on the side you control. "It behaves like X and that is the
     third party's decision" is a complete root cause. A suspected race is a
     mechanism: state it, mark the confidence unproven. A fact discovered here
     about a system you do not control is recorded here, not in a document of
     its own. Delete this comment. -->

## The fix

<!-- What changed. Delete this comment. -->

## How to confirm it is fixed

<!-- REQUIRED, never omitted. Written before the code and specific enough to
     stand alone: name the command and the expected result. This is the
     contract. Delete this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it.
     Delete this comment. -->
EOF
}

write_feature() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## Why

<!-- The problem being solved. Delete this comment. -->

## What changes

<!-- Observable behaviour of the project, not implementation. Delete this
     comment. -->

## What it touches

<!-- Areas, not a file list. Before writing this, once: 'workbench find <paths>'
     for the files involved; read an item from the index only if its line
     matches. Delete this comment. -->

## How to confirm it works

<!-- The criterion. Written before the code and specific enough to stand alone:
     name the command and the expected result. This is the contract. Delete
     this comment. -->

## Evidence

<!-- Filled in after implementation: the actual output, not a summary of it.
     Delete this comment. -->
EOF
}

write_rename() {
  cat > "$1" <<EOF
# $2 — $3

status: open

## The term

<!-- old -> new, and the glossary entry that changes with this commit. Delete
     this comment. -->

## Scope

<!-- The paths holding the domain sense. If the word also has a non-domain
     sense in this codebase, say which paths carry it and stay out of them.
     Delete this comment. -->

## How to confirm it is done

<!-- Written before the change. An occurrence count over the scope, plus the
     count that legitimately survives outside it. Delete this comment. -->

## Evidence

<!-- Filled in after: the actual counts and paths. Delete this comment. -->
EOF
}

cmd_new() {
  local class="${1:-}" title="${2:-}" letter dir slug num id path root milestone=
  [ -n "$class" ] && [ -n "$title" ] || usage
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --milestone) milestone="${2:-}"; [ -n "$milestone" ] || usage; shift 2 ;;
      *) usage ;;
    esac
  done
  require_init
  if [ -n "$milestone" ]; then
    [ -n "$(find_milestone "$milestone")" ] || die "no milestone named '$milestone'"
  fi

  case "$class" in
    bug) letter=b; dir=bugs ;;
    feature) letter=f; dir=features ;;
    rename) letter=r; dir=renames ;;
    *) die "class must be 'bug', 'feature' or 'rename', got '$class'" ;;
  esac

  root=$(repo_root)
  slug=$(slugify "$title")
  [ -n "$slug" ] || die "title produced an empty slug"

  num=$(next_id)
  id="$letter-$num"
  path="$root/$WB/items/$dir/$id-$slug.md"

  mkdir -p "$root/$WB/items/$dir"
  [ -e "$path" ] && die "$path already exists"

  case "$class" in
    bug) write_bug "$path" "$id" "$title" ;;
    feature) write_feature "$path" "$id" "$title" ;;
    rename) write_rename "$path" "$id" "$title" ;;
  esac
  [ -z "$milestone" ] || sed -i "s/^status: open\$/&\nmilestone: $milestone/" "$path"

  echo "$id"
  echo "$path" >&2
  echo "leave it uncommitted; 'workbench start $id' moves it onto its branch" >&2
}

find_item() {
  local roots=()
  mapfile -t roots < <(wb_roots)
  find "${roots[@]/%//$WB\/items}" -name "$1-*.md" -print -quit 2>/dev/null
}

# The same item, over every checkout, for callers that only read it: a
# pre-merge names an item whose worktree need not be the one the sweep runs
# from. Linked worktrees first, so the copy on the item's branch wins over an
# older one in the main checkout.
find_item_anywhere() {
  local roots=() main
  main=$(main_root)
  mapfile -t roots < <(all_roots | grep -vxF "$main"; printf '%s\n' "$main")
  find "${roots[@]/%//$WB\/items}" -name "$1-*.md" -print -quit 2>/dev/null
}

# The checkout an item file belongs to. find_item may return a path from the
# main checkout while the caller stands in a linked worktree, so every path
# derived from an item must be rooted here and not at repo_root.
item_root() {
  printf '%s\n' "${1%/"$WB"/items/*}"
}

cmd_start() {
  local id="${1:-}" path branch root wt
  [ -n "$id" ] || usage
  require_init

  path=$(find_item "$id")
  [ -n "$path" ] || die "no item matching '$id'"

  branch=$(basename "$path" .md)
  root=$(item_root "$path")
  # Always under the main checkout and off the default branch. Run from inside
  # another item's worktree, the new one would otherwise nest under it — and
  # vanish with it at that item's merge — and start from that item's commits.
  wt="$(main_root)/.worktrees/$branch"

  [ -e "$wt" ] && die "worktree already exists: $wt"

  git worktree add --quiet -b "$branch" "$wt" "$(default_branch)"

  # The item file lives on its branch, so a new one is not on the default
  # branch and the fresh worktree lacks it; carry it over. Untracked, it moves.
  # Already committed on another item's branch, it is copied and that branch
  # is named: its squash would otherwise land this file on the default branch
  # under the wrong trailer, and this item's own merge would then collide.
  local rel="${path#"$root"/}"
  if [ ! -e "$wt/$rel" ]; then
    mkdir -p "$(dirname "$wt/$rel")"
    if git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
      cp "$path" "$wt/$rel"
      echo "copied $rel onto the branch; it is also committed on $(git -C "$root" rev-parse --abbrev-ref HEAD) — remove it there before that branch merges" >&2
    else
      mv "$path" "$wt/$rel"
      echo "moved $rel onto the branch" >&2
    fi
  fi

  echo "$wt"
}

# The checkout holding a branch, from git's own list rather than the
# .worktrees/<branch> convention: 'workbench start' run from a linked worktree
# nests its .worktrees/ there, and a worktree moved by hand is still a worktree.
worktree_of() {
  git worktree list --porcelain \
    | awk -v want="refs/heads/$1" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { if ($2 == want) { print wt; exit } }
      '
}

# The squash commit is the whole point of the merge: the change lands on the
# default branch as one commit whose only body is the trailer. Everything the
# command checks exists to keep that commit honest — one branch, one item, one
# subject, no unrelated changes, nothing lost — and everything it cannot check
# (whether what could be verified was) is the pre-merge review's job. So no
# evidence gate here: an item merges open as 'awaiting'.
#
# Every git call is pinned to the main checkout. The command may be run from
# the item's own worktree, which stops existing halfway through, and a bare
# 'git' there fails on a working directory that has gone.
cmd_merge() {
  local id="${1:-}" subject="${2:-}" branch main root wt
  [ -n "$id" ] && [ -n "$subject" ] || usage
  require_init

  case "$subject" in
    *$'\n'*) die "the subject must be a single line" ;;
    *"Item:"*) die "the subject must not carry the trailer; it is added here" ;;
  esac

  root=$(main_root)
  main=$(default_branch)

  # The branch is what merges, and it carries the ID, so resolve it directly:
  # the item file lives on the branch and is invisible to find_item from the
  # main checkout. The archive is still consulted — an archived item's branch
  # is a leftover, not work to merge.
  case "$(find_item "$id")" in
    */items/archive/*) die "$id is already archived" ;;
  esac
  local prior
  prior=$(git -C "$root" log "$main" --grep="^Item: $id\$" --format=%h -1)
  [ -z "$prior" ] || die "$main already carries 'Item: $id' at $prior"
  branch=$(git -C "$root" for-each-ref --format='%(refname:short)' "refs/heads/$id-*")
  [ -n "$branch" ] || die "no branch named $id-*; nothing to merge"
  case "$branch" in
    *$'\n'*) die "several branches match $id-*:"$'\n'"$branch" ;;
  esac

  # The squash needs the default branch checked out, and that checkout is the
  # main one: a linked worktree cannot hold a branch another checkout holds.
  local on
  on=$(git -C "$root" symbolic-ref -q --short HEAD || true)
  [ "$on" = "$main" ] || die "$root has '${on:-a detached HEAD}' checked out, not $main; the squash lands there"

  # A dirty main checkout would bleed into the squash commit — staged or not,
  # since the commit takes the index and the index is about to be rewritten.
  [ -z "$(git -C "$root" status --porcelain --untracked-files=no)" ] \
    || die "$root has uncommitted changes; the squash commit would absorb them"

  wt=$(worktree_of "$branch")
  if [ -n "$wt" ]; then
    [ -z "$(git -C "$wt" status --porcelain)" ] \
      || die "$wt has uncommitted changes; commit or discard them first"
  fi

  git -C "$root" merge-base --is-ancestor "$branch" "$main" \
    && die "$branch has nothing $main does not already have"

  # Refuse a conflicting branch before touching anything. A squash that stops
  # on conflicts leaves the main index half-merged, and the repair is the
  # user's rebase in the worktree anyway, so ask for it up front.
  if ! git -C "$root" merge-tree --write-tree "$main" "$branch" >/dev/null 2>&1; then
    die "$branch conflicts with $main; rebase it onto $main in its worktree, then retry"
  fi

  git -C "$root" merge --squash --quiet "$branch" >/dev/null
  git -C "$root" commit --quiet -m "$subject" -m "Item: $id"

  # git's own safety in 'branch -d' cannot apply after a squash — the branch is
  # never an ancestor of the commit — so the check it would have made is made
  # here instead: the commit just written is the one the trailer finds.
  local sha
  sha=$(git -C "$root" log "$main" --grep="^Item: $id\$" --format=%h -1)
  [ -n "$sha" ] && [ "$sha" = "$(git -C "$root" rev-parse --short HEAD)" ] \
    || die "the squash commit did not land on $main as expected; nothing removed"

  [ -n "$wt" ] && git -C "$root" worktree remove "$wt"
  git -C "$root" branch -D --quiet "$branch"

  echo "merged $id as $sha on $main"
  # The item file rode along in the squash, so read its status from the copy
  # now on the default branch.
  local item
  item=$(find "$root/$WB/items" -name "$id-*.md" -not -path '*/archive/*' -print -quit 2>/dev/null)
  case "$(item_status "${item:-/dev/null}")" in
    awaiting*) echo "$id stays open until its trigger fires" >&2 ;;
    *) echo "next: workbench archive $id" >&2 ;;
  esac
  if [ -n "$wt" ]; then
    case "$PWD" in
      "$wt"|"$wt"/*) echo "this shell's directory is gone; cd $root" >&2 ;;
    esac
  fi
}

item_status() {
  sed -n 's/^status: *//p' "$1" | head -1
}

# The branch squash commits land on. Repositories here are local-first, so the
# main/master leg is the common path and origin/HEAD the exception; an explicit
# 'git config workbench.main' answers an odd layout once.
default_branch() {
  local b
  b=$(git config --get workbench.main 2>/dev/null || true)
  [ -n "$b" ] || b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
  if [ -z "$b" ]; then
    for b in main master; do
      git rev-parse --verify -q "refs/heads/$b" >/dev/null && break
      b=
    done
  fi
  [ -n "$b" ] || die "cannot resolve the default branch; set 'git config workbench.main <branch>'"
  printf '%s\n' "$b"
}

# Evidence is present when the Evidence section holds something other than
# blank lines and the template comment.
has_evidence() {
  sed -n '/^## Evidence/,$p' "$1" \
    | tail -n +2 \
    | sed -e 's/<!--.*-->//' -e '/<!--/,/-->/d' \
    | grep -q '[^[:space:]]'
}

cmd_archive() {
  local id="${1:-}" path root sha
  [ -n "$id" ] || usage
  require_init

  path=$(find_item "$id")
  [ -n "$path" ] || die "no item matching '$id'"

  case "$path" in
    */items/archive/*) die "$id is already archived" ;;
  esac

  local status
  status=$(item_status "$path")

  case "$status" in
    awaiting*)
      die "$id is awaiting a trigger and does not archive as-is. When the trigger
fires, set 'status: open', record the evidence, then archive; or re-state it as
'unverified — <trigger>' if no bound can be named." ;;
    unverified*)
      # The trigger is the whole value of an unverified archive: it is what a
      # later search matches on.
      case "$status" in
        *—*|*" - "*) ;;
        *) die "$id: 'unverified' must name its trigger, e.g. status: unverified — resolves when the server next pushes an announcement" ;;
      esac ;;
    unreproduced*) ;;
    *)
      if ! has_evidence "$path"; then
        die "$id has no evidence recorded; archive requires it (or status: unreproduced / unverified — <trigger>)"
      fi ;;
  esac

  # The commit that carries this item's trailer, searched on the default branch
  # only. The squash commit is the one that legitimately carries the trailer
  # and it lives there; HEAD would miss it from a worktree branched before the
  # merge, and --all (or HEAD from the item's own worktree) could hit a branch
  # commit that the squash then discards — a dangling SHA in the archive.
  local main
  main=$(default_branch)
  sha=$(git log "$main" --grep="^Item: $id\$" --format=%h -1 2>/dev/null || true)
  # Never fall back to HEAD: HEAD is whatever the checkout happens to sit on,
  # and recording it would write a commit into the archive that did not
  # implement the item. An item with no trailer yet — an unreproduced bug, or
  # one archived before its merge — says so.
  if [ -z "$sha" ]; then
    sha=none
    echo "warning: no commit on $main carries 'Item: $id'; merge first, or archive with commit: none" >&2
  fi

  root=$(item_root "$path")
  local dest
  dest="$root/$WB/items/archive/$(basename "$path")"
  mkdir -p "$(dirname "$dest")"

  printf '\ncommit: %s\n' "$sha" >> "$path"
  # An item created but never committed is untracked, so git mv cannot move it.
  # Every other failure is real and must not be swallowed.
  if git -C "$root" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
    git -C "$root" mv "$path" "$dest"
  else
    mv "$path" "$dest"
  fi

  echo "archived $id at $sha"
}

# --- find -------------------------------------------------------------------

FIND_CAP=10

item_title() {
  sed -n '1s/^# [bfr]-[0-9]* — //p' "$1"
}

# Every item file, open or archived, over both checkouts.
all_items() {
  local roots=()
  mapfile -t roots < <(wb_roots)
  find "${roots[@]/%//$WB\/items}" -name '[bfr]-*.md' 2>/dev/null
}

# One index line per item: date, status, title. The date is the commit that
# carries the trailer for an archived item, or the last commit that touched an
# open one; an item never committed has none.
index_line() {
  local f="$1" id date status
  id=$(basename "$f" | sed -n 's/^\([bfr]-[0-9]\{1,\}\)-.*/\1/p')
  status=$(item_status "$f")
  case "$f" in
    */archive/*)
      # Archiving leaves the status line alone, so a plain 'open' here means
      # verified and shipped; the unproved statuses say so themselves.
      [ "$status" = open ] && status=archived
      local sha
      sha=$(sed -n 's/^commit: *//p' "$f" | tail -1)
      date=$(git log -1 --format=%cs "$sha" -- 2>/dev/null || true) ;;
  esac
  [ -n "${date:-}" ] || date=$(git -C "$(item_root "$f")" log -1 --format=%cs -- "$f" 2>/dev/null || true)
  printf '%s\t%s\t%s\t%s\n' "${date:--}" "$id" "$status" "$(item_title "$f")"
}

# Retrieval keyed to files, not topics: git already indexes which items touched
# a path, through the trailer, so the answer is exact and costs nothing to
# maintain. Words are opt-in and narrow that set, or search the items alone
# when no path is given. The output is an index, never bodies — one line per
# item, capped, with unreproduced and unverified items first regardless of age
# because an unproved claim on the file about to change is the hit that bites.
cmd_find() {
  local paths=() words=() all=0 arg
  require_init
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --grep) while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do words+=("$1"); shift; done ;;
      --all) all=1 ;;
      --) ;;
      -*) usage ;;
      *) paths+=("$arg") ;;
    esac
  done
  [ "${#paths[@]}" -gt 0 ] || [ "${#words[@]}" -gt 0 ] || usage

  local files=() f ids=() id
  if [ "${#paths[@]}" -gt 0 ]; then
    local main root
    main=$(default_branch)
    root=$(main_root)
    mapfile -t ids < <(git -C "$root" log "$main" --format='%(trailers:key=Item,valueonly)' -- "${paths[@]}" \
      | grep -E '^[bfr]-[0-9]+$' | awk '!seen[$0]++')
    for id in ${ids+"${ids[@]}"}; do
      f=$(all_items | grep -m1 "/$id-[^/]*\.md$" || true)
      [ -n "$f" ] && files+=("$f")
    done
    # An unproved item has no commit on the path, so the trailer cannot find
    # it; it names the path in its own text, and that is the link used here.
    local p
    while IFS= read -r f; do
      case "$(item_status "$f")" in unreproduced*|unverified*) ;; *) continue ;; esac
      for p in "${paths[@]}"; do
        if grep -qF -- "$p" "$f"; then files+=("$f"); break; fi
      done
    done < <(all_items | grep '/archive/')
  else
    mapfile -t files < <(all_items)
  fi

  local w kept=() seen=()
  for f in ${files+"${files[@]}"}; do
    for w in ${seen+"${seen[@]}"}; do [ "$w" = "$f" ] && continue 2; done
    seen+=("$f")
    for w in ${words+"${words[@]}"}; do
      grep -qi -- "$w" "$f" || continue 2
    done
    kept+=("$f")
  done

  if [ "${#kept[@]}" -eq 0 ]; then
    echo "no items"
    return 0
  fi

  # Flagged first, then newest. The flag column is stripped before printing.
  local lines
  lines=$(for f in "${kept[@]}"; do
    case "$(item_status "$f")" in
      unreproduced*|unverified*) printf '0\t' ;;
      *) printf '1\t' ;;
    esac
    printf '%s\t' "$(basename "$f" | sed -n 's/^[bfr]-\([0-9]\{1,\}\)-.*/\1/p')"
    index_line "$f"
  done | sort -s -t "$(printf '\t')" -k1,1 -k3,3r -k2,2nr)

  local total shown
  total=$(printf '%s\n' "$lines" | wc -l)
  shown=$total
  [ "$all" -eq 1 ] || [ "$total" -le "$FIND_CAP" ] || shown=$FIND_CAP

  printf '%s\n' "$lines" | head -n "$shown" \
    | awk -F '\t' '{ printf "%-6s  %-10s  %-28s  %s\n", $4, $3, $5, $6 }'
  if [ "$shown" -lt "$total" ]; then
    echo "… $((total - shown)) more; narrow with a path or --grep, or pass --all"
  fi
}

# --- milestones -------------------------------------------------------------

# A milestone is a big-picture goal with a done-criterion, and nothing more:
# no item list to maintain, since the items name it themselves with an
# optional 'milestone:' line, and no obligation for any item to name one.
find_milestone() {
  local roots=()
  mapfile -t roots < <(wb_roots)
  find "${roots[@]/%//$WB\/milestones}" -maxdepth 1 -name "$1.md" -print -quit 2>/dev/null
}

write_milestone() {
  cat > "$1" <<EOF
# $2

status: open

## Goal

<!-- The big picture: what is true of the project once this is done. Delete
     this comment. -->

## Done when

<!-- Observable, like an item criterion, at the level of the project. Delete
     this comment. -->

## Evidence

<!-- Filled in when it is done: the actual output. Delete this comment. -->
EOF
}

# Items naming a milestone, split open / archived, over both checkouts.
milestone_items() {
  local slug="$1" f
  while IFS= read -r f; do
    grep -qx "milestone: $slug" "$f" || continue
    case "$f" in
      */archive/*) printf 'archived\t%s\n' "$(basename "$f" .md)" ;;
      *) printf 'open\t%s\n' "$(basename "$f" .md)" ;;
    esac
  done < <(all_items)
}

cmd_milestone() {
  local sub="${1:-}" root slug path
  [ -n "$sub" ] || usage
  require_init
  root=$(repo_root)

  case "$sub" in
    archive)
      slug="${2:-}"
      [ -n "$slug" ] || usage
      path=$(find_milestone "$slug")
      [ -n "$path" ] || die "no milestone named '$slug'"
      local open
      open=$(milestone_items "$slug" | awk -F '\t' '$1 == "open" { print "  " $2 }')
      [ -z "$open" ] || die "$slug still has open items:
$open"
      has_evidence "$path" || die "$slug has no evidence recorded"
      local mroot dest
      mroot="${path%/"$WB"/milestones/*}"
      dest="$mroot/$WB/milestones/archive/$(basename "$path")"
      mkdir -p "$(dirname "$dest")"
      if git -C "$mroot" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
        git -C "$mroot" mv "$path" "$dest"
      else
        mv "$path" "$dest"
      fi
      echo "archived milestone $slug" ;;
    *)
      # anything else is a title
      slug=$(slugify "$sub")
      [ -n "$slug" ] || die "title produced an empty slug"
      path="$root/$WB/milestones/$slug.md"
      [ -e "$path" ] && die "$path already exists"
      [ -n "$(find_milestone "$slug")" ] && die "milestone '$slug' already exists in another checkout"
      mkdir -p "$root/$WB/milestones"
      write_milestone "$path" "$sub"
      echo "$slug"
      echo "$path" >&2 ;;
  esac
}

# --- watch ------------------------------------------------------------------

find_watch() {
  local roots=()
  mapfile -t roots < <(wb_roots)
  find "${roots[@]/%//$WB\/watches}" -maxdepth 1 -name "$1.md" -print -quit 2>/dev/null
}

# The contract a watch shift runs under. It is the whole authority for what
# the fork may do to the running system: observe with anything, recover with
# exactly what is listed, escalate as stated.
write_watch() {
  cat > "$1" <<EOF
# $2

## Healthy when

<!-- Each check as a command and what its output looks like when healthy.
     Every check runs every tick. Delete this comment. -->

## Recovery, in order

<!-- The only actions permitted to change the running system's state in
     order to bring it back. Step 1 first; the next step only if the re-check
     still fails. Nothing outside this list is recovery. Delete this comment. -->

## Escalate

<!-- When to stop recovering — e.g. the same failure 3 times in one shift —
     and how to notify. Delete this comment. -->
EOF
}

cmd_watch() {
  local title="${1:-}" slug root path
  [ -n "$title" ] || usage
  require_init
  slug=$(slugify "$title")
  [ -n "$slug" ] || die "title produced an empty slug"
  root=$(repo_root)
  path="$root/$WB/watches/$slug.md"
  [ -e "$path" ] && die "$path already exists"
  mkdir -p "$root/$WB/watches"
  write_watch "$path" "$title"
  echo "$slug"
  cat >&2 <<EOF
$path

next, with the user:
  1. fill the three sections — every check, the only recovery actions, when to escalate
  2. every command in it runs from a fork through Bash: allow-list each in
     .claude/settings.json (or the shift runs in auto mode), or the first
     restart blocks on a prompt nobody is there to answer
  3. run the shift from the main checkout:  /loop 15m /workbench-review watch $slug
EOF
}

# --- reviews ----------------------------------------------------------------

# In-flight work is branches plus items merged as 'awaiting', which have no
# branch left. Both halves are needed; neither alone is the answer.
# An item file lives on its branch, so the copy in a worktree and the copy in
# the main checkout are the same item at two points in its life and their
# status lines can legitimately disagree. Print one line per copy that
# disagrees, labelled, rather than picking one and hiding the other.
status_lines() {
  local name="$1" d f st where seen=() pairs=() prev
  shift
  for d in "$@"; do
    f=$(find "$d" -name "$name" -print -quit 2>/dev/null)
    [ -n "$f" ] || continue
    st=$(item_status "$f")
    where=$(basename "$(item_root "$f")")
    for prev in ${seen+"${seen[@]}"}; do
      [ "$prev" = "$st" ] && continue 2
    done
    seen+=("$st")
    pairs+=("$st|$where")
  done
  # Label only when the copies disagree, and then label every one of them —
  # an unlabelled first line next to a labelled second reads as authoritative.
  local pair
  for pair in ${pairs+"${pairs[@]}"}; do
    if [ "${#pairs[@]}" -gt 1 ]; then
      printf '  %-34s %s   [in %s]\n' "${name%.md}" "${pair%%|*}" "${pair##*|}"
    else
      printf '  %-34s %s\n' "${name%.md}" "${pair%%|*}"
    fi
  done
}

cmd_status() {
  local roots=() dirs=()
  require_init
  # Every checkout: an item on a sibling worktree's branch is in flight too.
  mapfile -t roots < <(all_roots)
  dirs=("${roots[@]/%//$WB\/items}")

  local names=() name
  mapfile -t names < <(find "${dirs[@]}" -path '*/archive/*' -prune -o \
    -name '[bfr]-*.md' -print 2>/dev/null | sed 's|.*/||' | sort -u)

  echo "open items"
  if [ "${#names[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    for name in "${names[@]}"; do status_lines "$name" "${dirs[@]}"; done
  fi

  # Progress is derived from the items that name the milestone, so there is
  # nothing to keep in step by hand and nothing an unattached item owes it.
  local ms=() m
  mapfile -t ms < <(find "${roots[@]/%//$WB\/milestones}" -maxdepth 1 -name '*.md' 2>/dev/null \
    | sed 's|.*/||; s|\.md$||' | sort -u)
  if [ "${#ms[@]}" -gt 0 ]; then
    echo
    echo "milestones"
    for m in "${ms[@]}"; do
      local done_n open_n
      done_n=$(milestone_items "$m" | grep -c '^archived' || true)
      open_n=$(milestone_items "$m" | grep -c '^open' || true)
      printf '  %-34s %s archived, %s open\n' "$m" "$done_n" "$open_n"
    done
  fi

  echo
  echo "branches"
  git branch --format='  %(refname:short)' | grep -E '^  [bfr]-[0-9]+-' \
    || echo "  (none)"

  # Merged and open: invisible to 'git branch', so nothing but a grep or a
  # sweep surfaces one whose trigger never fired. Report the file that actually
  # matched, never a re-lookup that may land on the other checkout's copy.
  echo
  echo "merged, still awaiting a trigger"
  local hits=()
  mapfile -t hits < <(grep -rl '^status: awaiting' "${dirs[@]}" 2>/dev/null | sort -u)
  if [ "${#hits[@]}" -eq 0 ]; then
    echo "  (none)"
  else
    local f
    for f in "${hits[@]}"; do
      printf '  %-34s %s\n' "$(basename "$f" .md)" "$(item_status "$f")"
    done
  fi

  # Two machines allocating before either pushes get the same number, and
  # because the slugs differ git merges the files silently. Detect by ID prefix
  # over deduplicated names — the same name in two checkouts is one item.
  #
  # This runs over the archive as well as the open items. The archive is where
  # spent numbers live, so an open item colliding with an archived one is the
  # likeliest real collision, and pruning it here would hide exactly that case.
  local dupes
  dupes=$(find "${dirs[@]}" -name '[bfr]-*-*.md' -print 2>/dev/null \
    | sed 's|.*/||' | sort -u \
    | sed -n 's|^\([bfr]-[0-9]\{1,\}\)-.*|\1|p' | sort | uniq -d)
  if [ -n "$dupes" ]; then
    echo
    echo "DUPLICATE IDS — see references/git.md for repair"
    printf '%s\n' "$dupes" | sed 's/^/  /'
  fi

  # Reports are untracked and live per checkout; baselines live in the shared
  # git directory. Classify each name over the union of both, from every
  # worktree, so the labels hold from any checkout:
  #   report + baseline  the sweep never returned (the invoker is blocked while
  #                      one runs, so nobody sees this mid-sweep) — or
  #                      review-check failed and left the baseline for a re-run
  #   report only        checked, waiting for triage
  #   baseline only      the report went without 'review-drop'
  local reports=() name all=()
  mapfile -t all < <(all_roots)
  mapfile -t reports < <({
    find "${all[@]/%//$WB\/reviews}" -maxdepth 1 -name '*.md' 2>/dev/null | sed 's|.*/||'
    find "$(baseline_dir)" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | sed 's|.*/||'
  } | sort -u)
  if [ "${#reports[@]}" -gt 0 ]; then
    echo
    echo "reports"
    for name in "${reports[@]}"; do
      local has_report=0 has_base=0
      [ -n "$(find_report "$name")" ] && has_report=1
      [ -f "$(baseline_dir)/$name" ] && has_base=1
      if [ "$has_report" -eq 1 ] && [ "$has_base" -eq 1 ] && grep -qx 'R watch' "$(baseline_dir)/$name"; then
        printf '  %-40s watch shift open — review-check to verify, review-drop to end it\n' "$name"
      elif [ "$has_report" -eq 1 ] && [ "$has_base" -eq 1 ]; then
        printf '  %-40s unchecked — never returned, or review-check failed; inspect, then drop\n' "$name"
      elif [ "$has_report" -eq 1 ]; then
        printf '  %-40s awaiting triage\n' "$name"
      else
        printf '  %-40s stale marker — review-drop it\n' "$name"
      fi
    done
  fi
}

# Every checkout of the repository. Reports are untracked and stay in the
# checkout the sweep ran in, so unlike items — which wb_roots covers — a report
# can sit in any worktree, and only the full list finds it.
all_roots() {
  git worktree list --porcelain | sed -n 's/^worktree //p'
}

# A report by bare name or path, searched over every checkout.
find_report() {
  local roots=()
  mapfile -t roots < <(all_roots)
  find "${roots[@]/%//$WB\/reviews}" -maxdepth 1 -name "$(basename "$1")" -print -quit 2>/dev/null
}

# A report holds findings when something other than the heading, the date line
# and HTML comments is present — structural, like has_evidence, because the
# baseline predates the skeleton and so holds no hash to compare against.
has_findings() {
  sed -e 's/<!--.*-->//' -e '/<!--/,/-->/d' "$1" \
    | grep -v -e '^# ' -e '^date: ' \
    | grep -q '[^[:space:]]'
}

# The one removal path for a report, at either end of its life: an orphan left
# by a sweep that never returned, or a report whose triage is done. Deletes
# whichever of the report and its baseline exist, so neither can be left behind
# for the other to be forgotten about.
cmd_review_drop() {
  local report="${1:-}" force="${2:-}" name path base
  [ -n "$report" ] || usage
  require_init

  name=$(basename "$report")
  path=$(find_report "$name")
  base="$(baseline_dir)/$name"
  [ -n "$path" ] || [ -f "$base" ] || die "no report or baseline named '$name'"

  # Triage leaves no mark on the report, so content alone cannot tell a triaged
  # report from one nobody has read. The baseline can: review-check removes it
  # on a clean pass, so while it exists the findings are unseen — or the check
  # failed, and they are the findings of a sweep that tampered with the tree.
  # Either way they do not vanish on a bare drop.
  # A watch keeps its baseline across the shift; the 'C checked' line is what
  # says the last review-check passed on it.
  if [ -n "$path" ] && [ -f "$base" ] && has_findings "$path" && [ "$force" != "--force" ] \
    && ! grep -qx 'C checked' "$base"; then
    die "$name is unchecked and has findings; run review-check, or pass --force to discard them"
  fi

  [ -n "$path" ] && rm -f "$path" && echo "deleted $path"
  [ -f "$base" ] && rm -f "$base" && echo "deleted baseline for $name"
  local d
  d=$(scratch_dir "$name")
  [ -d "$d" ] && rm -rf "$d" && echo "deleted scratch for $name"
  return 0
}

baseline_dir() {
  printf '%s\n' "$(git_common_dir)/review-baseline"
}

# Where a sweep may write besides its report: helper scripts, captured output,
# whatever investigation needs. The directory ignores itself, so it never
# shows in the snapshot and needs no entry in the project's .gitignore.
scratch_dir() {
  local root
  root=$(repo_root)
  printf '%s\n' "$root/$WB/scratch/$(basename "$1" .md)"
}

ensure_scratch() {
  local d
  d=$(scratch_dir "$1")
  mkdir -p "$d"
  [ -f "$d/../.gitignore" ] || printf '*\n' > "$d/../.gitignore"
  printf '%s\n' "$d"
}

# 'git status --porcelain' reports status, not content: a file already showing
# ' M' still shows ' M' after further edits, so porcelain alone cannot tell a
# sweep's changes from the ones already in the tree. The snapshot therefore
# carries content too — a hash over the tracked diff, and one per untracked
# file — which is what makes the check hold on the dirty tree it exists for.
#
# Runs from the repository root, always. 'git status --porcelain' is
# root-relative wherever it runs, but 'git ls-files --others' is scoped to the
# current directory and prints paths relative to it — so an unpinned snapshot
# would depend on where it was taken, and the two are taken in different places:
# the baseline wherever the sweep stood, the check wherever the caller stands.
tree_snapshot() (
  cd "${1:-$(repo_root)}" || die "cannot reach the repository root"
  git status --porcelain | sed 's/^/S /'
  if git rev-parse --verify -q HEAD >/dev/null; then
    printf 'D %s\n' "$(git diff HEAD | sha256sum | cut -d' ' -f1)"
  fi
  git ls-files --others --exclude-standard -z \
    | while IFS= read -r -d '' f; do
        printf 'H %s %s\n' "$f" "$(sha256sum "$f" | cut -d' ' -f1)"
      done
)

# The sweep runs in a forked context and cannot be trusted to audit itself, so
# the comparison is done here: a baseline the CLI recorded, against the tree as
# it stands now. The only acceptable delta is the report appearing.
cmd_review_check() {
  local report="${1:-}" name base root rel added removed
  [ -n "$report" ] || usage
  require_init

  name=$(basename "$report")
  base="$(baseline_dir)/$name"
  [ -f "$base" ] || die "no baseline for '$name'; open the report with 'workbench review'"

  # The report sits in the checkout the sweep ran in, which need not be the
  # one the check runs from; the snapshot is taken there as the baseline was.
  local found
  found=$(find_report "$name")
  [ -n "$found" ] || die "$WB/reviews/$name does not exist in any checkout; the sweep wrote no report"
  root=${found%/"$WB"/reviews/*}
  rel="$WB/reviews/$name"

  local now reason
  now=$(tree_snapshot "$root")
  reason=$(sed -n 's/^R //p' "$base")
  added=$(comm -13 <(grep -v -e '^M ' -e '^R ' -e '^C ' "$base" | sort) <(printf '%s\n' "$now" | sort))
  removed=$(comm -23 <(grep -v -e '^M ' -e '^R ' -e '^C ' "$base" | sort) <(printf '%s\n' "$now" | sort))

  # The report appearing is the whole permitted delta: its porcelain line, and
  # its content hash. Everything else names something the sweep touched.
  #
  # A watch runs in the main checkout for hours, and by day the user works
  # there too, so a tracked change during a watch is listed for the user to
  # own rather than failing — by night the list is empty and the proof holds.
  local bad=0 tracked=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "S ?? $rel") ;;
      "H $rel "*) ;;
      "D "*) tracked=1 ;;
      "H "*) echo "the sweep wrote: ${line#H }" >&2; bad=1 ;;
      "S ?? "*) [ "$reason" = watch ] || { echo "unexpected change: ${line#S }" >&2; bad=1; } ;;  # its H line reports it
      "S "*) if [ "$reason" = watch ]; then tracked=1; else echo "unexpected change: ${line#S }" >&2; bad=1; fi ;;
      *) echo "unexpected change: $line" >&2; bad=1 ;;
    esac
  done <<< "$added"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "D "*) ;;   # already reported by its replacement on the added side
      "S "*) if [ "$reason" = watch ]; then tracked=1; else echo "the sweep reverted or staged: ${line#S }" >&2; bad=1; fi ;;
      *) echo "the sweep reverted or staged: $line" >&2; bad=1 ;;
    esac
  done <<< "$removed"

  if [ "$tracked" -eq 1 ]; then
    if [ "$reason" = watch ]; then
      echo "tracked files changed during the watch — verify these are yours:" >&2
      git -C "$root" status --porcelain --untracked-files=no | sed 's/^/  /' >&2
    elif [ "$bad" -eq 0 ]; then
      # content changed on a file that was already modified, so no status line moved
      echo "the sweep changed tracked files" >&2; bad=1
    fi
  fi

  if [ "$bad" -ne 0 ]; then
    die "the sweep modified the tree beyond its report. Inspect the changes above
before triaging; the report may be reporting on code it edited."
  fi

  # Nothing here proves the sweep read anything. What it proves is that the
  # evidence points at the tree as it stands — the one failure a sweep that
  # read nothing cannot avoid is citing a place that is not there.
  # The skeleton's own comments name every manifest file, so match against the
  # report with its comments stripped — what the sweep wrote, not what it got.
  local prose tok file line n
  prose=$(mktemp)
  sed -e 's/<!--.*-->//' -e '/<!--/,/-->/d' "$root/$rel" > "$prose"

  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    file=${tok%:*}; line=${tok##*:}
    file=${file#./}
    if [ ! -f "$root/$file" ]; then
      echo "cites $tok, and $file is not in the tree" >&2; bad=1
    else
      n=$(grep -c '' "$root/$file" || true)
      [ "$line" -le "$n" ] || { echo "cites $tok, and $file has $n lines" >&2; bad=1; }
    fi
  done < <(citations "$prose")

  local missing=()
  mapfile -t missing < <(uncovered "$prose" "$base")
  rm -f "$prose"
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "in scope but never named in the report — unswept, or swept and unstated:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    bad=1
  fi

  if [ "$bad" -ne 0 ]; then
    die "the report does not hold up as written. Fix the citations or state the
coverage, then re-run review-check; or review-drop --force to discard it."
  fi

  # A watch shift stays open — its baseline is what lets the next tick find
  # the report — until review-drop ends it. Every other report is checked once.
  if [ "$reason" = watch ]; then
    grep -qx 'C checked' "$base" || echo 'C checked' >> "$base"
    echo "clean: $rel holds up; the shift stays open until review-drop"
  else
    rm -f "$base"
    echo "clean: $rel is the only change, its citations resolve, its scope is named"
  fi
}

# The path:line tokens in a report — the evidence form the sweep is told to
# use. Needs a slash or a dot so a clock time does not count; a URL's port
# arrives as '//host/path:port' once the scheme is cut at its colon. Real
# command output cites places outside the tree too — a host:port, a stack
# frame under /usr — and those are skipped by their shape. Only ever by shape:
# the sweep writes the whole report, so any region exempted (a fenced block,
# say) is a region it could hide a bogus citation in.
citations() {
  grep -oE '[][A-Za-z0-9_.+()/-]+:[0-9]+' "$1" \
    | grep -E '[/.]' | grep -v -e '://' -e '^//' -e '^/' -e '^[0-9.]*:' | sort -u
}

# Manifest files the report never mentions. A file counts as mentioned by its
# own path or by any parent directory written with its trailing slash — "src/"
# standing alone, not "src/" as the head of another path — so a sweep that
# covered a directory says so once. A path is bounded by whitespace, quotes,
# brackets or ,;:* on either side, with an optional "./" before and a
# sentence-ending period after; every other character in it is literal, which
# is what keeps "(group)" and "+page" from reading as regex. A bad pattern is
# fatal — grep's exit 2 read as "not found" would credit every file.
uncovered() {
  local report="$1" base="$2" p cand found rc
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    found=0
    cand=$p
    while :; do
      rc=0
      grep -qE "(^|[[:space:]\`\"'(*,;:])(\./)?$(printf '%s' "$cand" | sed 's/[^A-Za-z0-9_/-]/\\&/g')(\.?([[:space:]\`\"'),;:*]|$))" "$report" || rc=$?
      [ "$rc" -le 1 ] || die "coverage check: bad pattern for '$cand'"
      if [ "$rc" -eq 0 ]; then
        found=1; break
      fi
      cand=${cand%/}
      case "$cand" in
        */*) cand="${cand%/*}/" ;;
        *) break ;;
      esac
    done
    [ "$found" -eq 1 ] || printf '%s\n' "$p"
  done < <(sed -n 's/^M //p' "$base")
}

cmd_review() {
  local reason="${1:-}" scope="${2:-}" root path stamp slug
  [ -n "$reason" ] || usage
  require_init

  case "$reason" in
    sweep|pre-merge|docs|memory|adopt) ;;
    watch)
      # A watch is a sweep with a clock: the loop calls this every tick, and
      # the ticks share one report. An open shift — report and baseline both
      # present for this contract — is resumed, not reopened.
      [ -n "$scope" ] || die "watch needs the contract's slug: workbench review watch <slug>"
      [ -n "$(find_watch "$scope")" ] || die "no contract $WB/watches/$scope.md; write it with 'workbench watch'"
      local open
      open=$(find "$(baseline_dir)" -mindepth 1 -maxdepth 1 \( -name "*-watch-$scope.md" -o -name "*-watch-$scope-[0-9]*.md" \) 2>/dev/null \
        | sort | tail -1 || true)
      if [ -n "$open" ] && [ -n "$(find_report "$(basename "$open")")" ]; then
        # The tick may append findings the last review-check never saw, so
        # its verdict is withdrawn; review-drop asks for a fresh one.
        sed -i '/^C checked$/d' "$open"
        find_report "$(basename "$open")"
        return 0
      fi ;;
    *) die "reason must be one of: sweep, pre-merge, docs, memory, adopt, watch" ;;
  esac

  root=$(repo_root)
  stamp=$(date +%Y%m%d)
  slug=$(slugify "${scope:-$reason}")
  path="$root/$WB/reviews/$stamp-$reason${scope:+-$slug}"

  # The sweep skill opens the report from a preprocessed block, and a failing
  # command there aborts the whole skill silently. So a same-day collision gets
  # a numbered suffix rather than an error; 'workbench status' lists every
  # report still sitting here, which is how an orphaned skeleton stays visible.
  # The baseline dir is shared by every worktree while reports are per
  # checkout, so the collision test covers both or a second worktree's sweep
  # would overwrite the first one's baseline.
  local n=1 candidate="$path.md"
  while [ -e "$candidate" ] || [ -e "$(baseline_dir)/$(basename "$candidate")" ]; do
    n=$((n + 1))
    candidate="$path-$n.md"
  done
  path=$candidate

  # Record what the tree looked like before the sweep touched anything, so that
  # 'review-check' can prove afterwards that the sweep wrote only its report.
  # A clean-tree check would not do: mid-item the tree is normally dirty and the
  # sweep's edits would be indistinguishable from the user's own. The baseline
  # lives in the git directory rather than the tree, or it would appear in its
  # own diff. Taken before the report is written, so the one expected delta is
  # the report itself. While it exists, a sweep is in flight — or was aborted;
  # 'review-check' removes it on a clean pass, 'review-drop' otherwise.
  mkdir -p "$(baseline_dir)"
  # The scratch directory exists before the snapshot, so its self-ignore is
  # in place and nothing written there can ever show as a delta.
  ensure_scratch "$path" >/dev/null
  { tree_snapshot; printf 'R %s\n' "$reason"; } > "$(baseline_dir)/$(basename "$path")"

  local stem
  stem=$(basename "$path" .md)
  cat > "$path" <<EOF
# Review — $reason${scope:+ — $scope}

date: $(date +%Y-%m-%d)

<!-- opened by workbench review; findings with evidence, no template.
     scratch: $WB/scratch/$stem/ — yours to write in -->
EOF

  # A pre-merge's item file lives on its branch — in that item's worktree,
  # not necessarily where the sweep runs. Name it, or say it was not found;
  # never fail here, since the skill's preprocessed block aborts silently.
  if [ "$reason" = pre-merge ]; then
    local item=
    [ -z "$scope" ] || item=$(find_item_anywhere "$scope")
    if [ -n "$item" ]; then
      printf '\n<!-- item: %s -->\n' "$item" >> "$path"
    else
      printf '\n<!-- no item file matching "%s" in any checkout; ask for the id -->\n' "$scope" >> "$path"
    fi
  fi

  write_manifest "$path" "$(baseline_dir)/$(basename "$path")" "$scope"

  echo "$path"
}

# An unswept file and a clean one look the same in a report, so when the scope
# names paths, the skeleton lists what is in them and the baseline records the
# same list as 'M ' lines. review-check then names every file the report never
# mentions. Coverage stays self-reported — the sweep can name a file it never
# opened — but an area it forgot is no longer silent.
#
# Nested CLAUDE.md files are listed alongside because they load on Read only,
# never on cat, head or grep: a sweep that shells out for everything walks
# straight past the instructions for the area it is reviewing.
MANIFEST_CAP=300
write_manifest() {
  local report="$1" base="$2" scope="$3" root
  root=$(repo_root)

  local words=() w paths=()
  read -ra words <<< "$scope"
  for w in ${words+"${words[@]}"}; do
    [ -e "$root/$w" ] && paths+=("$w")
  done

  local files=() guides=()
  if [ "${#words[@]}" -gt 0 ] && [ "${#paths[@]}" -eq "${#words[@]}" ]; then
    mapfile -t files < <(git -C "$root" ls-files --cached --others --exclude-standard -- "${paths[@]}" | sort -u)
    mapfile -t guides < <(printf '%s\n' ${files+"${files[@]}"} | grep -E '(^|/)(CLAUDE|AGENTS)\.md$' | grep -v '^[^/]*$')
  else
    mapfile -t guides < <(git -C "$root" ls-files -- '*/CLAUDE.md' '*/AGENTS.md' | grep '/')
  fi

  if [ "${#guides[@]}" -gt 0 ]; then
    {
      echo
      echo '<!-- CLAUDE.md under the scope. Read each before sweeping its area; they do'
      echo '     not auto-load on cat, head or grep:'
      printf '     %s\n' "${guides[@]}"
      echo '-->'
    } >> "$report"
  fi

  [ "${#files[@]}" -gt 0 ] || return 0
  if [ "${#files[@]}" -gt "$MANIFEST_CAP" ]; then
    echo "workbench: scope holds ${#files[@]} files, above $MANIFEST_CAP; no manifest, coverage unchecked" >&2
    return 0
  fi

  {
    echo
    echo "<!-- in scope: ${#files[@]} files. Name each one the sweep covered, or the"
    echo '     directory when a whole directory was; review-check lists any the report'
    echo '     never mentions:'
    printf '     %s\n' "${files[@]}"
    echo '-->'
  } >> "$report"
  printf 'M %s\n' "${files[@]}" >> "$base"
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  adopt) shift; cmd_adopt "$@" ;;
  new) shift; cmd_new "$@" ;;
  start) shift; cmd_start "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  find) shift; cmd_find "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  milestone) shift; cmd_milestone "$@" ;;
  archive) shift; cmd_archive "$@" ;;
  review) shift; cmd_review "$@" ;;
  status) shift; cmd_status "$@" ;;
  review-check) shift; cmd_review_check "$@" ;;
  review-drop) shift; cmd_review_drop "$@" ;;
  *) usage ;;
esac
