#!/usr/bin/env bash
set -euo pipefail

# tmux-overlay — a program in a popup.
#
#   tmux-overlay -c <client> [-s repo|popup] <name> <command...>
#   tmux-overlay --reap
#   tmux-overlay --show     (the popup's own process)
#
# The popup is a nested tmux client attached to a hidden session that runs
# the command.
#   repo     kept, one per git repository: `ov-<name>-<root>`.
#   popup    (default) new at every open, ended when the popup closes:
#            `ov-<name>-<client>`.
# A pane that runs ssh, a folder that does not exist here, and a program
# that is not installed get a message instead. The design decisions behind
# all of this: common/scripts/CLAUDE.md.

usage() {
  echo "usage: tmux-overlay -c <client> [-s repo|popup] <name> <command...> | --reap" >&2
  exit 2
}

# say <message>: shows the message on the client and stops.
say() {
  tmux display-message -l -c "$client" "tmux-overlay: $1"
  exit 0
}

# key <text>: <text> as a session name part. Letters, digits, - and _ only:
# tmux turns . and : into _ and expands # in a name, / would stop the ov-*
# glob in @skip_sessions from matching.
key() {
  printf '%s' "$1" | sed 's/[^[:alnum:]_-]/_/g'
}

# root_key <dir>: the repo scope's part of the session name.
root_key() {
  local dir="$1"
  case "$dir" in
    "$HOME") key home ;;
    "$HOME"/*) key "${dir#"$HOME"/}" ;;
    *) key "${dir#/}" ;;
  esac
}

# Unsaved buffers plus running terminal jobs. A terminal buffer never counts
# as changed, so its job is counted on its own. The changed field, not the
# bufmodified filter of getbufinfo(): that one also counts a fresh scratch
# buffer.
NVIM_WORK='len(filter(getbufinfo(),{_,b->b.changed&&getbufvar(b.bufnr,"&buftype")!="terminal"}))+len(filter(nvim_list_chans(),{_,c->get(c,"mode","")=="terminal"&&jobwait([c.id],0)[0]==-1}))'

# nvim_busy <pid>: true unless the nvim at <pid> says it has no work. nvim
# 0.12 listens on nvim.<pid>.0 of its server process, a child of the one
# the pane started; older ones are a single process. No socket or no answer
# in 2 seconds (a :! command blocks it) counts as work.
nvim_busy() {
  local pid="$1" p sock n
  for p in "$pid" $(pgrep -P "$pid" || true); do
    for sock in "${XDG_RUNTIME_DIR:-/nonexistent}/nvim.$p.0" "${TMPDIR:-/tmp}/nvim.${USER:-$(id -un)}"/*/"nvim.$p.0"; do
      [ -S "$sock" ] || continue
      n=$(timeout 2 nvim --server "$sock" --remote-expr "$NVIM_WORK" 2>/dev/null) || return 0
      [ "$n" != 0 ]
      return
    done
  done
  return 0
}

# busy <session>: true while the hidden session's program is not alone in
# its pane: something else in the foreground (a command in the shell, an
# editor from lazygit), a child process (a shell's background job, lazygit's
# git), or nvim's own work. Unknown counts as busy.
busy() {
  local s="$1" pid current start
  read -r pid current < <(tmux display -p -t "=$s:" '#{pane_pid} #{pane_current_command}') || return 0
  start=$(tmux display -p -t "=$s:" '#{pane_start_command}') || return 0
  start="${start#\"}"; start="${start%% *}"; start="${start##*/}"
  [ -n "$pid" ] && [ "$current" = "$start" ] || return 0
  [ "$start" = nvim ] && { nvim_busy "$pid"; return; }
  pgrep -P "$pid" >/dev/null
}

# reap <keep>: ends the hidden sessions, other than <keep>, that nothing
# owns, nobody shows and no work keeps. A popup one is left alone: it ends
# with its popup, and before the popup attaches it is not shown yet. A shell
# from before the popup scope (@ov_scope session) goes once idle. One
# without @ov_root (from a restore, or from before this script set it)
# always goes: its program was typed into a shell.
reap() {
  local keep="$1" paths=() attached scope rooted name root path owned
  mapfile -t paths < <(tmux list-panes -a -f '#{?#{m:ov-*,#{session_name}},0,1}' -F '#{pane_current_path}' 2>/dev/null)
  tmux list-sessions -F '#{session_attached} #{?@ov_scope,#{@ov_scope},-} #{?@ov_root,1,0} #{session_name}' 2>/dev/null |
    while read -r attached scope rooted name; do
      case "$name" in ov-*) ;; *) continue ;; esac
      [ "$name" != "$keep" ] && [ "$attached" = 0 ] || continue
      if [ "$rooted" = 1 ]; then
        case "$scope" in
          popup) continue ;;
          session) ;;
          *)
            # A repo one, or one from before @ov_scope: owned by any pane
            # in its folder or below.
            root=$(tmux show -qv -t "=$name:" @ov_root) || continue
            owned=0
            for path in "${paths[@]}"; do
              case "$path" in "$root"|"${root%/}"/*) owned=1; break ;; esac
            done
            [ "$owned" = 0 ] || continue
            ;;
        esac
        busy "$name" && continue
      fi
      tmux kill-session -t "=$name" 2>/dev/null || true
    done
}

# ot <args>: tmux on the outer server, from inside the popup. $TMUX must be
# unset for the nested attach, tmux refuses it otherwise; the socket is
# passed explicitly so a non-default server still works.
ot() {
  TMUX='' tmux -S "$OV_SOCKET" "$@"
}

# popup_loop: the popup's process. It attaches to $OV_SESSION, and after a
# swap to the session the swap names in @ov_next_<this popup's tty>.
# attach -d detaches the session's other clients, whose popups then close.
# @ov_viewer is set in the same command list, so the last attach is always
# the recorded one. A popup one ends with its last client: that is set at
# the attach, not at its creation, because tmux ends a session with
# destroy-unattached as soon as no client is on it. A popup whose attach
# ends with another terminal recorded was taken over and says so; one
# closed or quit says nothing. A mark left by a swap whose popup died would
# send a later popup on the same tty there, so it is cleared first.
popup_loop() {
  local s="$OV_SESSION" mark next end v
  mark="@ov_next_$(key "$(tty)")"
  ot set -gu "$mark" 2>/dev/null || true
  while :; do
    end=off
    [ "$(ot show -qv -t "=$s:" @ov_scope 2>/dev/null)" != popup ] || end=on
    ot attach -d -t "=$s" \; set -t "=$s:" @ov_viewer "$OV_CLIENT" \; \
      set -t "=$s:" destroy-unattached "$end" || return 0
    next=$(ot show -gqv "$mark" 2>/dev/null) || next=
    if [ -n "$next" ]; then
      ot set -gu "$mark"
      s="$next"
      continue
    fi
    v=$(ot show -qv -t "=$s:" @ov_viewer 2>/dev/null) || return 0
    [ -z "$v" ] || [ "$v" = "$OV_CLIENT" ] ||
      ot display-message -l -c "$OV_CLIENT" "tmux-overlay: $(ot show -qv -t "=$s:" @ov_label) moved to another terminal"
    return 0
  done
}

# The popup runs this script with the outer server's variables in its own
# environment, so it comes first.
if [ "${1:-}" = --show ]; then
  [ $# = 1 ] || usage
  popup_loop
  exit 0
fi

[ -n "${TMUX:-}" ] || { echo "tmux-overlay: not inside tmux" >&2; exit 1; }

if [ "${1:-}" = --reap ]; then
  [ $# = 1 ] || usage
  reap ""
  exit 0
fi

[ "${1:-}" = "-c" ] && [ $# -ge 4 ] || usage
client="$2"; shift 2
scope=popup
if [ "$1" = "-s" ]; then
  scope="${2:-}"; shift 2 || usage
fi
case "$scope" in popup|repo) ;; *) usage ;; esac
[ $# -ge 2 ] || usage
name="$1"; shift
pane="${TMUX_PANE:-}"
[ -n "$pane" ] || { echo "tmux-overlay: TMUX_PANE is not set" >&2; exit 1; }

here=$(tmux display -p -t "$pane" '#{session_name}')

# A key inside a popup: the hidden session's table runs this with the
# nested client and the hidden pane. The popup's own key closes it. Another
# one swaps it, as a press from the pane behind the popup: the outer client
# is the one the hidden session recorded, its pane the one on its screen.
nested=
case "$here" in
  ov-*)
    nested="$client"
    if [ "$(tmux show -qv -t "=$here:" @ov_name)" = "$name" ]; then
      tmux detach-client -t "$nested"
      exit 0
    fi
    client=$(tmux show -qv -t "=$here:" @ov_viewer)
    [ -n "$client" ] || exit 0
    pane=$(tmux list-clients -f "#{==:#{client_name},$client}" -F '#{pane_id}')
    [ -n "$pane" ] || exit 0
    ;;
esac

ssh_host=$(tmux show -pqv -t "$pane" @ssh_host)
if [ -n "$ssh_host" ] || [ "$(tmux display -p -t "$pane" '#{pane_current_command}')" = ssh ]; then
  say "this pane is on ${ssh_host:-a remote machine} over ssh; $name would open on this machine"
fi

cwd=$(tmux display -p -t "$pane" '#{pane_current_path}')
[ -d "$cwd" ] || say "$cwd does not exist on this machine"
command -v "${1%% *}" >/dev/null || say "${1%% *} is not installed on this machine"

if [ "$scope" = repo ]; then
  dir=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || dir="$cwd"
  inner="ov-$name-$(root_key "$dir")"
  # Two folders can give one name (a/b_c and a_b/c): the second one gets a
  # name of its own.
  root=$(tmux show -qv -t "=$inner:" @ov_root 2>/dev/null || true)
  if [ -n "$root" ] && [ "$root" != "$dir" ]; then
    inner="$inner-$(printf '%s' "$dir" | cksum | cut -d' ' -f1)"
  fi
  case "$dir" in
    "$HOME") label="$name for ~" ;;
    "$HOME"/*) label="$name for ~/${dir#"$HOME"/}" ;;
    *) label="$name for $dir" ;;
  esac
else
  dir="$cwd"
  label="$name"
  inner="ov-$name-$(key "$client")"
  # Always new. One with this name is left from a popup that never
  # attached: this terminal has one popup, and it is not showing it.
  tmux kill-session -t "=$inner" 2>/dev/null || true
fi

# A failed cleanup must not keep the popup from opening.
reap "$inner" || true

# Start over on a hidden session this script did not start. A restore types
# the program into a shell, so the pane's start command is not the program
# (tmux-revive's own, or none) and :q would leave that shell in the popup.
# tmux shows a start command with a space in quotes.
if tmux has-session -t "=$inner" 2>/dev/null; then
  start=$(tmux display -p -t "=$inner:" '#{pane_start_command}')
  if [ "$start" != "$*" ] && [ "$start" != "\"$*\"" ]; then
    tmux kill-session -t "=$inner"
  fi
fi

# What the hidden session is, set with its creation in one command list so
# no --reap sees it without @ov_root. Two presses at once: the second
# new-session fails, the first one's session is used.
ident=(set -t "=$inner:" @ov_root "$dir" \; set -t "=$inner:" @ov_scope "$scope" \;
  set -t "=$inner:" @ov_name "$name" \; set -t "=$inner:" @ov_label "$label")
if ! tmux has-session -t "=$inner" 2>/dev/null; then
  # -c is a format: ## keeps a # in the folder name.
  tmux new-session -d -s "$inner" -c "${dir//#/##}" "$*" \; "${ident[@]}" 2>/dev/null ||
    tmux has-session -t "=$inner"
fi
# Set on every open, so a session from before these options gets them too.
# @ov_root stays the folder it started in.
ident[4]=$(tmux show -qv -t "=$inner:" @ov_root || true)
[ -n "${ident[4]}" ] || ident[4]="$dir"
tmux "${ident[@]}" \; \
  set -t "=$inner:" status off \; \
  set -t "=$inner:" detach-on-destroy on \; \
  set -t "=$inner:" prefix None \; \
  set -t "=$inner:" prefix2 None \; \
  set -t "=$inner:" key-table ov-root

# A swap: the popup's process attaches to $inner once its client detaches,
# the same attach as for a press.
if [ -n "$nested" ]; then
  tmux set -g "@ov_next_$(key "$nested")" "$inner" \; detach-client -t "$nested"
  exit 0
fi

# The values go in the environment, not the command: tmux expands # in the
# command and a ' in a path would end the quoting.
self="$0"
case "$self" in /*) ;; *) self="$PWD/$self" ;; esac
# shellcheck disable=SC2016 # expanded by the popup's shell
exec tmux display-popup -c "$client" -E -w 92% -h 92% \
  -e "OV_SOCKET=${TMUX%%,*}" -e "OV_SESSION=$inner" \
  -e "OV_CLIENT=$client" -e "OV_SELF=$self" \
  '"$OV_SELF" --show'
