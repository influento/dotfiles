# Claude Code local state (settings overrides, scheduled task locks, etc.)
.claude/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.nvimlog

# Generated from .tpl templates by theme engine (do not edit directly)
common/zsh/.zshrc
common/starship/starship.toml
workstation/lazygit/config.yml
workstation/waybar/config
workstation/waybar/style.css
workstation/mako/config
workstation/swaylock/config
workstation/swayosd/style.css
workstation/swaybg/wallpaper.sh
workstation/theming/gtk-4.0/gtk.css
workstation/mpv/mpv.conf
workstation/mpv/script-opts/osc.conf
common/tmux/tmux.conf
workstation/sway/config

# Runtime config (written by widgets)
workstation/sway/scale.conf
workstation/wlsunset/temperature
workstation/scripts/__pycache__/

# skill-creator eval artifacts (workspace dirs are siblings of the skill)
common/claude-code/skills/**/*-workspace/
common/claude-code/skills/**/__pycache__/
common/claude-code/skills-optional/**/*-workspace/
common/claude-code/skills-optional/**/__pycache__/

# build-cv contains real CV data (name, employers, dates) — this repo is public,
# and identity is deliberately kept untracked (see common/git/.gitconfig)
common/claude-code/skills-optional/build-cv/